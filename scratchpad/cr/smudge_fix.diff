+            print("  ", s[:220])
+    if steps and len(steps) < 30:
+        for e in steps:
+            print("  ALL:", repr(e)[:220])
+    if planes:
+        print("planes_out sample (x=75,100,108):")
+        pl = planes[0] if isinstance(planes[0], (list, tuple)) and len(planes) == 1 else planes
