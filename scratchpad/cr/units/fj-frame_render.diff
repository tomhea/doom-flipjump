+        rep(spn, k) hex.if1 1, hdfl, hcon
+        rep(spn, k) hex.zero w/4, tcon
+        rep(spn, k) hex.mov 4, tcon, sp_base2
+        rep(spn, k) hex.zero w/4, tidx
+        rep(spn, k) hex.mov 2, tidx, tbkt
+        rep(spn, k) hex.add w/4, tcon, tidx
+      hcon:
+        // the shade row: (light, sprite height) class << 8 | bucket height, one baked byte
+        hex.zero w/4, tidx
+        hex.mov 2, tidx + 2*dw, sp_lt
+        hex.mov 2, tidx, thb
+        hex.set w/4, tbb, sprlight
+        hex.ptr_index tbp, tbb, tidx
+        hex.read_byte tlr, tbp
+        // the column DDA: frac starts at (clamped x1 - x1) * istep, exactly as the oracle's does
+        hex.mov 8, tx, tx1
+        hex.zero 8, tfrac
+        hex.sign 8, tx1, tlx, tlxo
+      tlx:
+        hex.zero 8, tx
+        hex.mov 8, tneg, tx1
+        hex.neg 8, tneg
+        hex.mul_lo 8, tfrac, tneg, tistep
+      tlxo:
+        hex.set 8, tcvh, viewwc                 // x2 is INCLUSIVE, so clamp it to VIEW_W-1
+        hex.dec 8, tcvh
+        hex.scmp 8, tx2, tcvh, thxo, thxo, tclamp
+      tclamp:
+        hex.mov 8, tx2, tcvh
+      thxo:
+        hex.mov 2, tdwm, sp_dw
+        hex.dec 2, tdwm                         // the last downscaled texture column
+        hex.set w/4, tdb, drawn
+        hex.ptr_index tdp, tdb, tx
+        hex.set w/4, tfb, sprflag
+        hex.ptr_index tfp, tfb, tx
+      tloop:
+        hex.cmp 2, tx, tx2, tbody, tbody, tret
+      tbody:
+        hex.mov 8, tu, tfrac                    // u = min(dw-1, frac >> 16)
+        hex.shr_hex 8, 4, tu
+        hex.cmp 2, tu, tdwm, tfree, tfree, tuclamp
+      tuclamp:
+        hex.mov 2, tu, tdwm
+      tfree:
+        hex.read_byte tdv, tdp
+        hex.if0 2, tdv, tfree2                  // a nearer wall owns this column -> the thing is hidden
+        ;tnext
+      tfree2:
+        hex.read_byte tfv, tfp
+        hex.if0 2, tfv, tslota                  // no fragment yet -> slot A (offset 0, flag 1)
+        // V4b: slot A taken -- take slot B (byte offset 8 of the same 16-byte slot, flag 2),
+        // else both slots are spent and this thing is hidden here. Walk-arrival order makes
+        // A the nearer fragment and B the one behind it, exactly like the oracle's sfrag2.
+        hex.dec 2, tfv
+        hex.if1 2, tfv, tnext                   // both slots spent -> the thing is hidden here
+        rep(deg, k) hex.if0 1, ballow, tnext    // 25M-CAP: B only for tall-enough fragments
+        ;tslotb
+      tslota:
+        hex.set w/4, tsofs, 0
+        hex.set 2, tflagv, 1
+        ;tblkok
+      tslotb:
+        hex.set w/4, tsofs, 8
+        hex.set 2, tflagv, 2
+      tblkok:
+        // block = sp_base + u*buckets + bucket, at a POWER-OF-TWO stride so the address is a shift
+        // blk = (base + bucket) + u*BUCKETS -- and (base + bucket) is a per-THING constant, so
+        // only the `u*BUCKETS` term belongs in the column loop. `tcon` is that constant, hoisted.
+        hex.zero w/4, tblk
+        hex.mov 2, tblk, tu
+        rep(spn, k) hex.if1 1, hdfl, hmul   // SPR-NEAR: the packed region strides nld
+        rep(spn, k) hex.mul_const w/4, tblk, tblk, nld
+        rep(spn, k) hex.if0 1, hdfl, hmdone
+      hmul:
+        hex.mul_const w/4, tblk, tblk, buckets
+      hmdone:
+        hex.add w/4, tblk, tcon
+        // ⚠ `tblk` stays the RAW block INDEX -- that is what the slot stores and what the emit
+        // shifts. Shifting it here as well double-multiplied the address by the stride AND
+        // overflowed the slot's 4 nibbles, which read back as an all-zero block header and made
+        // every column skip: the frame then differed from the oracle by EXACTLY its sprite pixels.
+        hex.mov w/4, tbo, tblk
+        rep(blkshift, k) hex.shl_bit w/4, tbo   // x SPR_BLOCK_STRIDE dw (a power of two)
+        hex.set w/4, tbb, sprbank
+        hex.ptr_index tbp, tbb, tbo
+        hex.read_byte tr0, tbp                  // the block HEADER: first row, last row
+        hex.ptr_add tbp, 1
+        hex.read_byte trl, tbp
+        hex.ptr_sub tbp, 1
+        hex.if0 2, trl, tnext                   // a fully transparent sprite column
+        // sy1 = max(y0 + r0, 0), sy2p1 = min(y0 + last_rel, VIEW_H); empty -> nothing to store
+        // sy1 = clamp(y0 + r0, 0, VIEW_H), sy2p1 = clamp(y0 + last_rel, 0, VIEW_H).
+        // ⚠ CLAMPED, never REJECTED: the oracle takes the column as soon as the sprite column has
+        // any opaque texel, even when the projected run lands entirely off-screen -- and a taken
+        // column is closed to every LATER thing. Rejecting here instead left the column claimable
+        // and fj recorded fragments the oracle does not have. An empty [sy1, sy2) costs nothing at
+        // emit: the two regions then cover the whole column and every sprite run skips or clamps.
+        // ⚠ the baked run list is relative to r0 (the column's FIRST OPAQUE row), not to the
+        // sprite's row 0 -- exactly as the oracle's fragment stores `ytop_b + st[0]` as its base.
+        // Fold r0 in ONCE here, so the emit's `y0 + rel` is right and `sy1` is the same row.
+        hex.zero 8, trw                         // ... widened: `hex.add 8` reads EIGHT nibbles
+        hex.mov 2, trw, tr0
+        hex.mov 8, tyb, ty0
+        hex.add 8, tyb, trw
+        hex.set 8, tcvh, viewh
+        hex.mov 8, tsy1, tyb
+        hex.sign 8, tsy1, tsy1z, tsy1k
+      tsy1z:
+        hex.zero 8, tsy1
+      tsy1k:
+        hex.scmp 8, tsy1, tcvh, tsy2c, tsy2c, tsy1h
+      tsy1h:
+        hex.mov 8, tsy1, tcvh
+      tsy2c:
+        hex.zero 8, trw
+        hex.mov 2, trw, trl
+        hex.mov 8, tsy2, tyb
+        hex.add 8, tsy2, trw
+        hex.sign 8, tsy2, tsy2z, tsy2k0
+      tsy2z:
+        hex.zero 8, tsy2
+      tsy2k0:
+        hex.scmp 8, tsy2, tcvh, tsy2k, tsy2k, tsy2h
+      tsy2h:
+        hex.mov 8, tsy2, tcvh
+      tsy2k:
+      tdraw:
+        hex.mov 8, tb8, tyb                     // base + 32768, stored as TWO bytes: a tall NEAR
+        hex.add_constant 8, tb8, 32768          // sprite's top can sit far above row -128, and the
+                                                // old one-byte +128 bias WRAPPED there (M13-15M)
+        hex.set w/4, tidx, 0
+        hex.mov 2, tidx, tx
+        rep(slotstride/16, k) hex.shl_hex w/4, 1, tidx   // a power-of-16 stride: whole-nibble shift
+        hex.add w/4, tidx, tsofs                // V4b: slot B lives at byte offset 8
+        hex.set w/4, tbb, spslot
+        hex.ptr_index tbp, tbb, tidx
+        hex.write_byte_and_inc tbp, tsy1
+        hex.write_byte_and_inc tbp, tsy2
+        hex.write_byte_and_inc tbp, tb8
+        hex.write_byte_and_inc tbp, tb8 + 2*dw
+        hex.write_byte_and_inc tbp, tblk
+        hex.write_byte_and_inc tbp, tblk + 2*dw
+        hex.write_byte_and_inc tbp, tlr
+        hex.write_byte tfp, tflagv              // V4b: 1 = A only, 2 = A + B
+      tnext:
+        hex.ptr_add tdp, 1
+        hex.ptr_add tfp, 1
+        hex.inc 2, tx
+        hex.add 8, tfrac, tistep
+        ;tloop
+      tstopset:
+        hex.set 1, tstop, 1
+      tret:
+        stl.fret thing_ret
+      tcap: hex.vec 2
+      vis: hex.vec 1
+      dvis: hex.vec 1
+      dtx1: hex.vec 8
+      dtx2: hex.vec 8
+      dtyt: hex.vec 8
+      dthp: hex.vec 8
+      dtis: hex.vec 8
+      tx1: hex.vec 8
+      tx2: hex.vec 8
+      tytop: hex.vec 8
+      thpx: hex.vec 8
+      tistep: hex.vec 8
+      tbkt: hex.vec 4
+      thb: hex.vec 8
+      ty0: hex.vec 8
+      tyb: hex.vec 8
+      tfrac: hex.vec 8
+      tu: hex.vec 8
+      tdwm: hex.vec 2
+      tx: hex.vec 8
+      tdb: hex.vec w/4
+      tdp: hex.vec w/4
+      tdv: hex.vec 2
+      tfb: hex.vec w/4
+      tfp: hex.vec w/4
+      tfv: hex.vec 2
+      tbb: hex.vec w/4
+      tbp: hex.vec w/4
+      tblk: hex.vec w/4
+      tcon: hex.vec w/4
+      tbo: hex.vec w/4
+      tidx: hex.vec w/4
+      tlr: hex.vec 2
+      tr0: hex.vec 2
+      trl: hex.vec 2
+      trw: hex.vec 8
+      tsy1: hex.vec 8
+      tsy2: hex.vec 8
+      tb8: hex.vec 8
+      tneg: hex.vec 8
+      tcvh: hex.vec 8
+      tsofs: hex.vec w/4                        // V4b: this claim's slot byte offset (0 = A, 8 = B)
+      tflagv: hex.vec 2                         // ... and the flag it leaves (1 = A, 2 = A+B)
+      end:
+    }
+
+    // ── V3 step faces — the RECORD half ────────────────────────────────────────────────────────
+    // A two-sided boundary whose front ceiling is HIGHER (an upper face: a door lintel, a window
+    // head) or whose back floor is HIGHER (a lower face: a stair riser, a ledge front) shows a
+    // vertical strip of wall that this tier otherwise never draws -- without it a step you can walk
+    // up is invisible, the floor just changes colour where it rises.
+    //
+    // The leaf this lives in had NO projection machinery at all (its inputs are geometry and claim
+    // state), so this is a projection path ADDED to a claim walk, not a splice into an existing one.
+    // Two things bound the cost. `STEP_SEG_BUDGET` gates the per-seg SETUP -- a face-carrying seg
+    // pays a full ~93k wall_scale_setup_m, and at a heavy viewpoint every marking seg would
+    // otherwise qualify. And the slots are WRITE-ONCE, which is what makes "nearest wins" free: the
+    // walk is front-to-back, so the FIRST writer is the nearest.
+    //
+    // The scale is INTERPOLATED across the seg (one setup, then `+= scalestep` per column) exactly
+    // as the wall path's is -- an exact per-column scale_from_global_angle is ~40k ops per COLUMN
+    // against ~93k once per SEG. The oracle interpolates identically (ReferenceModel.render_wall_frame).
+    // V5 -- the piece-2 monotone clamp: when this side already holds a piece (count nibble
+    // `cnt` nonzero), the new piece's FIRST row clips past the STORED previous piece's end
+    // byte (slot byte `off`+1), sentinels included -- exactly the oracle's stored-value clamp
+    // (R6), so the two sides can never disagree about a clamped piece.
+    def ts_clamp2 fra, cnt, fbp, off @ doclamp, noprev, fpy, fp1, end {
+        hex.if0 1, cnt, noprev
+        hex.ptr_add fbp, off+1
+        hex.read_byte fpy, fbp
+        hex.ptr_sub fbp, off+1
+        hex.zero 8, fp1
+        hex.mov 2, fp1, fpy
+        hex.inc 8, fp1                          // stored prev y2 + 1 (sentinel bytes included)
+        hex.scmp 8, fra, fp1, doclamp, noprev, noprev
+      doclamp:
+        hex.mov 8, fra, fp1
+      noprev:
+        ;end
+      fpy: hex.vec 2
+      fp1: hex.vec 8
+      end:
+    }
+
+    // V5 -- the LOWER side's mirror: the new piece's LAST row clips past the stored previous
+    // piece's start byte (slot byte `off`) -- b = min(b, prev_y1 - 1), sentinels included.
+    def ts_clamp2_lo frb, cnt, fbp, off @ doclamp, noprev, fpy, fp1, end {
+        hex.if0 1, cnt, noprev
+        hex.ptr_add fbp, off
+        hex.read_byte fpy, fbp
+        hex.ptr_sub fbp, off
+        hex.zero 8, fp1
+        hex.mov 2, fp1, fpy
+        hex.dec 8, fp1                          // stored prev y1 - 1
+        hex.scmp 8, frb, fp1, noprev, noprev, doclamp
+      doclamp:
+        hex.mov 8, frb, fp1
+      noprev:
+        ;end
+      fpy: hex.vec 2
+      fp1: hex.vec 8
+      end:
+    }
+
+    // V5 -- write one 4-byte piece [y1][y2][cls][bpid] at slot offset `off` + count*4, leaving
+    // the slot pointer where it was. count (0 or 1) lives in the flag cell `cnt`.
+    def ts_piece_wr cnt, fbp, off, fy1, fy2, cls, bpid @ wr0, end {
+        hex.if0 1, cnt, wr0
+        hex.ptr_add fbp, off+4
+        hex.write_byte_and_inc fbp, fy1
+        hex.write_byte_and_inc fbp, fy2
+        hex.write_byte_and_inc fbp, cls
+        hex.write_byte_and_inc fbp, bpid
+        hex.ptr_sub fbp, off+8
+        ;end
+      wr0:
+        hex.ptr_add fbp, off
+        hex.write_byte_and_inc fbp, fy1
+        hex.write_byte_and_inc fbp, fy2
+        hex.write_byte_and_inc fbp, cls
+        hex.write_byte_and_inc fbp, bpid
+        hex.ptr_sub fbp, off+4
+        ;end
+      end:
+    }
+
+    // OPTION A (dda) -- the step-face frac DDA. rowfrac = centeryfix - wt*scale accumulates
+    // mod 2^32 with NO shift (the mapmul identity step_rows itself relies on), so stepping the
+    // frac by -wt*scalestep per column reproduces the per-column product BIT FOR BIT: this is
+    // pure ops savings, never a pixel change. Setup runs once per face seg (4 bases + 4 steps);
+    // the steps use 8 schoolbook rows because a negative scalestep is dense in two's complement.
+    def ts_dda_setup fscale, fsstep, fwu1, fwu2, fwl1, fwl2, ccy_c, fru1, fru2, frl1, frl2, stu1, stu2, stl1, stl2 \
+            @ ccyf, end {
+        hex.set 8, ccyf, ccy_c
+        hex.zero 8, fru1
+        rep(6, j) hex.fixed_mul_lo.row 8, j, fru1, fwu1, fscale
+        hex.neg 8, fru1
+        hex.add 8, fru1, ccyf
+        hex.zero 8, fru2
+        rep(6, j) hex.fixed_mul_lo.row 8, j, fru2, fwu2, fscale
+        hex.neg 8, fru2
+        hex.add 8, fru2, ccyf
+        hex.zero 8, frl1
+        rep(6, j) hex.fixed_mul_lo.row 8, j, frl1, fwl1, fscale
+        hex.neg 8, frl1
+        hex.add 8, frl1, ccyf
+        hex.zero 8, frl2
+        rep(6, j) hex.fixed_mul_lo.row 8, j, frl2, fwl2, fscale
+        hex.neg 8, frl2
+        hex.add 8, frl2, ccyf
+        hex.zero 8, stu1
+        rep(8, j) hex.fixed_mul_lo.row 8, j, stu1, fwu1, fsstep
+        hex.zero 8, stu2
+        rep(8, j) hex.fixed_mul_lo.row 8, j, stu2, fwu2, fsstep
+        hex.zero 8, stl1
+        rep(8, j) hex.fixed_mul_lo.row 8, j, stl1, fwl1, fsstep
+        hex.zero 8, stl2
+        rep(8, j) hex.fixed_mul_lo.row 8, j, stl2, fwl2, fsstep
+        ;end
+      ccyf: hex.vec 8
+      end:
+    }
+
+    // ... the per-column row derivation (frac >> 16 arithmetic, exactly step_rows' epilogue)
+    def ts_dda_rows fra, frb, fA, fB {
+        hex.mov 8, fra, fA
+        hex.shr_hex 8, 4, fra
+        hex.sign_extend 8, 4, fra
+        hex.mov 8, frb, fB
+        hex.shr_hex 8, 4, frb
+        hex.sign_extend 8, 4, frb
+    }
+
+    // ... and the per-column advance (frac -= wt*scalestep, mod 2^32 = the 8-nibble sub)
+    def ts_dda_adv fru1, fru2, frl1, frl2, stu1, stu2, stl1, stl2 {
+        hex.sub 8, fru1, stu1
+        hex.sub 8, fru2, stu2
+        hex.sub 8, frl1, stl1
+        hex.sub 8, frl2, stl2
+    }
+
+    def ts_step_faces budget, centeryfix_c, viewh1, projection, slotstride, stack, deg, dstkscale, dda, dlipscale \
+            @ nofaces, dofaces, floop, fbody, fwork, fnext, uskip, udo, ugo, ust1, ust2, ust3, uclz, \
+              ukhi, uhicl, uwr, umark, umark2, lskip, ldo, lgo, lst1, lst2, lst3, lclz, lkhi, lhicl, lwr, \
+              lmark, lmark2, fmax, \
+              fcap, fnorm, fdist, fscale, fsstep, fwu1, fwu2, fwl1, fwl2, fra, frb, fcvh, \
+              fru1, fru2, frl1, frl2, stu1, stu2, stl1, stl2, fmv, ulipn, llipn, udng, ldng, \
+              fx, fdb, fdp, fdv, fsb, fsp, fsv, fbb, fbp, fidx, fy1, fy2, end \
+            < viewangle, viewz, sgn_aff, x1, x2, n_face, drawn, sfflag, sfslot, \
+              seg_segangle, seg_fmask, seg_uh1, seg_uh2, seg_lh1, seg_lh2, seg_ucls, seg_lcls, \
+              seg_bpid {
+        hex.if0 2, seg_fmask, nofaces           // this boundary carries no face at all (compile-time)
+        hex.set 2, fcap, budget
+        hex.cmp 2, n_face, fcap, dofaces, nofaces, nofaces
+      dofaces:
+        hex.inc 2, n_face
+        proj.wall_setup_sgn fnorm, fdist, sgn_aff, seg_segangle
+        proj.wall_scale_setup_m fscale, fsstep, viewangle, fnorm, fdist, x1, x2, projection
+        // the four world heights as map-unit deltas from the eye, hoisted once per seg exactly as
+        // pass 2 hoists wtc8/wtf8. Upper face = [row(front ceil), row(back ceil) - 1]; lower face =
+        // [row(back floor), row(front floor)] -- the oracle's wall_screen_span pairs, verbatim.
+        hex.mov 4, fwu1, seg_uh1
+        hex.sub 4, fwu1, viewz + 4*dw
+        hex.sign_extend 8, 4, fwu1
+        hex.mov 4, fwu2, seg_uh2
+        hex.sub 4, fwu2, viewz + 4*dw
+        hex.sign_extend 8, 4, fwu2
+        hex.mov 4, fwl1, seg_lh1
+        hex.sub 4, fwl1, viewz + 4*dw
+        hex.sign_extend 8, 4, fwl1
+        hex.mov 4, fwl2, seg_lh2
+        hex.sub 4, fwl2, viewz + 4*dw
+        hex.sign_extend 8, 4, fwl2
+        hex.set 8, fcvh, viewh1
+        rep(dda, k) .ts_dda_setup fscale, fsstep, fwu1, fwu2, fwl1, fwl2, centeryfix_c, fru1, fru2, frl1, frl2, stu1, stu2, stl1, stl2
+        hex.zero 8, fx
+        hex.mov 2, fx, x1
+        hex.set w/4, fdb, drawn                 // the occlusion flag, read but never written here
+        hex.ptr_index fdp, fdb, fx
+        hex.set w/4, fsb, sfflag                // one byte per column: which slots are filled
+        hex.ptr_index fsp, fsb, fx
+        hex.zero w/4, fidx
+        hex.mov 2, fidx, fx
+        hex.shl_hex w/4, 1, fidx                // slotstride = 16 bytes -> a whole-nibble shift
+        hex.set w/4, fbb, sfslot
+        hex.ptr_index fbp, fbb, fidx
+      floop:
+        hex.cmp 2, fx, x2, fbody, nofaces, nofaces
+      fbody:
+        hex.read_byte fdv, fdp
+        hex.if0 2, fdv, fwork                   // already painted by a nearer wall -> nothing to show
+        ;fnext
+      fwork:
+        hex.read_byte fsv, fsp
+        // ---- the UPPER face(s) ----------------------------------------------------------------
+        // V5: the flag nibbles are per-side COUNTS (0..1+stack); slot layout is 4-byte pieces
+        // [y1][y2][cls][bpid] at u1@0, u2@4, l1@8, l2@12 -- all inside the 16-byte stride.
+        hex.if0 1, seg_fmask, uskip             // nibble 0 = has an upper face
+        hex.cmp 1, fsv, fmax, udo, uskip, uskip // upper count < 1+stack -> room for a piece
+      udo:
+        // V5-DROP FAR GATE: a LIP farther than dlipscale projects to a sub-pixel line
+        // -- skip the whole piece. Risers are never lip-gated (they ARE the stairs).
+        rep(deg, k) hex.mov 1, fmv, seg_fmask
+        rep(deg, k) hex.dec 1, fmv
+        rep(deg, k) hex.if0 1, fmv, udng
+        rep(deg, k) hex.set 8, fy1, dlipscale
+        rep(deg, k) hex.cmp 8, fscale, fy1, uskip, udng, udng
+      udng:
+        // 25M-CAP STACK FAR GATE: a SECOND stacked piece only when the boundary is near enough
+        // (scale >= dstkscale, one unsigned compare on the register the DDA already carries).
+        // fy1 is dead until ust3, so it serves as the constant cell.
+        rep(deg*stack, k) hex.if0 1, fsv, ugo             // the FIRST piece is never gated
+        rep(deg*stack, k) hex.set 8, fy1, dstkscale
+        rep(deg*stack, k) hex.cmp 8, fscale, fy1, uskip, ugo, ugo
+      ugo:
+        rep(1-dda, k) proj.step_rows fra, frb, fscale, fwu1, fwu2, centeryfix_c
+        rep(dda, k) .ts_dda_rows fra, frb, fru1, fru2
+        hex.dec 8, frb                          // ... ends one row ABOVE the back ceiling
+        // V5-DROP: mode 2 = LIP -- the near ceiling's edge row ALONE; the stored
+        // region-behind then paints the far ceiling below it (mode 1 keeps the riser)
+        hex.mov 1, fmv, seg_fmask
+        hex.dec 1, fmv
+        hex.if0 1, fmv, ulipn
+        hex.mov 8, frb, fra
+      ulipn:
+        // V5: a second piece clips past the STORED first piece's end (sentinels included)
+        rep(stack, k) .ts_clamp2 fra, fsv, fbp, 0
+        // the slot stores BYTES, so a VISIBLE face is stored clipped; the oracle stores the
+        // face whenever A <= B -- EVEN FULLY OFF-SCREEN -- and that write CONSUMES the slot,
+        // blocking farther segs (R40, the 28-column phantom face). V5 splits the off-screen
+        // sentinel by DIRECTION, because the region BEHIND a piece derives from the stored
+        // bytes: fully ABOVE the screen -> (1, 0) (the region behind starts at ~row 0); fully
+        // BELOW -> (255, 254) (the region behind is off-screen). Both keep y1 > y2, so
+        // lines_step_load still rejects them before drawing.
+        hex.scmp 8, fra, frb, ust1, ust1, uskip
+      ust1:
+        hex.sign 8, frb, umark, ust2
+      ust2:
+        hex.scmp 8, fra, fcvh, ust3, ust3, umark2
+      umark:
+        hex.set 8, fy1, 1
+        hex.zero 8, fy2
+        ;uwr
+      umark2:
+        hex.set 8, fy1, 255
+        hex.set 8, fy2, 254
+        ;uwr
+      ust3:
+        hex.mov 8, fy1, fra
+        hex.sign 8, fra, uclz, ukhi
+      uclz:
+        hex.zero 8, fy1
+      ukhi:
+        hex.mov 8, fy2, frb
+        hex.scmp 8, frb, fcvh, uwr, uwr, uhicl
+      uhicl:
+        hex.mov 8, fy2, fcvh
+      uwr:
+        .ts_piece_wr fsv, fbp, 0, fy1, fy2, seg_ucls, seg_bpid
+        hex.inc 1, fsv                          // nibble 0: the upper count
+        hex.write_byte fsp, fsv
+      uskip:
+        // ---- the LOWER face -------------------------------------------------------------------
+        hex.if0 1, seg_fmask + 1*dw, lskip
+        hex.cmp 1, fsv + 1*dw, fmax, ldo, lskip, lskip   // lower count < 1+stack -> room
+      ldo:
+        rep(deg, k) hex.mov 1, fmv, seg_fmask + 1*dw     // V5-DROP far gate, lower mirror
+        rep(deg, k) hex.dec 1, fmv
+        rep(deg, k) hex.if0 1, fmv, ldng
+        rep(deg, k) hex.set 8, fy1, dlipscale
+        rep(deg, k) hex.cmp 8, fscale, fy1, lskip, ldng, ldng
+      ldng:
+        rep(deg*stack, k) hex.if0 1, fsv + 1*dw, lgo      // ... and the LOWER side's mirror
+        rep(deg*stack, k) hex.set 8, fy1, dstkscale
+        rep(deg*stack, k) hex.cmp 8, fscale, fy1, lskip, lgo, lgo
+      lgo:
+        rep(1-dda, k) proj.step_rows fra, frb, fscale, fwl1, fwl2, centeryfix_c
+        rep(dda, k) .ts_dda_rows fra, frb, frl1, frl2
+        // V5-DROP: mode 2 = LIP -- the near floor's edge row alone (the tread-lip line)
+        hex.mov 1, fmv, seg_fmask + 1*dw
+        hex.dec 1, fmv
+        hex.if0 1, fmv, llipn
+        hex.mov 8, fra, frb
+      llipn:
+        // V5: a second (farther) piece clips ABOVE the stored first piece's start
+        rep(stack, k) .ts_clamp2_lo frb, fsv + 1*dw, fbp, 8
+        hex.scmp 8, fra, frb, lst1, lst1, lskip
+      lst1:
+        hex.sign 8, frb, lmark, lst2
+      lst2:
+        hex.scmp 8, fra, fcvh, lst3, lst3, lmark2
+      lmark:
+        hex.set 8, fy1, 1                       // off-screen ABOVE: the (1, 0) sentinel
+        hex.zero 8, fy2
+        ;lwr
+      lmark2:
+        hex.set 8, fy1, 255                     // off-screen BELOW: the (255, 254) sentinel
+        hex.set 8, fy2, 254
+        ;lwr
+      lst3:
+        hex.mov 8, fy1, fra
+        hex.sign 8, fra, lclz, lkhi
+      lclz:
+        hex.zero 8, fy1
+      lkhi:
+        hex.mov 8, fy2, frb
+        hex.scmp 8, frb, fcvh, lwr, lwr, lhicl
+      lhicl:
+        hex.mov 8, fy2, fcvh
+      lwr:
+        .ts_piece_wr fsv + 1*dw, fbp, 8, fy1, fy2, seg_lcls, seg_bpid
+        hex.inc 1, fsv + 1*dw                   // nibble 1: the lower count
+        hex.write_byte fsp, fsv
+      lskip:
+      fnext:
+        hex.ptr_add fdp, 1
+        hex.ptr_add fsp, 1
+        hex.ptr_add fbp, slotstride
+        hex.inc 2, fx
+        hex.add 8, fscale, fsstep               // the interpolated scale advances on EVERY column
+        rep(dda, k) .ts_dda_adv fru1, fru2, frl1, frl2, stu1, stu2, stl1, stl2
+        ;floop
+      nofaces:
+        ;end
+      fcap: hex.vec 2
+      fmax: hex.vec 1, 1+stack                  // V5: pieces allowed per side per column
+      fnorm: hex.vec 8
+      fdist: hex.vec 8
+      fscale: hex.vec 8
+      fsstep: hex.vec 8
+      fwu1: hex.vec 8
+      fwu2: hex.vec 8
+      fwl1: hex.vec 8
+      fwl2: hex.vec 8
+      fra: hex.vec 8
+      frb: hex.vec 8
+      fcvh: hex.vec 8
+      fmv: hex.vec 1
+      fru1: hex.vec 8
+      fru2: hex.vec 8
+      frl1: hex.vec 8
+      frl2: hex.vec 8
+      stu1: hex.vec 8
+      stu2: hex.vec 8
+      stl1: hex.vec 8
+      stl2: hex.vec 8
+      fx: hex.vec 8
+      fdb: hex.vec w/4
+      fdp: hex.vec w/4
+      fdv: hex.vec 2
+      fsb: hex.vec w/4
+      fsp: hex.vec w/4
+      fsv: hex.vec 2
+      fbb: hex.vec w/4
+      fbp: hex.vec w/4
+      fidx: hex.vec w/4
+      fy1: hex.vec 8
+      fy2: hex.vec 8
+      end:
+    }
+
+    def seg_pass1_leaf_body_ts budget, dbl, dsl, dtb, steps, sbudget, centeryfix_c, viewh1, projection, slotstride, stack, deg, dstkscale, dda, dlipscale \
+            @ ret, bok, bstop, wok, wlo, wahi, wbhi, wbok, scan, nolow, dolow, nohigh, dohigh, \
+              loop, body, claim, next, pdone, tsgo, xa, xb, pm1, bcap \
+            < viewx, viewy, viewxa, viewxs, viewya, viewys, sgn_aff, viewangle, \
+              seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c, seg_pid, \
+              pclm, visible, x1, x2, x, pbase, pptr, pval8, pmin, pmax, \
+              n_claimed, n_tsv, tsstop, tsbstop, vieww, seg_ret, full, \
+              wrej, wqa, wna, wqb, wnb, wex, wey, weyx, wexy {
+        // V5-DROP-P2: the correct monotone stop -- every column WALL-drawn means neither an
+        // attribution nor a PIECE can land (drawn[x] blocks both), exactly like the thing
+        // pre-pass (R48). Attribution-complete alone must NOT stop this leaf: pieces still
+        // record into attributed-but-undrawn columns.
+        hex.if0 1, full, tsgo
+        stl.fret seg_ret
+      tsgo:
+        // Spend one unit of the per-frame attribution BUDGET (config.PNEAR_SEG_BUDGET). Segs arrive
+        // nearest-first, so the budget only ever costs FAR attribution -- and it is what BOUNDS the
+        // cost of a frame whose view never closes: with open sky or void on screen `n_claimed` never
+        // reaches VIEW_W, and one such E1M1 viewpoint measured 69.6M ops/frame before this existed.
+        hex.inc 2, n_tsv
+        hex.set 2, bcap, budget
+        hex.cmp 2, n_tsv, bcap, bok, bstop, bok
+      bstop:
+        hex.set 1, tsstop, 1                    // this seg is the last one the budget allows
+        hex.set 1, tsbstop, 1                   // V5-DROP-P2b: the BUDGET-ONLY latch piece-seg
+      bok:                                      // call sites test (tsstop also means claim-done)
+        proj.wedge_reject wrej, seg_v1x, seg_v1y, seg_v2x, seg_v2y, wqa, wna, wqb, wnb, wex, wey, weyx, wexy
+        hex.if0 1, wrej, wok
+        stl.fret seg_ret
+      wok:
+        proj.wall_x_range_m dbl, dsl, dtb, visible, x1, x2, sgn_aff, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c
+        hex.if0 1, visible, ret
+        // V3: record this boundary's step faces over its FULL column range -- deliberately BEFORE
+        // the [pmin, pmax] window clip below, which is an attribution optimisation only: a column
+        // outside the unattributed window can still be undrawn, and the oracle records a face there.
+        rep(steps, k) .ts_step_faces sbudget, centeryfix_c, viewh1, projection, slotstride, stack, deg, dstkscale, dda, dlipscale
+        // Clip the scan to the UNATTRIBUTED WINDOW [pmin, pmax]. Every column below pmin / above
+        // pmax is already attributed by a nearer seg, so scanning it can only re-read a nonzero
+        // byte: at (-309,636) that is 769 column reads cut to 201, and 37 of the 60 projected segs
+        // exit here outright. The bounds are maintained WITHOUT any extra reads -- see below.
+        hex.mov 2, xa, x1
+        hex.cmp 2, xa, pmin, wlo, wahi, wahi    // xa = max(x1, pmin)
+      wlo:
+        hex.mov 2, xa, pmin
+      wahi:
+        hex.mov 2, pm1, pmax
+        hex.inc 2, pm1
+        hex.mov 2, xb, x2
+        hex.cmp 2, xb, pm1, wbok, wbok, wbhi    // xb = min(x2, pmax+1)
+      wbhi:
+        hex.mov 2, xb, pm1
+      wbok:
+        hex.cmp 2, xa, xb, scan, ret, ret       // window empty for this seg -> nothing to attribute
+      scan:
+        // After this scan [xa, xb) is attributed in full, so if the scan STARTS at pmin the bound
+        // can jump to xb, and if it ENDS at pmax+1 the bound can drop to xa-1 -- a conservative
+        // update that costs two compares and no memory reads. (pmax underflowing to 0xFF is fine:
+        // it makes pm1 = 0, so every later seg finds an empty window, which is exactly the truth.)
+        hex.cmp 2, xa, pmin, nolow, dolow, nolow
+      dolow:
+        hex.mov 2, pmin, xb
+      nolow:
+        hex.cmp 2, xb, pm1, nohigh, dohigh, nohigh
+      dohigh:
+        hex.mov 2, pmax, xa
+        hex.dec 2, pmax
+      nohigh:
+        hex.zero 8, x
+        hex.mov 2, x, xa                        // the claim scan over the stride-1 pclm[]
+        hex.set w/4, pbase, pclm
+        hex.ptr_index pptr, pbase, x            // ptr_index reads w/4 nibbles of its index (R11)
+      loop:
+        hex.cmp 2, x, xb, body, ret, ret
+      body:
+        hex.read_byte pval8, pptr
+        hex.if0 2, pval8, claim
+        hex.ptr_add pptr, 1                     // a nearer seg already attributed this column
+        ;next
+      claim:
+        hex.write_byte_and_inc pptr, seg_pid    // pclm[x] = this seg's plane-pair id (advances too)
+        hex.inc 2, n_claimed
+        hex.cmp 2, n_claimed, vieww, next, pdone, next
+      pdone:
+        // V5-DROP-P2: claim-completion latches tsstop, but the CALL SITES only test it for
+        // LIGHT-ONLY marking segs (no pieces possible -- attribution was their whole job).
+        // Piece-carrying segs call unconditionally and stop on this leaf's `full` entry test
+        // instead: pieces still land in attributed-but-undrawn columns (the owner's
+        // (1210,1187) field flip -- R48's sibling).
+        hex.set 1, tsstop, 1
+      next:
+        hex.inc 2, x
+        ;loop
+      ret:
+        stl.fret seg_ret
+      xa: hex.vec 2
+      xb: hex.vec 2
+      pm1: hex.vec 2
+      bcap: hex.vec 2
+    }
+
+    // M13-2S rung 3a — a column's two band-list addresses FROM ITS PLANE-PAIR ID. The bank is laid
+    // out per pid (1-based): pid p's ceiling list is slot 2(p-1), its floor list 2(p-1)+1, so both
+    // addresses are one strength-reduced constant multiply (the stride has 2 set bits) plus adds off
+    // the frame's bank pointer. That is the whole reason the claim state is a single BYTE: the
+    // alternative -- per-column address cells read back with hex.ptr_index + hex.read_hex 8 -- costs
+    // ~780 dispatches per column (w(2.25@) + 8x(24@)), measured at +5M/frame.
+    // M13-15M BANDS-AS-CODE: the ID twin of lines_pid_addrs. The four registers now carry LIST
+    // IDS for `vpb_walk` instead of bank addresses: pid p's four half-lists are consecutive at
+    // vzcbase + (p-1)*4 (vzcbase = class*n_bank_keys*2, a per-frame const the descend leaf sets),
+    // in the SAME [ceil_asc][ceil_desc][floor_asc][floor_desc] order the bank used. The multiply
+    // shrinks from mul_const 4*half_slots*dw to mul_const 4.
+    def lines_pid_ids pidreg, cbufa, cbufd, fbufa, fbufd < vzcbase {
+        hex.zero w/4, cbufa
+        hex.mov 2, cbufa, pidreg
+        hex.mul_const w/4, cbufa, cbufa, 4
+        hex.add w/4, cbufa, vzcbase
+        hex.sub_constant w/4, cbufa, 4                     // pids are 1-based (0 = unattributed)
+        hex.mov w/4, cbufd, cbufa
+        hex.add_constant w/4, cbufd, 1
+        hex.mov w/4, fbufa, cbufa
+        hex.add_constant w/4, fbufa, 2
+        hex.mov w/4, fbufd, fbufa
+        hex.add_constant w/4, fbufd, 1
+    }
+
+    def lines_pid_addrs pidreg, half_slots, cbufa, cbufd, fbufa, fbufd < vzbank {
+        hex.zero w/4, cbufa                                // widen the 2-nibble pid first: mul_const
+        hex.mov 2, cbufa, pidreg                           // reads w/4 nibbles of its source (R11)
+        hex.mul_const w/4, cbufa, cbufa, 4*half_slots*dw
+        hex.add w/4, cbufa, vzbank
+        hex.sub_constant w/4, cbufa, 4*half_slots*dw       // pids are 1-based (0 = unattributed)
+        hex.mov w/4, cbufd, cbufa
+        hex.add_constant w/4, cbufd, half_slots*dw
+        hex.mov w/4, fbufa, cbufa
+        hex.add_constant w/4, fbufa, 2*half_slots*dw
+        hex.mov w/4, fbufd, fbufa
+        hex.add_constant w/4, fbufd, half_slots*dw
+    }
+
+    // M13-2S rung 3a — this column's plane attribution, in the EMIT half. The nearest marking seg's
+    // stored pid wins; if none reached the column yet then THIS seg is the nearest, so it uses its
+    // own baked pid and claims the column (which is what lets `tsstop` ever become true -- most
+    // columns are first reached by a one-sided wall). `pptr` walks pclm[] in lockstep with the
+    // drawn[] pointer, so there is no per-column ptr_index (w(2.25@)) at all.
+    // V2 - the frame's sky scroll = viewangle >> 24, i.e. exactly 6 nibbles. That is why SKY_TURN
+    // is 2 and not 4: fj shifts cheaply only by whole nibbles (ReferenceModel._sky_shift).
+    def lines_sky_base skb @ t8, end < viewangle {
+        hex.mov 8, t8, viewangle
+        hex.shr_hex 8, 6, t8
+        hex.mov 2, skb, t8
+        ;end
+      t8: hex.vec 8
+      end:
+    }
+
+    // V2 - this column's CEILING list: the SKY list when the attributed pid's ceiling is F_SKY1,
+    // otherwise the plane list `lines_pid_addrs` already computed. Sky is the one surface with no
+    // perspective and no distance lighting, so a sky column IS just a band list -- which is why the
+    // whole feature costs one dispatch and one add here and adds NO new emit path: the existing
+    // ceiling prefix walk streams it unchanged.
+    // `u = skybase + skyoff[x]` needs NO MASK: both addends are <= 127 and the bank holds 256
+    // lists with entry u carrying sky column (u & 127), so the sum can never leave it (max 253).
+    // M13-15M: the ID twin — sky list u's two halves are ids SKY_BASE_ID + u*2 (+1 for desc);
+    // the 16-nibble mul_const + label add of the address form die (they were 0.66M at the tree).
+    def lines_sky_ceil_ids sky_base_id, skyall, cbufa, cbufd, x, skb, soff, issky, pidreg @ notsky, end {
+        skypid.lookup issky, pidreg
+        rep(1-skyall, k) hex.if0 2, issky, notsky
+        skyoff.lookup soff, x
+        hex.add 2, soff, skb
+        hex.zero w/4, cbufa
+        hex.mov 2, cbufa, soff
+        hex.shl_bit w/4, cbufa                  // u*2: the ids interleave asc,desc
+        hex.add_constant w/4, cbufa, sky_base_id
+        hex.mov w/4, cbufd, cbufa
+        hex.add_constant w/4, cbufd, 1
+        ;end
+      notsky:
+        hex.zero 2, soff                        // non-sky columns share soff=0 for the ditto test
+        ;end
+      end:
+    }
+
+    def lines_sky_ceil skystride, halfslots, skyall, cbufa, cbufd, x, skb, soff, issky, pidreg @ notsky, tskb, end < skybands {
+        skypid.lookup issky, pidreg
+        rep(1-skyall, k) hex.if0 2, issky, notsky   // skyall=1: force it (bisect probe)
+        skyoff.lookup soff, x
+        hex.add 2, soff, skb
+        hex.zero w/4, cbufa                     // widen before mul_const (R11 reads w/4 nibbles)
+        hex.mov 2, cbufa, soff
+        hex.mul_const w/4, cbufa, cbufa, skystride*dw
+        hex.set w/4, tskb, skybands             // a LABEL base goes through hex.set (the proven
+        hex.add w/4, cbufa, tskb                // idiom -- cf. `hex.set w/4, dbase, drawn`), not
+                                                // through add_constant
+        hex.mov w/4, cbufd, cbufa               // ... and the DESC half, which emit_col_lines walks
+        hex.add_constant w/4, cbufd, halfslots*dw   // via cdesc2 once ctake > CENTERY. Overriding
+                                                // only cbufa left sky above the horizon and PLANE
+                                                // bands below it.
+        ;end
+      notsky:
+        hex.zero 2, soff                        // non-sky columns share soff=0 so the ditto test
+        ;end                                    // compares equal for them
+      tskb: hex.vec w/4
+      end:
+    }
+
+    // V3 -- the per-face SHADE. A step face is flat-shaded, but it still takes DOOM's scalelight row
+    // for its own on-screen height exactly as a wall column does, so the colour is a pure function
+    // of (light class, CLIPPED height) -- which makes it a baked table, `stepcol`, 256 bytes per
+    // class so the class offset is a whole-nibble shift and the whole lookup is one ptr_index.
+    // ⚠ The height is the CLIPPED one, so this cannot be folded into the slot at record time.
+    def step_shade cls, y1, y2, cpb @ sh_idx, sh_p, end {
+        hex.zero w/4, sh_idx
+        hex.mov 2, sh_idx + 2*dw, cls           // idx = class<<8 | h
+        hex.mov 2, sh_idx, y2
+        hex.sub 2, sh_idx, y1
+        hex.inc 2, sh_idx                       // h = y2 - y1 + 1, in [1, VIEW_H]
+        hex.ptr_index sh_p, cpb, sh_idx
+        hex.read_byte cls, sh_p                 // in place: the class byte becomes the colour byte
+        ;end
+      sh_idx: hex.vec w/4
+      sh_p: hex.vec w/4
+      end:
+    }
+
+    // V3 -- this column's step faces, read back from the write-once slots the two-sided claim leaf
+    // filled, then CLIPPED to the regions the claiming wall actually left open (ceiling [0, ctake),
+    // floor [fstart, VIEW_H)) and shaded. Clipping here rather than in the emit keeps the emitted
+    // column MONOTONE by construction: each face is proven to land strictly inside its own region.
+    // The overwhelming majority of columns carry no face, and they pay ONE byte read for it.
+    def lines_step_load stv, ufl, uy1, uy2p1, ucol, lfl, ly1, ly2p1, lcol, x, cexcl, fstart \
+            @ ct0, cth, unone, uhave, uclamp, ustart, udraw, uskip, \
+              lnone, lhave, lclamp, lstart, ldraw, lskip, \
+              sfb, sfp, sbb, sbp, sidx, cpb, ctake, ct1, end \
+            < sfflag, sfslot, stepcol {
+        hex.zero 1, ufl
+        hex.zero 1, lfl
+        // ⚠ ZEROED, not left stale: these six are the column's DITTO SIGNATURE (see dstchk), and a
+        // leftover value from the previous column would make two identical columns compare
+        // different. `uy2p1`/`ly2p1` are exclusive end rows, so a real face always has them >= 1 --
+        // which is what lets the signature be the six values alone, with no separate "has a face"
+        // bit in the compare.
+        hex.zero 2, uy1
+        hex.zero 2, uy2p1
+        hex.zero 2, ucol
+        hex.zero 2, ly1
+        hex.zero 2, ly2p1
+        hex.zero 2, lcol
+        hex.set w/4, sfb, sfflag
+        hex.ptr_index sfp, sfb, x
+        hex.read_byte stv, sfp
+        hex.if0 2, stv, end                     // no face in this column -- the common case
+        hex.mov 2, ctake, cexcl                 // ctake = min(cexcl, fstart), as the emit computes it
+        hex.cmp 2, ctake, fstart, ct0, ct0, cth
+      cth:
+        hex.mov 2, ctake, fstart
+      ct0:
+        hex.zero w/4, sidx
+        hex.mov 2, sidx, x
+        hex.shl_hex w/4, 1, sidx                // 16 bytes per column -> a whole-nibble shift
+        hex.set w/4, sbb, sfslot
+        hex.ptr_index sbp, sbb, sidx
+        hex.set w/4, cpb, stepcol
+        // ---- UPPER: [uy1, min(uy2, ctake-1)], inside the ceiling region
+        hex.if0 1, stv, unone
+        hex.read_byte_and_inc uy1, sbp
+        hex.read_byte_and_inc uy2p1, sbp
+        hex.read_byte_and_inc ucol, sbp         // the face's colour CLASS until step_shade runs
+        ;uhave
+      unone:
+        hex.ptr_add sbp, 3
+        ;uskip
+      uhave:
+        hex.if0 2, ctake, uskip                 // no ceiling region at all in this column
+        hex.mov 2, ct1, ctake
+        hex.dec 2, ct1
+        hex.cmp 2, uy2p1, ct1, ustart, ustart, uclamp
+      uclamp:
+        hex.mov 2, uy2p1, ct1
+      ustart:
+        hex.cmp 2, uy1, uy2p1, udraw, udraw, uskip
+      udraw:
+        .step_shade ucol, uy1, uy2p1, cpb
+        hex.inc 2, uy2p1                        // the pair's EXCLUSIVE end row
+        hex.set 1, ufl, 1
+      uskip:
+        // ---- LOWER: [max(ly1, fstart), ly2], inside the floor region
+        hex.if0 1, stv + 1*dw, lnone
+        hex.read_byte_and_inc ly1, sbp
+        hex.read_byte_and_inc ly2p1, sbp
+        hex.read_byte_and_inc lcol, sbp
+        ;lhave
+      lnone:
+        ;lskip
+      lhave:
+        hex.cmp 2, ly1, fstart, lclamp, lstart, lstart
+      lclamp:
+        hex.mov 2, ly1, fstart
+      lstart:
+        hex.cmp 2, ly1, ly2p1, ldraw, ldraw, lskip
+      ldraw:
+        .step_shade lcol, ly1, ly2p1, cpb
+        hex.inc 2, ly2p1
+        hex.set 1, lfl, 1
+      lskip:
+        ;end
+      sfb: hex.vec w/4
+      sfp: hex.vec w/4
+      sbb: hex.vec w/4
+      sbp: hex.vec w/4
+      sidx: hex.vec w/4
+      cpb: hex.vec w/4
+      ctake: hex.vec 2
+      ct1: hex.vec 2
+      end:
+    }
+
+    // V5 -- the STACKED-pieces load: the RAW stored slot bytes (rows still unclipped-to-region,
+    // sentinels included) plus the per-side counts. The stack emit (`steps_splice_c`/`_f`) does
+    // its own clipping and shading against the column's window, so the ditto signature is the
+    // raw values + the window rows already in the chain. Zeroed when absent (the signature
