+    def row_clamp_top dst, src, viewh @ lo, hi, keep, clampv, cVH, end {
+        hex.sign 8, src, lo, hi
+      lo:
+        hex.zero 2, dst
+        ;end
+      hi:
+        hex.set 8, cVH, viewh
+        hex.scmp 8, src, cVH, keep, keep, clampv
+      keep:
+        hex.mov 2, dst, src
+        ;end
+      clampv:
+        hex.set 2, dst, viewh
+        ;end
+      cVH: hex.vec 8
+      end:
+    }
+
+    def row_clamp_bot dst, src, viewh @ tmp, end {
+        hex.mov 8, tmp, src
+        hex.inc 8, tmp
+        .row_clamp_top dst, tmp, viewh
+        ;end
+      tmp: hex.vec 8
+      end:
+    }
+
+    // the one-sided wall's run: [max(ctake, chi), min(fstart, flo))
+    def wall_span y1, y2, ctake, fstart @ a, b, clampf, end < chi, flo {
+        hex.mov 2, y1, ctake
+        hex.cmp 2, y1, chi, a, b, b
+      a:
+        hex.mov 2, y1, chi
+      b:
+        hex.mov 2, y2, fstart
+        hex.cmp 2, y2, flo, end, end, clampf
+      clampf:
+        hex.mov 2, y2, flo
+      end:
+    }
+
+    // ablate "colstub" (measurement only): a column visit that does the bookkeeping a one-sided
+    // wall would -- close the window -- but none of the projection, region or buffer work. The
+    // delta against the full body prices that work with the walk's early-outs still firing.
+    def ts_stub_close < chi, flo, viewh_stub {
+        hex.mov 2, chi, viewh_stub
+        hex.zero 2, flo
