+        hex.cmp 2, loi, bb_count, wrt, past, past
+      past:                                          // b >= count: the run reaches the window end
+        hex.mov 2, runw, bb_count
+        hex.sub 2, runw, ycur
+        hex.write_byte_and_inc ptr, runw
+        hex.write_byte_and_inc ptr, zrow_cur
+        hex.inc 2, bb_n
+        ;done
+      wrt:
+        hex.mov 2, runw, loi
+        hex.sub 2, runw, ycur
+        hex.write_byte_and_inc ptr, runw
+        hex.write_byte_and_inc ptr, zrow_cur
+        hex.inc 2, bb_n
+        hex.mov 2, ycur, loi
+        hex.zero w/4, probe                          // re-read ys at the boundary row
+        hex.mov 2, probe, loi
+        hex.mul_const w/4, probe, probe, 3*dw
+        hex.add w/4, probe, ysbase
+        hex.zero 8, ys
+        rep(3, k) hex.read_byte_and_inc ys + 2*k*dw, probe
+        hex.if0 2, bb_ascending, rdesc
+      rasc:                                          // re-march: while zidx<127 && ys >= step*(zidx+1)
+        hex.zero 8, cutT
+        hex.mov 3, cutT, zidx
+        hex.inc 3, cutT
+        hex.mul_lo 8, cutT6, step, cutT
+        hex.mov 8, cutT, cutT6
+      rabody:
+        hex.cmp 3, zidx, c127, rachk, rastop, rastop
+      rachk:
+        hex.cmp 8, cutT, cFFF6, rat1, rat1, rat2
+      rat2:
+        hex.set 6, thr, 0xFFFFFF
+        ;rat3
+      rat1:
+        hex.mov 6, thr, cutT
+      rat3:
+        hex.cmp 6, ys, thr, rastop, rabump, rabump
+      rabump:
+        hex.inc 3, zidx
+        hex.add 8, cutT, step
+        ;rabody
+      rastop:
+        ;rdone
+      rdesc:                                         // re-march: while zidx>0 && ys < step*zidx
+        hex.zero 8, cutT
+        hex.mov 3, cutT, zidx
+        hex.mul_lo 8, cutT6, step, cutT
+        hex.mov 8, cutT, cutT6
+      rdbody:
+        hex.if0 3, zidx, rdstop
+        hex.cmp 8, cutT, cFFF6, rdt1, rdt1, rdt2
+      rdt2:
+        hex.set 6, thr, 0xFFFFFF
+        ;rdt3
+      rdt1:
+        hex.mov 6, thr, cutT
+      rdt3:
+        hex.cmp 6, ys, thr, rdbump, rdstop, rdstop
+      rdbump:
+        hex.dec 3, zidx
+        hex.sub 8, cutT, step
+        ;rdbody
+      rdstop:
+        ;rdone
+      rdone:
+        hex.mov 3, zlidx, zlbase
+        hex.add 3, zlidx, zidx
+        hex.read_table 2, zrow_cur, zlight, 3, zlidx
+        ;gloop
+
+      empty:
+        ;done
+      done:
+        stl.fret plane_band_ret
+
+      ptr: hex.vec w/4
+      ysbase: hex.vec w/4
+      ysptr: hex.vec w/4
+      probe: hex.vec w/4
+      y0w: hex.vec w/4
+      yadv: hex.vec w/4
+      ycur: hex.vec 2
+      cutz: hex.vec 3
+      cutT: hex.vec 8
+      cutT6: hex.vec 8
+      zidx: hex.vec 3
+      zrow_cur: hex.vec 2
+      zrow: hex.vec 2
+      step: hex.vec 8
+      lvl: hex.vec 3
+      zlbase: hex.vec 3
+      zlidx: hex.vec 3
+      loi: hex.vec 2
+      hii: hex.vec 2
+      mid: hex.vec 2
+      thr: hex.vec 6
+      dist: hex.vec 8
+      ys: hex.vec 8
+      runw: hex.vec 2
+      cFF2: hex.vec 2
+      c127: hex.vec 3
+      cFFF6: hex.vec 8
+    }
+}
