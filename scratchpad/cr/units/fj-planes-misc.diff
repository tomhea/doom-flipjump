--- a/src/fj/fixed_point.fj
+++ b/src/fj/fixed_point.fj
@@ -39,6 +39,55 @@ ns hex {
     }
 
 
+    // M13-mulcrush — BYTE-EXACT-identical to `fixed_mul n, f, dst, a, b`, ~3x cheaper: the full
+    //  2n-nibble product is TRUNCATED-SCHOOLBOOK'd at n+f nibbles (the only nibbles fixed_mul's
+    //  [f, f+n) result slice can see). Row j adds wa[0..m-j)*wb[j] at offset j with add_mul's own
+    //  mod-16^(m-j) ripple — every pair with i+j < m lands exactly, columns >= m are dropped, so
+    //  res[0..m) == the full product's low m nibbles and dst == fixed_mul's dst, bit for bit.
+    //  Zero-digit rows (e.g. the sign-extension nibbles of small positive operands) skip their
+    //  add_mul behind a 1-nibble if0. No dst/src shifting, no count_bits (hex.mul's per-iteration
+    //  overhead), compile-time offsets throughout.
+    // @Assumes: 0 < f <= n.
+    // @requires hex.init
+    def fixed_mul_lo n, f, dst, a, b @ wide_a, wide_b, res, end {
+        .mov n, wide_a, a
+        .sign_extend n+f, n, wide_a
+        .mov n, wide_b, b
+        .sign_extend n+f, n, wide_b
+        .zero n+f, res
+        rep(n+f, j) .fixed_mul_lo.row n+f, j, res, wide_a, wide_b
+        .mov n, dst, res + f*dw
+        ;end
+
+      wide_a: .vec n+f
+      wide_b: .vec n+f
+      res: .vec n+f
+      end:
+    }
+    ns fixed_mul_lo {
+        // one truncated-schoolbook row: res[j..m) += wa[0..m-j) * wb[j]  (skipped when wb[j]==0)
+        def row m, j, res, wa, wb @ skip {
+            ..if0 1, wb + j*dw, skip
+            ..add_mul m-j, res + j*dw, wa, wb + j*dw
+          skip:
+        }
+    }
+
+
+    // M13-sidemul — BIT-IDENTICAL to `hex.mul n, res, a, b` (both are the product mod 16^n),
+    //  as an unrolled truncated schoolbook: n(n+1)/2 nibble-pairs at compile-time offsets, an
+    //  if0-skip per zero b-digit — no per-iteration shl/shr n, no count_bits, and (unlike
+    //  hex.mul's early-exit) no blow-up on sign-extended NEGATIVE operands (R19). res must not
+    //  alias a or b.
+    // @requires hex.init
+    def mul_lo n, res, a, b @ end {
+        .zero n, res
+        rep(n, j) .fixed_mul_lo.row n, j, res, a, b
+        ;end
+      end:
+    }
+
+
     //  Time Complexity: n^2(76@+216) + n(15@+50)
     // Space Complexity: n(45@+600)
     //   if b==0: goto div0
@@ -103,6 +152,24 @@ ns hex {
     // The entry address is computed with the strength-reduced mul_const (no runtime-amount
     //  shift), then read through a pointer.
     // @requires hex.init & stl.ptr_init
+    // M13-lutpack — dst[:2*nb] = table[idx] for a PACKED-byte LUT (entry = nb consecutive bytes,
+    //  little-endian, one dw-slot per byte: doomfj generate_packed_lut_fj). Same values as the
+    //  read_table form, ~600 ops/BYTE (read_byte_and_inc) instead of ~1.1k/NIBBLE (read_hex's
+    //  per-nibble pointer re-derivation) — delta-measured, R19-era. dst must not alias idx.
+    // @requires hex.init & stl.ptr_init
+    def read_table_packed nb, dst, table, idx_n, idx @ ptr, table_address, end {
+        .zero w/4, ptr
+        .mov idx_n, ptr, idx
+        .mul_const w/4, ptr, ptr, nb*dw
+        .add w/4, ptr, table_address
+        rep(nb, k) .read_byte_and_inc dst + 2*k*dw, ptr
+        ;end
+
+      ptr: .vec w/4
+      table_address: .vec w/4, table
+      end:
+    }
+
     def read_table n, dst, table, idx_n, idx @ ptr, table_address, end {
         .zero w/4, ptr
         .mov idx_n, ptr, idx
diff --git a/src/fj/plane_bands.fj b/src/fj/plane_bands.fj
new file mode 100644
index 0000000..28b1dec
--- /dev/null
+++ b/src/fj/plane_bands.fj
@@ -0,0 +1,510 @@
+// M13pS2c — the LS2 per-column ceiling/floor BAND LIST builder (the column-stream design's floor
+// raster). Replaces the row-major `render_planes_spans`/`plane_col`/`plane.draw_span_flat` (M13c3/p1)
+// with a per-COLUMN walk: seed the window's first row EXACTLY (one real `hex.fixed_mul`, matching
+// `plane.draw_pixel`'s zidx derivation bit-for-bit) then advance via a cheap threshold walk
+// (add/compare only) for the rest — mirrors `ReferenceModel._zidx_band_walk` (R15) exactly, so the fj
+// kernel and the oracle stay byte-identical. @requires hex.init & stl.ptr_init.
+
+ns plane {
+    // perf #11-style: dst = (1<<32)//ph via the SHARED block-FP reciprocal table (`slopediv_recip`,
+    // perf #13's SSOT — the SAME table `proj.slope_div`/`column_setup`'s `ipre` already use). Mirrors
+    // `ReferenceModel._recip_div32` — RIGHT-NORMALIZE ONLY (no left-normalize branch): valid because
+    // any REAL planeheight (16.16, >=1 world unit) has magnitude >= 0x10000, always above the table's
+    // 0xFFF threshold, exactly like `column_setup`'s wall-scale `ipre` (SCALE_MIN=256 gives the same
+    // guarantee). ⚠ scope limit: an implausibly tiny nonzero planeheight (< 0x100, i.e. under ~0.004
+    // world units — never seen in real E1M1 data) would hit the table's unpopulated (zero) region;
+    // not guarded, matching how M13pS2a's oracle prototype also only validated realistic magnitudes.
+    def recip32 @ sph, rc, cfff, czero2, irecip, nrm, more, done, shloop, shmore, shdone \
+            < bb_recip_ph, bb_recip_out, slopediv_recip, plane_recip_ret {
+        hex.mov 8, sph, bb_recip_ph
+        hex.set 2, rc, 0
+        hex.set 8, cfff, 0xFFF
+        hex.set 2, czero2, 0
+      nrm:
+        hex.cmp 8, sph, cfff, done, done, more   // sph > 0xFFF ? gt -> shift right
+      more:
+        hex.shr_hex 8, 1, sph
+        hex.inc 2, rc
+        ;nrm
+      done:
+        hex.read_table_packed 3, irecip, slopediv_recip, 3, sph   // recip[m] (packed, M13-lutpack)
+        hex.zero 8, bb_recip_out
+        hex.mov 5, bb_recip_out, irecip
+        hex.shl_hex 8, 2, bb_recip_out             // recip << 2 nibbles
+      shloop:
+        hex.cmp 2, rc, czero2, shdone, shdone, shmore
+      shmore:
+        hex.shr_hex 8, 1, bb_recip_out
+        hex.dec 2, rc
+        ;shloop
+      shdone:                                       // bb_recip_out = (recip<<2) >> rc = recip<<(2-rc)
+        stl.fret plane_recip_ret
+
+      sph: hex.vec 8
+      rc: hex.vec 2
+      cfff: hex.vec 8
+      czero2: hex.vec 2
+      irecip: hex.vec 6
+    }
+
+    // Build ONE column's ceiling/floor BAND LIST: mirrors `ReferenceModel._zidx_band_walk` (R15)
+    // exactly. Inputs (globals, caller-set): bb_ph (planeheight, 8nib), bb_light (RAW sector light
+    // 0..255, 2nib), bb_base (flat base palette index, 2nib), bb_y0 (window start row, 2nib),
+    // bb_count (window length, 2nib — 0 means no window, writes nothing), bb_ascending (2nib, 1 =
+    // ceiling/yslope increasing, 0 = floor/yslope decreasing), bb_arr (packed-byte output buffer
+    // base, w/4nib, caller-owned, sized for the worst case — see the emitter's MAX_BANDS). Output:
+    // bb_n (band-entry count written, 2nib). Each written entry is 3 PACKED bytes (run-length,
+    // base — constant, repeated per entry so the reader's format stays uniform — , zrow), read back
+    // by `stream.emit_band_list` via `hex.read_byte_and_inc` (byte order: count, base, zrow — the
+    // cm-index `zrow<<8|base` decomposes into exactly these two bytes, so no combine is needed here).
+    // @requires hex.init & stl.ptr_init.
+    // `basewidth` (compile-time 0/1): how many copies of bb_base each entry carries. stream/spans
+    // pass 1 (3-byte entries [runlen][base][zrow] -- the 0x09/0x0A present reads base+zrow as the
+    // colormap index); M13-lines passes 0 (2-byte entries [runlen][zrow] -- the flat base joins at
+    // EMIT time from the seg's own register, letting visplanes sharing (height,light) share a list).
+    def build_bands basewidth \
+            @ i, ys, ysptr, y0w, yadv, zidx, step, threshold_hi, threshold_lo, thi6, tlo6, cFFF6, \
+              zidx8, lvl, zlbase, zlidx, zrow, \
+              cur_zrow, runlen, ptr, c127, dist, \
+              empty, phzero, seed, seedclamp, seedok, chi_gt, chi_ok, chi_done, clo_gt, clo_ok, clo_done, \
+              bhi_gt, bhi_ok, blo_gt, blo_ok, \
+              bloop, bbody, ascloop, ascmaybe, ascmaybe0, ascbump, \
+              descloop, descloop0, descmaybe, descbump, classify, samezidx, diffzidx, cont2, \
+              flush_final, writeentry, done \
+            < bb_ph, bb_light, bb_base, bb_y0, bb_count, bb_ascending, bb_arr, bb_n, \
+              bb_recip_ph, bb_recip_out, yslope_packed, zlight, recip32_leaf, plane_recip_ret, \
+              plane_band_ret {
+        hex.zero 2, bb_n
+        hex.if0 2, bb_count, empty
+        hex.mov w/4, ptr, bb_arr   // bb_arr is a RUNTIME register holding the buffer address (set by
+                                   // the caller per call) -- NOT itself a compile-time array label, so
+                                   // this must be hex.mov (copy the held value), never hex.set (which
+                                   // would bake bb_arr's OWN storage address as a literal instead of
+                                   // reading what's stored there -- the R11-adjacent trap that
+                                   // corrupted memory starting at bb_arr's own location, eventually
+                                   // smashing adjacent globals/code and crashing with ip<2w).
+        // basewidth=0 leaves bb_base unread -- this dummy read (overwritten right below)
+        // keeps the extern used so warning-as-error doesn't trip. rep(0,..) when basewidth=1.
+        rep(1-basewidth, k) hex.mov 2, lvl, bb_base
+        hex.zero 3, lvl
+        hex.mov 2, lvl, bb_light
+        hex.shr_hex 3, 1, lvl                       // lvl = light >> 4 (LIGHTSEGSHIFT)
+        hex.if0 8, bb_ph, phzero
+        ;seed
+
+      phzero:                                        // ph==0 -> ONE band covering the whole window, zidx=0
+        hex.zero 3, zidx
+        hex.mul_const 3, zlidx, lvl, 128
+        hex.read_table 2, zrow, zlight, 3, zlidx
+        hex.write_byte_and_inc ptr, bb_count
+        rep(basewidth, k) hex.write_byte_and_inc ptr, bb_base
+        hex.write_byte_and_inc ptr, zrow
+        hex.inc 2, bb_n
+        ;done
+
+      seed:                                          // exact zidx at row y0 (mirrors plane.draw_pixel)
+        // the yslope walk: ONE incrementing packed-byte pointer over yslope_packed (3 bytes/row,
+        // little-endian, 6 nibbles -- max real yslope is 0xA00000). MEASURED: the old per-row
+        // `hex.read_table 8` re-derived the full pointer every row at ~10k of the ~12.6k ops/row;
+        // 3x read_byte_and_inc through a running pointer is ~4-7x cheaper (R14's array-walk lesson).
+        hex.set w/4, ysptr, yslope_packed
+        hex.zero w/4, y0w
+        hex.mov 2, y0w, bb_y0
+        hex.mul_const w/4, yadv, y0w, 3*dw
+        hex.add w/4, ysptr, yadv                        // ysptr -> yslope_packed[y0]
+        rep(3, k) hex.read_byte_and_inc ys + 2*k*dw, ysptr   // ys[0:6] = yslope[y0]; ptr -> y0+1
+        hex.fixed_mul_lo 8, 4, dist, bb_ph, ys             // ys[6:8] stay zero-init (R11-safe wide read)
+        hex.shr_hex 8, 5, dist
+        hex.set 3, c127, 127
+        hex.zero 3, zidx
+        hex.mov 3, zidx, dist
+        hex.cmp 3, zidx, c127, seedok, seedok, seedclamp   // zidx>127 -> clamp
+      seedclamp:
+        hex.mov 3, zidx, c127
+      seedok:
+        hex.mov 8, bb_recip_ph, bb_ph
+        stl.fcall recip32_leaf, plane_recip_ret
+        hex.zero 8, step
+        hex.mov 8, step, bb_recip_out
+        hex.shl_hex 8, 1, step                          // step = recip << 1 nibble ( *16 )
+        hex.zero 8, zidx8
+        hex.mov 3, zidx8, zidx
+        hex.mul 8, threshold_lo, step, zidx8            // threshold_lo = step*zidx
+        hex.mov 8, threshold_hi, threshold_lo           // threshold_hi = step*(zidx+1) = lo + step
+        hex.add 8, threshold_hi, step                   //   (one hex.mul saved per call)
+        // the per-row compares run at 6 NIBBLES against CLAMPED copies of the thresholds: ys is at
+        // most 0xA00000 < 0xFFFFFF, so min(threshold, 0xFFFFFF) preserves EVERY comparison outcome
+        // (a true threshold above 2^24 compares the same as 0xFFFFFF against any real ys), and the
+        // clamped copies only need refreshing when a bump changes the threshold -- rare, vs the
+        // per-row compare. Byte-identical to comparing the full-width thresholds.
+        hex.set 8, cFFF6, 0xFFFFFF
+        hex.cmp 8, threshold_hi, cFFF6, chi_ok, chi_ok, chi_gt
+      chi_gt:
+        hex.set 6, thi6, 0xFFFFFF
+        ;chi_done
+      chi_ok:
+        hex.mov 6, thi6, threshold_hi
+      chi_done:
+        hex.cmp 8, threshold_lo, cFFF6, clo_ok, clo_ok, clo_gt
+      clo_gt:
+        hex.set 6, tlo6, 0xFFFFFF
+        ;clo_done
+      clo_ok:
+        hex.mov 6, tlo6, threshold_lo
+      clo_done:
+        hex.mul_const 3, zlbase, lvl, 128               // zlbase = lvl*128 -- CALL-invariant, hoisted
+        hex.mov 3, zlidx, zlbase                        //   out of the per-row classify (R12)
+        hex.add 3, zlidx, zidx
+        hex.read_table 2, cur_zrow, zlight, 3, zlidx    // seed cur_zrow = zlight[lvl*128+zidx]
+        // row y0 is classified AT the seed (runlen=1) and the loop starts at the SECOND row --
+        // mirroring the host `_zidx_band_walk` exactly (out=[seed]; walk only rows[1:]). Walking row
+        // y0 too (the old shape) also risked a spurious first-row bump whenever the approximate
+        // threshold undercuts the exact seed's own yslope.
+        hex.set 2, runlen, 1
+        hex.set 2, i, 1
+
+      bloop:
+        hex.cmp 2, i, bb_count, bbody, flush_final, flush_final
+      bbody:
+        rep(3, k) hex.read_byte_and_inc ys + 2*k*dw, ysptr   // ys = yslope[y]; ptr -> next row
+        // M13-lines4b: the moved-flag is THREADED away -- the FIRST threshold test's no-move
+        // outcome jumps straight to samezidx (most rows), and `classify` is reached only after
+        // >=1 bump, so the per-row zero/set/if0 flag traffic is gone. Same rows, same output.
+        hex.if0 2, bb_ascending, descloop0
+        hex.cmp 3, zidx, c127, ascmaybe0, samezidx, samezidx
+      ascmaybe0:
+        hex.cmp 6, ys, thi6, samezidx, ascbump, ascbump
+      ascloop:
+        hex.cmp 3, zidx, c127, ascmaybe, classify, classify
+      ascmaybe:
+        hex.cmp 6, ys, thi6, classify, ascbump, ascbump
+      ascbump:
+        hex.inc 3, zidx
+        hex.add 8, threshold_hi, step
+        hex.cmp 8, threshold_hi, cFFF6, bhi_ok, bhi_ok, bhi_gt   // refresh the clamped compare copy
+      bhi_gt:
+        hex.set 6, thi6, 0xFFFFFF
+        ;ascloop
+      bhi_ok:
+        hex.mov 6, thi6, threshold_hi
+        ;ascloop
+      descloop0:
+        hex.if0 3, zidx, samezidx
+        hex.cmp 6, ys, tlo6, descbump, samezidx, samezidx
+      descloop:
+        hex.if0 3, zidx, classify
+      descmaybe:
+        hex.cmp 6, ys, tlo6, descbump, classify, classify
+      descbump:
+        hex.dec 3, zidx
+        hex.sub 8, threshold_lo, step
+        hex.cmp 8, threshold_lo, cFFF6, blo_ok, blo_ok, blo_gt   // refresh the clamped compare copy
+      blo_gt:
+        hex.set 6, tlo6, 0xFFFFFF
+        ;descloop
+      blo_ok:
+        hex.mov 6, tlo6, threshold_lo
+        ;descloop
+      classify:
+        // reached only when zidx MOVED this row. GROUP BY ZROW, not zidx: distinct zidx buckets can
+        // share the same darkest/lightest colormap row (zlight clamps) -- comparing raw zidx here
+        // under-merges bands.
+        hex.mov 3, zlidx, zlbase
+        hex.add 3, zlidx, zidx
+        hex.read_table 2, zrow, zlight, 3, zlidx
+        hex.cmp 2, zrow, cur_zrow, diffzidx, samezidx, diffzidx
+      samezidx:
+        hex.inc 2, runlen
+        ;cont2
+      diffzidx:
+        ;writeentry
+      cont2:
+        hex.inc 2, i
+        ;bloop
+
+      writeentry:
+        hex.write_byte_and_inc ptr, runlen
+        rep(basewidth, k) hex.write_byte_and_inc ptr, bb_base
+        hex.write_byte_and_inc ptr, cur_zrow
+        hex.inc 2, bb_n
+        hex.mov 2, cur_zrow, zrow
+        hex.set 2, runlen, 1
+        ;cont2
+
+      flush_final:
+        hex.write_byte_and_inc ptr, runlen
+        rep(basewidth, k) hex.write_byte_and_inc ptr, bb_base
+        hex.write_byte_and_inc ptr, cur_zrow
+        hex.inc 2, bb_n
+        ;done
+
+      empty:
+        ;done
+
+      done:
+        stl.fret plane_band_ret
+
+      i: hex.vec 2
+      ys: hex.vec 8
+      ysptr: hex.vec w/4
+      y0w: hex.vec w/4
+      yadv: hex.vec w/4
+      zidx: hex.vec 3
+      step: hex.vec 8
+      threshold_hi: hex.vec 8
+      threshold_lo: hex.vec 8
+      thi6: hex.vec 6
+      tlo6: hex.vec 6
+      cFFF6: hex.vec 8
+      zidx8: hex.vec 8
+      lvl: hex.vec 3
+      zlbase: hex.vec 3
+      zlidx: hex.vec 3
+      zrow: hex.vec 2
+      cur_zrow: hex.vec 2
+      runlen: hex.vec 2
+      ptr: hex.vec w/4
+      c127: hex.vec 3
+      dist: hex.vec 8
+    }
+
+    // M13-lines4 -- build_bands_bs: the BINARY-SEARCH band builder (lines mode only; 2-byte
+    // entries [runlen][zrow]). Identical output to `build_bands 0` -- PROVEN over 1,036 windows
+    // (118 real E1M1-spawn (ph,light) pairs + 400 fuzz, both halves, zero mismatches) -- but
+    // instead of marching all `count` rows it finds each ZROW boundary directly: the only zidx
+    // values where the colormap row changes are baked per light level in `zl_nextcut`/`zl_prevcut`
+    // (lut_generator.generate_zlight_cuts_fj), and each cut's screen row is the first crossing of
+    // a monotone yslope half-window -- a ~6-probe binary search. Typical list: ~3-8 boundaries
+    // instead of ~50 marched rows.
+    //   asc  (ceiling half, ys non-decreasing): boundary(k) = first row with ys >= step*k
+    //   desc (floor half,   ys non-increasing): boundary(k) = first row with ys <  step*(k+1)
+    // After each boundary the zidx re-marches from the boundary row's ys (the walk's own bump
+    // loop, run only at boundaries). Seed/step/clamp arithmetic is copied from build_bands
+    // verbatim, so the fixed_mul seed and recip32 step stay bit-identical.
+    // @requires hex.init & stl.ptr_init
+    def build_bands_bs \
+            @ ptr, ysbase, ysptr, probe, y0w, yadv, ycur, cutz, cutT, cutT6, zidx, zrow_cur, zrow, \
+              step, lvl, zlbase, zlidx, loi, hii, mid, thr, dist, ys, runw, cFF2, c127, cFFF6, \
+              empty, phzero, seed, seedclamp, seedok, gloop, gdesc, gcut, nocut, tok0, tdesc, tmul, \
+              tclamp, tok, bsprep, bsloop, bsbody, pdesc, phi, plo, bsdone, past, wrt, \
+              rasc, rdesc, rabody, rachk, rat1, rat2, rat3, rabump, rastop, \
+              rdbody, rdt1, rdt2, rdt3, rdbump, rdstop, rdone, done \
+            < bb_ph, bb_light, bb_y0, bb_count, bb_ascending, bb_arr, bb_n, \
+              bb_recip_ph, bb_recip_out, yslope_packed, zlight, zl_nextcut, zl_prevcut, \
+              recip32_leaf, plane_recip_ret, plane_band_ret {
+        hex.zero 2, bb_n
+        hex.if0 2, bb_count, empty
+        hex.mov w/4, ptr, bb_arr
+        hex.zero 3, lvl
+        hex.mov 2, lvl, bb_light
+        hex.shr_hex 3, 1, lvl                       // lvl = light >> 4
+        hex.mul_const 3, zlbase, lvl, 128
+        hex.if0 8, bb_ph, phzero
+        ;seed
+
+      phzero:                                        // ph==0 -> ONE band, zidx=0
+        hex.mov 3, zlidx, zlbase
+        hex.read_table 2, zrow, zlight, 3, zlidx
+        hex.write_byte_and_inc ptr, bb_count
+        hex.write_byte_and_inc ptr, zrow
+        hex.inc 2, bb_n
+        ;done
+
+      seed:                                          // exact zidx at y0 (bit-identical to build_bands)
+        hex.set w/4, ysbase, yslope_packed
+        hex.zero w/4, y0w
+        hex.mov 2, y0w, bb_y0
+        hex.mul_const w/4, yadv, y0w, 3*dw
+        hex.add w/4, ysbase, yadv                    // ysbase -> yslope_packed[y0] (window row 0)
+        hex.zero 8, ys
+        hex.mov w/4, ysptr, ysbase
+        rep(3, k) hex.read_byte_and_inc ys + 2*k*dw, ysptr
+        hex.fixed_mul_lo 8, 4, dist, bb_ph, ys
+        hex.shr_hex 8, 5, dist
+        hex.set 3, c127, 127
+        hex.zero 3, zidx
+        hex.mov 3, zidx, dist
+        hex.cmp 3, zidx, c127, seedok, seedok, seedclamp
+      seedclamp:
+        hex.mov 3, zidx, c127
+      seedok:
+        hex.mov 8, bb_recip_ph, bb_ph
+        stl.fcall recip32_leaf, plane_recip_ret
+        hex.zero 8, step
+        hex.mov 8, step, bb_recip_out
+        hex.shl_hex 8, 1, step                       // step = recip << 4
+        hex.mov 3, zlidx, zlbase
+        hex.add 3, zlidx, zidx
+        hex.read_table 2, zrow_cur, zlight, 3, zlidx
+        hex.set 8, cFFF6, 0xFFFFFF
+        hex.set 2, cFF2, 0xFF
+        hex.zero 2, ycur                             // relative row where the current run starts
+
+      gloop:                                         // == one zrow GROUP per iteration
+        hex.zero 3, cutz
+        hex.mov 3, zlidx, zlbase
+        hex.add 3, zlidx, zidx
+        hex.if0 2, bb_ascending, gdesc
+        hex.read_table_byte cutz, zl_nextcut, 3, zlidx
+        ;gcut
+      gdesc:
+        hex.read_table_byte cutz, zl_prevcut, 3, zlidx
+      gcut:
+        hex.cmp 2, cutz, cFF2, tok0, nocut, nocut
+      nocut:                                         // zrow never changes again -> one final run
+        hex.mov 2, runw, bb_count
+        hex.sub 2, runw, ycur
+        hex.write_byte_and_inc ptr, runw
+        hex.write_byte_and_inc ptr, zrow_cur
+        hex.inc 2, bb_n
+        ;done
+      tok0:
+        hex.if0 2, bb_ascending, tdesc               // T: asc = step*cut ; desc = step*(cut+1)
+        ;tmul
+      tdesc:
+        hex.inc 3, cutz
+      tmul:
+        hex.zero 8, cutT
+        hex.mov 3, cutT, cutz
+        hex.mul_lo 8, cutT6, step, cutT              // (cut is <=3 nonzero nibbles: cheap rows)
+        hex.mov 8, cutT, cutT6
+        hex.cmp 8, cutT, cFFF6, tok, tok, tclamp     // 6-nibble clamped compare copy (as the walk)
+      tclamp:
+        hex.set 6, thr, 0xFFFFFF
+        ;bsprep
+      tok:
+        hex.mov 6, thr, cutT
+      bsprep:                                        // binary search over rows (ycur, count)
+        hex.mov 2, loi, ycur
+        hex.inc 2, loi
+        hex.mov 2, hii, bb_count
+      bsloop:
+        hex.cmp 2, loi, hii, bsbody, bsdone, bsdone
+      bsbody:
+        hex.mov 2, mid, loi                          // mid = (loi+hii)>>1
+        hex.add 2, mid, hii
+        hex.shr_bit 2, mid
+        hex.zero w/4, probe                          // probe -> yslope row (window-relative mid)
+        hex.mov 2, probe, mid
+        hex.mul_const w/4, probe, probe, 3*dw
+        hex.add w/4, probe, ysbase
