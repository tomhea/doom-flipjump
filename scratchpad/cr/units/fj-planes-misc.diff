+        rep(3, k) hex.read_byte_and_inc ys + 2*k*dw, probe
+        hex.if0 2, bb_ascending, pdesc
+        hex.cmp 6, ys, thr, plo, phi, phi            // asc: ys >= T -> boundary at/left of mid
+      pdesc:
+        hex.cmp 6, ys, thr, phi, plo, plo            // desc: ys < T -> boundary at/left of mid
+      phi:
