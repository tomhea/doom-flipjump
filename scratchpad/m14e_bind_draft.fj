// M14-e WORK IN PROGRESS -- NOT PROVEN, parked here rather than in src/ (CLAUDE.md: scratchpad is
// where unproven experiments live).
//
// sim.bind_things rebuilds the per-leaf thing lists each frame: clear sshead[] to the 0xFF
// sentinel, then for t = nthings-1 downto 0 locate the thing's subsector with ptloc_walk and
// prepend it. Descending insertion makes traversal ascending, which is today's things_by_ss order.
//
// ⚠ SYMPTOM WHERE I LEFT IT: the macro never returns. A marker printed immediately BEFORE the call
// appears; the one immediately after does not, and the run ends at ~5,064 ops -- about the cost of
// stl.startup_and_init_all alone, so it dies within a few ops of entry, before even the clear
// loop's first iteration. Neither loop body executes. Suspect the preamble
// (`;body` / @-local data / `body:` / the first hex.cmp), not the pointer walks further down.
// scratchpad/_bind.py drives it and diffs the per-leaf lists against point_in_subsector.
//
// Everything it depends on IS proven and in src/: sim.thing_load (all 13 fields match the baked
// constants) and collision.generate_point_location_fj (50/50 vs point_in_subsector).

ns sim {
    // sim.bind_things — rebuild the per-leaf thing lists for this frame.
    //
    // DOOM keeps a per-subsector thing list and moves a thing between them on P_SetThingPosition.
    // fj has no state between frames (one run = one frame), so the lists are rebuilt from the
    // position table every frame instead.
    //
    // ⚠ A LINKED LIST, not per-leaf arrays: `thnext[t]` and `sshead[ss]`, both BYTE arrays with
    // 0xFF as the empty sentinel. Prepending is O(1) and there is NO CAP -- so no budget can
    // silently drop a thing when a leaf gets crowded, which is precisely the failure class M14-a
    // exists to prevent. 251 things fit a byte index with the sentinel to spare.
    //
    // ⚠ Bind in DESCENDING index order. Prepending reverses, so descending insertion makes the
    // traversal ASCENDING -- exactly the order `things_by_ss` has today, which is what keeps the
    // front-to-back slot each sprite claims bit-identical for a static thing.
    def bind_things thpos, n_th, nthings, nss             @ body, clr, clr_body, clr_done, bl, bl_done,               t, ss, hv, tv, p, q, cst, pos, xn, xp, yn, yp             < ptx, pty, ptss, sshead, thnext, ptloc_walk, ptloc_ret {
        ;body
      t:   hex.vec 4
      ss:  hex.vec 4
      hv:  hex.vec 2
      tv:  hex.vec 2
      p:   hex.vec w/4
      q:   hex.vec w/4
      cst: hex.vec 4
      pos: hex.vec 16
      body:
        // every leaf starts empty
        hex.zero 4, ss
        hex.set 4, cst, nss
      clr:
        hex.cmp 4, ss, cst, clr_body, clr_done, clr_done
      clr_body:
        hex.set w/4, q, sshead
        hex.ptr_index p, q, ss
        hex.set 2, hv, 0xFF
        hex.write_hex 2, p, hv
        hex.inc 4, ss
        ;clr
      clr_done:
        hex.set 4, t, nthings
      bl:
        hex.if0 4, t, bl_done
        hex.dec 4, t                             // descending: nthings-1 .. 0
        // the thing's position -> the 10-nibble signed map coords point location reads
        hex.read_table_packed 8, pos, thpos, n_th, t
        hex.zero 10, ptx
        hex.mov 4, ptx, pos + 4*dw               // the INTEGER part of a 16.16 is nibbles 4..7
        hex.sign 4, pos + 4*dw, xn, xp
      xn:
        hex.set 6, ptx + 4*dw, 0xFFFFFF
      xp:
        hex.zero 10, pty
        hex.mov 4, pty, pos + 12*dw
        hex.sign 4, pos + 12*dw, yn, yp
      yn:
        hex.set 6, pty + 4*dw, 0xFFFFFF
      yp:
        stl.fcall ptloc_walk, ptloc_ret
        // thnext[t] = sshead[ptss];  sshead[ptss] = t
        hex.set w/4, q, sshead
        hex.ptr_index p, q, ptss
        hex.read_byte hv, p
        hex.set w/4, q, thnext
        hex.ptr_index q, q, t
        hex.write_hex 2, q, hv
        hex.zero 2, tv
        hex.mov 2, tv, t
        hex.write_hex 2, p, tv
        ;bl
      bl_done:
    }
}
