// M14-e WORK IN PROGRESS -- NOT PROVEN, parked here rather than in src/ (CLAUDE.md: scratchpad is
// where unproven experiments live; everything in src/fj/sim.fj has a passing test behind it).
//
// TWO REAL fj DEFECTS WERE FOUND AND FIXED HERE, both isolated in scratchpad/_ptrtest.py (20 lines,
// assembles in seconds) after the macro died within a few ops of entry:
//
//   1. `hex.ptr_index dst, ptr, index` does `.mov w/4, dst, index` -- it reads EIGHT nibbles out of
//      the index register. Passing a `hex.vec 4` index drags the neighbouring cell in and yields a
//      wild pointer, and the write through it kills the program. Every index handed to ptr_index
//      must be `hex.vec w/4`. This is the repo's own lesson -- an n-nibble op reads n nibbles of
//      its SOURCE -- in its nastiest form, because the symptom is a dead program, not a bad value.
//   2. `hex.write_byte ptr, src` (TWO args) is the partner of `hex.read_byte dst, ptr`. The
//      three-arg `hex.write_hex n, ptr, src` is a different overload and wrote only one nibble:
//      0xAB went in, 0x0b came back.
//
// WHERE IT STANDS: with both fixed the clear loop runs (682 leaves, ~1.65M ops) and the bind loop
// enters. The run then does not finish inside 40 minutes -- and the first thing to check is the
// TEST HARNESS, not the macro: scratchpad/_bind.py's dump loop reads a byte into an 8-nibble `dh`
// (read_byte fills only 2 nibbles, leaving the top stale) and then compares all 8 against the 0xFF
// sentinel, so its inner walk can never terminate. Zero `dh` before each read, or compare 2
// nibbles, before suspecting bind_things itself.
//
// Everything it depends on IS proven and in src/: sim.thing_load (all 13 fields match the baked
// constants) and collision.generate_point_location_fj (50/50 vs point_in_subsector).

ns sim {
    // sim.bind_things — rebuild the per-leaf thing lists for this frame.
    //
    // DOOM keeps a per-subsector thing list and moves a thing between them on P_SetThingPosition.
    // fj has no state between frames (one run = one frame), so the lists are rebuilt from the
    // position table every frame instead.
    //
    // ⚠ A LINKED LIST, not per-leaf arrays: `thnext[t]` and `sshead[ss]`, both BYTE arrays with
    // 0xFF as the empty sentinel. Prepending is O(1) and there is NO CAP -- so no budget can
    // silently drop a thing when a leaf gets crowded, which is precisely the failure class M14-a
    // exists to prevent. 251 things fit a byte index with the sentinel to spare.
    //
    // ⚠ Bind in DESCENDING index order. Prepending reverses, so descending insertion makes the
    // traversal ASCENDING -- exactly the order `things_by_ss` has today, which is what keeps the
    // front-to-back slot each sprite claims bit-identical for a static thing.
    def bind_things thpos, n_th, nthings, nss             @ body, clr, clr_body, clr_done, bl, bl_done,               t, ss, hv, tv, p, q, cst, pos, xn, xp, yn, yp             < ptx, pty, ptss, sshead, thnext, ptloc_walk, ptloc_ret {
        ;body
      t:   hex.vec w/4                          // ⚠ w/4, not 4: hex.ptr_index does
      ss:  hex.vec w/4                          // `mov w/4` out of its INDEX register
      hv:  hex.vec 2
      tv:  hex.vec 2
      p:   hex.vec w/4
      q:   hex.vec w/4
      cst: hex.vec w/4
      pos: hex.vec 16
      body:
        // every leaf starts empty
        hex.zero 4, ss
        hex.set w/4, cst, nss
      clr:
        hex.cmp w/4, ss, cst, clr_body, clr_done, clr_done
      clr_body:
        hex.set w/4, q, sshead
        hex.ptr_index p, q, ss
        hex.set 2, hv, 0xFF
        hex.write_byte p, hv
        hex.inc w/4, ss
        ;clr
      clr_done:
        hex.set w/4, t, nthings
      bl:
        hex.if0 w/4, t, bl_done
        hex.dec w/4, t                             // descending: nthings-1 .. 0
        // the thing's position -> the 10-nibble signed map coords point location reads
        hex.read_table_packed 8, pos, thpos, n_th, t
        hex.zero 10, ptx
        hex.mov 4, ptx, pos + 4*dw               // the INTEGER part of a 16.16 is nibbles 4..7
        hex.sign 4, pos + 4*dw, xn, xp
      xn:
        hex.set 6, ptx + 4*dw, 0xFFFFFF
      xp:
        hex.zero 10, pty
        hex.mov 4, pty, pos + 12*dw
        hex.sign 4, pos + 12*dw, yn, yp
      yn:
        hex.set 6, pty + 4*dw, 0xFFFFFF
      yp:
        stl.fcall ptloc_walk, ptloc_ret
        // thnext[t] = sshead[ptss];  sshead[ptss] = t
        hex.set w/4, q, sshead
        hex.ptr_index p, q, ptss
        hex.read_byte hv, p
        hex.set w/4, q, thnext
        hex.ptr_index q, q, t
        hex.write_byte q, hv
        hex.zero 2, tv
        hex.mov 2, tv, t
        hex.write_byte p, tv
        ;bl
      bl_done:
    }
}
