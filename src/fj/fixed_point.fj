// ==============================================================================================
// fixed_point.fj   16.16 fixed-point + the packed-table reads. Extends the stl's `hex` namespace.
// STATUS  LIVE - every other fj file, and the generated main
// ENTRY   hex.fixed_mul_lo, hex.mul_lo, hex.mul_const, hex.fixed_div, hex.read_table[_packed]
// SIZE    10 macros (hex.fixed_mul_lo .. hex.read_table_packed)
// NOTE    `read_table_packed nb` is nb separate pointer rebuilds (~781 ops each) plus a staging
//         preamble -- it is the single most expensive idiom in the program.
// ==============================================================================================
// fixed_point.fj — F2: signed Q-format fixed-point math (no floating point).
//
// ---------- Fixed-Point Math
// Signed Q-format fixed-point helpers (no floating point) - e.g. DOOM's 16.16 format
//  is n=8, f=4 (8 nibbles total, 4 nibbles of fraction); 8.8 is n=4, f=2.
// The LUT-side of this design (replacing runtime divides/trig with data tables) is
//  generated host-side (e.g. by the doom-flipjump LUT generator), and read with
//  hex.read_table / hex.read_table_byte below - their entry-layout contracts are
//  documented on the macros themselves.
// fixed_mul/fixed_div/mul_const are byte-exact against the host mirror
//  src/doomfj/fixedpoint.py; read_table/read_table_byte are the §3.4 data-table fallback
//  (history: docs/d15-disposition.md, the PR #1 / D15 / D13 keep decisions).
//
// ---------- Conventions used in this file
// * The Q-FORMAT PARAMS lead every signature and are COMPILE-TIME: `n` = total nibbles of the
//   value (or `nb` = total bytes, for the packed-byte reader), and where a macro takes `f` too,
//   `f` = how many of those n nibbles are fraction. Every f-taking macro assumes 0 < f <= n, so
//   the shift by the fraction is NIBBLE-ALIGNED — a compile-time `+ f*dw` slice, never a
//   runtime-amount shift. That alignment is the reason these macros are cheap.
// * `wide_…` = a widened (2n or n+f nibble) SIGN-EXTENDED scratch copy of an n-nibble
//   operand, so the intermediate product/dividend cannot overflow.
// * `_lo` suffix on a macro name = the TRUNCATED variant: it computes only the low nibbles
//   the final result can see. Bit-identical to the full-width form it replaces, and cheaper.
// * read_table family: `table_address` is the compile-time table BASE (a `.vec w/4, table`
//   data cell), `ptr` the running address walked into it. Both are w/4 nibbles = exactly one
//   w-bit address, which is also the cap on the index register (`idx_n <= w/4`).
// * ALIASING is stated per macro and is load-bearing: where a macro does not say
//   "dst may alias …", it may not (mul_lo's res, and `dst` vs `idx` in the read_table family).
// * `end:` is the macro's exit label, and `skip:` a forward branch target. Where a macro has
//   data cells, they (`name: .vec …`) sit BETWEEN the body's closing `;end` and `end:` — data
//   cells are fj ops that must never execute, so that jump is what steps over them.
// * Annotations: `@Assumes:` = an unchecked precondition the caller must meet.
//   `@requires hex.init` (sometimes `& stl.ptr_init`) = those dispatch tables must already be
//   initialised at run time; without them the hex ops jump through uninitialised tables.
//   `@note:` = a usage warning (e.g. prefer a reciprocal LUT over a runtime divide).
// * The `Time/Space Complexity` lines are stl-style op-cost formulas in the `k@ + c` unit.
//   They are measured, not decorative — keep them in sync if a body ever changes.


ns hex {
    //  Time Complexity: 4n^2(5.5@+20) + n(8@+33)
    // Space Complexity: n(50@+1000)
    //   dst[:n] = (a[:n] * b[:n]) >> 4f    (signed fixed-point multiply)
    //
    // a,b,dst are signed Q-format hex[:n] with f fraction-nibbles (dst may alias a/b).
    // The product is computed at full 2n-nibble width (no intermediate overflow), then
    //  shifted right by the (nibble-aligned) fraction - so no runtime-amount shift is needed.
    // The result is truncated to n nibbles (wraps modulo 2^4n, like C's fixed-point casts).
    // @Assumes: 0 < f <= n.
    // @requires hex.init
    def fixed_mul n, f, dst, a, b @ wide_a, wide_b, product, end {
        .mov n, wide_a, a
        .sign_extend 2*n, n, wide_a
        .mov n, wide_b, b
        .sign_extend 2*n, n, wide_b
        .mul 2*n, product, wide_a, wide_b
        .mov n, dst, product + f*dw
        ;end

      wide_a: .vec 2*n
      wide_b: .vec 2*n
      product: .vec 2*n
      end:
    }


    // M13-mulcrush — BYTE-EXACT-identical to `fixed_mul n, f, dst, a, b`, ~3x cheaper: the full
    //  2n-nibble product is TRUNCATED-SCHOOLBOOK'd at n+f nibbles (the only nibbles fixed_mul's
    //  [f, f+n) result slice can see). Row j adds wa[0..m-j)*wb[j] at offset j with add_mul's own
    //  mod-16^(m-j) ripple — every pair with i+j < m lands exactly, columns >= m are dropped, so
    //  res[0..m) == the full product's low m nibbles and dst == fixed_mul's dst, bit for bit.
    //  Zero-digit rows (e.g. the sign-extension nibbles of small positive operands) skip their
    //  add_mul behind a 1-nibble if0. No dst/src shifting, no count_bits (hex.mul's per-iteration
    //  overhead), compile-time offsets throughout.
    // @Assumes: 0 < f <= n.
    // @requires hex.init
    // P3-1 (2026-09-04): the rows read `b` IN PLACE; wide_b and its sign_extend are gone.
    //   wide_b existed only to be read one nibble at a time as the row driver, and hex.add_mul
    //   never writes its b operand (both `.xor .mul.dst, b` in it are restore dances). The only
    //   thing the copy added was the f sign-extension nibbles, which drive f more rows -- so
    //   those become f rows against a constant 0xF, run only when b is negative. hex.sign tests
    //   the same nibble with the same predicate hex.sign_extend does, so the polarity is
    //   identical by construction, not by inspection.
    //   Measured against PYTHON's (a*b)>>16 and against the old macro over 14 cases -- every
    //   sign combination, both most-negative extremes, b = 0, b = -1, b = +1.0: all identical.
    //   -225.0 executed ops per call when b is positive, -385.0 when it is negative.
    // @Assumes: `b` is read LIVE across the row loop, never snapshotted, so no caller may write
    //   it during the call -- the mirror of the assumption proj.scale_from_global_angle already
    //   states for its own static operand.
    def fixed_mul_lo n, f, dst, a, b @ res, asgn, fnib, aneg, apos, bneg, bpos, end {
        // P3-2 (2026-09-04): wide_a is gone too. It was only [a's n nibbles, then f copies of
        //   a's sign], so a row reads `a` directly for its first min(n, m-j) nibbles and a
        //   4-nibble all-sign vector for the rest. `asgn` is written before it is read (zero,
        //   then NOT if a is negative), which keeps M1's zero-@-local-keys property.
        .zero n+f, res
        .zero f, asgn
        .sign n, a, aneg, apos
      aneg:
        .not f, asgn                           // a < 0: its sign nibbles are 0xF
      apos:
        rep(n, j) .fixed_mul_lo.rowb n+f, n, j, res, a, asgn, b + j*dw
        .sign n, b, bneg, bpos
      bneg:                                    // b < 0: the f sign nibbles are 0xF, so run them
        rep(f, k) .fixed_mul_lo.rowb n+f, n, n+k, res, a, asgn, fnib
      bpos:                                    // bneg FALLS THROUGH to here -- no jump
        .mov n, dst, res + f*dw
        ;end
        // LAYOUT FREEZE for the 795 ops each expansion loses. Unreachable: the `;end` above
        // exists precisely to step over this data region. One number freezes every whole-macro
        // call site, because every one of them is `8, 4`.
        rep(1998, i) stl.fj 0, 0

      res: .vec n+f
      asgn: .vec f
      fnib: .hex 0xf
      end:
    }
    ns fixed_mul_lo {
        // one truncated-schoolbook row: res[j..m) += wa[0..m-j) * wbj  (skipped when wbj==0).
        // `rowa` takes the driver NIBBLE's address so fixed_mul_lo can point it straight at b;
        // `row` keeps the old base+index signature for the 12 inline `rep(k, j) row` loops in
        // frame_render.fj and projection.fj, and is a literal no-op wrapper -- verified by
        // measuring both forms at j = 0, 3, 7, 11: identical space AND identical executed ops.
        def rowa m, j, res, wa, wbj @ skip {
            ..if0 1, wbj, skip
            ..add_mul m-j, res + j*dw, wa, wbj
          skip:
        }
        def row m, j, res, wa, wb {
            .rowa m, j, res, wa, wb + j*dw
        }
        // P3-2: the SPLIT row -- `lo` nibbles of the multiplicand come from `a`, the rest from
        // the all-sign vector. hex.add_mul brackets its inner loop with .mul.clear_carry, so
        // calling it twice would clear the carry BETWEEN the halves and lose it; the split has
        // to happen inside one bracket, over the 2-arg .add_mul, which carries no clear_carry.
        // Checked in the IDENTITY configuration (both halves aimed at the same vector) against
        // `row` at j = 0, 3, 7, 11: identical space and identical executed ops.
        def rowb m, n, j, res, a, asgn, wbj @ skip < hex.mul.dst {
            ..if0 1, wbj, skip
            ..mul.clear_carry
            ..xor hex.mul.dst, wbj
            rep((m-j < n ? m-j : n), i) ..add_mul res + (j+i)*dw, a + i*dw
            rep((m-j > n ? m-j-n : 0), i) ..add_mul res + (j+n+i)*dw, asgn + i*dw
            ..xor hex.mul.dst, wbj
            ..mul.clear_carry
          skip:
        }
    }


    // M13-sidemul — BIT-IDENTICAL to `hex.mul n, res, a, b` (both are the product mod 16^n),
    //  as an unrolled truncated schoolbook: n(n+1)/2 nibble-pairs at compile-time offsets, an
    //  if0-skip per zero b-digit — no per-iteration shl/shr n, no count_bits, and (unlike
    //  hex.mul's early-exit) no blow-up on sign-extended NEGATIVE operands (R19). res must not
    //  alias a or b.
    // @requires hex.init
    def mul_lo n, res, a, b @ end {
        .zero n, res
        rep(n, j) .fixed_mul_lo.row n, j, res, a, b
        ;end
      end:
    }


    //  Time Complexity: n^2(76@+216) + n(15@+50)
    // Space Complexity: n(45@+600)
    //   if b==0: goto div0
    //   dst[:n] = (a[:n] << 4f) / b[:n]    (signed fixed-point divide, truncated toward zero)
    //
    // a,b,dst are signed Q-format hex[:n] with f fraction-nibbles (dst may alias a/b).
    // The dividend is pre-shifted at full 2n-nibble width (nibble-aligned - no runtime shift).
    // @note: a runtime divide is expensive - prefer a reciprocal LUT in hot paths.
    // @Assumes: 0 < f <= n.
    // @requires hex.init
    def fixed_div n, f, dst, a, b, div0 @ wide_a, quotient, remainder, end {
        .zero f, wide_a
        .mov n, wide_a + f*dw, a
        .sign_extend 2*n, n+f, wide_a
        .idiv 2*n, n, quotient, remainder, wide_a, b, div0, 1
        .mov n, dst, quotient
        ;end

      wide_a: .vec 2*n
      quotient: .vec 2*n
      remainder: .vec n     // discarded: fixed_div truncates toward zero
      end:
    }


    //  Time Complexity: n(2@+12) + #c(n(@+1)) + (#on-bits of c)(n(4@+12))
    // Space Complexity: #c(n(5@+25)) + n(4@+40)
    //   dst[:n] = src[:n] * c    (c is a compile-time constant)
    //
    // The strength-reduced constant multiply: c's set bits become shifted adds, so sparse
    //  constants are cheap, and no multiplication tables are needed.
    // dst may alias src.
    // @requires hex.add.init (or hex.init)
    def mul_const n, dst, src, c @ shifted, end {
        .mov n, shifted, src
        .zero n, dst
        rep(#c, i) .mul_const.maybe_add_shifted n, dst, shifted, (c>>i)&1
        ;end

      shifted: .vec n
      end:
    }
    ns mul_const {
        def maybe_add_shifted n, dst, shifted, bit @ skip {
            stl.comp_if0 bit, skip
            ..add n, dst, shifted
          skip:
            ..shl_bit n, shifted
        }
    }


    // M13-lutpack — dst[:2*nb] = table[idx] for a PACKED-byte LUT.
    //
    // Entry-layout contract: entry k sits at table + k*nb*dw and is nb consecutive PACKED-byte
    //  data-ops, little-endian, one dw-slot per byte (as emitted by doomfj
    //  generate_packed_lut_fj). dst receives them in REGISTER form — 2*nb hex ops, low nibble
    //  of byte k at 2k, high at 2k+1.
    // Same values as the read_table form below, but ~600 ops/BYTE (read_byte_and_inc) instead of
    //  ~1.1k/NIBBLE (read_hex re-derives the pointer per nibble) — delta-measured, R19-era.
    // idx is an unsigned hex[:idx_n] (idx_n <= w/4); dst must not alias idx.
    // @requires hex.init & stl.ptr_init
    def read_table_packed nb, dst, table, idx_n, idx @ ptr, table_address, end {
        .zero w/4, ptr
        .mov idx_n, ptr, idx
        .mul_const w/4, ptr, ptr, nb*dw
        .add w/4, ptr, table_address
        rep(nb, k) .read_byte_and_inc dst + 2*k*dw, ptr
        ;end

      ptr: .vec w/4
      table_address: .vec w/4, table
      end:
    }

    //  Time Complexity: n(w(0.75@+5) + 16@+27) + #(n*dw)(w/4(1.5@+10)) + 22@+60
    // Space Complexity: n(w(1.13@+32) + 14@+127) + #(n*dw)(w/4(2@+30))
    //   dst[:n] = table[idx]    (entry idx of a LUT of hex[:n] entries)
    //
    // table is a compile-time address (label) of consecutive hex[:n] entries.
    // Entry-layout contract: entry k sits at table + k*n*dw; each entry is n hex data-ops
    //  (exactly a `hex.vec n` value: nibble i of the value is the data bits of op i,
    //  little-endian nibbles, each op `;nibble * dw`).
    // idx is an unsigned hex[:idx_n] (idx_n <= w/4); dst must not alias idx.
    // The entry address is computed with the strength-reduced mul_const (no runtime-amount
    //  shift), then read through a pointer.
    // @requires hex.init & stl.ptr_init
    def read_table n, dst, table, idx_n, idx @ ptr, table_address, end {
        .zero w/4, ptr
        .mov idx_n, ptr, idx
        .mul_const w/4, ptr, ptr, n*dw
        .add w/4, ptr, table_address
        .read_hex n, dst, ptr
        ;end

      ptr: .vec w/4
      table_address: .vec w/4, table
      end:
    }
}


ns hex {
    //  Time Complexity: w(0.75@+5) + #(dw)(w/4(1.5@+10)) + 40@+80
    // Space Complexity: w(2.25@+50) + #(dw)(w/4(2@+30)) + 40@+300
    //   dst[:2] = table[idx]    (entry idx of a LUT of packed bytes)
    //
    // table is a compile-time address (label) of consecutive packed-byte ops.
    // Entry-layout contract: entry k sits at table + k*dw; each entry is one fj data-op
    //  whose data bits hold the byte (i.e. `;value * dw`). Byte tables are 2x smaller and
    //  cheaper to read than hex.read_table's hex[:n]-entry tables - right for
    //  colormaps/light-level tables.
    // idx is an unsigned hex[:idx_n] (idx_n <= w/4); dst must not alias idx.
    // @requires hex.init & stl.ptr_init
    def read_table_byte dst, table, idx_n, idx @ ptr, table_address, end {
        .zero w/4, ptr
        .mov idx_n, ptr, idx
        .mul_const w/4, ptr, ptr, dw
        .add w/4, ptr, table_address
        .read_byte dst, ptr
        ;end

      ptr: .vec w/4
      table_address: .vec w/4, table
      end:
    }
}
