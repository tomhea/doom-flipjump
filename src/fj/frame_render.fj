// F5 / D2b (full-unroll renderer, M11c) — the chosen D2 structure done RIGHT: every framebuffer pixel
// address is a COMPILE-TIME constant (`rep(VIEW_W, x) ... rep(count, row) frame.pixel ...`), so the pixel
// path carries ZERO pointers — BUT the heavy per-pixel body (DDA + texture sample + colormap apply) lives
// in ONE shared `stl.fcall`'d leaf (`pixel_leaf`), NOT duplicated per pixel (D2: "heavy color/select/pack
// logic factored into a shared stl.fcall leaf so it isn't duplicated WIDTH×"). This is the space lever:
// the assembler is ~cubic in the number of unrolled ops, and an inlined body was ~1100 ops/pixel; the
// shared-leaf shell is ~40 ops/pixel (an fcall + one fixed-address write) — ~25× less unrolled code.
//
// Per-pixel write uses the hex.vec2 register framebuffer (§2.1): the leaf renders the lit byte into the
// shared scratch `lit`, and the shell XORs it straight into the pixel's zero-initialised hex.vec2 cell
// (`hex.xor_zero 2, fb+pixel*2dw, lit`) — no per-pixel zero (the framebuffer's hex.vec is zero-init) and
// NO deposit (the hex.vec2 simplification; deposit eliminated). Only the pixel ADDRESS is compile-time.
//
// Per-column state lives in registers (set once per column by `frame.setup_col`, read by the leaf): the
// texture base `base_reg = texcol*texheight`, the colormap light in `cmidx`'s high byte, and the 8.8 DDA
// `step`; `frac` is the DDA accumulator. This matches the real M12 renderer, where base/light/step are
// the column's RUNTIME (BSP/perspective) values — only the leaf's inputs change, not its structure.
//
// Shared scratch the includer declares: frac (hex.vec 4, 8.8), v3 (3), idx (3), cmidx (4), lit (2),
// base_reg (3), step (hex.vec 4), heightmask (texheight-1), pixel_ret (the fcall ret-reg, one op `;0`),
// and the global label `pixel_leaf:` followed by `frame.leaf_body`. Tables = `tex`/`cm` (M8), `W` from
// fj_consts.

ns frame {
    // per-column setup: load the column's constants into registers + reset the DDA (called once/column).
    def setup_col base, light, step_val, frac0 < base_reg, cmidx, step, frac {
        hex.set 3, base_reg, base
        hex.zero 4, cmidx
        hex.set 2, cmidx + 2*dw, light        // cmidx high byte = light (the leaf keeps it; tex writes low)
        hex.set 4, step, step_val
        hex.set 4, frac, frac0
    }

    // RUNTIME per-column setup (M12aa): same as setup_col, but base/light/step_val/frac0 are RUNTIME
    // registers (the M12 renderer computes them via the projection macros — base=texcol*texheight, light
    // the sector light, step/frac0 from column_setup), not compile-time literals. The leaf body is
    // identical (it only reads the registers). base is hex[:3], light hex[:2], step_val/frac0 hex[:4] (8.8).
    def setup_col_reg base, light, step_val, frac0 < base_reg, cmidx, step, frac {
        hex.mov 3, base_reg, base
        hex.zero 4, cmidx
        hex.mov 2, cmidx + 2*dw, light        // cmidx high byte = light (runtime)
        hex.mov 4, step, step_val
        hex.mov 4, frac, frac0
    }

    // one pixel (the thin unrolled shell): fcall the shared leaf (which renders into `lit` + advances the
    // DDA), then write `lit` straight into the pixel's hex.vec2 framebuffer cell (zero-init -> xor = set).
    def pixel fbcell < lit, pixel_ret, pixel_leaf {
        stl.fcall pixel_leaf, pixel_ret
        hex.xor_zero 2, fbcell, lit
    }

    // CLIPPED pixel (M12bb, optimized M12dd): the wall renderer unrolls ALL screen rows per column at
    // COMPILE-TIME pixel addresses (the M11c zero-pointer structure), but a wall only covers the RUNTIME
    // rows [top, bottom]. Render `y` (compile-time row) iff top <= y <= bottom.
    //  - The row constant `y` is read straight from the shared `rows` table (`rows[k] = k`, 2 nibbles) at
    //    the COMPILE-TIME address `rows + 2*dw*y` -> no per-pixel hex.set.
    //  - top/bottom are clamped to [0, VIEW_H-1] by the column setup, so they fit 2 nibbles and are
    //    non-negative -> cheap UNSIGNED `hex.cmp 2` (never scmp).
    //  - The more-probable below-wall skip (`bottom < y`) is checked FIRST so it exits in one compare.
    //  - render = fcall the leaf (advances the DDA) + write; a skip falls straight to `end` with NO fcall
    //    (so the DDA only advances over the wall's rows, frac0 aligned to `top`, as render_textured_column).
    def pixel_clipped y, fbcell, top, bottom \
            @ lo_ok, render, end < lit, pixel_ret, pixel_leaf, rows {
        hex.cmp 2, bottom, rows + 2*dw*y, end, lo_ok, lo_ok   // bottom < y -> skip (below the wall)
      lo_ok:
        hex.cmp 2, top, rows + 2*dw*y, render, render, end    // top > y -> skip (above the wall)
      render:
        stl.fcall pixel_leaf, pixel_ret
        hex.zero 2, fbcell                                    // OVERWRITE: clear the cell first so the wall
        hex.xor_zero 2, fbcell, lit                           // composes OVER a filled background (M12ii), not
      end:                                                    // just zero-init cells (zeroing a zero cell is a no-op)
    }

    // PASS-2 SHARED-COMPARE TRAMPOLINE (M12oo) — the space-optimized replacement for pixel_clipped. The old
    // pixel_clipped INLINED two `hex.cmp 2` per pixel; unrolled over VIEW_W*VIEW_H (~16K) pixels that clip is
    // ~16M words (bisected). This moves BOTH compares into ONE shared `compare_y` body (emitted once at the
    // global label `compare_y:` via compare_y_body) that every pixel JUMPS INTO via a cheap wflip trampoline,
    // so the heavy compare setup is emitted once, not 16K times. `y` is now a RUNTIME register (zeroed per
    // column by load_col_mtw, incremented at the END of each pixel here), replacing the compile-time `rows`
    // table. Per pixel: set ret_reg's jump word to THIS pixel's `ret`, jump compare_y; it returns to *ret_reg
    // (= `ret`, the SKIP op) or, on render, redirects ret_reg to `ret+dw` (the RENDER op) by flipping the
    // dw-valued bit of ret_reg's jump word at offset `w + log2(dw)` (= `w + #dw - 1`); `pad 2` aligns `ret`
    // to 2*dw so that single-bit flip is carry-free. ret_reg self-cleans (the render op flips the bit back;
    // `end` xors `ret` back out), so it is 0 between pixels. ~2 wflips + an inc per pixel vs ~490 inlined ops.
    // Globals: ret_reg (a `;0` op), compare_y (the body label), y (hex.vec 2), + the pixel-leaf regs. The
    // off-screen sentinel (top=1,bottom=0) still skips every row. top/bottom are compared at 2 nibbles (clamped
    // [0,VIEW_H-1]). @requires hex.init.
    def pixel_tramp fbcell @ ret, end < ret_reg, compare_y, lit, pixel_ret, pixel_leaf, y {
        wflip ret_reg + w, ret, compare_y     // ret_reg -> this pixel's `ret`; jump the shared compare_y
        pad 2                                 // align `ret` to 2*dw so the redirect-bit flip is carry-free
      ret:
        ; end                                 // SKIP target (op at ret): render nothing, fall to `end`
        ret_reg + w + (#dw - 1) ;             // RENDER target (op at ret+dw): un-redirect ret_reg (self-clean)
        stl.fcall pixel_leaf, pixel_ret       // sample + colormap -> lit, advance the DDA
        hex.zero 2, fbcell                    // OVERWRITE so the wall composes over the filled background (M12ii)
        hex.xor_zero 2, fbcell, lit
      end:
        wflip ret_reg + w, ret                // clear ret_reg back to 0 (xor `ret` out)
        hex.inc 2, y                          // advance the row (INC AT END, so frac0 aligns to `top`)
    }

    // the SHARED compare_y body (M12oo), emitted ONCE at the global label `compare_y:` and JUMPED INTO by every
    // pixel_tramp. Decides render vs skip from the runtime row `y` against the column's clipped [top,bottom]
    // (same logic as pixel_clipped): on skip jump *ret_reg (= the pixel's `ret`); on render fall to `next`,
    // which redirects ret_reg to `ret+dw` (the RENDER op) and jumps it. top/bottom compared at 2 nibbles. The
    // body never falls through (every path jumps to ret_reg), so it is safe to place after stl.loop. @requires
    // hex.init.
    def compare_y_body @ lo_ok, next < bottom, y, ret_reg, top {
        hex.cmp 2, bottom, y, ret_reg, lo_ok, lo_ok   // bottom < y -> skip (below the wall): jump *ret_reg
      lo_ok:
        hex.cmp 2, top, y, next, next, ret_reg        // top > y -> skip (above the wall); else fall to `next` (render)
      next:
        ret_reg + w + (#dw - 1) ; ret_reg             // redirect ret_reg: ret -> ret+dw, jump it (render)
    }

    // per-column orchestrator (M12cc): compute the column's render params (clipped top/bottom + texcol +
    // the 8.8 DDA frac0/step) via proj.column_render_params, then load the shared leaf's per-column
    // registers (base_reg = texcol*texheight, cmidx light byte, step, frac) ready for the row loop. Writes
    // the clipped top/bottom for the caller's `rep(H, y) frame.pixel_clipped y, <fbcell>, top, bottom`.
    // Runtime per-column inputs: scale (accumulated by the caller) + x. Per-seg inputs (rw_centerangle,
    // rw_offset, rw_distance, light, ceilfix, floorfix, viewz, worldtop, tw) pass through as REGISTERS;
    // texheight/centery/ds/viewh1 are compile-time Config/texture consts (R6). NOTE tw is a REGISTER (it
    // is a hex.div memory operand in texture_u), not a compile-time literal. @requires hex.init & stl.ptr_init.
    def wall_column top, bottom, scale, x, rw_centerangle, rw_offset, rw_distance, light, ceilfix, floorfix, viewz, worldtop, tw, texheight, centery, ds, viewh1 \
            @ texcol, frac0, stepv, end < base_reg, cmidx, step, frac {
        proj.column_render_params top, bottom, texcol, frac0, stepv, scale, rw_centerangle, rw_offset, rw_distance, x, tw, ceilfix, floorfix, viewz, worldtop, centery, ds, viewh1
        hex.mul_const 3, base_reg, texcol, texheight    // base_reg = texcol * texheight (column-major M8)
        hex.zero 4, cmidx
        hex.mov 2, cmidx + 2*dw, light                  // cmidx high byte = light
        hex.mov 4, step, stepv
        hex.mov 4, frac, frac0
        ;end

      texcol: hex.vec 8
      frac0: hex.vec 4
      stepv: hex.vec 4
      end:
    }

    // the shared per-COLUMN leaf (M12dd), emitted ONCE at the global label `column_leaf:` and fcall'd per
    // column — so the heavy `proj.column_render_params` is inlined ONCE, not WIDTH× (the assemble lever,
    // like pixel_leaf). It is the register form of `wall_column`: reads the per-column runtime inputs
    // (scale, x, the per-seg rw_*/light/ceilfix/floorfix/viewz/worldtop/tw) from the includer's registers,
    // computes the column params, loads the pixel-leaf's per-column registers (base_reg/cmidx/step/frac),
    // and writes the clipped top/bottom — then returns via fret. texheight/centery/ds/viewh1 are the
    // compile-time Config/texture consts (single-texture; multi-seg texheight goes runtime later). `tw` is
    // a REGISTER (a hex.div memory operand). @requires hex.init & stl.ptr_init.
    def column_leaf_body texheight, centery, ds, viewh1 \
            @ texcol, frac0, stepv \
            < scale, x, rw_centerangle, rw_offset, rw_distance, light, ceilfix, floorfix, viewz, worldtop, \
              tw, top, bottom, base_reg, cmidx, step, frac, col_ret {
        proj.column_render_params top, bottom, texcol, frac0, stepv, scale, rw_centerangle, rw_offset, rw_distance, x, tw, ceilfix, floorfix, viewz, worldtop, centery, ds, viewh1
        hex.mul_const 3, base_reg, texcol, texheight    // base_reg = texcol * texheight (column-major M8)
        hex.zero 4, cmidx
        hex.mov 2, cmidx + 2*dw, light                  // cmidx high byte = light
        hex.mov 4, step, stepv
        hex.mov 4, frac, frac0
        stl.fret col_ret                                // return (the data below is never fallen into)

      texcol: hex.vec 8
      frac0: hex.vec 4
      stepv: hex.vec 4
    }

    // PASS-2 per-column setup from the param ARRAYS (M12jj, the array bridge). The two-pass renderer (B')
    // splits "decide each column's content" (pass 1, runtime, seg-major) from "paint pixels" (pass 2,
    // unrolled). Pass 1 (runtime, later) fills the per-column arrays col_top/col_bottom/col_base/col_light/
    // col_step/col_frac0; pass 2 reads a column's entry HERE at a COMPILE-TIME address — x is the unroll
    // (rep) index, so each `*_src` is a constant address (zero pointers, lessons #11-12) — and loads the
    // shared leaf's per-column registers: top/bottom for the row clip (pixel_clipped); base_reg/cmidx-light/
    // step/frac for the pixel leaf. This REPLACES column_leaf_body's runtime compute with an array read —
    // the pass-1<->pass-2 contract. The per-column read happens ONCE here (the HOISTING invariant); the
    // pixel leaf only advances the DDA per pixel. Array element widths: top/bottom = the clamped
    // [0,VIEW_H-1] rows (2 nibbles), base = texcol*texheight (3), light (2), step/frac0 = 8.8 (4).
    def load_col top_src, bottom_src, base_src, light_src, step_src, frac0_src \
            < top, bottom, base_reg, cmidx, step, frac {
        hex.mov 2, top, top_src
        hex.mov 2, bottom, bottom_src
        hex.mov 3, base_reg, base_src
        hex.zero 4, cmidx
        hex.mov 2, cmidx + 2*dw, light_src          // cmidx high byte = light (the leaf keeps it)
        hex.mov 4, step, step_src
        hex.mov 4, frac, frac0_src
    }

    // MULTI-TEXTURE pass-2 per-column setup (M12mm2) — load_col + the per-column HEIGHTMASK. With per-seg
    // textures the texel v-mask (texheight-1) varies per column, so it is read from col_heightmask[x] into
    // the shared `heightmask` register (which the pixel leaf's `hex.and 2, v3, heightmask` consumes). The
    // texture is selected purely via base_reg = the ABSOLUTE texel index in the single combined dispatch
    // table (col_base[x] = seg_texbase + texcol*texheight, computed in pass 1) — so the per-pixel fetch is
    // UNCHANGED (one `tex.sample` over the combined table), honouring the hoisting rule (no per-pixel texture
    // re-select). hm_src is the col_heightmask[x] address (4-nibble element). @requires hex.init & stl.ptr_init.
    def load_col_mt top_src, bottom_src, base_src, light_src, step_src, frac0_src, hm_src \
            < top, bottom, base_reg, cmidx, step, frac, heightmask {
        hex.mov 2, top, top_src
        hex.mov 2, bottom, bottom_src
        hex.mov 3, base_reg, base_src
        hex.zero 4, cmidx
        hex.mov 2, cmidx + 2*dw, light_src
        hex.mov 4, step, step_src
        hex.mov 4, frac, frac0_src
        hex.mov 3, heightmask, hm_src                // per-column texheight-1 (the leaf masks v by this)
    }

    // MULTI-TEXTURE pass-2 per-column setup, WIDE-INDEX (M12nn) — load_col_mt for a full E1M1-scale COMBINED
    // table: base_reg is 5 nibbles (col_base[x] = an absolute texel index up to ~793k), read from an 8-nibble
    // col array element. All other fields are read from their (now 8-nibble) elements at their natural widths
    // (the high nibbles are 0). Pairs with leaf_body_w (5-nibble idx). @requires hex.init & stl.ptr_init.
    def load_col_mtw top_src, bottom_src, base_src, light_src, step_src, frac0_src, hm_src \
            < top, bottom, base_reg, cmidx, step, frac, heightmask, y {
        hex.mov 2, top, top_src
        hex.mov 2, bottom, bottom_src
        hex.mov 5, base_reg, base_src                // 5-nibble absolute texel index into the combined table
        hex.zero 4, cmidx
        hex.mov 2, cmidx + 2*dw, light_src
        hex.mov 4, step, step_src
        hex.mov 4, frac, frac0_src
        hex.mov 3, heightmask, hm_src
        hex.zero 2, y                                // reset the pass-2 trampoline row counter for this column (M12oo)
    }

    // PASS-1 per-column runtime STORE (M12kk) — the write-side analog of load_col. The seg-major pass 1
    // computes a column's render params (proj.column_render_params) and writes them to the per-column
    // param ARRAYS at the RUNTIME column index x; pass 2 then reads col_*[x] at compile-time addresses
    // (load_col). ALL arrays use a UNIFORM 4-nibble element stride, so the digit offset is x*4 — computed
    // ONCE here and reused for every field. Built on the stl runtime-indexed write (ptr_index -> write_hex,
    // .store_col_field). These per-column writes are the ONLY runtime-indexed (pointer) writes in the
    // renderer (<=VIEW_W per frame); the framebuffer stays the compile-time wflip path (pass 2). col_top/
    // col_bottom/col_base/col_step/col_frac0 are the array base labels (compile-time addresses); the
    // values are REGISTERS (top/bottom hex[:8] clamped rows, base hex[:4]=texcol*texheight, step/frac0
    // hex[:4] 8.8). light is per-SEG (baked) in M12kk so it is NOT stored here (pass 2 reads one light
    // reg); it goes per-column in M12mm. @requires hex.init & stl.ptr_init (ptr_index / write_hex).
    def store_col x, col_top, col_bottom, col_base, col_step, col_frac0, top, bottom, base, step, frac0 \
            @ idx, end {
        hex.mov w/4, idx, x
        hex.shl_bit w/4, idx
        hex.shl_bit w/4, idx                       // idx = x*4 (the uniform 4-nibble element digit offset)
        .store_col_field col_top, idx, top
        .store_col_field col_bottom, idx, bottom
        .store_col_field col_base, idx, base
        .store_col_field col_step, idx, step
        .store_col_field col_frac0, idx, frac0
        ;end                                       // skip the scratch data (else it runs as code, lesson #2)
      idx: hex.vec w/4
      end:
    }

    // one runtime-indexed array write: array[x] = src[:4], where `array` holds 4-nibble elements and
    // `idx` (= x*4) is the precomputed digit offset. `array` is the base label (compile-time address); the
    // stl ptr machinery forms array + idx*dw at runtime (ptr_index needs a SEPARATE result reg from the
    // base — an in-place ptr_index clobbers the base before the add). @requires hex.init & stl.ptr_init.
    def store_col_field array, idx, src @ aptr, cell, end {
        hex.set w/4, aptr, array
        hex.ptr_index cell, aptr, idx
        hex.write_hex 4, cell, src
        ;end                                       // skip the scratch data (lesson #2)
      aptr: hex.vec w/4
      cell: hex.vec w/4
      end:
    }

    // store_col_field, 5-nibble variant (M12nn) — for col_base only, which in a full E1M1-scale COMBINED
    // texture table holds an ABSOLUTE texel index up to ~10^6 (793k texels) = 5 nibbles, too wide for a
    // 4-nibble element. The WIDE pass-1 leaf gives every col array an 8-nibble stride (idx = x*8) so this
    // 5-nibble write fits (high 3 nibbles of the element stay 0 from init). @requires hex.init & stl.ptr_init.
    def store_col_field5 array, idx, src @ aptr, cell, end {
        hex.set w/4, aptr, array
        hex.ptr_index cell, aptr, idx
        hex.write_hex 5, cell, src
        ;end
      aptr: hex.vec w/4
      cell: hex.vec w/4
      end:
    }

    // PASS-1 solid-seg clip (M12ll) — the runtime per-column `drawn[]` flag (render_wall_frame's front-to-
    // back occlusion). `drawn` is a VIEW_W array of 4-nibble flags (uniform stride, idx = x*4); a column is
    // CLAIMED by the FIRST (nearest) seg that reaches it. skip_if_drawn: if drawn[x] != 0 (already claimed by
    // a nearer seg) jump to `skip` (the caller skips the store but STILL advances scale, oracle line 563);
    // else fall through to the store. mark_drawn: set drawn[x] = 1 (claim the column). For a CONVEX scene
    // (square room) the segs cover disjoint x-ranges so drawn[] never blocks — but the mechanism RUNS (M12ll);
    // it actually clips in M12mm (occlusion). @requires hex.init & stl.ptr_init.
    def skip_if_drawn x, drawn, skip @ idx, aptr, cell, dval, cont, end {
        hex.mov w/4, idx, x
        hex.shl_bit w/4, idx
        hex.shl_bit w/4, idx                       // idx = x*4 (drawn shares the col arrays' 4-nibble stride)
        hex.set w/4, aptr, drawn
        hex.ptr_index cell, aptr, idx
        hex.read_hex 2, dval, cell                 // dval = drawn[x] (low 2 nibbles)
        hex.if0 2, dval, cont                      // drawn[x] == 0 -> not claimed, continue to the store
        ;skip                                      // already claimed -> skip the store (scale still advances)
      cont:
        ;end
      idx: hex.vec w/4
      aptr: hex.vec w/4
      cell: hex.vec w/4
      dval: hex.vec 2
      end:
    }

    def mark_drawn x, drawn @ idx, aptr, cell, one, end {
        hex.mov w/4, idx, x
        hex.shl_bit w/4, idx
        hex.shl_bit w/4, idx
        hex.set w/4, aptr, drawn
        hex.ptr_index cell, aptr, idx
        hex.set 2, one, 1
        hex.write_hex 2, cell, one                 // drawn[x] = 1 (claim the column)
        ;end
      idx: hex.vec w/4
      aptr: hex.vec w/4
      cell: hex.vec w/4
      one: hex.vec 2
      end:
    }

    // PASS-1 per-SEG shared leaf (M12ll) — the walk-driven multi-seg fill, emitted ONCE at a global label
    // and fcall'd per one-sided seg (mantra #9: the whole projection front-end + the per-column loop are NOT
    // unrolled per seg). The caller (the BSP walk's subsector action) sets the seg's BAKED consts into the
    // registers (seg_v1x/seg_v1y/seg_v2x/seg_v2y/seg_segangle/seg_texoff) then fcalls this; it RELOADS the
    // projection for that seg from the RUNTIME viewpoint (viewx/viewy/viewangle): wall_x_range (cull ->
    // fret), wall_setup, wall_scale_setup, wall_offset, then the runtime per-column loop — drawn[] clip ->
    // column_render_params -> base=texcol*texheight -> store_col -> mark_drawn; scale += step over EVERY
    // column. tw/ceilfix/floorfix/viewz/worldtop are per-seg registers (single-sector square room bakes them
    // once; M12mm makes texture/light per-seg). texheight/centery/ds/viewh1/projection are compile-time
    // Config args (R6). Returns via stl.fret seg_ret. @requires hex.init & stl.ptr_init.
    def seg_pass1_leaf_body texheight, centery, ds, viewh1, projection \
            @ loop, body, skipcol, ret \
            < viewx, viewy, viewxa, viewxs, viewya, viewys, sgn_aff, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_segangle, seg_a, seg_b, seg_c, seg_texoff, \
              tw, ceilfix, floorfix, viewz, worldtop, \
              visible, x1, x2, rwa, normalangle, rw_distance, scale, scalestep, rw_offset, rw_centerangle, x, \
              top, bottom, texcol, cfrac0, stepv, base, \
              col_top, col_bottom, col_base, col_step, col_frac0, drawn, seg_ret {
        proj.wall_x_range visible, x1, x2, rwa, sgn_aff, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c
        hex.if0 1, visible, ret                    // culled seg -> nothing to fill
        proj.wall_setup_sgn normalangle, rw_distance, sgn_aff, seg_segangle   // M13-absmul: sgn from wall_x_range
        proj.wall_scale_setup scale, scalestep, viewangle, normalangle, rw_distance, x1, x2, projection
        proj.wall_offset rw_offset, rw_centerangle, viewx, viewy, viewangle, normalangle, rwa, seg_v1x, seg_v1y, seg_texoff
        hex.mov 8, x, x1
      loop:
        hex.scmp 8, x, x2, body, ret, ret          // x < x2 ? body, else done (fret)
      body:
        .skip_if_drawn x, drawn, skipcol           // claimed by a nearer seg -> skip the store
        proj.column_render_params top, bottom, texcol, cfrac0, stepv, scale, rw_centerangle, rw_offset, rw_distance, x, tw, ceilfix, floorfix, viewz, worldtop, centery, ds, viewh1
        hex.mul_const 4, base, texcol, texheight
        .store_col x, col_top, col_bottom, col_base, col_step, col_frac0, top, bottom, base, stepv, cfrac0
        .mark_drawn x, drawn
      skipcol:
        hex.inc 8, x
        hex.add 8, scale, scalestep                // scale advances over EVERY column (incl. claimed)
        ;loop
      ret:
        stl.fret seg_ret
    }

    // PASS-1 per-SEG shared leaf, MULTI-TEXTURE (M12mm2) — seg_pass1_leaf_body with PER-SEG textures. The
    // seg's texture is one slice of a single COMBINED dispatch table; the caller bakes seg_texbase (the
    // slice's absolute texel offset, aligned to texheight so the leaf's base|v OR == base+v), seg_texheight
    // (runtime, so base = texcol*texheight uses hex.mul not mul_const), seg_tw (texture width, for the
    // texture_u mod), seg_hm (= texheight-1, the per-column v-mask). Per column: base = seg_texbase +
    // texcol*texheight (absolute combined-table index) -> col_base[x]; col_heightmask[x] = seg_hm. A '-' /
    // missing texture is baked as a 1x1 WALL_BG sentinel slice (texheight=1, tw=1, seg_hm=0) so the SAME path
    // flat-fills WALL_BG (v masked to 0 -> samples the single sentinel texel every row) — no per-pixel
    // branch. Light stays single (1-sector test; multi-light is E1M1). @requires hex.init & stl.ptr_init.
    def seg_pass1_leaf_body_mt centery, ds, viewh1, projection \
            @ loop, body, skipcol, ret, sidx \
            < viewx, viewy, viewxa, viewxs, viewya, viewys, sgn_aff, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_segangle, seg_a, seg_b, seg_c, seg_texoff, \
              seg_texbase, seg_texheight, seg_tw, seg_hm, ceilfix, floorfix, viewz, worldtop, \
              visible, x1, x2, rwa, normalangle, rw_distance, scale, scalestep, rw_offset, rw_centerangle, x, \
              top, bottom, texcol, cfrac0, stepv, base, \
              col_top, col_bottom, col_base, col_step, col_frac0, col_heightmask, drawn, seg_ret {
        proj.wall_x_range visible, x1, x2, rwa, sgn_aff, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c
        hex.if0 1, visible, ret
        proj.wall_setup_sgn normalangle, rw_distance, sgn_aff, seg_segangle   // M13-absmul: sgn from wall_x_range
        proj.wall_scale_setup scale, scalestep, viewangle, normalangle, rw_distance, x1, x2, projection
        proj.wall_offset rw_offset, rw_centerangle, viewx, viewy, viewangle, normalangle, rwa, seg_v1x, seg_v1y, seg_texoff
        hex.mov 8, x, x1
      loop:
        hex.scmp 8, x, x2, body, ret, ret
      body:
        .skip_if_drawn x, drawn, skipcol
        proj.column_render_params top, bottom, texcol, cfrac0, stepv, scale, rw_centerangle, rw_offset, rw_distance, x, seg_tw, ceilfix, floorfix, viewz, worldtop, centery, ds, viewh1
        hex.mul 4, base, texcol, seg_texheight     // base = texcol*texheight (RUNTIME: per-seg texheight)
        hex.add 4, base, seg_texbase                // + the seg texture's slice offset (absolute combined idx)
        hex.mov w/4, sidx, x
        hex.shl_bit w/4, sidx
        hex.shl_bit w/4, sidx                       // sidx = x*4 (the per-column array digit offset)
        .store_col_field col_top, sidx, top
        .store_col_field col_bottom, sidx, bottom
        .store_col_field col_base, sidx, base
        .store_col_field col_step, sidx, stepv
        .store_col_field col_frac0, sidx, cfrac0
        .store_col_field col_heightmask, sidx, seg_hm   // per-column texheight-1 (the v-mask)
        .mark_drawn x, drawn
      skipcol:
        hex.inc 8, x
        hex.add 8, scale, scalestep
        ;loop
      ret:
        stl.fret seg_ret                            // return (the data below is never fallen into)
      sidx: hex.vec w/4
    }

    // PASS-1 per-SEG shared leaf, MULTI-TEXTURE + MULTI-LIGHT (M12nn) — seg_pass1_leaf_body_mt plus the per-seg
    // sector LIGHT goes per-column. In E1M1 a frame's visible segs span sectors of different light, so the
    // colormap row (the cmidx high byte the pixel leaf keeps) must vary per column, not be one baked value.
    // The caller bakes seg_light (= the seg's sector light row, sec.light>>LIGHT_SHIFT clamped); this leaf
    // stores it into col_light[x] alongside the other 6 fields, mirroring how _mt added col_heightmask. Pass 2
    // then reads col_light[x] into cmidx's high byte (load_col_mt's light_src). The WALL_BG flat-fill samples
    // the same tex.sample with that per-column light, so the fallback is colormapped at the seg's own light too
    // (oracle: colormap[seg_light][WALL_BG]). The per-pixel leaf is UNCHANGED. @requires hex.init & stl.ptr_init.
    def seg_pass1_leaf_body_mtl centery, ds, viewh1, projection \
            @ loop, body, skipcol, ret, sidx \
            < viewx, viewy, viewxa, viewxs, viewya, viewys, sgn_aff, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_segangle, seg_a, seg_b, seg_c, seg_texoff, \
              seg_texbase, seg_texheight, seg_tw, seg_hm, seg_light, ceilfix, floorfix, viewz, worldtop, \
              visible, x1, x2, rwa, normalangle, rw_distance, scale, scalestep, rw_offset, rw_centerangle, x, \
              top, bottom, texcol, cfrac0, stepv, base, \
              col_top, col_bottom, col_base, col_step, col_frac0, col_heightmask, col_light, drawn, seg_ret {
        proj.wall_x_range visible, x1, x2, rwa, sgn_aff, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c
        hex.if0 1, visible, ret
        proj.wall_setup_sgn normalangle, rw_distance, sgn_aff, seg_segangle   // M13-absmul: sgn from wall_x_range
        proj.wall_scale_setup scale, scalestep, viewangle, normalangle, rw_distance, x1, x2, projection
        proj.wall_offset rw_offset, rw_centerangle, viewx, viewy, viewangle, normalangle, rwa, seg_v1x, seg_v1y, seg_texoff
        hex.mov 8, x, x1
      loop:
        hex.scmp 8, x, x2, body, ret, ret
      body:
        .skip_if_drawn x, drawn, skipcol
        proj.column_render_params top, bottom, texcol, cfrac0, stepv, scale, rw_centerangle, rw_offset, rw_distance, x, seg_tw, ceilfix, floorfix, viewz, worldtop, centery, ds, viewh1
        hex.mul 4, base, texcol, seg_texheight
        hex.add 4, base, seg_texbase
        hex.mov w/4, sidx, x
        hex.shl_bit w/4, sidx
        hex.shl_bit w/4, sidx                       // sidx = x*4 (the per-column array digit offset)
        .store_col_field col_top, sidx, top
        .store_col_field col_bottom, sidx, bottom
        .store_col_field col_base, sidx, base
        .store_col_field col_step, sidx, stepv
        .store_col_field col_frac0, sidx, cfrac0
        .store_col_field col_heightmask, sidx, seg_hm
        .store_col_field col_light, sidx, seg_light     // per-column colormap row (the seg's sector light)
        .mark_drawn x, drawn
      skipcol:
        hex.inc 8, x
        hex.add 8, scale, scalestep
        ;loop
      ret:
        stl.fret seg_ret
      sidx: hex.vec w/4
    }

    // PASS-1 per-SEG shared leaf, MULTI-TEXTURE + MULTI-LIGHT + WIDE-INDEX (M12nn) — seg_pass1_leaf_body_mtl
    // for a full E1M1-scale COMBINED texture table. The absolute texel index base = seg_texbase +
    // texcol*texheight reaches ~793k (5 nibbles), too wide for a 4-nibble col array element, so EVERY col
    // array gets an 8-nibble stride (idx = x*8) and col_base is written with the 5-nibble store_col_field5.
    // base is computed at 5 nibbles (zero -> mul 4 (texcol*texheight, <=4 nibbles) -> add 5 the texbase).
    // drawn[] keeps its own 4-nibble stride (skip_if_drawn/mark_drawn unchanged). Pairs with load_col_mtw +
    // leaf_body_w. @requires hex.init & stl.ptr_init.
    def seg_pass1_leaf_body_mtlw centery, ds, viewh1, projection \
            @ loop, body, skipcol, ret, sidx, tbskip, tbok \
            < viewx, viewy, viewxa, viewxs, viewya, viewys, sgn_aff, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_segangle, seg_a, seg_b, seg_c, seg_texoff, \
              seg_texbase, seg_texheight, seg_tw, seg_hm, seg_light, ceilfix, floorfix, viewz, viewzw, seg_ceil, worldtop, \
              visible, x1, x2, rwa, normalangle, rw_distance, scale, scalestep, rw_offset, rw_centerangle, x, \
              top, bottom, texcol, cfrac0, stepv, base, \
              col_top, col_bottom, col_base, col_step, col_frac0, col_heightmask, col_light, drawn, seg_ret {
        proj.wall_x_range visible, x1, x2, rwa, sgn_aff, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c
        hex.if0 1, visible, ret
        proj.wall_setup_sgn normalangle, rw_distance, sgn_aff, seg_segangle   // M13-absmul: sgn from wall_x_range
        proj.wall_scale_setup scale, scalestep, viewangle, normalangle, rw_distance, x1, x2, projection
        proj.wall_offset rw_offset, rw_centerangle, viewx, viewy, viewangle, normalangle, rwa, seg_v1x, seg_v1y, seg_texoff
        hex.mov 8, worldtop, seg_ceil           // M12pp: worldtop = seg_ceil - viewzw computed IN-LEAF, so the baked
        hex.sub 8, worldtop, viewzw             // field is the PURE const seg_ceil (xor_by/involution-bakeable), not worldtop
        hex.mov 8, x, x1
      loop:
        hex.scmp 8, x, x2, body, ret, ret
      body:
        .skip_if_drawn x, drawn, skipcol
        proj.column_render_params top, bottom, texcol, cfrac0, stepv, scale, rw_centerangle, rw_offset, rw_distance, x, seg_tw, ceilfix, floorfix, viewz, worldtop, centery, ds, viewh1
        hex.scmp 8, top, bottom, tbok, tbok, tbskip   // oracle "if top<=bottom": top>bottom (wall off the top of
      tbskip:                                         // the screen, both rows clipped) -> store the skip sentinel
        hex.set 8, top, 1                             // (top=1>bottom=0) so pass 2 renders NO rows; mark_drawn still
        hex.zero 8, bottom                            // CLAIMS the column (the near off-screen wall occludes far segs)
      tbok:
        hex.zero 5, base
        hex.mul 4, base, texcol, seg_texheight       // base = texcol*texheight (<= 4 nibbles)
        hex.add 5, base, seg_texbase                 // + the seg slice offset = absolute combined idx (5 nibbles)
        hex.mov w/4, sidx, x
        hex.shl_bit w/4, sidx
        hex.shl_bit w/4, sidx
        hex.shl_bit w/4, sidx                        // sidx = x*8 (the uniform WIDE 8-nibble array stride)
        .store_col_field col_top, sidx, top
        .store_col_field col_bottom, sidx, bottom
        .store_col_field5 col_base, sidx, base       // 5-nibble absolute texel index
        .store_col_field col_step, sidx, stepv
        .store_col_field col_frac0, sidx, cfrac0
        .store_col_field col_heightmask, sidx, seg_hm
        .store_col_field col_light, sidx, seg_light
        .mark_drawn x, drawn
      skipcol:
        hex.inc 8, x
        hex.add 8, scale, scalestep
        ;loop
      ret:
        stl.fret seg_ret
      sidx: hex.vec w/4
    }

    // the shared heavy body, emitted ONCE at the global label `pixel_leaf:`. Reads the per-column
    // registers + the DDA, writes the lit palette byte into `lit`, advances the DDA, returns via fret.
    def leaf_body < frac, v3, idx, cmidx, lit, base_reg, step, heightmask, pixel_ret {
        // v3 is held kept-zero between pixels (the xor_zero below restores it), so no per-pixel hex.zero.
        hex.xor 2, v3, frac + 2*dw            // v3 = high byte of frac (the 8.8 integer part)
        hex.and 2, v3, heightmask             // v = v & (texheight-1). FULL 2-nibble and (M12mm2): correct for
                                              // texheight<16 too (heightmask in nibble 0). For texheight>=16 the
                                              // low nibble of heightmask is 0xF so this == the old nibble-1-only and.
        hex.mov 3, idx, base_reg              // idx = base
        hex.xor_zero 3, idx, v3               // idx = base | v = base + v (disjoint bits); v3 -> 0 (kept-zero)
        tex.sample cmidx, idx                 // cmidx low byte = pal (high byte = light, preset per column)
        cm.apply lit, cmidx                   // lit = colormapped palette byte
        hex.add 4, frac, step                 // advance the DDA (8.8)
        stl.fret pixel_ret
    }

    // the shared heavy body, WIDE-INDEX (M12nn) — leaf_body with a 5-nibble texel index for a full E1M1-scale
    // COMBINED texture table (~793k texels). base_reg/idx are 5 nibbles (vs 3); the texel-v offset (v3, masked
    // by heightmask, < texheight <= 256 => 2 nibbles) is OR'd into the low bits. The texture table's own
    // sample reads only its index_nibbles, so a wider idx with zero high nibbles is correct for small tables
    // too. Pairs with load_col_mtw + seg_pass1_leaf_body_mtlw. @requires hex.init, stl.ptr_init.
    def leaf_body_w < frac, v3, idx, cmidx, lit, base_reg, step, heightmask, pixel_ret {
        hex.xor 2, v3, frac + 2*dw            // v3 = high byte of frac (the 8.8 integer part)
        hex.and 2, v3, heightmask             // v = v & (texheight-1)
        hex.mov 5, idx, base_reg              // idx = base (5 nibbles)
        hex.xor_zero 2, idx, v3               // idx = base | v (v < texheight <= 256 => low 2 nibbles); v3 -> 0
        tex.sample cmidx, idx
        cm.apply lit, cmidx
        hex.add 4, frac, step
        stl.fret pixel_ret
    }

    // frame.render_background base, ceil_color, floor_color, view_w, view_h, horizon — the M9 two-band
    // background (R_DrawViewBorder / the empty-view clear, oracle reference_model.render_frame): fill the
    // top `horizon` rows of the hex.vec2 framebuffer `base` with the (already colormapped) ceiling byte and
    // the remaining rows with the floor byte. Each pixel k is a hex.vec2 cell at base + 2*k*dw (low nibble
    // 2k, high 2k+1); the constant colors are compile-time, so each pixel is one `hex.set 2`. view_w/view_h/
    // horizon are compile-time Config args (R6; horizon = VIEW_H//2). This is what the wall renderer paints
    // over (and what visplanes replace in M13). @requires hex.init.
    def render_background base, ceil_color, floor_color, view_w, view_h, horizon {
        rep(horizon*view_w, k) hex.set 2, base + 2*k*dw, ceil_color
        rep((view_h - horizon)*view_w, k) hex.set 2, base + 2*(horizon*view_w + k)*dw, floor_color
    }

    // frame.render_background_reg base, ceil_reg, floor_reg, view_w, view_h, horizon — the RUNTIME-color two-band
    // background (M12nn). Same two-band fill as render_background, but the ceiling/floor bytes are RUNTIME
    // REGISTERS (already colormapped), not compile-time literals. In E1M1 the player moves between sectors of
    // different light, so the bg colors are computed per frame (player subsector -> sector light -> colormap row
    // -> cm.apply at CEIL_BG / FLOOR_BG) and passed in as registers. Each pixel is a compile-time-ADDRESS
    // hex.mov 2 of the runtime byte (vs render_background's hex.set of a literal) — the destination stays a
    // wflip at a fixed address, so pass-2 walls still OVERWRITE it. view_w/view_h/horizon are compile-time
    // Config args (R6; horizon = VIEW_H//2). ceil_reg/floor_reg are 2-nibble. @requires hex.init.
    def render_background_reg base, ceil_reg, floor_reg, view_w, view_h, horizon {
        rep(horizon*view_w, k) hex.mov 2, base + 2*k*dw, ceil_reg
        rep((view_h - horizon)*view_w, k) hex.mov 2, base + 2*(horizon*view_w + k)*dw, floor_reg
    }

    // ── M13c3 FLOOR/CEILING (visplane) FLAT-COLORED raster — the pass-2 plane fill that REPLACES the M9
    //    two-band background. The walls tile screen rows [top,bottom] per column; the ceiling is the rows
    //    ABOVE (y < cexcl) and the floor the rows BELOW (y >= fstart) — together the three bands cover every
    //    pixel (oracle reference_model._render_planes_flat). Each plane pixel is distance-lit via the shared
    //    plane.draw_pixel kernel (plane_render.fj, M13c2). ──────────────────────────────────────────────

    // store_col_field, 8-nibble variant (M13c3) — for the per-column plane heights col_ceil_ph/col_floor_ph
    // (16.16 |plane_z - viewz|, up to 8 nibbles). The WIDE pass-1 leaf's 8-nibble array stride (idx = x*8)
    // holds it exactly. @requires hex.init & stl.ptr_init.
    def store_col_field8 array, idx, src @ aptr, cell, end {
        hex.set w/4, aptr, array
        hex.ptr_index cell, aptr, idx
        hex.write_hex 8, cell, src
        ;end
      aptr: hex.vec w/4
      cell: hex.vec w/4
      end:
    }

    // PASS-2 per-column PLANE setup (M13c3) — the floor/ceiling analog of load_col_mtw. Loads a column's
    // visplane params (filled by seg_pass1_leaf_body_mtlwp): cexcl (ceiling fills rows y < cexcl), fstart
    // (floor fills rows y >= fstart), the ceil/floor planeheights (16.16 |plane_z - viewz|), the RAW sector
    // light (plane.draw_pixel does the >>LIGHTSEGSHIFT itself), and the ceil/floor flat base palette index.
    // Resets the trampoline row counter y. Reads from 8-nibble col array elements at their natural widths.
    // @requires hex.init & stl.ptr_init.
    def load_col_plane cexcl_src, fstart_src, ceil_ph_src, floor_ph_src, plight_src, ceil_base_src, floor_base_src \
            < cexcl, fstart, ceil_ph, floor_ph, light, ceil_base, floor_base, y {
        hex.mov 2, cexcl, cexcl_src
        hex.mov 2, fstart, fstart_src
        hex.mov 8, ceil_ph, ceil_ph_src
        hex.mov 8, floor_ph, floor_ph_src
        hex.mov 2, light, plight_src
        hex.mov 2, ceil_base, ceil_base_src
        hex.mov 2, floor_base, floor_base_src
        hex.zero 2, y                                // reset the pass-2 trampoline row counter for this column
    }

    // the SHARED plane-select body (M13c3), emitted ONCE at the global label `plane_compare:` and JUMPED INTO
    // by every plane_tramp (the M12oo trampoline pattern). From the runtime row y + the column's clipped region
    // bounds, decide FLOOR (y >= fstart) / CEILING (y < cexcl) / SKIP (a wall row, already painted by pass 2a).
    // Floor is checked FIRST so it wins the off-screen overlap (oracle _render_planes_flat fills ceiling THEN
    // floor). On a plane row it loads that plane's (planeheight, pbase) into the shared regs plane.draw_pixel
    // reads, then falls to render (redirect ret_reg -> ret+dw); a wall row jumps *ret_reg (the skip op). The
    // body never falls through (every path jumps ret_reg), so it is safe after stl.loop. @requires hex.init.
    def plane_compare_body @ ck_ceil, do_floor, do_ceil, render \
            < y, cexcl, fstart, planeheight, pbase, ceil_ph, floor_ph, ceil_base, floor_base, ret_reg {
        hex.cmp 2, y, fstart, ck_ceil, do_floor, do_floor   // y >= fstart -> floor
      ck_ceil:
        hex.cmp 2, y, cexcl, do_ceil, ret_reg, ret_reg      // y < cexcl -> ceiling; else SKIP (jump *ret_reg)
      do_floor:
        hex.mov 8, planeheight, floor_ph
        hex.mov 2, pbase, floor_base
        ;render
      do_ceil:
        hex.mov 8, planeheight, ceil_ph
        hex.mov 2, pbase, ceil_base
      render:
        ret_reg + w + (#dw - 1) ; ret_reg                   // redirect ret -> ret+dw, jump it (render)
    }

    // PASS-2 PLANE trampoline (M13c3) — the floor/ceiling analog of pixel_tramp. Per (column,row): redirect
    // ret_reg to this pixel's `ret`, jump the shared plane_compare (decides floor/ceiling/skip + loads the
    // plane's planeheight/pbase). On skip ret_reg returns to `ret` (render nothing — the cell keeps the wall
    // pixel or stays zero); on a plane row plane_compare redirects ret_reg to `ret+dw` (render): fcall
    // plane_leaf (plane.draw_pixel -> lit), xor lit into the cell. The plane pass runs AFTER the wall pass, and
    // plane rows are disjoint from wall rows, so plane cells are still zero -> xor = set (no overwrite needed).
    // ret_reg self-cleans; y advances at the end. Globals: ret_reg, plane_compare, lit, plane_ret, plane_leaf,
    // y. @requires hex.init.
    def plane_tramp fbcell @ ret, end < ret_reg, plane_compare, lit, plane_ret, plane_leaf, y {
        wflip ret_reg + w, ret, plane_compare     // ret_reg -> this pixel's `ret`; jump the shared plane_compare
        pad 2                                     // align `ret` to 2*dw so the redirect-bit flip is carry-free
      ret:
        ; end                                     // SKIP target (op at ret): render nothing, fall to `end`
        ret_reg + w + (#dw - 1) ;                 // RENDER target (op at ret+dw): un-redirect ret_reg (self-clean)
        stl.fcall plane_leaf, plane_ret           // plane.draw_pixel: distance-lit flat pixel -> lit
        hex.xor_zero 2, fbcell, lit
      end:
        wflip ret_reg + w, ret                    // clear ret_reg back to 0 (xor `ret` out)
        hex.inc 2, y                              // advance the row
    }

    // PASS-1 per-SEG shared leaf, MULTI-TEXTURE + MULTI-LIGHT + WIDE-INDEX + PLANES (M13c3) —
    // seg_pass1_leaf_body_mtlw plus the per-column FLOOR/CEILING visplane params. After clipping each column's
    // wall span [top,bottom], it records the plane regions (oracle: ceiling rows y < cexcl = min(top,VIEW_H),
    // floor rows y >= fstart = max(bottom+1,0)) and the per-seg plane shading consts: the ceil/floor
    // planeheight cph/fph = |(plane_z<<16) - viewz| (computed ONCE per seg from the PURE baked seg_ceil/
    // seg_floor + the runtime player eye viewz), the RAW sector light seg_plight, and the ceil/floor flat SLICE
    // offset seg_ceilbase/seg_floorbase (into the combined flat table; M13d2 textured). Stored alongside the wall fields (same x*8 stride),
    // for the pass-2 load_col_plane + plane_tramp fill. The wall path is byte-identical to _mtlw (incl. the
    // off-screen top=1/bottom=0 sentinel). viewh = VIEW_H (compile-time). @requires hex.init & stl.ptr_init.
    def seg_pass1_leaf_body_mtlwp centery, ds, viewh1, viewh, projection \
            @ loop, body, skipcol, ret, sidx, tbskip, tbok, cge, cdone, fneg, fdone, cVH, cexcl, fstart, cph, fph, work, sfull, occscan, occchk, occnext, occdone, occproc \
            < viewx, viewy, viewxa, viewxs, viewya, viewys, sgn_aff, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_segangle, seg_a, seg_b, seg_c, seg_texoff, \
              seg_texbase, seg_texheight, seg_tw, seg_hm, seg_light, ceilfix, floorfix, viewz, viewzw, seg_ceil, seg_floor, worldtop, \
              seg_plight, seg_ceilbase, seg_floorbase, \
              visible, x1, x2, rwa, normalangle, rw_distance, scale, scalestep, rw_offset, rw_centerangle, x, \
              top, bottom, texcol, cfrac0, stepv, base, \
              col_top, col_bottom, col_base, col_step, col_frac0, col_heightmask, col_light, \
              col_cexcl, col_fstart, col_ceil_ph, col_floor_ph, col_plight, col_ceilbase, col_floorbase, drawn, seg_ret, \
              full, n_drawn, vieww {
        hex.if0 1, full, work                   // M13opt-P1: screen already full (all VIEW_W cols claimed) -> this
        stl.fret seg_ret                         // seg (and every later, farther seg) paints nothing. Byte-exact:
      work:                                      // front-to-back drawn[] means its cols are all occluded already.
        proj.wall_x_range visible, x1, x2, rwa, sgn_aff, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c
        hex.if0 1, visible, ret
        hex.mov 8, x, x1                          // M13opt-P1 occlusion pre-scan: if EVERY column in [x1,x2) is
      occscan:                                    // already claimed by a nearer seg, this seg paints nothing ->
        hex.scmp 8, x, x2, occchk, occdone, occdone   // skip its projection. x<x2 ? test : scanned-all-drawn -> skip
      occchk:
        .skip_if_drawn x, drawn, occnext          // drawn[x]!=0 -> keep scanning; ==0 -> an unclaimed col exists
        ;occproc                                  // found an unclaimed column -> must render this seg
      occnext:
        hex.inc 8, x
        ;occscan
      occdone:
        stl.fret seg_ret                          // fully occluded (every col in range drawn) -> byte-exact skip
      occproc:
        proj.wall_setup_sgn normalangle, rw_distance, sgn_aff, seg_segangle   // M13-absmul: sgn from wall_x_range
        proj.wall_scale_setup scale, scalestep, viewangle, normalangle, rw_distance, x1, x2, projection
        proj.wall_offset rw_offset, rw_centerangle, viewx, viewy, viewangle, normalangle, rwa, seg_v1x, seg_v1y, seg_texoff
        hex.mov 8, worldtop, seg_ceil           // worldtop = seg_ceil - viewzw (M12pp; seg_ceil baked PURE)
        hex.sub 8, worldtop, viewzw
        hex.mov 8, cph, seg_ceil                // cph = |(ceil_h<<16) - viewz| (16.16), computed ONCE per seg
        hex.shl_hex 8, 4, cph
        hex.sub 8, cph, viewz
        hex.abs 8, cph
        hex.mov 8, fph, seg_floor               // fph = |(floor_h<<16) - viewz|
        hex.shl_hex 8, 4, fph
        hex.sub 8, fph, viewz
        hex.abs 8, fph
        hex.mov 8, x, x1
      loop:
        hex.scmp 8, x, x2, body, ret, ret
      body:
        .skip_if_drawn x, drawn, skipcol
        proj.column_render_params top, bottom, texcol, cfrac0, stepv, scale, rw_centerangle, rw_offset, rw_distance, x, seg_tw, ceilfix, floorfix, viewz, worldtop, centery, ds, viewh1
        hex.set 8, cVH, viewh                   // cexcl = min(top, VIEW_H)  (top is the clipped >=0 row)
        hex.mov 8, cexcl, top
        hex.scmp 8, top, cVH, cdone, cge, cge   // top < VIEW_H -> keep top; else clamp to VIEW_H
      cge:
        hex.mov 8, cexcl, cVH
      cdone:
        hex.mov 8, fstart, bottom               // fstart = max(bottom+1, 0)
        hex.inc 8, fstart
        hex.sign 8, fstart, fneg, fdone         // (bottom+1) < 0 -> 0
      fneg:
        hex.zero 8, fstart
      fdone:
        hex.scmp 8, top, bottom, tbok, tbok, tbskip   // off-screen wall (top>bottom) -> the skip sentinel
      tbskip:
        hex.set 8, top, 1
        hex.zero 8, bottom
      tbok:
        hex.zero 5, base
        hex.mul 4, base, texcol, seg_texheight
        hex.add 5, base, seg_texbase
        hex.mov w/4, sidx, x
        hex.shl_bit w/4, sidx
        hex.shl_bit w/4, sidx
        hex.shl_bit w/4, sidx                   // sidx = x*8 (the uniform WIDE 8-nibble array stride)
        .store_col_field col_top, sidx, top
        .store_col_field col_bottom, sidx, bottom
        .store_col_field5 col_base, sidx, base
        .store_col_field col_step, sidx, stepv
        .store_col_field col_frac0, sidx, cfrac0
        .store_col_field col_heightmask, sidx, seg_hm
        .store_col_field col_light, sidx, seg_light
        .store_col_field col_cexcl, sidx, cexcl
        .store_col_field col_fstart, sidx, fstart
        .store_col_field8 col_ceil_ph, sidx, cph
        .store_col_field8 col_floor_ph, sidx, fph
        .store_col_field col_plight, sidx, seg_plight
        .store_col_field5 col_ceilbase, sidx, seg_ceilbase   // M13d2: 5-nibble flat SLICE offset (combined
        .store_col_field5 col_floorbase, sidx, seg_floorbase //   flat table, ~151k texels for E1M1 -> idx_n=5)
        .mark_drawn x, drawn
        hex.inc 2, n_drawn                       // M13opt-P1: count this newly-claimed column (mark_drawn only
        hex.cmp 2, n_drawn, vieww, skipcol, sfull, skipcol   // runs on a NEW claim) -> when all VIEW_W claimed, full=1
      sfull:
        hex.set 1, full, 1
      skipcol:
        hex.inc 8, x
        hex.add 8, scale, scalestep
        ;loop
      ret:
        stl.fret seg_ret
      sidx: hex.vec w/4
      cVH: hex.vec 8
      cexcl: hex.vec 8
      fstart: hex.vec 8
      cph: hex.vec 8
      fph: hex.vec 8
    }

    // M13pS2c — seg_pass1_leaf_body_mtlwp PLUS the per-column ceiling/floor BAND LIST construction (the
    // column-stream design's LS2 producer): identical wall-clip logic, but ALSO calls `plane.build_bands`
    // twice per claimed column (ceiling window [0,cexcl), ascending; floor window [fstart,viewh),
    // descending), storing the packed-byte results in `col_ceil_bands`/`col_floor_bands` (each column's
    // own `band_stride`-byte slice) + the entry counts `col_ceil_n`/`col_floor_n`, and stores the W1
    // wall's fully-baked lit byte `seg_lit` (a pure per-seg constant, computed at Python emit time — no
    // runtime colormap lookup) into `col_lit`. `band_stride` = MAX_BANDS*3 (compile-time, the Python
    // emitter's BAND_STRIDE). NOTHING here changes the wall/pass-1 fields above — this is additive-only,
    // a separate leaf so the existing `_mtlwp` (framebuffer raster_mode) is untouched. @requires
    // hex.init & stl.ptr_init.
    def seg_pass1_leaf_body_stream centery, viewh1, viewh, projection, band_stride \
            @ loop, body, notdrawn, skipcol, ret, sidx, cptr, cbase, dval, one, cge, cdone, fneg, fdone, cVH, cexcl, \
              fstart, cph, fph, nacc, nadv, vpp, vpb, cbufaddr, fbufaddr, \
              cbuild, cbuilt, fbuild, fbuilt, \
              work, sfull, occscan, occchk, occdone, occproc \
            < viewx, viewy, viewxa, viewxs, viewya, viewys, sgn_aff, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_segangle, seg_a, seg_b, seg_c, \
              ceilfix, floorfix, viewz, seg_ceil, seg_floor, \
              seg_plight, seg_ceilbase, seg_floorbase, seg_lit, seg_cvpidx, seg_fvpidx, \
              visible, x1, x2, rwa, normalangle, rw_distance, scale, scalestep, x, \
              top, bottom, \
              col_struct, \
              vpc_bufs, vpf_bufs, vpc_flags, vpf_flags, seg_ret, \
              full, n_drawn, vieww, \
              bb_ph, bb_light, bb_base, bb_y0, bb_count, bb_ascending, bb_arr, bb_n, build_bands_leaf, \
              plane_band_ret {
        hex.if0 1, full, work                   // M13opt-P1: screen already full (all VIEW_W cols claimed) -> this
        stl.fret seg_ret                         // seg (and every later, farther seg) paints nothing. Byte-exact:
      work:                                      // front-to-back drawn[] means its cols are all occluded already.
        proj.wall_x_range visible, x1, x2, rwa, sgn_aff, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c
        hex.if0 1, visible, ret
        // M13-colstruct: the per-column fields (drawn,cexcl,fstart,lit,cvp,fvp) live PACKED in ONE
        // combined byte struct (col_struct, stride 11 dw/column: 1 packed byte for drawn + 5 fields x
        // 2-nibble-vec each -- byte.emit's dispatch needs a 2-NIBBLE-VEC cell, not a packed byte, see
        // the write-chain comment below). ptr_index (cost scales with the address width, R20) runs
        // ONCE per seg to aim at column x1; every column after that is a cheap ptr_add/read_byte/
        // write_hex_and_inc walk, not a fresh per-field dereference.
        hex.mov 8, x, x1                          // M13opt-P1 occlusion pre-scan: if EVERY column in [x1,x2) is
        hex.mul_const w/4, sidx, x1, 11           // already claimed by a nearer seg, this seg paints nothing ->
        hex.set w/4, cbase, col_struct            // skip its projection. x<x2 ? test : scanned-all-drawn -> skip
        hex.ptr_index cptr, cbase, sidx           // cptr -> &col_struct[x1].drawn
      occscan:
        hex.scmp 8, x, x2, occchk, occdone, occdone
      occchk:
        hex.read_byte dval, cptr                  // dval = drawn[x] (packed byte, no ptr_index)
        hex.if0 2, dval, occproc                  // ==0 -> an unclaimed column exists -> must render this seg
        hex.ptr_add cptr, 11                      // claimed -> advance to the next column's slot, keep scanning
        hex.inc 8, x
        ;occscan
      occdone:
        stl.fret seg_ret                          // fully occluded (every col in range drawn) -> byte-exact skip
      occproc:
        proj.wall_setup_sgn normalangle, rw_distance, sgn_aff, seg_segangle   // M13-absmul: sgn from wall_x_range
        proj.wall_scale_setup scale, scalestep, viewangle, normalangle, rw_distance, x1, x2, projection
        // pG3-stream: wall_offset (texture-u inputs) + worldtop (the DDA texturemid) are DEAD here
        hex.mov 8, cph, seg_ceil                // cph = |(ceil_h<<16) - viewz| (16.16), computed ONCE per seg
        hex.shl_hex 8, 4, cph
        hex.sub 8, cph, viewz
        hex.abs 8, cph
        hex.mov 8, fph, seg_floor               // fph = |(floor_h<<16) - viewz|
        hex.shl_hex 8, 4, fph
        hex.sub 8, fph, viewz
        hex.abs 8, fph

        // M13pS2-crush2b: build this seg's CEILING/FLOOR visplane FULL-RANGE band lists ONCE per
        // frame (per-vp built-flags, cleared each frame) -- every column the plane covers slices the
        // SHARED list at emit time (prefix/suffix), mirroring the oracle's shared full-range walk.
        // The full range always straddles the horizon, so each list is exactly TWO build_bands calls
        // with COMPILE-TIME window constants ([0,centery) ascending + [centery,viewh) descending).
        // Buffer layout: slot 0 = the entry count n (one packed byte), entries from slot 1.
        hex.mul_const w/4, cbufaddr, seg_cvpidx, (1+band_stride)*dw
        hex.set w/4, vpp, vpc_bufs                // (add_constant can't take a LABEL: its rep count
        hex.add w/4, cbufaddr, vpp                //  needs the value at macro-resolve time)
        hex.mul_const w/4, vpp, seg_cvpidx, dw
        hex.set w/4, nadv, vpc_flags
        hex.add w/4, vpp, nadv
        hex.read_hex 1, vpb, vpp
        hex.if0 1, vpb, cbuild
        ;cbuilt
      cbuild:
        hex.mov 8, bb_ph, cph
        hex.mov 2, bb_light, seg_plight
        hex.mov 2, bb_base, seg_ceilbase
        hex.mov w/4, bb_arr, cbufaddr
        hex.add_constant w/4, bb_arr, dw          // entries start at slot 1
        hex.set 2, bb_y0, 0
        hex.set 2, bb_count, centery
        hex.set 2, bb_ascending, 1
        stl.fcall build_bands_leaf, plane_band_ret
        hex.zero w/4, nacc
        hex.mov 2, nacc, bb_n
        hex.mul_const w/4, nadv, nacc, 3*dw
        hex.add w/4, bb_arr, nadv
        hex.set 2, bb_y0, centery
        hex.set 2, bb_count, viewh - centery
        hex.zero 2, bb_ascending
        stl.fcall build_bands_leaf, plane_band_ret
        hex.add 2, bb_n, nacc                     // total entries (<= 64, fits one byte)
        hex.write_byte cbufaddr, bb_n
        hex.set 1, vpb, 1
        hex.write_hex 1, vpp, vpb                 // built
      cbuilt:
        hex.mul_const w/4, fbufaddr, seg_fvpidx, (1+band_stride)*dw
        hex.set w/4, vpp, vpf_bufs
        hex.add w/4, fbufaddr, vpp
        hex.mul_const w/4, vpp, seg_fvpidx, dw
        hex.set w/4, nadv, vpf_flags
        hex.add w/4, vpp, nadv
        hex.read_hex 1, vpb, vpp
        hex.if0 1, vpb, fbuild
        ;fbuilt
      fbuild:
        hex.mov 8, bb_ph, fph
        hex.mov 2, bb_light, seg_plight
        hex.mov 2, bb_base, seg_floorbase
        hex.mov w/4, bb_arr, fbufaddr
        hex.add_constant w/4, bb_arr, dw
        hex.set 2, bb_y0, 0
        hex.set 2, bb_count, centery
        hex.set 2, bb_ascending, 1
        stl.fcall build_bands_leaf, plane_band_ret
        hex.zero w/4, nacc
        hex.mov 2, nacc, bb_n
        hex.mul_const w/4, nadv, nacc, 3*dw
        hex.add w/4, bb_arr, nadv
        hex.set 2, bb_y0, centery
        hex.set 2, bb_count, viewh - centery
        hex.zero 2, bb_ascending
        stl.fcall build_bands_leaf, plane_band_ret
        hex.add 2, bb_n, nacc
        hex.write_byte fbufaddr, bb_n
        hex.set 1, vpb, 1
        hex.write_hex 1, vpp, vpb
      fbuilt:
        hex.mov 8, x, x1
        hex.mul_const w/4, sidx, x1, 11
        hex.set w/4, cbase, col_struct
        hex.ptr_index cptr, cbase, sidx           // cptr -> &col_struct[x1].drawn (ONE ptr_index for the whole seg)
        hex.set 2, one, 1                         // the drawn=1 constant, hoisted out of the per-column loop
      loop:
        hex.scmp 8, x, x2, body, ret, ret
      body:
        hex.read_byte dval, cptr                  // peek drawn[x] (a lone packed byte -- never emit'd, so it
        hex.if0 2, dval, notdrawn                 // doesn't need byte.emit's 2-nibble-vec layout, see below)
        hex.ptr_add cptr, 11                      // already claimed -> advance past this column's slot
        ;skipcol
      notdrawn:
        proj.column_render_params_stream top, bottom, scale, ceilfix, floorfix, viewz, centery, viewh1
        hex.set 8, cVH, viewh                   // cexcl = min(top, VIEW_H)  (top is the clipped >=0 row)
        hex.mov 8, cexcl, top
        hex.scmp 8, top, cVH, cdone, cge, cge   // top < VIEW_H -> keep top; else clamp to VIEW_H
      cge:
        hex.mov 8, cexcl, cVH
      cdone:
        hex.mov 8, fstart, bottom               // fstart = max(bottom+1, 0)
        hex.inc 8, fstart
        hex.sign 8, fstart, fneg, fdone         // (bottom+1) < 0 -> 0
      fneg:
        hex.zero 8, fstart
      fdone:
        // M13-colstruct: one sequential write chain through the held pointer -- drawn (ONE packed byte,
        // internal-only) then 5 fields each as a 2-NIBBLE-VEC pair (cexcl,fstart,lit,cvp,fvp) -- the
        // emit side (present_tail's byte.emit) reads its cell as idx/idx+1*dw, i.e. TWO SEPARATE NIBBLE
        // dw-slots, not one packed byte, so every emit'd field must keep that layout (byte.emit doesn't
        // dereference through a register; it XORs the two nibble ADDRESSES straight into the dispatch
        // op, so the addresses it's given must actually hold nibble-vec data). No per-field
        // ptr_index/hex.set-array-base either way; cptr ends exactly at the NEXT column's slot
        // (11 dw advanced == the struct stride), so `skipcol` needs no extra pointer work
        // for this path. col_fvp's 0xF,0xF init (0xFF, the struct's offset 9-10) is the UNCLAIMED
        // sentinel; the device does the per-column prefix/suffix clipping via cvp/fvp.
        hex.write_byte_and_inc cptr, one          // drawn = 1 (packed byte)
        hex.write_hex_and_inc cptr, cexcl
        hex.write_hex_and_inc cptr, cexcl + 1*dw
        hex.write_hex_and_inc cptr, fstart
        hex.write_hex_and_inc cptr, fstart + 1*dw
        hex.write_hex_and_inc cptr, seg_lit        // the W1 wall's fully-baked constant lit byte
        hex.write_hex_and_inc cptr, seg_lit + 1*dw
        hex.write_hex_and_inc cptr, seg_cvpidx
        hex.write_hex_and_inc cptr, seg_cvpidx + 1*dw
        hex.write_hex_and_inc cptr, seg_fvpidx
        hex.write_hex_and_inc cptr, seg_fvpidx + 1*dw
        hex.inc 2, n_drawn                       // M13opt-P1: count this newly-claimed column (only
        hex.cmp 2, n_drawn, vieww, skipcol, sfull, skipcol   // runs on a NEW claim) -> when all VIEW_W claimed, full=1
      sfull:
        hex.set 1, full, 1
      skipcol:
        hex.inc 8, x
        hex.add 8, scale, scalestep
        ;loop
      ret:
        stl.fret seg_ret
      sidx: hex.vec w/4
      cptr: hex.vec w/4
      cbase: hex.vec w/4
      dval: hex.vec 2
      one: hex.vec 2
      cVH: hex.vec 8
      cexcl: hex.vec 8
      fstart: hex.vec 8
      cph: hex.vec 8
      fph: hex.vec 8
      nacc: hex.vec w/4
      nadv: hex.vec w/4
      vpp: hex.vec w/4
      vpb: hex.vec 1
      cbufaddr: hex.vec w/4
      fbufaddr: hex.vec w/4
    }

    // M13-raster — the DEVICE RASTERIZER leaf body: fj stays the "brain" (BSP walk, visibility/
    // occlusion DECISIONS, per-seg projection setup); the device does the per-column wall DDA, the
    // first-writer-wins fill, and the distance-light shading. build_bands, column_render_params_stream
    // and the 11-field col_struct writes are ALL GONE, replaced by two small emitted records: one per
    // NEWLY-referenced visplane ([0xFE/0xFD tag][vp_idx][planeheight:4][light][base] — vp_idx/light/
    // base are the SAME per-seg xorby-baked runtime registers seg_cvpidx/seg_fvpidx/seg_plight/
    // seg_ceilbase/seg_floorbase already carry today, just byte.emit'd instead of stored; only the
    // tag is a true compile-time literal since this leaf is SHARED/fcall'd, not unrolled per seg) and
    // one per surviving seg ([x1][x2][scale1:4][scalestep:4][wt_ceil:4 signed][wt_floor:4 signed]
    // [lit][cvp_idx][fvp_idx]). `drawn` is a lone packed byte per column (colstruct-style: ONE
    // ptr_index per seg to aim at column x1, then ptr_add per column) so the walk's until-full early-
    // abort and the "skip a fully-occluded seg's emit" optimization both survive; the DEVICE
    // separately tracks its own per-column painted[] to do the fine-grained first-wins fill within a
    // seg's range (fj only coarsely pre-scans "does ANY unclaimed column exist"). vpc_flags/vpf_flags
    // are the existing per-visplane "already emitted this frame" flags (same access pattern as
    // seg_pass1_leaf_body_stream's build-once check). wt_ceil/wt_floor stay SIGNED throughout (cph/
    // fph hold the separate |wt| copies for the visplane record, so the seg record's own wt_ceil/
    // wt_floor emit is never clobbered). Verified byte-exact against the oracle over a broad random-
    // viewpoint sweep (scratchpad/proto_device_rasterizer.py + scratchpad/verify_stream_screen_
    // raster.py) before this macro was written. @requires hex.init & stl.ptr_init.
    def seg_pass1_leaf_body_raster projection \
            @ ret, dptr, dbase, dval, \
              wtc, wtf, cph, fph, \
              work, wok, occscan, occchk, occdone, occproc, \
              cvpp, cnadv, cvpb, cbuild, cbuilt, fvpp, fnadv, fvpb, fbuild, fbuilt, \
              mloop, mbody, mnext, msfull, mnext2 \
            < viewx, viewy, viewxa, viewxs, viewya, viewys, sgn_aff, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_segangle, seg_a, seg_b, seg_c, \
              viewz, seg_ceil, seg_floor, seg_plight, seg_ceilbase, seg_floorbase, seg_lit, \
              seg_cvpidx, seg_fvpidx, \
              visible, x1, x2, rwa, normalangle, rw_distance, scale, scalestep, x, \
              drawn, vpc_flags, vpf_flags, seg_ret, full, n_drawn, vieww, \
              wrej, wqa, wna, wqb, wnb, wex, wey, weyx, wexy {
        hex.if0 1, full, work                   // M13opt-P1: screen already full -> paint nothing
        stl.fret seg_ret
      work:
        // M13-wedge: the multiply-free conservative FOV pre-cull, BEFORE the affine back-face test
        // (2 fixed_mul) and the two atans. Byte-exact -- the wedge strictly contains the FOV, so a
        // seg it rejects contributes no pixel. Measured at spawn: 173/432 segs never reach the mul.
        proj.wedge_reject wrej, seg_v1x, seg_v1y, seg_v2x, seg_v2y, wqa, wna, wqb, wnb, wex, wey, weyx, wexy
        hex.if0 1, wrej, wok
        stl.fret seg_ret
      wok:
        proj.wall_x_range visible, x1, x2, rwa, sgn_aff, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c
        hex.if0 1, visible, ret
        hex.mov 8, x, x1
        hex.set w/4, dbase, drawn
        hex.ptr_index dptr, dbase, x1              // dptr -> &drawn[x1] (1 packed byte/column, stride 1)
      occscan:
        hex.scmp 8, x, x2, occchk, occdone, occdone
      occchk:
        hex.read_byte dval, dptr                   // peek drawn[x] (no advance)
        hex.if0 2, dval, occproc                   // ==0 -> an unclaimed column exists -> must emit this seg
        hex.ptr_add dptr, 1                        // claimed -> advance, keep scanning
        hex.inc 8, x
        ;occscan
      occdone:
        stl.fret seg_ret                           // fully occluded -> byte-exact skip (no emit at all)
      occproc:
        proj.wall_setup_sgn normalangle, rw_distance, sgn_aff, seg_segangle   // M13-absmul: sgn from wall_x_range
        proj.wall_scale_setup scale, scalestep, viewangle, normalangle, rw_distance, x1, x2, projection
        hex.mov 8, wtc, seg_ceil                   // wt_ceil = (ceil_h<<16) - viewz   (SIGNED -- the
        hex.shl_hex 8, 4, wtc                      // device's own DDA needs the true signed value;
        hex.sub 8, wtc, viewz                      // never overwritten again below)
        hex.mov 8, wtf, seg_floor                  // wt_floor = (floor_h<<16) - viewz
        hex.shl_hex 8, 4, wtf
        hex.sub 8, wtf, viewz

        // ceiling visplane: emit [0xFE][vp_idx][planeheight:4][light][base] on first reference this
        // frame. planeheight = |wt_ceil|, computed into the SEPARATE cph register (wtc itself stays
        // signed for the seg record emitted further down).
        hex.mul_const w/4, cnadv, seg_cvpidx, dw
        hex.set w/4, cvpp, vpc_flags
        hex.add w/4, cvpp, cnadv
        hex.read_hex 1, cvpb, cvpp
        hex.if0 1, cvpb, cbuild
        ;cbuilt
      cbuild:
        hex.mov 8, cph, wtc
        hex.abs 8, cph
        stl.output_char 0xFE
        byte.emit seg_cvpidx
        stream.emit_bytes4 cph
        byte.emit seg_plight
        byte.emit seg_ceilbase
        hex.set 1, cvpb, 1
        hex.write_hex 1, cvpp, cvpb
      cbuilt:
        hex.mul_const w/4, fnadv, seg_fvpidx, dw
        hex.set w/4, fvpp, vpf_flags
        hex.add w/4, fvpp, fnadv
        hex.read_hex 1, fvpb, fvpp
        hex.if0 1, fvpb, fbuild
        ;fbuilt
      fbuild:
        hex.mov 8, fph, wtf
        hex.abs 8, fph
        stl.output_char 0xFD
        byte.emit seg_fvpidx
        stream.emit_bytes4 fph
        byte.emit seg_plight
        byte.emit seg_floorbase
        hex.set 1, fvpb, 1
        hex.write_hex 1, fvpp, fvpb
      fbuilt:
        // the seg record: [x1][x2][scale1:4][scalestep:4][wt_ceil:4][wt_floor:4][lit][cvp_idx][fvp_idx]
        byte.emit x1
        byte.emit x2
        stream.emit_bytes4 scale
        stream.emit_bytes4 scalestep
        stream.emit_bytes4 wtc
        stream.emit_bytes4 wtf
        byte.emit seg_lit
        byte.emit seg_cvpidx
        byte.emit seg_fvpidx

        // mark [x1,x2) drawn (cheap: no DDA/clip/store — the device's own painted[] does the
        // fine-grained per-column fill decision) + count NEWLY-claimed columns toward the until-full
        // abort, exactly mirroring seg_pass1_leaf_body_stream's own bookkeeping. dptr must be
        // RE-AIMED at x1 here: the occlusion pre-scan above left it wherever it stopped (the first
        // unclaimed column found), not necessarily x1.
        hex.mov 8, x, x1
        hex.ptr_index dptr, dbase, x1
      mloop:
        hex.scmp 8, x, x2, mbody, ret, ret
      mbody:
        hex.read_byte dval, dptr
        hex.if0 2, dval, mnext
        hex.ptr_add dptr, 1
        hex.inc 8, x
        ;mloop
      mnext:
        hex.set 2, dval, 1
        hex.write_byte_and_inc dptr, dval
        hex.inc 2, n_drawn
        hex.cmp 2, n_drawn, vieww, mnext2, msfull, mnext2
      msfull:
        hex.set 1, full, 1
      mnext2:
        hex.inc 8, x
        ;mloop
      ret:
        stl.fret seg_ret
      dbase: hex.vec w/4
      dptr: hex.vec w/4
      dval: hex.vec 2
      wtc: hex.vec 8
      wtf: hex.vec 8
      cph: hex.vec 8
      fph: hex.vec 8
      cvpp: hex.vec w/4
      cnadv: hex.vec w/4
      cvpb: hex.vec 1
      fvpp: hex.vec w/4
      fnadv: hex.vec w/4
      fvpb: hex.vec 1
    }

    // M13-proj (Path B lab mode) — the PER-SEG leaf when the DEVICE does the vertex->column
    // projection. fj keeps every per-seg decision it can make from world coordinates alone: the
    // multiply-free wedge pre-cull, then the abs-form affine back-face cull. A survivor emits ONLY
    // its 2-byte compact seg id -- the device holds the seg's whole geometry row (0x0E DMA) and runs
    // wall_x_range/scale/DDA/fill/shade itself, first-writer-wins in walk order, so the pixels are
    // identical to the 0x0D raster mode by construction. No drawn[], no until-full accounting: fj
    // cannot know which columns the device claimed, so the walk always visits the full tree (the
    // ~4M full-walk baseline is the price of the offload). @requires hex.init & stl.ptr_init.
    def seg_pass1_leaf_body_proj \
            @ ret, chkz, work, pxad, pyad, sgnt \
            < viewxa, viewxs, viewya, viewys, \
              seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c, seg_sid, seg_ret, sgn_aff, \
              wrej, wqa, wna, wqb, wnb, wex, wey, weyx, wexy {
        proj.wedge_reject wrej, seg_v1x, seg_v1y, seg_v2x, seg_v2y, wqa, wna, wqb, wnb, wex, wey, weyx, wexy
        hex.if0 1, wrej, chkz
        stl.fret seg_ret
      chkz:
        hex.fixed_mul_lo 8, 4, sgn_aff, seg_a, viewxa   // the abs-form affine back-face cull
        hex.if0 1, viewxs, pxad
        hex.neg 8, sgn_aff
      pxad:
        hex.fixed_mul_lo 8, 4, sgnt, seg_b, viewya
        hex.if0 1, viewys, pyad
        hex.neg 8, sgnt
      pyad:
        hex.add 8, sgn_aff, sgnt
        hex.add 8, sgn_aff, seg_c
        hex.sign 8, sgn_aff, ret, work                  // sgn < 0 -> back-facing, cull
      work:
        hex.if0 8, sgn_aff, ret                         // sgn == 0 -> on the line, cull
        byte.emit seg_sid                               // the whole record: the 2-byte compact id
        byte.emit seg_sid + 2*dw
      ret:
        stl.fret seg_ret
      sgnt: hex.vec 8
    }

    // M13-lines — the DUMB-DEVICE leaf body: fj does EVERYTHING (projection, per-column clip,
    // occlusion, band boundaries, colours) and the device only paints explicit fillCol lines
    // ([x][y1][y2][colour], the 0x0A spans protocol). Structure = the stream leaf's front end
    // (wedge pre-cull + wall_x_range + occlusion pre-scan + wall_setup_sgn/wall_scale_setup + the
    // crush2b per-visplane shared band-list build) but NO col_struct and NO separate present pass:
    // each column is claimed AND emitted right here, at claim time, via stream.emit_col_lines
    // (walk order is front-to-back, each column claimed exactly once, so records never overlap and
    // the device needs no first-writer logic at all). `drawn` is the raster leaf's stride-1 packed
    // byte per column. @requires hex.init & stl.ptr_init
    // ── M13-2S rung 3a — the TWO-SIDED PLANE-CLAIM leaf ────────────────────────────────────────
    // A two-sided seg paints no wall in this tier, but it still BOUNDS the near floor/ceiling
    // SURFACE, and that is the owner's "the close floor in the middle is gray, yet the sides are
    // yellow" bug: the per-column plane record used to come from whichever one-sided (hence
    // distant) wall claimed the column, so one continuous floor was painted with several other
    // rooms' flat/height/light. Here the NEAREST MARKING seg attributes the column instead --
    // marking = the seg's two sides differ in the band-bank key (height, light, flat), DOOM's
    // R_StoreWallRange markfloor/markceiling test; segs equal on both sides are excluded at COMPILE
    // time and attributing those to either side is identical anyway.
    //
    // It writes ONLY the attribution state -- one byte per column, `pclm[x]` = the claiming seg's
    // PLANE-PAIR ID -- never `drawn`/`n_drawn`/`full`: the region EXTENTS still come from the
    // one-sided wall that closes the column. Once every column is attributed nothing later can
    // change anything, so it sets `tsstop` -- and the caller tests that BEFORE the xorby block,
    // which is what makes this affordable: at E1M1 spawn 59 marking two-sided segs are reached
    // before tsstop and 1386 after it (measured; walking all of them through this front end costs
    // +11.9M, over the ceiling -- see docs/handoff-m13-2s.md §4).
    // Returns via stl.fret seg_ret. @requires hex.init & stl.ptr_init
    // ── V4 THINGS — the RECORD half ─────────────────────────────────────────────────────────────
    // One thing, projected the moment the BSP walk arrives at its subsector, into WRITE-ONCE
    // per-column fragment slots. Front-to-back arrival is doing two jobs at once: it makes "the
    // first writer is the nearest" true, and it IS the occlusion test -- a wall nearer than the
    // thing has already claimed the column, so the thing simply cannot record there. That is what
    // lets a write-once, forward-only column protocol show sprites at all; DOOM draws them last,
    // back-to-front, and this renderer cannot.
    //
    // Cost is one `hex.fixed_div` (~38.5k) plus a block-FP reciprocal and five multiplies per
    // thing, which is what THING_BUDGET bounds. Both of the oracle's stop conditions are monotone,
    // so `tstop` short-circuits every later thing at its call site for one 1-nibble test.
    // Mirrors ReferenceModel.render_wall_frame's things pre-pass EXACTLY.
    def thing_record_body budget, monbudget, minz, projection, centerx, centery, viewwc, viewh, ds, blkshift, \
            buckets, slotstride, ttwice, deg, dsofts, dsoftm, sprbminh, spn, lowh, nld, neartz \
            @ tgo, tgo2, tsce, tincs, tinced, tstopset, tret, tlx, tlxo, tclamp, thxo, tloop, tbody, tuclamp, \
              tdsc, tdno, tdok, tbno, tbok, hdld, hdok, hcon, hmul, hmdone, \
              tfree, tfree2, tslota, tslotb, tblkok, tnext, \
              tsy1z, tsy1k, tsy1h, tsy2c, tsy2z, tsy2k0, tsy2h, tsy2k, tdraw, \
              tcap, vis, dvis, dtx1, dtx2, dtyt, dthp, dtis, tx1, tx2, tytop, thpx, tistep, tbkt, thb, ty0, tyb, tfrac, tu, tdwm, \
              tx, tdb, tdp, tdv, tfb, tfp, tfv, tbb, tbp, tblk, tbo, tcon, tidx, tlr, tr0, trl, trw, \
              tsy1, tsy2, tb8, tneg, tcvh, tsofs, tflagv, end \
            < n_thing, n_mon, full, tstop, drawn, sprflag, spslot, sprbank, sprlight, \
              sp_base, sp_dw, sp_lt, sp_mon, thing_ret, degfl, ballow, sp_base2, thfar, hdfl {
        // TWO budgets, and which one this thing spends is baked (`sp_mon`). Walk-arrival order is
        // NOT distance order, so one shared counter let 1-pixel bonus dots spend the frame's slots
        // while monsters were turned away (EXP-8a). A monster now has its own, deliberately loose
        // budget. ⚠ Failing a budget must NOT set `tstop` -- that latch stops EVERY later thing,
        // and the other category may still have slots. Only `full` latches now: a sprite records
        // into columns no WALL has drawn yet, so the correct monotone "nothing can land" signal
        // is all-columns-WALL-DRAWN -- NOT the plane-attribution counter. The old n_claimed==vieww
        // stop hid every monster in the room whenever a near marking seg finished the plane claim
        // before the walk reached them (the owner's (1329,1065) one-step vanish).
        hex.if0 2, sp_mon, tsce
        hex.set 2, tcap, monbudget
        hex.cmp 2, n_mon, tcap, tgo, tret, tret
      tsce:
        hex.set 2, tcap, budget
        hex.cmp 2, n_thing, tcap, tgo, tret, tret
      tgo:
        hex.if1 1, full, tstopset               // every column WALL-drawn -> no fragment can land
      tgo2:
        // 25M-CAP GRADUATED ACCEPTANCE: past the SOFT count for this thing's (baked) category the
        // min-size bar rises -- project_thing then rejects on the second baked depth bound
        // (sp_tzmax2). The walk is front-to-back, so what the raised bar drops is the far tail,
        // and a light frame never fills SOFT so it renders exactly as before.
        rep(deg, k) hex.set 1, degfl, 1
        rep(deg, k) hex.if0 2, sp_mon, tdsc
        rep(deg, k) hex.set 2, tcap, dsoftm
        rep(deg, k) hex.cmp 2, n_mon, tcap, tdno, tdok, tdok
      tdsc:
        rep(deg, k) hex.set 2, tcap, dsofts
        rep(deg, k) hex.cmp 2, n_thing, tcap, tdno, tdok, tdok
      tdno:
        rep(deg, k) hex.set 1, degfl, 0
      tdok:
        proj.project_thing vis, tx1, tx2, tytop, thpx, tistep, minz, projection, centerx, centery, viewwc, viewh, ds, deg, spn, neartz
        // ablate "thingtwice" (measurement only): the SAME projection, SAME operands, dead
        // outputs. Pricing by ADDING keeps the frame byte-exact -- a stub would price itself
        // plus everything downstream (fj-cost-model, the `noproj` retraction).
        rep(ttwice, k) proj.project_thing dvis, dtx1, dtx2, dtyt, dthp, dtis, minz, projection, centerx, centery, viewwc, viewh, ds, deg, spn, neartz
        hex.if0 1, vis, tret
        hex.if0 2, sp_mon, tincs                // ... and credit the counter this thing spends
        hex.inc 2, n_mon
        ;tinced
      tincs:
        hex.inc 2, n_thing
      tinced:
        // the height BUCKET, and the exact height it renders at -- one dispatch, [hb:2][bucket:2]
        sprbkt.lookup tbkt, thpx
        hex.zero w/4, tcon                      // the per-thing block base: sp_base + bucket,
        hex.mov 4, tcon, sp_base                // WIDENED first (a narrow add cannot carry out
        hex.zero w/4, tidx                      // of its own nibbles)
        hex.mov 2, tidx, tbkt
        hex.add w/4, tcon, tidx
        hex.zero 8, thb                         // ⚠ WIDENED: `hex.sub 8, dst, src` reads EIGHT
        hex.mov 2, thb, tbkt + 2*dw             // nibbles of src, so a 2-nibble register would
        hex.mov 8, ty0, tytop                   // drag its neighbours in as high nibbles.
        hex.add 8, ty0, thpx                    // FEET planted: the bucket moves the sprite's TOP
        hex.sub 8, ty0, thb
        // 25M-CAP B-GATE, hoisted per thing: slot B only for fragments whose bucket height
        // reaches sprbminh -- a smaller B fragment sits behind slot A and ~never shows, so the
        // per-column bank walk it would pay is invisible work. The slot stays OPEN for a later,
        // taller thing (the oracle's elif does the same).
        rep(deg, k) hex.set 1, ballow, 1
        rep(deg, k) hex.set 2, tcap, sprbminh
        rep(deg, k) hex.cmp 2, thb, tcap, tbno, tbok, tbok
      tbno:
        rep(deg, k) hex.set 1, ballow, 0
      tbok:
        // SPR-NEAR (spn): a thing both SHORT on screen (bucket < lowh) and beyond the
        // detail radius (thfar, set by project_thing) takes the packed COARSE region; near
        // things -- however small they project -- keep the main bank's full detail.
        rep(spn, k) hex.set 1, hdfl, 1
        rep(spn, k) hex.if0 1, thfar, hdok
        rep(spn, k) hex.set 2, tcap, lowh
        rep(spn, k) hex.cmp 2, thb, tcap, hdld, hdok, hdok
      hdld:
        rep(spn, k) hex.set 1, hdfl, 0
      hdok:
        // ... and the block base: the low buckets are a PREFIX, so the coarse index keeps
        // the same base+bucket shape with no offset
        rep(spn, k) hex.if1 1, hdfl, hcon
        rep(spn, k) hex.zero w/4, tcon
        rep(spn, k) hex.mov 4, tcon, sp_base2
        rep(spn, k) hex.zero w/4, tidx
        rep(spn, k) hex.mov 2, tidx, tbkt
        rep(spn, k) hex.add w/4, tcon, tidx
      hcon:
        // the shade row: (light, sprite height) class << 8 | bucket height, one baked byte
        hex.zero w/4, tidx
        hex.mov 2, tidx + 2*dw, sp_lt
        hex.mov 2, tidx, thb
        hex.set w/4, tbb, sprlight
        hex.ptr_index tbp, tbb, tidx
        hex.read_byte tlr, tbp
        // the column DDA: frac starts at (clamped x1 - x1) * istep, exactly as the oracle's does
        hex.mov 8, tx, tx1
        hex.zero 8, tfrac
        hex.sign 8, tx1, tlx, tlxo
      tlx:
        hex.zero 8, tx
        hex.mov 8, tneg, tx1
        hex.neg 8, tneg
        hex.mul_lo 8, tfrac, tneg, tistep
      tlxo:
        hex.set 8, tcvh, viewwc                 // x2 is INCLUSIVE, so clamp it to VIEW_W-1
        hex.dec 8, tcvh
        hex.scmp 8, tx2, tcvh, thxo, thxo, tclamp
      tclamp:
        hex.mov 8, tx2, tcvh
      thxo:
        hex.mov 2, tdwm, sp_dw
        hex.dec 2, tdwm                         // the last downscaled texture column
        hex.set w/4, tdb, drawn
        hex.ptr_index tdp, tdb, tx
        hex.set w/4, tfb, sprflag
        hex.ptr_index tfp, tfb, tx
      tloop:
        hex.cmp 2, tx, tx2, tbody, tbody, tret
      tbody:
        hex.mov 8, tu, tfrac                    // u = min(dw-1, frac >> 16)
        hex.shr_hex 8, 4, tu
        hex.cmp 2, tu, tdwm, tfree, tfree, tuclamp
      tuclamp:
        hex.mov 2, tu, tdwm
      tfree:
        hex.read_byte tdv, tdp
        hex.if0 2, tdv, tfree2                  // a nearer wall owns this column -> the thing is hidden
        ;tnext
      tfree2:
        hex.read_byte tfv, tfp
        hex.if0 2, tfv, tslota                  // no fragment yet -> slot A (offset 0, flag 1)
        // V4b: slot A taken -- take slot B (byte offset 8 of the same 16-byte slot, flag 2),
        // else both slots are spent and this thing is hidden here. Walk-arrival order makes
        // A the nearer fragment and B the one behind it, exactly like the oracle's sfrag2.
        hex.dec 2, tfv
        hex.if1 2, tfv, tnext                   // both slots spent -> the thing is hidden here
        rep(deg, k) hex.if0 1, ballow, tnext    // 25M-CAP: B only for tall-enough fragments
        ;tslotb
      tslota:
        hex.set w/4, tsofs, 0
        hex.set 2, tflagv, 1
        ;tblkok
      tslotb:
        hex.set w/4, tsofs, 8
        hex.set 2, tflagv, 2
      tblkok:
        // block = sp_base + u*buckets + bucket, at a POWER-OF-TWO stride so the address is a shift
        // blk = (base + bucket) + u*BUCKETS -- and (base + bucket) is a per-THING constant, so
        // only the `u*BUCKETS` term belongs in the column loop. `tcon` is that constant, hoisted.
        hex.zero w/4, tblk
        hex.mov 2, tblk, tu
        rep(spn, k) hex.if1 1, hdfl, hmul   // SPR-NEAR: the packed region strides nld
        rep(spn, k) hex.mul_const w/4, tblk, tblk, nld
        rep(spn, k) hex.if0 1, hdfl, hmdone
      hmul:
        hex.mul_const w/4, tblk, tblk, buckets
      hmdone:
        hex.add w/4, tblk, tcon
        // ⚠ `tblk` stays the RAW block INDEX -- that is what the slot stores and what the emit
        // shifts. Shifting it here as well double-multiplied the address by the stride AND
        // overflowed the slot's 4 nibbles, which read back as an all-zero block header and made
        // every column skip: the frame then differed from the oracle by EXACTLY its sprite pixels.
        hex.mov w/4, tbo, tblk
        rep(blkshift, k) hex.shl_bit w/4, tbo   // x SPR_BLOCK_STRIDE dw (a power of two)
        hex.set w/4, tbb, sprbank
        hex.ptr_index tbp, tbb, tbo
        hex.read_byte tr0, tbp                  // the block HEADER: first row, last row
        hex.ptr_add tbp, 1
        hex.read_byte trl, tbp
        hex.ptr_sub tbp, 1
        hex.if0 2, trl, tnext                   // a fully transparent sprite column
        // sy1 = max(y0 + r0, 0), sy2p1 = min(y0 + last_rel, VIEW_H); empty -> nothing to store
        // sy1 = clamp(y0 + r0, 0, VIEW_H), sy2p1 = clamp(y0 + last_rel, 0, VIEW_H).
        // ⚠ CLAMPED, never REJECTED: the oracle takes the column as soon as the sprite column has
        // any opaque texel, even when the projected run lands entirely off-screen -- and a taken
        // column is closed to every LATER thing. Rejecting here instead left the column claimable
        // and fj recorded fragments the oracle does not have. An empty [sy1, sy2) costs nothing at
        // emit: the two regions then cover the whole column and every sprite run skips or clamps.
        // ⚠ the baked run list is relative to r0 (the column's FIRST OPAQUE row), not to the
        // sprite's row 0 -- exactly as the oracle's fragment stores `ytop_b + st[0]` as its base.
        // Fold r0 in ONCE here, so the emit's `y0 + rel` is right and `sy1` is the same row.
        hex.zero 8, trw                         // ... widened: `hex.add 8` reads EIGHT nibbles
        hex.mov 2, trw, tr0
        hex.mov 8, tyb, ty0
        hex.add 8, tyb, trw
        hex.set 8, tcvh, viewh
        hex.mov 8, tsy1, tyb
        hex.sign 8, tsy1, tsy1z, tsy1k
      tsy1z:
        hex.zero 8, tsy1
      tsy1k:
        hex.scmp 8, tsy1, tcvh, tsy2c, tsy2c, tsy1h
      tsy1h:
        hex.mov 8, tsy1, tcvh
      tsy2c:
        hex.zero 8, trw
        hex.mov 2, trw, trl
        hex.mov 8, tsy2, tyb
        hex.add 8, tsy2, trw
        hex.sign 8, tsy2, tsy2z, tsy2k0
      tsy2z:
        hex.zero 8, tsy2
      tsy2k0:
        hex.scmp 8, tsy2, tcvh, tsy2k, tsy2k, tsy2h
      tsy2h:
        hex.mov 8, tsy2, tcvh
      tsy2k:
      tdraw:
        hex.mov 8, tb8, tyb                     // base + 32768, stored as TWO bytes: a tall NEAR
        hex.add_constant 8, tb8, 32768          // sprite's top can sit far above row -128, and the
                                                // old one-byte +128 bias WRAPPED there (M13-15M)
        hex.set w/4, tidx, 0
        hex.mov 2, tidx, tx
        rep(slotstride/16, k) hex.shl_hex w/4, 1, tidx   // a power-of-16 stride: whole-nibble shift
        hex.add w/4, tidx, tsofs                // V4b: slot B lives at byte offset 8
        hex.set w/4, tbb, spslot
        hex.ptr_index tbp, tbb, tidx
        hex.write_byte_and_inc tbp, tsy1
        hex.write_byte_and_inc tbp, tsy2
        hex.write_byte_and_inc tbp, tb8
        hex.write_byte_and_inc tbp, tb8 + 2*dw
        hex.write_byte_and_inc tbp, tblk
        hex.write_byte_and_inc tbp, tblk + 2*dw
        hex.write_byte_and_inc tbp, tlr
        hex.write_byte tfp, tflagv              // V4b: 1 = A only, 2 = A + B
      tnext:
        hex.ptr_add tdp, 1
        hex.ptr_add tfp, 1
        hex.inc 2, tx
        hex.add 8, tfrac, tistep
        ;tloop
      tstopset:
        hex.set 1, tstop, 1
      tret:
        stl.fret thing_ret
      tcap: hex.vec 2
      vis: hex.vec 1
      dvis: hex.vec 1
      dtx1: hex.vec 8
      dtx2: hex.vec 8
      dtyt: hex.vec 8
      dthp: hex.vec 8
      dtis: hex.vec 8
      tx1: hex.vec 8
      tx2: hex.vec 8
      tytop: hex.vec 8
      thpx: hex.vec 8
      tistep: hex.vec 8
      tbkt: hex.vec 4
      thb: hex.vec 8
      ty0: hex.vec 8
      tyb: hex.vec 8
      tfrac: hex.vec 8
      tu: hex.vec 8
      tdwm: hex.vec 2
      tx: hex.vec 8
      tdb: hex.vec w/4
      tdp: hex.vec w/4
      tdv: hex.vec 2
      tfb: hex.vec w/4
      tfp: hex.vec w/4
      tfv: hex.vec 2
      tbb: hex.vec w/4
      tbp: hex.vec w/4
      tblk: hex.vec w/4
      tcon: hex.vec w/4
      tbo: hex.vec w/4
      tidx: hex.vec w/4
      tlr: hex.vec 2
      tr0: hex.vec 2
      trl: hex.vec 2
      trw: hex.vec 8
      tsy1: hex.vec 8
      tsy2: hex.vec 8
      tb8: hex.vec 8
      tneg: hex.vec 8
      tcvh: hex.vec 8
      tsofs: hex.vec w/4                        // V4b: this claim's slot byte offset (0 = A, 8 = B)
      tflagv: hex.vec 2                         // ... and the flag it leaves (1 = A, 2 = A+B)
      end:
    }

    // ── V3 step faces — the RECORD half ────────────────────────────────────────────────────────
    // A two-sided boundary whose front ceiling is HIGHER (an upper face: a door lintel, a window
    // head) or whose back floor is HIGHER (a lower face: a stair riser, a ledge front) shows a
    // vertical strip of wall that this tier otherwise never draws -- without it a step you can walk
    // up is invisible, the floor just changes colour where it rises.
    //
    // The leaf this lives in had NO projection machinery at all (its inputs are geometry and claim
    // state), so this is a projection path ADDED to a claim walk, not a splice into an existing one.
    // Two things bound the cost. `STEP_SEG_BUDGET` gates the per-seg SETUP -- a face-carrying seg
    // pays a full ~93k wall_scale_setup_m, and at a heavy viewpoint every marking seg would
    // otherwise qualify. And the slots are WRITE-ONCE, which is what makes "nearest wins" free: the
    // walk is front-to-back, so the FIRST writer is the nearest.
    //
    // The scale is INTERPOLATED across the seg (one setup, then `+= scalestep` per column) exactly
    // as the wall path's is -- an exact per-column scale_from_global_angle is ~40k ops per COLUMN
    // against ~93k once per SEG. The oracle interpolates identically (ReferenceModel.render_wall_frame).
    // V5 -- the piece-2 monotone clamp: when this side already holds a piece (count nibble
    // `cnt` nonzero), the new piece's FIRST row clips past the STORED previous piece's end
    // byte (slot byte `off`+1), sentinels included -- exactly the oracle's stored-value clamp
    // (R6), so the two sides can never disagree about a clamped piece.
    def ts_clamp2 fra, cnt, fbp, off @ doclamp, noprev, fpy, fp1, end {
        hex.if0 1, cnt, noprev
        hex.ptr_add fbp, off+1
        hex.read_byte fpy, fbp
        hex.ptr_sub fbp, off+1
        hex.zero 8, fp1
        hex.mov 2, fp1, fpy
        hex.inc 8, fp1                          // stored prev y2 + 1 (sentinel bytes included)
        hex.scmp 8, fra, fp1, doclamp, noprev, noprev
      doclamp:
        hex.mov 8, fra, fp1
      noprev:
        ;end
      fpy: hex.vec 2
      fp1: hex.vec 8
      end:
    }

    // V5 -- the LOWER side's mirror: the new piece's LAST row clips past the stored previous
    // piece's start byte (slot byte `off`) -- b = min(b, prev_y1 - 1), sentinels included.
    def ts_clamp2_lo frb, cnt, fbp, off @ doclamp, noprev, fpy, fp1, end {
        hex.if0 1, cnt, noprev
        hex.ptr_add fbp, off
        hex.read_byte fpy, fbp
        hex.ptr_sub fbp, off
        hex.zero 8, fp1
        hex.mov 2, fp1, fpy
        hex.dec 8, fp1                          // stored prev y1 - 1
        hex.scmp 8, frb, fp1, noprev, noprev, doclamp
      doclamp:
        hex.mov 8, frb, fp1
      noprev:
        ;end
      fpy: hex.vec 2
      fp1: hex.vec 8
      end:
    }

    // V5 -- write one 4-byte piece [y1][y2][cls][bpid] at slot offset `off` + count*4, leaving
    // the slot pointer where it was. count (0 or 1) lives in the flag cell `cnt`.
    def ts_piece_wr cnt, fbp, off, fy1, fy2, cls, bpid @ wr0, end {
        hex.if0 1, cnt, wr0
        hex.ptr_add fbp, off+4
        hex.write_byte_and_inc fbp, fy1
        hex.write_byte_and_inc fbp, fy2
        hex.write_byte_and_inc fbp, cls
        hex.write_byte_and_inc fbp, bpid
        hex.ptr_sub fbp, off+8
        ;end
      wr0:
        hex.ptr_add fbp, off
        hex.write_byte_and_inc fbp, fy1
        hex.write_byte_and_inc fbp, fy2
        hex.write_byte_and_inc fbp, cls
        hex.write_byte_and_inc fbp, bpid
        hex.ptr_sub fbp, off+4
        ;end
      end:
    }

    // OPTION A (dda) -- the step-face frac DDA. rowfrac = centeryfix - wt*scale accumulates
    // mod 2^32 with NO shift (the mapmul identity step_rows itself relies on), so stepping the
    // frac by -wt*scalestep per column reproduces the per-column product BIT FOR BIT: this is
    // pure ops savings, never a pixel change. Setup runs once per face seg (4 bases + 4 steps);
    // the steps use 8 schoolbook rows because a negative scalestep is dense in two's complement.
    def ts_dda_setup fscale, fsstep, fwu1, fwu2, fwl1, fwl2, ccy_c, fru1, fru2, frl1, frl2, stu1, stu2, stl1, stl2 \
            @ ccyf, end {
        hex.set 8, ccyf, ccy_c
        hex.zero 8, fru1
        rep(6, j) hex.fixed_mul_lo.row 8, j, fru1, fwu1, fscale
        hex.neg 8, fru1
        hex.add 8, fru1, ccyf
        hex.zero 8, fru2
        rep(6, j) hex.fixed_mul_lo.row 8, j, fru2, fwu2, fscale
        hex.neg 8, fru2
        hex.add 8, fru2, ccyf
        hex.zero 8, frl1
        rep(6, j) hex.fixed_mul_lo.row 8, j, frl1, fwl1, fscale
        hex.neg 8, frl1
        hex.add 8, frl1, ccyf
        hex.zero 8, frl2
        rep(6, j) hex.fixed_mul_lo.row 8, j, frl2, fwl2, fscale
        hex.neg 8, frl2
        hex.add 8, frl2, ccyf
        hex.zero 8, stu1
        rep(8, j) hex.fixed_mul_lo.row 8, j, stu1, fwu1, fsstep
        hex.zero 8, stu2
        rep(8, j) hex.fixed_mul_lo.row 8, j, stu2, fwu2, fsstep
        hex.zero 8, stl1
        rep(8, j) hex.fixed_mul_lo.row 8, j, stl1, fwl1, fsstep
        hex.zero 8, stl2
        rep(8, j) hex.fixed_mul_lo.row 8, j, stl2, fwl2, fsstep
        ;end
      ccyf: hex.vec 8
      end:
    }

    // ... the per-column row derivation (frac >> 16 arithmetic, exactly step_rows' epilogue)
    def ts_dda_rows fra, frb, fA, fB {
        hex.mov 8, fra, fA
        hex.shr_hex 8, 4, fra
        hex.sign_extend 8, 4, fra
        hex.mov 8, frb, fB
        hex.shr_hex 8, 4, frb
        hex.sign_extend 8, 4, frb
    }

    // ... and the per-column advance (frac -= wt*scalestep, mod 2^32 = the 8-nibble sub)
    def ts_dda_adv fru1, fru2, frl1, frl2, stu1, stu2, stl1, stl2 {
        hex.sub 8, fru1, stu1
        hex.sub 8, fru2, stu2
        hex.sub 8, frl1, stl1
        hex.sub 8, frl2, stl2
    }

    def ts_step_faces budget, centeryfix_c, viewh1, projection, slotstride, stack, deg, dstkscale, dda, dlipscale \
            @ nofaces, dofaces, floop, fbody, fwork, fnext, uskip, udo, ugo, ust1, ust2, ust3, uclz, \
              ukhi, uhicl, uwr, umark, umark2, lskip, ldo, lgo, lst1, lst2, lst3, lclz, lkhi, lhicl, lwr, \
              lmark, lmark2, fmax, \
              fcap, fnorm, fdist, fscale, fsstep, fwu1, fwu2, fwl1, fwl2, fra, frb, fcvh, \
              fru1, fru2, frl1, frl2, stu1, stu2, stl1, stl2, fmv, ulipn, llipn, udng, ldng, \
              fx, fdb, fdp, fdv, fsb, fsp, fsv, fbb, fbp, fidx, fy1, fy2, end \
            < viewangle, viewz, sgn_aff, x1, x2, n_face, drawn, sfflag, sfslot, \
              seg_segangle, seg_fmask, seg_uh1, seg_uh2, seg_lh1, seg_lh2, seg_ucls, seg_lcls, \
              seg_bpid {
        hex.if0 2, seg_fmask, nofaces           // this boundary carries no face at all (compile-time)
        hex.set 2, fcap, budget
        hex.cmp 2, n_face, fcap, dofaces, nofaces, nofaces
      dofaces:
        hex.inc 2, n_face
        proj.wall_setup_sgn fnorm, fdist, sgn_aff, seg_segangle
        proj.wall_scale_setup_m fscale, fsstep, viewangle, fnorm, fdist, x1, x2, projection
        // the four world heights as map-unit deltas from the eye, hoisted once per seg exactly as
        // pass 2 hoists wtc8/wtf8. Upper face = [row(front ceil), row(back ceil) - 1]; lower face =
        // [row(back floor), row(front floor)] -- the oracle's wall_screen_span pairs, verbatim.
        hex.mov 4, fwu1, seg_uh1
        hex.sub 4, fwu1, viewz + 4*dw
        hex.sign_extend 8, 4, fwu1
        hex.mov 4, fwu2, seg_uh2
        hex.sub 4, fwu2, viewz + 4*dw
        hex.sign_extend 8, 4, fwu2
        hex.mov 4, fwl1, seg_lh1
        hex.sub 4, fwl1, viewz + 4*dw
        hex.sign_extend 8, 4, fwl1
        hex.mov 4, fwl2, seg_lh2
        hex.sub 4, fwl2, viewz + 4*dw
        hex.sign_extend 8, 4, fwl2
        hex.set 8, fcvh, viewh1
        rep(dda, k) .ts_dda_setup fscale, fsstep, fwu1, fwu2, fwl1, fwl2, centeryfix_c, fru1, fru2, frl1, frl2, stu1, stu2, stl1, stl2
        hex.zero 8, fx
        hex.mov 2, fx, x1
        hex.set w/4, fdb, drawn                 // the occlusion flag, read but never written here
        hex.ptr_index fdp, fdb, fx
        hex.set w/4, fsb, sfflag                // one byte per column: which slots are filled
        hex.ptr_index fsp, fsb, fx
        hex.zero w/4, fidx
        hex.mov 2, fidx, fx
        hex.shl_hex w/4, 1, fidx                // slotstride = 16 bytes -> a whole-nibble shift
        hex.set w/4, fbb, sfslot
        hex.ptr_index fbp, fbb, fidx
      floop:
        hex.cmp 2, fx, x2, fbody, nofaces, nofaces
      fbody:
        hex.read_byte fdv, fdp
        hex.if0 2, fdv, fwork                   // already painted by a nearer wall -> nothing to show
        ;fnext
      fwork:
        hex.read_byte fsv, fsp
        // ---- the UPPER face(s) ----------------------------------------------------------------
        // V5: the flag nibbles are per-side COUNTS (0..1+stack); slot layout is 4-byte pieces
        // [y1][y2][cls][bpid] at u1@0, u2@4, l1@8, l2@12 -- all inside the 16-byte stride.
        hex.if0 1, seg_fmask, uskip             // nibble 0 = has an upper face
        hex.cmp 1, fsv, fmax, udo, uskip, uskip // upper count < 1+stack -> room for a piece
      udo:
        // V5-DROP FAR GATE: a LIP farther than dlipscale projects to a sub-pixel line
        // -- skip the whole piece. Risers are never lip-gated (they ARE the stairs).
        rep(deg, k) hex.mov 1, fmv, seg_fmask
        rep(deg, k) hex.dec 1, fmv
        rep(deg, k) hex.if0 1, fmv, udng
        rep(deg, k) hex.set 8, fy1, dlipscale
        rep(deg, k) hex.cmp 8, fscale, fy1, uskip, udng, udng
      udng:
        // 25M-CAP STACK FAR GATE: a SECOND stacked piece only when the boundary is near enough
        // (scale >= dstkscale, one unsigned compare on the register the DDA already carries).
        // fy1 is dead until ust3, so it serves as the constant cell.
        rep(deg*stack, k) hex.if0 1, fsv, ugo             // the FIRST piece is never gated
        rep(deg*stack, k) hex.set 8, fy1, dstkscale
        rep(deg*stack, k) hex.cmp 8, fscale, fy1, uskip, ugo, ugo
      ugo:
        rep(1-dda, k) proj.step_rows fra, frb, fscale, fwu1, fwu2, centeryfix_c
        rep(dda, k) .ts_dda_rows fra, frb, fru1, fru2
        hex.dec 8, frb                          // ... ends one row ABOVE the back ceiling
        // V5-DROP: mode 2 = LIP -- the near ceiling's edge row ALONE; the stored
        // region-behind then paints the far ceiling below it (mode 1 keeps the riser)
        hex.mov 1, fmv, seg_fmask
        hex.dec 1, fmv
        hex.if0 1, fmv, ulipn
        hex.mov 8, frb, fra
      ulipn:
        // V5: a second piece clips past the STORED first piece's end (sentinels included)
        rep(stack, k) .ts_clamp2 fra, fsv, fbp, 0
        // the slot stores BYTES, so a VISIBLE face is stored clipped; the oracle stores the
        // face whenever A <= B -- EVEN FULLY OFF-SCREEN -- and that write CONSUMES the slot,
        // blocking farther segs (R40, the 28-column phantom face). V5 splits the off-screen
        // sentinel by DIRECTION, because the region BEHIND a piece derives from the stored
        // bytes: fully ABOVE the screen -> (1, 0) (the region behind starts at ~row 0); fully
        // BELOW -> (255, 254) (the region behind is off-screen). Both keep y1 > y2, so
        // lines_step_load still rejects them before drawing.
        hex.scmp 8, fra, frb, ust1, ust1, uskip
      ust1:
        hex.sign 8, frb, umark, ust2
      ust2:
        hex.scmp 8, fra, fcvh, ust3, ust3, umark2
      umark:
        hex.set 8, fy1, 1
        hex.zero 8, fy2
        ;uwr
      umark2:
        hex.set 8, fy1, 255
        hex.set 8, fy2, 254
        ;uwr
      ust3:
        hex.mov 8, fy1, fra
        hex.sign 8, fra, uclz, ukhi
      uclz:
        hex.zero 8, fy1
      ukhi:
        hex.mov 8, fy2, frb
        hex.scmp 8, frb, fcvh, uwr, uwr, uhicl
      uhicl:
        hex.mov 8, fy2, fcvh
      uwr:
        .ts_piece_wr fsv, fbp, 0, fy1, fy2, seg_ucls, seg_bpid
        hex.inc 1, fsv                          // nibble 0: the upper count
        hex.write_byte fsp, fsv
      uskip:
        // ---- the LOWER face -------------------------------------------------------------------
        hex.if0 1, seg_fmask + 1*dw, lskip
        hex.cmp 1, fsv + 1*dw, fmax, ldo, lskip, lskip   // lower count < 1+stack -> room
      ldo:
        rep(deg, k) hex.mov 1, fmv, seg_fmask + 1*dw     // V5-DROP far gate, lower mirror
        rep(deg, k) hex.dec 1, fmv
        rep(deg, k) hex.if0 1, fmv, ldng
        rep(deg, k) hex.set 8, fy1, dlipscale
        rep(deg, k) hex.cmp 8, fscale, fy1, lskip, ldng, ldng
      ldng:
        rep(deg*stack, k) hex.if0 1, fsv + 1*dw, lgo      // ... and the LOWER side's mirror
        rep(deg*stack, k) hex.set 8, fy1, dstkscale
        rep(deg*stack, k) hex.cmp 8, fscale, fy1, lskip, lgo, lgo
      lgo:
        rep(1-dda, k) proj.step_rows fra, frb, fscale, fwl1, fwl2, centeryfix_c
        rep(dda, k) .ts_dda_rows fra, frb, frl1, frl2
        // V5-DROP: mode 2 = LIP -- the near floor's edge row alone (the tread-lip line)
        hex.mov 1, fmv, seg_fmask + 1*dw
        hex.dec 1, fmv
        hex.if0 1, fmv, llipn
        hex.mov 8, fra, frb
      llipn:
        // V5: a second (farther) piece clips ABOVE the stored first piece's start
        rep(stack, k) .ts_clamp2_lo frb, fsv + 1*dw, fbp, 8
        hex.scmp 8, fra, frb, lst1, lst1, lskip
      lst1:
        hex.sign 8, frb, lmark, lst2
      lst2:
        hex.scmp 8, fra, fcvh, lst3, lst3, lmark2
      lmark:
        hex.set 8, fy1, 1                       // off-screen ABOVE: the (1, 0) sentinel
        hex.zero 8, fy2
        ;lwr
      lmark2:
        hex.set 8, fy1, 255                     // off-screen BELOW: the (255, 254) sentinel
        hex.set 8, fy2, 254
        ;lwr
      lst3:
        hex.mov 8, fy1, fra
        hex.sign 8, fra, lclz, lkhi
      lclz:
        hex.zero 8, fy1
      lkhi:
        hex.mov 8, fy2, frb
        hex.scmp 8, frb, fcvh, lwr, lwr, lhicl
      lhicl:
        hex.mov 8, fy2, fcvh
      lwr:
        .ts_piece_wr fsv + 1*dw, fbp, 8, fy1, fy2, seg_lcls, seg_bpid
        hex.inc 1, fsv + 1*dw                   // nibble 1: the lower count
        hex.write_byte fsp, fsv
      lskip:
      fnext:
        hex.ptr_add fdp, 1
        hex.ptr_add fsp, 1
        hex.ptr_add fbp, slotstride
        hex.inc 2, fx
        hex.add 8, fscale, fsstep               // the interpolated scale advances on EVERY column
        rep(dda, k) .ts_dda_adv fru1, fru2, frl1, frl2, stu1, stu2, stl1, stl2
        ;floop
      nofaces:
        ;end
      fcap: hex.vec 2
      fmax: hex.vec 1, 1+stack                  // V5: pieces allowed per side per column
      fnorm: hex.vec 8
      fdist: hex.vec 8
      fscale: hex.vec 8
      fsstep: hex.vec 8
      fwu1: hex.vec 8
      fwu2: hex.vec 8
      fwl1: hex.vec 8
      fwl2: hex.vec 8
      fra: hex.vec 8
      frb: hex.vec 8
      fcvh: hex.vec 8
      fmv: hex.vec 1
      fru1: hex.vec 8
      fru2: hex.vec 8
      frl1: hex.vec 8
      frl2: hex.vec 8
      stu1: hex.vec 8
      stu2: hex.vec 8
      stl1: hex.vec 8
      stl2: hex.vec 8
      fx: hex.vec 8
      fdb: hex.vec w/4
      fdp: hex.vec w/4
      fdv: hex.vec 2
      fsb: hex.vec w/4
      fsp: hex.vec w/4
      fsv: hex.vec 2
      fbb: hex.vec w/4
      fbp: hex.vec w/4
      fidx: hex.vec w/4
      fy1: hex.vec 8
      fy2: hex.vec 8
      end:
    }

    def seg_pass1_leaf_body_ts budget, dbl, dsl, dtb, steps, sbudget, centeryfix_c, viewh1, projection, slotstride, stack, deg, dstkscale, dda, dlipscale \
            @ ret, bok, bstop, wok, wlo, wahi, wbhi, wbok, scan, nolow, dolow, nohigh, dohigh, \
              loop, body, claim, next, pdone, tsgo, xa, xb, pm1, bcap \
            < viewx, viewy, viewxa, viewxs, viewya, viewys, sgn_aff, viewangle, \
              seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c, seg_pid, \
              pclm, visible, x1, x2, x, pbase, pptr, pval8, pmin, pmax, \
              n_claimed, n_tsv, tsstop, tsbstop, vieww, seg_ret, full, \
              wrej, wqa, wna, wqb, wnb, wex, wey, weyx, wexy {
        // V5-DROP-P2: the correct monotone stop -- every column WALL-drawn means neither an
        // attribution nor a PIECE can land (drawn[x] blocks both), exactly like the thing
        // pre-pass (R48). Attribution-complete alone must NOT stop this leaf: pieces still
        // record into attributed-but-undrawn columns.
        hex.if0 1, full, tsgo
        stl.fret seg_ret
      tsgo:
        // Spend one unit of the per-frame attribution BUDGET (config.PNEAR_SEG_BUDGET). Segs arrive
        // nearest-first, so the budget only ever costs FAR attribution -- and it is what BOUNDS the
        // cost of a frame whose view never closes: with open sky or void on screen `n_claimed` never
        // reaches VIEW_W, and one such E1M1 viewpoint measured 69.6M ops/frame before this existed.
        hex.inc 2, n_tsv
        hex.set 2, bcap, budget
        hex.cmp 2, n_tsv, bcap, bok, bstop, bok
      bstop:
        hex.set 1, tsstop, 1                    // this seg is the last one the budget allows
        hex.set 1, tsbstop, 1                   // V5-DROP-P2b: the BUDGET-ONLY latch piece-seg
      bok:                                      // call sites test (tsstop also means claim-done)
        proj.wedge_reject wrej, seg_v1x, seg_v1y, seg_v2x, seg_v2y, wqa, wna, wqb, wnb, wex, wey, weyx, wexy
        hex.if0 1, wrej, wok
        stl.fret seg_ret
      wok:
        proj.wall_x_range_m dbl, dsl, dtb, visible, x1, x2, sgn_aff, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c
        hex.if0 1, visible, ret
        // V3: record this boundary's step faces over its FULL column range -- deliberately BEFORE
        // the [pmin, pmax] window clip below, which is an attribution optimisation only: a column
        // outside the unattributed window can still be undrawn, and the oracle records a face there.
        rep(steps, k) .ts_step_faces sbudget, centeryfix_c, viewh1, projection, slotstride, stack, deg, dstkscale, dda, dlipscale
        // Clip the scan to the UNATTRIBUTED WINDOW [pmin, pmax]. Every column below pmin / above
        // pmax is already attributed by a nearer seg, so scanning it can only re-read a nonzero
        // byte: at (-309,636) that is 769 column reads cut to 201, and 37 of the 60 projected segs
        // exit here outright. The bounds are maintained WITHOUT any extra reads -- see below.
        hex.mov 2, xa, x1
        hex.cmp 2, xa, pmin, wlo, wahi, wahi    // xa = max(x1, pmin)
      wlo:
        hex.mov 2, xa, pmin
      wahi:
        hex.mov 2, pm1, pmax
        hex.inc 2, pm1
        hex.mov 2, xb, x2
        hex.cmp 2, xb, pm1, wbok, wbok, wbhi    // xb = min(x2, pmax+1)
      wbhi:
        hex.mov 2, xb, pm1
      wbok:
        hex.cmp 2, xa, xb, scan, ret, ret       // window empty for this seg -> nothing to attribute
      scan:
        // After this scan [xa, xb) is attributed in full, so if the scan STARTS at pmin the bound
        // can jump to xb, and if it ENDS at pmax+1 the bound can drop to xa-1 -- a conservative
        // update that costs two compares and no memory reads. (pmax underflowing to 0xFF is fine:
        // it makes pm1 = 0, so every later seg finds an empty window, which is exactly the truth.)
        hex.cmp 2, xa, pmin, nolow, dolow, nolow
      dolow:
        hex.mov 2, pmin, xb
      nolow:
        hex.cmp 2, xb, pm1, nohigh, dohigh, nohigh
      dohigh:
        hex.mov 2, pmax, xa
        hex.dec 2, pmax
      nohigh:
        hex.zero 8, x
        hex.mov 2, x, xa                        // the claim scan over the stride-1 pclm[]
        hex.set w/4, pbase, pclm
        hex.ptr_index pptr, pbase, x            // ptr_index reads w/4 nibbles of its index (R11)
      loop:
        hex.cmp 2, x, xb, body, ret, ret
      body:
        hex.read_byte pval8, pptr
        hex.if0 2, pval8, claim
        hex.ptr_add pptr, 1                     // a nearer seg already attributed this column
        ;next
      claim:
        hex.write_byte_and_inc pptr, seg_pid    // pclm[x] = this seg's plane-pair id (advances too)
        hex.inc 2, n_claimed
        hex.cmp 2, n_claimed, vieww, next, pdone, next
      pdone:
        // V5-DROP-P2: claim-completion latches tsstop, but the CALL SITES only test it for
        // LIGHT-ONLY marking segs (no pieces possible -- attribution was their whole job).
        // Piece-carrying segs call unconditionally and stop on this leaf's `full` entry test
        // instead: pieces still land in attributed-but-undrawn columns (the owner's
        // (1210,1187) field flip -- R48's sibling).
        hex.set 1, tsstop, 1
      next:
        hex.inc 2, x
        ;loop
      ret:
        stl.fret seg_ret
      xa: hex.vec 2
      xb: hex.vec 2
      pm1: hex.vec 2
      bcap: hex.vec 2
    }

    // M13-2S rung 3a — a column's two band-list addresses FROM ITS PLANE-PAIR ID. The bank is laid
    // out per pid (1-based): pid p's ceiling list is slot 2(p-1), its floor list 2(p-1)+1, so both
    // addresses are one strength-reduced constant multiply (the stride has 2 set bits) plus adds off
    // the frame's bank pointer. That is the whole reason the claim state is a single BYTE: the
    // alternative -- per-column address cells read back with hex.ptr_index + hex.read_hex 8 -- costs
    // ~780 dispatches per column (w(2.25@) + 8x(24@)), measured at +5M/frame.
    // M13-15M BANDS-AS-CODE: the ID twin of lines_pid_addrs. The four registers now carry LIST
    // IDS for `vpb_walk` instead of bank addresses: pid p's four half-lists are consecutive at
    // vzcbase + (p-1)*4 (vzcbase = class*n_bank_keys*2, a per-frame const the descend leaf sets),
    // in the SAME [ceil_asc][ceil_desc][floor_asc][floor_desc] order the bank used. The multiply
    // shrinks from mul_const 4*half_slots*dw to mul_const 4.
    def lines_pid_ids pidreg, cbufa, cbufd, fbufa, fbufd < vzcbase {
        hex.zero w/4, cbufa
        hex.mov 2, cbufa, pidreg
        hex.mul_const w/4, cbufa, cbufa, 4
        hex.add w/4, cbufa, vzcbase
        hex.sub_constant w/4, cbufa, 4                     // pids are 1-based (0 = unattributed)
        hex.mov w/4, cbufd, cbufa
        hex.add_constant w/4, cbufd, 1
        hex.mov w/4, fbufa, cbufa
        hex.add_constant w/4, fbufa, 2
        hex.mov w/4, fbufd, fbufa
        hex.add_constant w/4, fbufd, 1
    }

    def lines_pid_addrs pidreg, half_slots, cbufa, cbufd, fbufa, fbufd < vzbank {
        hex.zero w/4, cbufa                                // widen the 2-nibble pid first: mul_const
        hex.mov 2, cbufa, pidreg                           // reads w/4 nibbles of its source (R11)
        hex.mul_const w/4, cbufa, cbufa, 4*half_slots*dw
        hex.add w/4, cbufa, vzbank
        hex.sub_constant w/4, cbufa, 4*half_slots*dw       // pids are 1-based (0 = unattributed)
        hex.mov w/4, cbufd, cbufa
        hex.add_constant w/4, cbufd, half_slots*dw
        hex.mov w/4, fbufa, cbufa
        hex.add_constant w/4, fbufa, 2*half_slots*dw
        hex.mov w/4, fbufd, fbufa
        hex.add_constant w/4, fbufd, half_slots*dw
    }

    // M13-2S rung 3a — this column's plane attribution, in the EMIT half. The nearest marking seg's
    // stored pid wins; if none reached the column yet then THIS seg is the nearest, so it uses its
    // own baked pid and claims the column (which is what lets `tsstop` ever become true -- most
    // columns are first reached by a one-sided wall). `pptr` walks pclm[] in lockstep with the
    // drawn[] pointer, so there is no per-column ptr_index (w(2.25@)) at all.
    // V2 - the frame's sky scroll = viewangle >> 24, i.e. exactly 6 nibbles. That is why SKY_TURN
    // is 2 and not 4: fj shifts cheaply only by whole nibbles (ReferenceModel._sky_shift).
    def lines_sky_base skb @ t8, end < viewangle {
        hex.mov 8, t8, viewangle
        hex.shr_hex 8, 6, t8
        hex.mov 2, skb, t8
        ;end
      t8: hex.vec 8
      end:
    }

    // V2 - this column's CEILING list: the SKY list when the attributed pid's ceiling is F_SKY1,
    // otherwise the plane list `lines_pid_addrs` already computed. Sky is the one surface with no
    // perspective and no distance lighting, so a sky column IS just a band list -- which is why the
    // whole feature costs one dispatch and one add here and adds NO new emit path: the existing
    // ceiling prefix walk streams it unchanged.
    // `u = skybase + skyoff[x]` needs NO MASK: both addends are <= 127 and the bank holds 256
    // lists with entry u carrying sky column (u & 127), so the sum can never leave it (max 253).
    // M13-15M: the ID twin — sky list u's two halves are ids SKY_BASE_ID + u*2 (+1 for desc);
    // the 16-nibble mul_const + label add of the address form die (they were 0.66M at the tree).
    def lines_sky_ceil_ids sky_base_id, skyall, cbufa, cbufd, x, skb, soff, issky, pidreg @ notsky, end {
        skypid.lookup issky, pidreg
        rep(1-skyall, k) hex.if0 2, issky, notsky
        skyoff.lookup soff, x
        hex.add 2, soff, skb
        hex.zero w/4, cbufa
        hex.mov 2, cbufa, soff
        hex.shl_bit w/4, cbufa                  // u*2: the ids interleave asc,desc
        hex.add_constant w/4, cbufa, sky_base_id
        hex.mov w/4, cbufd, cbufa
        hex.add_constant w/4, cbufd, 1
        ;end
      notsky:
        hex.zero 2, soff                        // non-sky columns share soff=0 for the ditto test
        ;end
      end:
    }

    def lines_sky_ceil skystride, halfslots, skyall, cbufa, cbufd, x, skb, soff, issky, pidreg @ notsky, tskb, end < skybands {
        skypid.lookup issky, pidreg
        rep(1-skyall, k) hex.if0 2, issky, notsky   // skyall=1: force it (bisect probe)
        skyoff.lookup soff, x
        hex.add 2, soff, skb
        hex.zero w/4, cbufa                     // widen before mul_const (R11 reads w/4 nibbles)
        hex.mov 2, cbufa, soff
        hex.mul_const w/4, cbufa, cbufa, skystride*dw
        hex.set w/4, tskb, skybands             // a LABEL base goes through hex.set (the proven
        hex.add w/4, cbufa, tskb                // idiom -- cf. `hex.set w/4, dbase, drawn`), not
                                                // through add_constant
        hex.mov w/4, cbufd, cbufa               // ... and the DESC half, which emit_col_lines walks
        hex.add_constant w/4, cbufd, halfslots*dw   // via cdesc2 once ctake > CENTERY. Overriding
                                                // only cbufa left sky above the horizon and PLANE
                                                // bands below it.
        ;end
      notsky:
        hex.zero 2, soff                        // non-sky columns share soff=0 so the ditto test
        ;end                                    // compares equal for them
      tskb: hex.vec w/4
      end:
    }

    // V3 -- the per-face SHADE. A step face is flat-shaded, but it still takes DOOM's scalelight row
    // for its own on-screen height exactly as a wall column does, so the colour is a pure function
    // of (light class, CLIPPED height) -- which makes it a baked table, `stepcol`, 256 bytes per
    // class so the class offset is a whole-nibble shift and the whole lookup is one ptr_index.
    // ⚠ The height is the CLIPPED one, so this cannot be folded into the slot at record time.
    def step_shade cls, y1, y2, cpb @ sh_idx, sh_p, end {
        hex.zero w/4, sh_idx
        hex.mov 2, sh_idx + 2*dw, cls           // idx = class<<8 | h
        hex.mov 2, sh_idx, y2
        hex.sub 2, sh_idx, y1
        hex.inc 2, sh_idx                       // h = y2 - y1 + 1, in [1, VIEW_H]
        hex.ptr_index sh_p, cpb, sh_idx
        hex.read_byte cls, sh_p                 // in place: the class byte becomes the colour byte
        ;end
      sh_idx: hex.vec w/4
      sh_p: hex.vec w/4
      end:
    }

    // V3 -- this column's step faces, read back from the write-once slots the two-sided claim leaf
    // filled, then CLIPPED to the regions the claiming wall actually left open (ceiling [0, ctake),
    // floor [fstart, VIEW_H)) and shaded. Clipping here rather than in the emit keeps the emitted
    // column MONOTONE by construction: each face is proven to land strictly inside its own region.
    // The overwhelming majority of columns carry no face, and they pay ONE byte read for it.
    def lines_step_load stv, ufl, uy1, uy2p1, ucol, lfl, ly1, ly2p1, lcol, x, cexcl, fstart \
            @ ct0, cth, unone, uhave, uclamp, ustart, udraw, uskip, \
              lnone, lhave, lclamp, lstart, ldraw, lskip, \
              sfb, sfp, sbb, sbp, sidx, cpb, ctake, ct1, end \
            < sfflag, sfslot, stepcol {
        hex.zero 1, ufl
        hex.zero 1, lfl
        // ⚠ ZEROED, not left stale: these six are the column's DITTO SIGNATURE (see dstchk), and a
        // leftover value from the previous column would make two identical columns compare
        // different. `uy2p1`/`ly2p1` are exclusive end rows, so a real face always has them >= 1 --
        // which is what lets the signature be the six values alone, with no separate "has a face"
        // bit in the compare.
        hex.zero 2, uy1
        hex.zero 2, uy2p1
        hex.zero 2, ucol
        hex.zero 2, ly1
        hex.zero 2, ly2p1
        hex.zero 2, lcol
        hex.set w/4, sfb, sfflag
        hex.ptr_index sfp, sfb, x
        hex.read_byte stv, sfp
        hex.if0 2, stv, end                     // no face in this column -- the common case
        hex.mov 2, ctake, cexcl                 // ctake = min(cexcl, fstart), as the emit computes it
        hex.cmp 2, ctake, fstart, ct0, ct0, cth
      cth:
        hex.mov 2, ctake, fstart
      ct0:
        hex.zero w/4, sidx
        hex.mov 2, sidx, x
        hex.shl_hex w/4, 1, sidx                // 16 bytes per column -> a whole-nibble shift
        hex.set w/4, sbb, sfslot
        hex.ptr_index sbp, sbb, sidx
        hex.set w/4, cpb, stepcol
        // ---- UPPER: [uy1, min(uy2, ctake-1)], inside the ceiling region
        hex.if0 1, stv, unone
        hex.read_byte_and_inc uy1, sbp
        hex.read_byte_and_inc uy2p1, sbp
        hex.read_byte_and_inc ucol, sbp         // the face's colour CLASS until step_shade runs
        // V5 slots are 4-byte pieces [y1][y2][cls][bpid] at u1@0, u2@4, l1@8, l2@12 (see
        // ts_piece_wr / lines_steps_load2). This tier draws piece 1 per side only: skip the
        // bpid byte + the u2 slot to land on l1.
        hex.ptr_add sbp, 5
        ;uhave
      unone:
        hex.ptr_add sbp, 8
        ;uskip
      uhave:
        hex.if0 2, ctake, uskip                 // no ceiling region at all in this column
        hex.mov 2, ct1, ctake
        hex.dec 2, ct1
        hex.cmp 2, uy2p1, ct1, ustart, ustart, uclamp
      uclamp:
        hex.mov 2, uy2p1, ct1
      ustart:
        hex.cmp 2, uy1, uy2p1, udraw, udraw, uskip
      udraw:
        .step_shade ucol, uy1, uy2p1, cpb
        hex.inc 2, uy2p1                        // the pair's EXCLUSIVE end row
        hex.set 1, ufl, 1
      uskip:
        // ---- LOWER: [max(ly1, fstart), ly2], inside the floor region
        hex.if0 1, stv + 1*dw, lnone
        hex.read_byte_and_inc ly1, sbp
        hex.read_byte_and_inc ly2p1, sbp
        hex.read_byte_and_inc lcol, sbp
        ;lhave
      lnone:
        ;lskip
      lhave:
        hex.cmp 2, ly1, fstart, lclamp, lstart, lstart
      lclamp:
        hex.mov 2, ly1, fstart
      lstart:
        hex.cmp 2, ly1, ly2p1, ldraw, ldraw, lskip
      ldraw:
        .step_shade lcol, ly1, ly2p1, cpb
        hex.inc 2, ly2p1
        hex.set 1, lfl, 1
      lskip:
        ;end
      sfb: hex.vec w/4
      sfp: hex.vec w/4
      sbb: hex.vec w/4
      sbp: hex.vec w/4
      sidx: hex.vec w/4
      cpb: hex.vec w/4
      ctake: hex.vec 2
      ct1: hex.vec 2
      end:
    }

    // V5 -- the STACKED-pieces load: the RAW stored slot bytes (rows still unclipped-to-region,
    // sentinels included) plus the per-side counts. The stack emit (`steps_splice_c`/`_f`) does
    // its own clipping and shading against the column's window, so the ditto signature is the
    // raw values + the window rows already in the chain. Zeroed when absent (the signature
    // rule). Layout: 4-byte pieces [y1][y2][cls][bpid] at u1@0, u2@4, l1@8, l2@12.
    def lines_steps_load2 x \
            @ u1rd, l0rd, l1rd, l2rd, sfb, sfp, sbb, sbp, sidx, stv2, end \
            < sfflag, sfslot, ucnt, u1y1, u1y2, u1cls, u1bp, u2y1, u2y2, u2cls, u2bp, \
              lcnt, l1y1, l1y2, l1cls, l1bp, l2y1, l2y2, l2cls, l2bp {
        hex.zero 2, ucnt
        hex.zero 2, u1y1
        hex.zero 2, u1y2
        hex.zero 2, u1cls
        hex.zero 2, u1bp
        hex.zero 2, u2y1
        hex.zero 2, u2y2
        hex.zero 2, u2cls
        hex.zero 2, u2bp
        hex.zero 2, lcnt
        hex.zero 2, l1y1
        hex.zero 2, l1y2
        hex.zero 2, l1cls
        hex.zero 2, l1bp
        hex.zero 2, l2y1
        hex.zero 2, l2y2
        hex.zero 2, l2cls
        hex.zero 2, l2bp
        hex.set w/4, sfb, sfflag
        hex.ptr_index sfp, sfb, x
        hex.read_byte stv2, sfp
        hex.if0 2, stv2, end                    // no piece in this column -- the common case
        hex.mov 1, ucnt, stv2                   // nibble 0 = upper count, nibble 1 = lower
        hex.mov 1, lcnt, stv2 + 1*dw
        hex.zero w/4, sidx
        hex.mov 2, sidx, x
        hex.shl_hex w/4, 1, sidx
        hex.set w/4, sbb, sfslot
        hex.ptr_index sbp, sbb, sidx
        hex.if0 1, ucnt, l0rd
        hex.read_byte_and_inc u1y1, sbp
        hex.read_byte_and_inc u1y2, sbp
        hex.read_byte_and_inc u1cls, sbp
        hex.read_byte_and_inc u1bp, sbp
        hex.dec 1, ucnt
        hex.if0 1, ucnt, u1rd                   // count was 1 -> no second upper stored
        hex.read_byte_and_inc u2y1, sbp
        hex.read_byte_and_inc u2y2, sbp
        hex.read_byte_and_inc u2cls, sbp
        hex.read_byte_and_inc u2bp, sbp
        hex.inc 1, ucnt
        ;l1rd
      u1rd:
        hex.ptr_add sbp, 4
        hex.inc 1, ucnt
        ;l1rd
      l0rd:
        hex.ptr_add sbp, 8
      l1rd:
        hex.if0 1, lcnt, end
        hex.read_byte_and_inc l1y1, sbp
        hex.read_byte_and_inc l1y2, sbp
        hex.read_byte_and_inc l1cls, sbp
        hex.read_byte_and_inc l1bp, sbp
        hex.dec 1, lcnt
        hex.if0 1, lcnt, l2rd
        hex.read_byte_and_inc l2y1, sbp
        hex.read_byte_and_inc l2y2, sbp
        hex.read_byte_and_inc l2cls, sbp
        hex.read_byte_and_inc l2bp, sbp
        hex.inc 1, lcnt
        ;end
      l2rd:
        hex.inc 1, lcnt
        ;end
      sfb: hex.vec w/4
      sfp: hex.vec w/4
      sbb: hex.vec w/4
      sbp: hex.vec w/4
      sidx: hex.vec w/4
      stv2: hex.vec 2
      end:
    }

    // V4 -- this column's sprite fragment, read back from the write-once slot the thing pre-pass
    // filled. Six bytes, but a column WITHOUT a sprite pays only the one `sprflag` read -- and that
    // is most columns. All six are ZEROED when absent: they are the column's ditto signature too,
    // and a stale value from an earlier column would let an empty column ditto a sprite column.
    def lines_spr_load sprfl, ssy1, ssy2, sy0b, sblk, slr, ssy1b, ssy2b, sy0bb, sblkb, slrb, x \
            @ sfb, sfp, sbb, sbp, sidx, sfl2, end < sprflag, spslot {
        hex.zero 2, sprfl
        hex.zero 2, ssy1
        hex.zero 2, ssy2
        hex.zero 4, sy0b
        hex.zero 4, sblk
        hex.zero 2, slr
        // V4b: slot B's signature regs zero when absent -- like slot A's, that keeps the ditto
        // compares meaningful without a flag compare (a real fragment's sy0b is never 0).
        hex.zero 2, ssy1b
        hex.zero 2, ssy2b
        hex.zero 4, sy0bb
        hex.zero 4, sblkb
        hex.zero 2, slrb
        hex.set w/4, sfb, sprflag
        hex.ptr_index sfp, sfb, x
        hex.read_byte sprfl, sfp
        hex.if0 2, sprfl, end
        hex.zero w/4, sidx
        hex.mov 2, sidx, x
        hex.shl_hex w/4, 1, sidx                // 16 bytes per column -> a whole-nibble shift
        hex.set w/4, sbb, spslot
        hex.ptr_index sbp, sbb, sidx
        hex.read_byte_and_inc ssy1, sbp
        hex.read_byte_and_inc ssy2, sbp
        // M13-15M: y0 is TWO bytes, bias 32768. One biased byte wrapped for y0 < -128 -- a tall
        // near sprite's top row -- and the wrap turned (1869,479,W)'s fragment into an empty
        // above-region plus one bogus clamped run (the oracle keeps raw ints, so only fj wrapped).
        hex.read_byte_and_inc sy0b, sbp
        hex.read_byte_and_inc sy0b + 2*dw, sbp
        hex.read_byte_and_inc sblk, sbp
        hex.read_byte_and_inc sblk + 2*dw, sbp
        hex.read_byte_and_inc slr, sbp
        // V4b: sprfl == 2 -> the SECOND fragment at byte offset 8 of the same slot
        hex.mov 2, sfl2, sprfl
        hex.dec 2, sfl2
        hex.if0 2, sfl2, end
        hex.ptr_add sbp, 1                      // bytes 0-6 read -> skip byte 7 to land on 8
        hex.read_byte_and_inc ssy1b, sbp
        hex.read_byte_and_inc ssy2b, sbp
        hex.read_byte_and_inc sy0bb, sbp
        hex.read_byte_and_inc sy0bb + 2*dw, sbp
        hex.read_byte_and_inc sblkb, sbp
        hex.read_byte_and_inc sblkb + 2*dw, sbp
        hex.read_byte_and_inc slrb, sbp
        ;end
      sfb: hex.vec w/4
      sfp: hex.vec w/4
      sbb: hex.vec w/4
      sbp: hex.vec w/4
      sidx: hex.vec w/4
      sfl2: hex.vec 2
      end:
    }

    // M13-15M: the ID twin — identical claim/cache logic, lines_pid_ids instead of addresses.
    def lines_col_plane_ids cbufa, cbufd, fbufa, fbufd \
            @ own, have, recalc, pdone, end \
            < pptr, pval8, seg_pid, cpid, n_claimed, tsstop, vieww {
        hex.read_byte pval8, pptr
        hex.if0 2, pval8, own
        ;have
      own:
        hex.write_byte pptr, seg_pid
        hex.mov 2, pval8, seg_pid
        hex.inc 2, n_claimed
        hex.cmp 2, n_claimed, vieww, have, pdone, have
      pdone:
        hex.set 1, tsstop, 1
      have:
        hex.ptr_add pptr, 1
        hex.cmp 2, pval8, cpid, recalc, end, recalc
      recalc:
        hex.mov 2, cpid, pval8
        .lines_pid_ids pval8, cbufa, cbufd, fbufa, fbufd
      end:
    }

    def lines_col_plane half_slots, cbufa, cbufd, fbufa, fbufd \
            @ own, have, recalc, pdone, end \
            < pptr, pval8, seg_pid, cpid, n_claimed, tsstop, vieww {
        hex.read_byte pval8, pptr
        hex.if0 2, pval8, own
        ;have
      own:
        hex.write_byte pptr, seg_pid            // claim this column for this seg's front sector
        hex.mov 2, pval8, seg_pid
        hex.inc 2, n_claimed
        hex.cmp 2, n_claimed, vieww, have, pdone, have
      pdone:
        hex.set 1, tsstop, 1
      have:
        hex.ptr_add pptr, 1                     // in lockstep with dptr: one column per iteration
        // the four addresses are a function of the pid ALONE, so keep the last pid computed and
        // recompute only when it changes: a frame's 160 columns cover a handful of distinct
        // surfaces, and the strength-reduced multiply is ~15 shifts of w/4 (measured +1.1M/frame
        // when paid per column).
        hex.cmp 2, pval8, cpid, recalc, end, recalc
      recalc:
        hex.mov 2, cpid, pval8
        .lines_pid_addrs pval8, half_slots, cbufa, cbufd, fbufa, fbufd
      end:
    }

    // per-SEG setup / per-column advance of the pclm[] pointer (the lockstep partner of dptr).
    def lines_plane_ptr x1 < pclm, pbase, pptr {
        hex.set w/4, pbase, pclm
        hex.ptr_index pptr, pbase, x1
    }

    def lines_plane_step < pptr {
        hex.ptr_add pptr, 1
    }

    // M13-15M: the ID twin of lines_seg_plane — seg_cvpidx/seg_fvpidx are baked as LIST-ID
    // offsets (bankkey*2) in as-code builds, and the four registers carry vpb_walk ids.
    def lines_seg_plane_ids cbufa, cbufd, fbufa, fbufd \
            < vzcbase, seg_cvpidx, seg_fvpidx {
        hex.mov w/4, cbufa, vzcbase
        hex.add w/4, cbufa, seg_cvpidx
        hex.mov w/4, cbufd, cbufa
        hex.add_constant w/4, cbufd, 1
        hex.mov w/4, fbufa, vzcbase
        hex.add w/4, fbufa, seg_fvpidx
        hex.mov w/4, fbufd, fbufa
        hex.add_constant w/4, fbufd, 1
    }

    // the pre-rung-3a form: the plane addresses are the SEG's own, computed once per seg.
    def lines_seg_plane half_slots, cbufa, cbufd, fbufa, fbufd \
            < vzbank, seg_cvpidx, seg_fvpidx {
        hex.mov w/4, cbufa, vzbank
        hex.add w/4, cbufa, seg_cvpidx
        hex.mov w/4, cbufd, cbufa
        hex.add_constant w/4, cbufd, half_slots*dw
        hex.mov w/4, fbufa, vzbank
        hex.add w/4, fbufa, seg_fvpidx
        hex.mov w/4, fbufd, fbufa
        hex.add_constant w/4, fbufd, half_slots*dw
    }

    // M13-2S rung 3a: with per-column attribution the ditto test ("same as column x-1, emit 0xFE")
    // must also require the same plane surfaces -- two adjacent columns can share clip rows yet sit
    // on different floors. Without pnear the plane addresses are per-SEG constants, so the test is
    // unchanged and these two helpers cost nothing.
    def lines_jmp there {
        ;there
    }

    def lines_ditto_plane pval8, dpid, same, diff {
        hex.cmp 2, pval8, dpid, diff, same, diff
    }

    def lines_save_plane pval8, dpid {
        hex.mov 2, dpid, pval8
    }

    // M13-splitxb part 1 -- the CULL HALF: wedge pre-cull, map-unit projection/frustum cull,
    // occlusion pre-scan. Reads ONLY the geometry xorby block (v1..v2, a,b,c); sets `proceed`
    // = 1 iff the seg survives everything, so the REST block's SET+CLEAR (and part 2) never
    // happens for the 375 of 432 walked segs that stop here. dbase/dptr/x are globals -- part
    // 2 continues the same registers.
    def seg_pass1_leaf_body_lines dbl, dsl, dtb, noscan \
            @ ret, work, wok, occscan, occchk, occdone, occproc \
            < viewx, viewy, viewxa, viewxs, viewya, viewys, sgn_aff, viewangle, \
              seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c, \
              visible, x1, x2, x, dbase, dptr, dval8, \
              drawn, proceed, seg_ret, full, \
              wrej, wqa, wna, wqb, wnb, wex, wey, weyx, wexy {
        hex.set 1, proceed, 0
        hex.if0 1, full, work                   // screen already full -> paint nothing
        stl.fret seg_ret
      work:
        // M13-wedge: the multiply-free conservative FOV pre-cull, before the affine cull + atans
        proj.wedge_reject wrej, seg_v1x, seg_v1y, seg_v2x, seg_v2y, wqa, wna, wqb, wnb, wex, wey, weyx, wexy
        hex.if0 1, wrej, wok
        stl.fret seg_ret
      wok:
        // M13-mapunits: the map-unit variant -- 4-nibble atan front end, no rwa (dead here)
        proj.wall_x_range_m dbl, dsl, dtb, visible, x1, x2, sgn_aff, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, seg_v1x, seg_v1y, seg_v2x, seg_v2y, seg_a, seg_b, seg_c
        hex.if0 1, visible, ret
        hex.mov 8, x, x1                        // occlusion pre-scan over the stride-1 drawn[]
        hex.set w/4, dbase, drawn
        hex.ptr_index dptr, dbase, x1
        rep(noscan, k) .lines_jmp occproc        // ablate: what does the pre-scan actually buy?
        // M13-lines3: x/x2 are clipped columns in [0,161] here -- 2-nibble unsigned compares and
        // incs replace the 8-nibble signed forms in both hot loops (~2.4x cheaper each, measured).
      occscan:
        hex.cmp 2, x, x2, occchk, occdone, occdone
      occchk:
        hex.read_byte dval8, dptr
        hex.if0 2, dval8, occproc                // an unclaimed column exists -> render this seg
        hex.ptr_add dptr, 1
        hex.inc 2, x
        ;occscan
      occdone:
        stl.fret seg_ret                        // fully occluded -> byte-exact skip (proceed=0)
      occproc:
        hex.set 1, proceed, 1
      ret:
        stl.fret seg_ret
    }

    // M13-splitxb part 2 -- the EMIT HALF: projection setup, baked-bank addresses, the claim
    // loop with ditto + inline emission. Runs only when part 1 set `proceed`; reads the REST
    // xorby block (segangle, ceilfix/floorfix, lit, the two bank offsets).
    def seg_pass2_leaf_body_lines centery, viewh1, viewh, projection, half_slots, w2s, wpx, w1r, wpxstride, \
            pnear, eabl, noproj, ptwice, stwice, noise, sky, skystride, skyall, steps, things, blkshift, spremit, \
            ascode, sky_base_id, stack, deg, dslvw \
            @ loop, body, notdrawn, skipcol, ret, one, cge, cdone, fneg, fdone, cVH, cexcl, \
              sl0, sl1, slw, slc, xa, \
              fstart, cbufa, cbufd, fbufa, fbufd, sfull, wtc8, wtf8, dtop, dbot, dscale, dsstep, \
              dfull, dchk2, dgchk, dschk, dstchk, dst2, dst3, dst4, dst5, dst6, \
              dsp1, dsp2, dsp3, dsp4, \
              dpl, dsame, demitted, dvalid, dct, dfs, dpid, \
              gnrow, dgn, skb, soff, issky, dsoff, \
              stv, ufl, uy1, uy2p1, ucol, lfl, ly1, ly2p1, lcol, \
              duy1, duy2, ducol, dly1, dly2, dlcol, \
              sprfl, ssy1, ssy2, sy0b, sblk, slr, dssy1, dssy2, dsy0b, dsblk, \
              ssy1b, ssy2b, sy0bb, sblkb, slrb, dssy1b, dssy2b, dsy0bb, dsblkb, \
              dsp5, dsp6, dsp7, dsp8, \
              ducnt, du1y1, du1y2, du1cls, du1bp, du2y1, du2y2, du2cls, du2bp, \
              dlcnt, dl1y1, dl1y2, dl1cls, dl1bp, dl2y1, dl2y2, dl2cls, dl2bp, \
              dvc2, dvup, dvu2, dvu3, dvu4, dvu5, dvu6, dvu7, dvu8, dvu9, dvlo, \
              dvl2, dvl3, dvl4, dvl5, dvl6, dvl7, dvl8, dvl9, \
              dg3c, dg2g, dgfc, dgf2, dgf3, dgf4, dg2c, dgn2, dgn3, dwl, cw16 \
            < viewangle, seg_segangle, sgn_aff, \
              ceilfix, floorfix, viewz, \
              seg_lit, seg_lit2, seg_wstrip, wstripbase, \
              ucnt, u1y1, u1y2, u1cls, u1bp, u2y1, u2y2, u2cls, u2bp, \
              lcnt, l1y1, l1y2, l1cls, l1bp, l2y1, l2y2, l2cls, l2bp, \
              gnrow2, gnrow3, \
              x1, x2, x, dbase, dptr, dval8, pval8, \
              normalangle, rw_distance, scale, scalestep, \
              top, bottom, \
              seg_ret2, \
              full, n_drawn, vieww, w1rslv, wnoff {
        proj.wall_setup_sgn normalangle, rw_distance, sgn_aff, seg_segangle
        proj.wall_scale_setup_m scale, scalestep, viewangle, normalangle, rw_distance, x1, x2, projection
        // ablate "scaletwice" (measurement only): the same setup, same operands, dead outputs. This
        // is what rung 3c's step faces must pay for each marking seg they decorate, so it is THE
        // number that sets STEP_SEG_BUDGET. Frame stays byte-exact (asserted by the probe).
        rep(stwice, k) proj.wall_scale_setup_m dscale, dsstep, viewangle, normalangle, rw_distance, x1, x2, projection
        // 25M-CAP SLIVER: a wall whose whole span is <= dslvw columns renders FLAT -- the runtime
        // twin of the baked seg_w1rf flag (w1rslv, tested at both wall dispatch sites). A 1-2
        // column horizon sliver carries no readable texture; the heavy skyline frames have
        // dozens. Ditto-safe: dvalid resets per seg, so a ditto never crosses into this seg.
        rep(deg*w1r, k) hex.set 1, w1rslv, 0
        rep(deg*w1r, k) hex.mov 2, slw, x2
        rep(deg*w1r, k) hex.sub 2, slw, x1
        rep(deg*w1r, k) hex.set 2, slc, dslvw
        rep(deg*w1r, k) hex.cmp 2, slw, slc, sl1, sl1, sl0
      sl1:
        rep(deg*w1r, k) hex.set 1, w1rslv, 1
      sl0:
        // M13-paramhoist: the map-unit world heights, once per seg (the per-column subtracts and
        // the 12-nibble fixed_mul width both die; see proj.column_params_m).
        hex.mov 4, wtc8, ceilfix + 4*dw
        hex.sub 4, wtc8, viewz + 4*dw
        hex.sign_extend 8, 4, wtc8
        hex.mov 4, wtf8, floorfix + 4*dw
        hex.sub 4, wtf8, viewz + 4*dw
        hex.sign_extend 8, 4, wtf8

        // M13-bakedbands: the four half-list addresses -- pure adds off the per-frame bank
        // pointer (vzbank, set once by the player-subsector block); the offsets are BAKED per
        // seg. No build calls, no built-flags, no planeheight: the lists are compile-time data.
        // M13-2S rung 3a (pnear): the plane surfaces are no longer this seg's -- they are the
        // NEAREST MARKING seg's, per column, so the addresses move into the loop below.
        rep((1-pnear)*(1-ascode), k) .lines_seg_plane half_slots, cbufa, cbufd, fbufa, fbufd
        rep((1-pnear)*ascode, k) .lines_seg_plane_ids cbufa, cbufd, fbufa, fbufd
        hex.mov 8, x, x1                        // the claim loop: re-aim drawn[] at x1
        hex.ptr_index dptr, dbase, x1
        rep(pnear, k) .lines_plane_ptr x1       // ... and pclm[], walked in lockstep with it
        hex.set 2, one, 1
        hex.set 1, dvalid, 0                    // M13-ditto: no previous emitted column yet
        // HOISTED out of the per-column loop (EXP-14). `viewh` is a compile-time parameter and
        // `cVH` is never written again, so setting it once per SEG instead of once per CLAIMED
        // COLUMN is bit-identical. `hex.set 8` is a zero + a xor across EIGHT nibbles, and
        // `opprof.py` put the `hex.set > hex.set > hex.zero` path at ~2% of the whole frame.
        hex.set 8, cVH, viewh
      loop:
        hex.cmp 2, x, x2, body, ret, ret
      body:
        hex.read_byte dval8, dptr
        hex.if0 2, dval8, notdrawn
        hex.ptr_add dptr, 1                     // already claimed -> next column
        rep(pnear, k) .lines_plane_step
        hex.set 1, dvalid, 0                    // M13-ditto: a gap breaks x-adjacency
        ;skipcol
      notdrawn:
        rep(1-noproj, k) .lines_projcall centery*0x10000, viewh1, top, bottom, scale, wtc8, wtf8
        rep(noproj, k) .lines_projstub centery, top, bottom
        // ablate "projtwice" (measurement only): the SAME call with the SAME operands into dead
        // destinations. Measuring by ADDING keeps the frame byte-exact -- unlike "noproj", whose
        // stub shrinks every wall and so changes the WPX emit volume too (its delta is NOT the
        // projection's cost; see docs/handoff-m13-2s-fast.md §1).
        rep(ptwice, k) .lines_projcall centery*0x10000, viewh1, dtop, dbot, scale, wtc8, wtf8
        hex.mov 8, cexcl, top                   // cexcl = min(top, VIEW_H); cVH hoisted above
        hex.scmp 8, top, cVH, cdone, cge, cge
      cge:
        hex.mov 8, cexcl, cVH
      cdone:
        hex.mov 8, fstart, bottom               // fstart = max(bottom+1, 0)
        hex.inc 8, fstart
        hex.sign 8, fstart, fneg, fdone
      fneg:
        hex.zero 8, fstart
      fdone:
        // M13-2S rung 3a: which SURFACES this column's plane regions belong to (see lines_col_plane)
        rep(pnear*(1-ascode), k) .lines_col_plane half_slots, cbufa, cbufd, fbufa, fbufd
        rep(pnear*ascode, k) .lines_col_plane_ids cbufa, cbufd, fbufa, fbufd
        rep(sky, k) .lines_sky_base skb
        rep(sky*(1-ascode), k) .lines_sky_ceil skystride, half_slots, skyall, cbufa, cbufd, x, skb, soff, issky, pval8
        rep(sky*ascode, k) .lines_sky_ceil_ids sky_base_id, skyall, cbufa, cbufd, x, skb, soff, issky, pval8
        // V3: this column's step faces, clipped to the regions this wall leaves open and shaded.
        // Must run BEFORE the ditto decision -- a face changes a column's CONTENT without changing
        // its clip rows, the third feature in a row to hit that (see dgchk).
        rep(steps*(1-stack), k) .lines_step_load stv, ufl, uy1, uy2p1, ucol, lfl, ly1, ly2p1, lcol, x, cexcl, fstart
        // V5: the stacked load -- RAW slot bytes + per-side counts; the emit splices clip
        rep(steps*stack, k) .lines_steps_load2 x
        // ablate "sprnoemit" (measurement only): keep the RECORD half, never read the
        // fragments back. The frame is then identical to a things=False build, so the
        // delta against one prices the record half ALONE -- by subtraction from a
        // byte-exact frame, not by stubbing something the rest of the frame depends on.
        rep(things*spremit, k) .lines_spr_load sprfl, ssy1, ssy2, sy0b, sblk, slr, ssy1b, ssy2b, sy0bb, sblkb, slrb, x
        // M13-ditto: same clip rows as the previous (adjacent, same-seg) column -> the whole pair
        // list would be identical, so emit [x][0xFE] ("copy column x-1" -- the owner-approved
        // rectangle-widening) and skip both band walks. 58% of E1M1-spawn columns take this path.
        // W1R-ANCHOR: the pattern key is (x + wnoff), wnoff = viewangle*640/turn computed
        // once per frame -- turning slides the masonry WITH the walls instead of
        // re-rolling it (the flickering-TV fix's temporal half).
        rep(w1r, k) hex.zero 4, xa
        rep(w1r, k) hex.mov 2, xa, x
        rep(w1r, k) hex.add 4, xa, wnoff
        rep(noise*(1-w1r), k) wnoise.lookup gnrow, x   // V1 grain (non-W1R): unanchored
        rep(noise*w1r, k) wnoise.lookup gnrow, xa
        rep(w1r, k) wnoise2.lookup gnrow2, xa   // W1R-LOD: the fine + coarse group keys
        rep(w1r, k) wnoise3.lookup gnrow3, xa
        hex.if0 1, dvalid, dfull
        hex.cmp 2, cexcl, dct, dfull, dchk2, dfull
      dchk2:
        hex.cmp 2, fstart, dfs, dfull, dgchk, dfull
      dgchk:
        // V1: ... and the same GRAIN row. The grain varies per x>>2 group, so two adjacent columns
        // can share clip rows and plane yet render differently -- without this the ditto ("copy
        // column x-1") fires across a group boundary and the frame diverges. Measured before the
        // fix: the first differing pixel sat at column 12 and at column 144, both x = 0 (mod 4).
        // ⚠ EVERY feature that changes a column's CONTENT without changing its CLIP ROWS must join
        // this chain -- that includes the step faces and the sprite fragments still to come.
        rep(noise, k) hex.cmp 2, gnrow, dgn, dfull, dg3c, dfull
      dg3c:
        // W1R-LOD: the coarse 8-px key is in every stacked pattern pick (the near tier)
        rep(w1r, k) hex.cmp 2, gnrow3, dgn3, dfull, dg2g, dfull
      dg2g:
        // ... the fine 2-px key matters only for FAR-tier walls (wlen < 16) or columns that
        // carry a boundary piece/face (faces pick their pattern by their own height): gate
        // the compare so near plain columns keep their 4-px ditto granularity
        rep(w1r, k) hex.mov 2, dwl, fstart
        rep(w1r, k) hex.sub 2, dwl, cexcl
        rep(w1r, k) hex.if0 2, dwl, dgfc
        rep(w1r, k) hex.cmp 2, dwl, cw16, dg2c, dgfc, dgfc
      dgfc:
        rep(w1r, k) hex.if0 1, ucnt, dgf2
        rep(w1r, k) .lines_jmp dg2c
      dgf2:
        rep(w1r, k) hex.if0 1, lcnt, dgf3
        rep(w1r, k) .lines_jmp dg2c
      dgf3:
        rep(w1r, k) hex.if0 1, ufl, dgf4
        rep(w1r, k) .lines_jmp dg2c
      dgf4:
        rep(w1r, k) hex.if0 1, lfl, dschk
      dg2c:
        rep(w1r, k) hex.cmp 2, gnrow2, dgn2, dfull, dschk, dfull
      dschk:
        rep(sky, k) hex.cmp 2, soff, dsoff, dfull, dstchk, dfull
      dstchk:
        // V3: ... and the same STEP FACES. A face is a run whose rows come from a DIFFERENT seg's
        // projection, so two neighbours can share clip rows, plane and grain and still differ.
        // ⚠ COMPARE them, do not refuse the ditto outright: the first build did refuse, stayed
        // byte-exact, and cost +4.06M/+9.16M -- because at an outdoor viewpoint nearly every column
        // carries a face, so "no ditto on a face column" is "no ditto", and ditto is worth ~4.8M.
        // The six values below are exactly the emit's face inputs, so equal signature => identical
        // pair list; the projection changes slowly across a flat surface, so long runs still ditto.
        rep(steps, k) hex.cmp 2, uy1, duy1, dfull, dst2, dfull
      dst2:
        rep(steps, k) hex.cmp 2, uy2p1, duy2, dfull, dst3, dfull
      dst3:
        rep(steps, k) hex.cmp 2, ucol, ducol, dfull, dst4, dfull
      dst4:
        rep(steps, k) hex.cmp 2, ly1, dly1, dfull, dst5, dfull
      dst5:
        rep(steps, k) hex.cmp 2, ly2p1, dly2, dfull, dst6, dfull
      dst6:
        rep(steps, k) hex.cmp 2, lcol, dlcol, dfull, dsp1, dfull
      dsp1:
        // V4: ... and the same SPRITE FRAGMENT. Fifth feature on this chain; same rule as V3 --
        // COMPARE it, never refuse the ditto, or the columns AROUND a billboard stop dittoing too.
        // The four values are the emit's whole sprite input (the block index carries r0/last_rel).
        rep(things, k) hex.cmp 2, ssy1, dssy1, dfull, dsp2, dfull
      dsp2:
        rep(things, k) hex.cmp 2, ssy2, dssy2, dfull, dsp3, dfull
      dsp3:
        rep(things, k) hex.cmp 4, sy0b, dsy0b, dfull, dsp4, dfull
      dsp4:
        rep(things, k) hex.cmp 4, sblk, dsblk, dfull, dsp5, dfull
      dsp5:
        // V4b: ... and the SECOND fragment's signature (zeroed when absent, like slot A's --
        // a real fragment's biased y0 is never 0, so presence is encoded in the values).
        rep(things, k) hex.cmp 2, ssy1b, dssy1b, dfull, dsp6, dfull
      dsp6:
        rep(things, k) hex.cmp 2, ssy2b, dssy2b, dfull, dsp7, dfull
      dsp7:
        rep(things, k) hex.cmp 4, sy0bb, dsy0bb, dfull, dsp8, dfull
      dsp8:
        rep(things, k) hex.cmp 4, sblkb, dsblkb, dfull, dvc2, dfull
      dvc2:
        // V5: ... and the STACKED-piece signature. Counts first; the field compares are gated
        // on the (equal) count, so pieceless columns pay two compares and two if0s only.
        rep(stack, k) hex.cmp 2, ucnt, ducnt, dfull, dvup, dfull
      dvup:
        rep(stack, k) hex.cmp 2, lcnt, dlcnt, dfull, dvu2, dfull
      dvu2:
        rep(stack, k) hex.if0 1, ucnt, dvlo
        rep(stack, k) hex.cmp 2, u1y1, du1y1, dfull, dvu3, dfull
      dvu3:
        rep(stack, k) hex.cmp 2, u1y2, du1y2, dfull, dvu4, dfull
      dvu4:
        rep(stack, k) hex.cmp 2, u1cls, du1cls, dfull, dvu5, dfull
      dvu5:
        rep(stack, k) hex.cmp 2, u1bp, du1bp, dfull, dvu6, dfull
      dvu6:
        rep(stack, k) hex.cmp 2, u2y1, du2y1, dfull, dvu7, dfull
      dvu7:
        rep(stack, k) hex.cmp 2, u2y2, du2y2, dfull, dvu8, dfull
      dvu8:
        rep(stack, k) hex.cmp 2, u2cls, du2cls, dfull, dvu9, dfull
      dvu9:
        rep(stack, k) hex.cmp 2, u2bp, du2bp, dfull, dvlo, dfull
      dvlo:
        rep(stack, k) hex.if0 1, lcnt, dpl
        rep(stack, k) hex.cmp 2, l1y1, dl1y1, dfull, dvl2, dfull
      dvl2:
        rep(stack, k) hex.cmp 2, l1y2, dl1y2, dfull, dvl3, dfull
      dvl3:
        rep(stack, k) hex.cmp 2, l1cls, dl1cls, dfull, dvl4, dfull
      dvl4:
        rep(stack, k) hex.cmp 2, l1bp, dl1bp, dfull, dvl5, dfull
      dvl5:
        rep(stack, k) hex.cmp 2, l2y1, dl2y1, dfull, dvl6, dfull
      dvl6:
        rep(stack, k) hex.cmp 2, l2y2, dl2y2, dfull, dvl7, dfull
      dvl7:
        rep(stack, k) hex.cmp 2, l2cls, dl2cls, dfull, dvl8, dfull
      dvl8:
        rep(stack, k) hex.cmp 2, l2bp, dl2bp, dfull, dvl9, dfull
      dvl9:
      dpl:
        // ... and (pnear) the same two plane surfaces, else the pair lists differ after all
        rep(1-pnear, k) .lines_jmp dsame
        rep(pnear, k) .lines_ditto_plane pval8, dpid, dsame, dfull
      dsame:
        byte.emit x
        stl.output_char 0xFE
        ;demitted
      dfull:
        // fj decided everything -- emit this column's ceiling bands, wall, floor bands as raw lines
        stream.emit_col_lines centery, viewh, w2s, wpx, w1r, wpxstride, eabl, noise, steps, things, blkshift, ascode, stack, deg, gnrow, x, cexcl, fstart, ufl, uy1, uy2p1, ucol, lfl, ly1, ly2p1, lcol, sprfl, ssy1, ssy2, sy0b, sblk, slr, ssy1b, ssy2b, sy0bb, sblkb, slrb, seg_lit, seg_lit2, seg_wstrip, wstripbase, cbufa, cbufd, fbufa, fbufd
        hex.mov 2, dct, cexcl                   // remember this column's clip rows for the ditto test
        hex.mov 2, dfs, fstart
        hex.mov 2, duy1, uy1                    // V3: the face signature, unconditional (same
        hex.mov 2, duy2, uy2p1                  // reason as dgn -- an unused label is an error)
        hex.mov 2, ducol, ucol
        hex.mov 2, dly1, ly1
        hex.mov 2, dly2, ly2p1
        hex.mov 2, dlcol, lcol
        hex.mov 2, dssy1, ssy1                  // V4: the sprite signature, unconditional
        hex.mov 2, dssy2, ssy2
        hex.mov 4, dsy0b, sy0b
        hex.mov 4, dsblk, sblk
        hex.mov 2, dssy1b, ssy1b                // V4b: the second fragment's signature
        hex.mov 2, dssy2b, ssy2b
        hex.mov 4, dsy0bb, sy0bb
        hex.mov 4, dsblkb, sblkb
        hex.mov 2, ducnt, ucnt                  // V5: the stacked-piece signature, unconditional
        hex.mov 2, du1y1, u1y1                  // (the dgn rule: the cells must never be unused)
        hex.mov 2, du1y2, u1y2
        hex.mov 2, du1cls, u1cls
        hex.mov 2, du1bp, u1bp
        hex.mov 2, du2y1, u2y1
        hex.mov 2, du2y2, u2y2
        hex.mov 2, du2cls, u2cls
        hex.mov 2, du2bp, u2bp
        hex.mov 2, dlcnt, lcnt
        hex.mov 2, dl1y1, l1y1
        hex.mov 2, dl1y2, l1y2
        hex.mov 2, dl1cls, l1cls
        hex.mov 2, dl1bp, l1bp
        hex.mov 2, dl2y1, l2y1
        hex.mov 2, dl2y2, l2y2
        hex.mov 2, dl2cls, l2cls
        hex.mov 2, dl2bp, l2bp
        hex.mov 2, dsoff, soff                  // V2: unconditional, same reason as dgn
        hex.mov 2, dgn2, gnrow2                 // W1R-LOD: the two extra key shadows
        hex.mov 2, dgn3, gnrow3
        hex.mov 2, dgn, gnrow                   // V1: unconditional so `dgn` is never an UNUSED
                                                // label when the grain is off -- the assembler
                                                // rejects those outright. ~55 ops x 160 columns.
        rep(pnear, k) .lines_save_plane pval8, dpid
        hex.set 1, dvalid, 1
      demitted:
        hex.write_byte_and_inc dptr, one        // drawn = 1 (advances to the next column's slot)
        hex.inc 2, n_drawn
        hex.cmp 2, n_drawn, vieww, skipcol, sfull, skipcol
      sfull:
        hex.set 1, full, 1
      skipcol:
        hex.inc 2, x
        hex.add 8, scale, scalestep
        ;loop
      ret:
        stl.fret seg_ret2
      one: hex.vec 2
      cVH: hex.vec 8
      cexcl: hex.vec 8
      fstart: hex.vec 8
      dvalid: hex.vec 1
      dct: hex.vec 2
      dfs: hex.vec 2
      dpid: hex.vec 2
      wtc8: hex.vec 8
      wtf8: hex.vec 8
      skb: hex.vec 2                            // V2: the frame's sky scroll
      soff: hex.vec 2                           // V2: this column's sky list index
      dsoff: hex.vec 2                          // ... and the previously emitted one
      issky: hex.vec 2
      gnrow: hex.vec 2                          // V1: this column's grain row
      dgn: hex.vec 2                            // ... and the previously emitted one
      dgn2: hex.vec 2                           // W1R-LOD: the fine/coarse key shadows
      dgn3: hex.vec 2
      dwl: hex.vec 2                            // ... and the ditto-gate's wlen scratch
      cw16: hex.vec 2, 16
      slw: hex.vec 2                            // 25M-CAP: the seg's span, for the sliver test
      slc: hex.vec 2                            // ... and the compile-time width bound cell
      xa: hex.vec 4                             // W1R-ANCHOR: x + wnoff, the shifted key
      stv: hex.vec 2                            // V3: which step-face slots this column holds
      ufl: hex.vec 1                            // V3: draw an upper face in this column?
      uy1: hex.vec 2                            // ... its first row,
      uy2p1: hex.vec 2                          // ... its exclusive end row,
      ucol: hex.vec 2                           // ... and its shade
      lfl: hex.vec 1                            // V3: the same four for the lower face
      ly1: hex.vec 2
      ly2p1: hex.vec 2
      lcol: hex.vec 2
      duy1: hex.vec 2                           // ... and the previously emitted column's six, the
      duy2: hex.vec 2                           // DITTO SIGNATURE
      ducol: hex.vec 2
      dly1: hex.vec 2
      dly2: hex.vec 2
      dlcol: hex.vec 2
      sprfl: hex.vec 2                          // V4: does this column carry a sprite fragment?
      ssy1: hex.vec 2                           // ... its first row,   (sy0b/dsy0b are 4-nibble:
                                                //     two-byte biased y0, see lines_spr_load)
      ssy2: hex.vec 2                           // ... one past its last,
      sy0b: hex.vec 4                           // ... the sprite's row 0, BIASED by 32768,
      sblk: hex.vec 4                           // ... its baked run-list block,
      slr: hex.vec 2                            // ... and its shade row
      dssy1: hex.vec 2                          // ... and the previously emitted column's four
      dssy2: hex.vec 2
      dsy0b: hex.vec 4
      dsblk: hex.vec 4
      ssy1b: hex.vec 2                          // V4b: the SECOND (farther) fragment's five ...
      ssy2b: hex.vec 2
      sy0bb: hex.vec 4
      sblkb: hex.vec 4
      slrb: hex.vec 2
      dssy1b: hex.vec 2                         // ... and its previously emitted signature
      dssy2b: hex.vec 2
      dsy0bb: hex.vec 4
      dsblkb: hex.vec 4
      ducnt: hex.vec 2                          // ... and the previously emitted signature
      du1y1: hex.vec 2
      du1y2: hex.vec 2
      du1cls: hex.vec 2
      du1bp: hex.vec 2
      du2y1: hex.vec 2
      du2y2: hex.vec 2
      du2cls: hex.vec 2
      du2bp: hex.vec 2
      dlcnt: hex.vec 2
      dl1y1: hex.vec 2
      dl1y2: hex.vec 2
      dl1cls: hex.vec 2
      dl1bp: hex.vec 2
      dl2y1: hex.vec 2
      dl2y2: hex.vec 2
      dl2cls: hex.vec 2
      dl2bp: hex.vec 2
      dtop: hex.vec 8                           // ablate "projtwice" only: dead projection outputs
      dbot: hex.vec 8
      dscale: hex.vec 8                         // ablate "scaletwice" only: dead scale-setup outputs
      dsstep: hex.vec 8
      cbufa: hex.vec w/4
      cbufd: hex.vec w/4
      fbufa: hex.vec w/4
      fbufd: hex.vec w/4
    }

    def lines_projcall centeryfix_c, viewh1, top, bottom, scale, wtc8, wtf8 {
        proj.column_params_m top, bottom, scale, wtc8, wtf8, centeryfix_c, viewh1
    }

    def lines_projstub centery, top, bottom {
        hex.set 8, top, 10
        hex.set 8, bottom, centery
    }

    // ── M13-2S rung 3b helpers: the per-column STATE and the two pair BUFFERS ─────────────────
    // `colst` holds 4 packed bytes per column -- [chi][flo][tcnt][bcnt] -- where chi/flo are the
    // window's exclusive-end row bounds (DOOM's ceilingclip+1 / floorclip) and tcnt/bcnt are the
    // BYTES used in the column's top / bottom pair buffers. `colbuf` gives each column tcap bytes of
    // top area followed by bcap of bottom. Both pointers walk in lockstep with the column loop, so
    // a column visit costs one ptr_add each, not a ptr_index (72@ -- fj-lessons R37).
    def col_ptrs x1, ecap @ idx, end < cstp, cbfp, dptr, dbase, colst, colbuf {
        hex.zero w/4, idx
        hex.mov 2, idx, x1
        hex.mul_const w/4, idx, idx, 4*dw
        hex.set w/4, cstp, colst
        hex.add w/4, cstp, idx
        hex.zero w/4, idx
        hex.mov 2, idx, x1
        hex.mul_const w/4, idx, idx, 10*ecap*dw
        hex.set w/4, cbfp, colbuf
        hex.add w/4, cbfp, idx
        hex.ptr_index dptr, dbase, x1
        ;end
      idx: hex.vec w/4
      end:
    }

    def col_ptrs_step ecap < cstp, cbfp, dptr {
        hex.ptr_add cstp, 4
        hex.ptr_add cbfp, 10*ecap
        hex.ptr_add dptr, 1
    }

    def col_state_load < cstp, chi, flo {
        hex.read_byte chi, cstp
        hex.ptr_add cstp, 1
        hex.read_byte flo, cstp
        hex.ptr_sub cstp, 1
    }

    def col_state_store < cstp, chi, flo {
        hex.write_byte cstp, chi
        hex.ptr_add cstp, 1
        hex.write_byte cstp, flo
        hex.ptr_sub cstp, 1
    }

    def buf_top_open @ end < cstp, cbfp, tcnt, tptr, idx {
        hex.ptr_add cstp, 2
        hex.read_byte tcnt, cstp
        hex.ptr_sub cstp, 2
        entoff.lookup idx, tcnt                  // entry index -> byte offset, by DISPATCH:
        hex.mov w/4, tptr, cbfp                  // mul_const is 9 shifts of w/4 (~72@) and this
        hex.add w/4, tptr, idx                   // is a handful (fj-cost-model, M13-ATANDISP)
        ;end
      end:
    }

    def buf_top_close < cstp, tcnt {
        hex.ptr_add cstp, 2
        hex.write_byte cstp, tcnt
        hex.ptr_sub cstp, 2
    }

    def buf_bot_open ecap @ end < cstp, cbfp, bcnt, bptr, idx {
        hex.ptr_add cstp, 3
        hex.read_byte bcnt, cstp
        hex.ptr_sub cstp, 3
        entoff.lookup idx, bcnt
        hex.mov w/4, bptr, cbfp
        hex.add_constant w/4, bptr, 5*ecap*dw
        hex.add w/4, bptr, idx
        ;end
      end:
    }

    // close a bottom BLOCK with its 1-byte length TRAILER (in BYTES, so the flush's backward walk
    // needs no division): the flush reads the trailer, steps back over the block's pairs, emits them
    // forward, and repeats -- bottom-up block order, top-down pairs inside each block.
    def buf_bot_close < cstp, bcnt {
        hex.ptr_add cstp, 3
        hex.write_byte cstp, bcnt
        hex.ptr_sub cstp, 3
    }

    // ctake = clamp(top, 0, VIEW_H) and fstart = clamp(bottom+1, 0, VIEW_H): DOOM's signed row
    // clipping, folded once per column so everything after it is 2-nibble unsigned.
    def row_clamp_top dst, src, viewh @ lo, hi, keep, clampv, cVH, end {
        hex.sign 8, src, lo, hi
      lo:
        hex.zero 2, dst
        ;end
      hi:
        hex.set 8, cVH, viewh
        hex.scmp 8, src, cVH, keep, keep, clampv
      keep:
        hex.mov 2, dst, src
        ;end
      clampv:
        hex.set 2, dst, viewh
        ;end
      cVH: hex.vec 8
      end:
    }

    def row_clamp_bot dst, src, viewh @ tmp, end {
        hex.mov 8, tmp, src
        hex.inc 8, tmp
        .row_clamp_top dst, tmp, viewh
        ;end
      tmp: hex.vec 8
      end:
    }

    // the one-sided wall's run: [max(ctake, chi), min(fstart, flo))
    def wall_span y1, y2, ctake, fstart @ a, b, clampf, end < chi, flo {
        hex.mov 2, y1, ctake
        hex.cmp 2, y1, chi, a, b, b
      a:
        hex.mov 2, y1, chi
      b:
        hex.mov 2, y2, fstart
        hex.cmp 2, y2, flo, end, end, clampf
      clampf:
        hex.mov 2, y2, flo
      end:
    }

    // ablate "colstub" (measurement only): a column visit that does the bookkeeping a one-sided
    // wall would -- close the window -- but none of the projection, region or buffer work. The
    // delta against the full body prices that work with the walk's early-outs still firing.
    def ts_stub_close < chi, flo, viewh_stub {
        hex.mov 2, chi, viewh_stub
        hex.zero 2, flo
    }

    // ══ M13-2S rung 3b — the TWO-SIDED per-column body ══════════════════════════════════════
    // DOOM's R_RenderSegLoop window, per column, per seg, front-to-back:
    //     front CEILING region | upper wall | (opening) | lower wall | front FLOOR region
    // narrowing [chi, flo) from both ends; a one-sided seg fills what is left and closes the
    // column. Each piece appends finished [y2][colour] pairs to the column's TOP or BOTTOM buffer
    // (stream.band_range / stream.wall_run); the record itself is assembled after the walk by
    // stream.flush_col, because the bottom pieces arrive in the wrong order for the 0x0B protocol.
    //
    // Everything here is 2-nibble UNSIGNED row arithmetic on EXCLUSIVE ends, which is what makes it
    // cheap: `ctake` = clamp(top, 0, VIEW_H) and `fstart` = clamp(bot+1, 0, VIEW_H) fold DOOM's
    // signed clipping away, and then
    //     ceiling region = [chi, min(ctake, flo))      upper wall = [chi, min(ufst, flo))
    //     floor region   = [max(fstart, chi), flo)     lower wall = [max(ltak, chi), flo)
    //     one-sided wall = [max(ctake, chi), min(fstart, flo))   -> closes the column
    // `seg_flags` bit 0 = two-sided, bit 1 = has upper, bit 2 = has lower (baked per seg).
    def seg_pass2_leaf_body_2s centery, viewh1, viewh, projection, half_slots, ecap, colstub @ loop, body, work, nextcol, ret, cdone, cge, doceil, noceil, fdone, fhi, dofloor, nofloor, haswin, nowin, solid, twosided, ckl, doproj, dosolid, nosolid, didclose, doup, uclip, upck, upno, dolo, lohi, lock, lono, sfull, cVH, ctake, fstart, cend, fbeg, wtop, wend, uend, lbeg, ltak, ubot, ltop, wtc8, wtf8, wbc8, wbf8, one, cbufa, cbufd, fbufa, fbufd < viewangle, seg_segangle, sgn_aff, ceilfix, floorfix, bceilfix, bfloorfix, viewz, seg_flags, seg_pid, seg_wstrip, seg_wsupper, seg_wslower, x1, x2, x, chi, flo, tcnt, bcnt, tptr, bptr, dptr, normalangle, rw_distance, scale, scalestep, top, bottom, seg_ret2, full, n_drawn, vieww {
        proj.wall_setup_sgn normalangle, rw_distance, sgn_aff, seg_segangle
        proj.wall_scale_setup_m scale, scalestep, viewangle, normalangle, rw_distance, x1, x2, projection
        hex.mov 4, wtc8, ceilfix + 4*dw
        hex.sub 4, wtc8, viewz + 4*dw
        hex.sign_extend 8, 4, wtc8
        hex.mov 4, wtf8, floorfix + 4*dw
        hex.sub 4, wtf8, viewz + 4*dw
        hex.sign_extend 8, 4, wtf8
        hex.mov 4, wbc8, bceilfix + 4*dw         // the BACK sector's two heights (0 for one-sided,
        hex.sub 4, wbc8, viewz + 4*dw            // where seg_flags keeps them unused)
        hex.sign_extend 8, 4, wbc8
        hex.mov 4, wbf8, bfloorfix + 4*dw
        hex.sub 4, wbf8, viewz + 4*dw
        hex.sign_extend 8, 4, wbf8
        .lines_pid_addrs seg_pid, half_slots, cbufa, cbufd, fbufa, fbufd
        hex.mov 8, x, x1
        .col_ptrs x1, ecap                 // cstp / cbfp: the per-column state + buffers
        hex.set 2, one, 1
      loop:
        hex.cmp 2, x, x2, body, ret, ret
      body:
        .col_state_load                          // chi, flo (2 packed bytes at cstp)
        hex.cmp 2, chi, flo, work, nextcol, nextcol
      work:
        rep(colstub, k) .ts_stub_close          // ablate: close as a solid wall would, no work
        proj.column_params_m top, bottom, scale, wtc8, wtf8, centery*0x10000, viewh1
        .row_clamp_top ctake, top, viewh
        .row_clamp_bot fstart, bottom, viewh
        // ── front-sector CEILING region [chi, min(ctake, flo))
        hex.mov 2, cend, ctake
        hex.cmp 2, cend, flo, cdone, cdone, cge
      cge:
        hex.mov 2, cend, flo
      cdone:
        hex.cmp 2, chi, cend, doceil, noceil, noceil
      doceil:
        .buf_top_open
        stream.entry_append tptr, tcnt, 0, seg_pid, chi, cend
        .buf_top_close
        hex.mov 2, chi, cend
      noceil:
        // ── front-sector FLOOR region [max(fstart, chi), flo)
        hex.mov 2, fbeg, fstart
        hex.cmp 2, fbeg, chi, fhi, fdone, fdone
      fhi:
        hex.mov 2, fbeg, chi
      fdone:
        hex.cmp 2, fbeg, flo, dofloor, nofloor, nofloor
      dofloor:
        .buf_bot_open ecap
        stream.entry_append bptr, bcnt, 1, seg_pid, fbeg, flo
        .buf_bot_close
        hex.mov 2, flo, fbeg
      nofloor:
        // ── the window [chi, flo): the wall(s)
        hex.cmp 2, chi, flo, haswin, nowin, nowin
      haswin:
        hex.if0 1, seg_flags, solid              // bit 0 clear -> one-sided: fill and close
        ;twosided
      solid:
        .wall_span wtop, wend, ctake, fstart     // [max(ctake,chi), min(fstart,flo))
        hex.cmp 2, wtop, wend, dosolid, nosolid, nosolid
      dosolid:
        .buf_top_open
        stream.entry_append tptr, tcnt, 2, seg_wstrip, wtop, wend
        .buf_top_close
      nosolid:
        hex.set 2, chi, viewh                    // ceilclip = H, floorclip = -1: column finished
        hex.zero 2, flo
        ;didclose
      twosided:
        // the BACK sector's two projected rows -- only for segs that actually have an upper or a
        // lower. A marking-only two-sided seg (equal heights, different flat or light) contributes
        // plane regions and nothing else, and it is the commonest kind.
        hex.if0 1, seg_flags + 1*dw, ckl
        ;doproj
      ckl:
        hex.if0 1, seg_flags + 2*dw, nowin
      doproj:
        proj.column_params_m ubot, ltop, scale, wbc8, wbf8, centery*0x10000, viewh1
        hex.if0 1, seg_flags + 1*dw, upno        // bit 1: front ceiling above back ceiling
        // the upper wall ends where the BACK ceiling projects: DOOM's `min(ub - 1, win_lo)` is an
        // INCLUSIVE end, so the exclusive one is ub itself -- no +1, unlike the one-sided wall
        // whose end comes from `bot` (measured: +1 here paints one row of step face too many).
        .row_clamp_top uend, ubot, viewh         // upper wall = [chi, min(uend, flo))
        hex.cmp 2, uend, flo, upck, upck, uclip
      uclip:
        hex.mov 2, uend, flo
      upck:
        hex.cmp 2, chi, uend, doup, upno, upno
      doup:
        .buf_top_open
        stream.entry_append tptr, tcnt, 2, seg_wsupper, chi, uend
        .buf_top_close
        hex.mov 2, chi, uend
      upno:
        hex.if0 1, seg_flags + 2*dw, lono        // bit 2: back floor above front floor
        .row_clamp_top ltak, ltop, viewh         // lower wall = [max(ltak, chi), flo)
        hex.mov 2, lbeg, ltak
        hex.cmp 2, lbeg, chi, lohi, lock, lock
      lohi:
        hex.mov 2, lbeg, chi
      lock:
        hex.cmp 2, lbeg, flo, dolo, lono, lono
      dolo:
        .buf_bot_open ecap
        stream.entry_append bptr, bcnt, 2, seg_wslower, lbeg, flo
        .buf_bot_close
        hex.mov 2, flo, lbeg
      lono:
      nowin:
        .col_state_store                         // chi, flo back to the column state
        hex.cmp 2, chi, flo, nextcol, didclose, didclose
      didclose:
        .col_state_store
        hex.write_byte dptr, one                 // pass 1's occlusion prescan reads drawn[]
        hex.inc 2, n_drawn                       // the column can never paint again
        hex.cmp 2, n_drawn, vieww, nextcol, sfull, nextcol
      sfull:
        hex.set 1, full, 1
      nextcol:
        .col_ptrs_step ecap
        hex.inc 2, x
        hex.add 8, scale, scalestep
        ;loop
      ret:
        stl.fret seg_ret2
      cVH: hex.vec 8
      ctake: hex.vec 2
      fstart: hex.vec 2
      cend: hex.vec 2
      fbeg: hex.vec 2
      wtop: hex.vec 2
      wend: hex.vec 2
      uend: hex.vec 2
      lbeg: hex.vec 2
      ltak: hex.vec 2
      ubot: hex.vec 8
      ltop: hex.vec 8
      wtc8: hex.vec 8
      wtf8: hex.vec 8
      wbc8: hex.vec 8
      wbf8: hex.vec 8
      one: hex.vec 2
      cbufa: hex.vec w/4
      cbufd: hex.vec w/4
      fbufa: hex.vec w/4
      fbufd: hex.vec w/4
    }

    // ── M13opt2 R_MakeSpans (compile-time-column) — the per-ROW TEXTURED floor/ceiling span pass. For each
    //    screen row y, the COLUMN scan is UNROLLED (`rep(view_w, x) plane_col x`) so every per-column array read
    //    is a DIRECT mov from a COMPILE-TIME address `col_X + 8*x*dw` — NO runtime `ptr_index` (the M13d2 runtime
    //    xcur loop's dominant cost: ~58% of the floor pass was the per-cell pointer reads of column-CONSTANT
    //    arrays re-read once per row). The span GROUPING + boundaries are byte-identical to the oracle: a column
    //    is FLOOR at row y if y >= col_fstart[x], CEILING if y < col_cexcl[x] (floor first; bands never overlap),
    //    else WALL (skip). Spans are closed (drawn via span_leaf) on a visplane change or row end. The span STATE
    //    (inspan/spanR/spanph/spanfb/spanlt/spanx1) + the classify scratch (cR/cph/cfb/clt/cexcl/fstart) are
    //    GLOBALS (shared by plane_col). view_w/view_h compile-time. @requires hex.init & stl.ptr_init. ─────────
    def render_planes_spans view_w, view_h \
            @ yloop, ybody, done, end, trail, notrail, cVH \
            < y, planeheight, light, flatbase, x1, x2, span_leaf, span_ret, \
              inspan, spanph, spanfb, spanlt, spanx1 {
        hex.set 2, cVH, view_h
        hex.zero 2, y
      yloop:
        hex.cmp 2, y, cVH, ybody, done, done             // y < view_h ? render the row : done
      ybody:
        hex.zero 1, inspan
        rep(view_w, x) frame.plane_col x                 // UNROLLED column scan (compile-time addresses)
      trail:
        hex.if0 1, inspan, notrail                       // close the trailing span [spanx1, view_w-1]
        hex.mov 2, x1, spanx1
        hex.set 2, x2, view_w - 1
        hex.mov 8, planeheight, spanph
        hex.mov 2, light, spanlt
        hex.mov 5, flatbase, spanfb
        stl.fcall span_leaf, span_ret
      notrail:
        hex.inc 2, y
        ;yloop
      done:
        ;end
      cVH: hex.vec 2
      end:
    }

    // M13opt2 — one UNROLLED column x of the span scan (called by render_planes_spans via rep). Reads column x's
    // visplane params from COMPILE-TIME addresses (`col_X + 8*x*dw`, the 8-nibble stride) — no ptr_index. Decides
    // the region at the runtime row y, then advances the running span: EXTEND if x's visplane matches the open
    // span, else CLOSE it (draw_span [spanx1, x-1]) and (if x is a plane column) START a new span at x. The span
    // state + scratch are globals (shared across the rep). @requires hex.init & stl.ptr_init.
    def plane_col x \
            @ ckceil, do_floor, do_ceil, skip, classified, e2, e3, e4, doclose, maybestart, nostart, colend \
            < y, planeheight, light, flatbase, x1, x2, span_leaf, span_ret, \
              inspan, spanR, spanph, spanfb, spanlt, spanx1, cR, cph, cfb, clt, cexcl, fstart, \
              col_cexcl, col_fstart, col_ceil_ph, col_floor_ph, col_plight, col_ceilbase, col_floorbase {
        hex.mov 2, cexcl, col_cexcl + 8*x*dw             // compile-time address reads (no ptr_index)
        hex.mov 2, fstart, col_fstart + 8*x*dw
        hex.cmp 2, y, fstart, ckceil, do_floor, do_floor // y >= fstart -> floor
      ckceil:
        hex.cmp 2, y, cexcl, do_ceil, skip, skip         // y < cexcl -> ceiling; else WALL (skip)
      do_floor:
        hex.set 2, cR, 2
        hex.mov 8, cph, col_floor_ph + 8*x*dw
        hex.mov 5, cfb, col_floorbase + 8*x*dw
        hex.mov 2, clt, col_plight + 8*x*dw
        ;classified
      do_ceil:
        hex.set 2, cR, 1
        hex.mov 8, cph, col_ceil_ph + 8*x*dw
        hex.mov 5, cfb, col_ceilbase + 8*x*dw
        hex.mov 2, clt, col_plight + 8*x*dw
        ;classified
      skip:
        hex.zero 2, cR
      classified:
        hex.if0 1, inspan, maybestart                    // not in a span -> try to START at x
        hex.cmp 2, cR, spanR, doclose, e2, doclose       // in a span: matches? (extend iff all 4 equal)
      e2:
        hex.cmp 8, cph, spanph, doclose, e3, doclose
      e3:
        hex.cmp 5, cfb, spanfb, doclose, e4, doclose
      e4:
        hex.cmp 2, clt, spanlt, doclose, colend, doclose // all match -> colend (extend); else close
      doclose:
        hex.mov 2, x1, spanx1                            // emit [spanx1, x-1]
        hex.set 2, x2, x
        hex.dec 2, x2                                    // x2 = x - 1  (set x then dec, avoids a negative literal)
        hex.mov 8, planeheight, spanph
        hex.mov 2, light, spanlt
        hex.mov 5, flatbase, spanfb
        stl.fcall span_leaf, span_ret
        hex.zero 1, inspan
        ;maybestart                                      // then try to start a new span at x
      maybestart:
        hex.if0 2, cR, nostart                           // skip column -> no span starts
        hex.mov 2, spanR, cR
        hex.mov 8, spanph, cph
        hex.mov 5, spanfb, cfb
        hex.mov 2, spanlt, clt
        hex.set 2, spanx1, x                             // span starts at column x (compile-time)
        hex.set 1, inspan, 1
        ;colend
      nostart:
      colend:
    }
}
