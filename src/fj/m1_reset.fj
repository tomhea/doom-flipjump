// ==============================================================================================
// m1_reset.fj      M1's self-reset primitives: byte read/write/clear at a CONSTANT address.
// STATUS  LIVE - the generated main (m1.zerobyte)
// ENTRY   m1.zerobyte
// SIZE    4 macros (m1.zerobyte, m1.readbyte, m1.writebyte, m1.readbyte_dispatch)
// NOTE    m1.readbyte / m1.writebyte are tested but currently unused by the program -- they were
//         built for the C1 dispatch, which does not work (docs/handoff-constaddr.md SS9).
// ==============================================================================================
// M1 -- the self-reset prologue's one new primitive.
//
// The frame's residue is almost all DATA-CELL values, and a nibble cell is cleared by `hex.zero`
// for 19.5 ops. A BYTE cell is not: `hex.write_byte` keeps all 8 bits in ONE cell, and a nibble op
// on one does not merely fail, it CORRUPTS -- measured 0xA5 -> 0x22A5, because `hex.xor`'s dispatch
// jumps out of its own 16-entry table.
//
// `hex.zero_ptr` clears a byte correctly but costs ~796 ops/cell, and 82-86% of that is
// `set_flip_and_jump_pointers` copying an 8-nibble ADDRESS so the machine can reach a cell it only
// knows at RUNTIME. When the address is known at EMIT time, none of that is needed.
//
// MEASURED (scratchpad/ptr_price_list.py, slopes over four program sizes, with vacuity,
// body-removed and --selftest negative controls):
//     hex.zero_ptr   795.9  ->  m1.zerobyte    79.6   10.0x
//     hex.read_byte  628.0  ->  m1.readbyte   111.4    5.6x
//     hex.write_byte 805.6  ->  m1.writebyte  110.3    7.3x
// ⚠ The `943 -> 91.1 (10.3x)` pair quoted in docs/handoff-m1-reset.md and in several commit
// messages is NOT an isolated per-call cost: the 943 bundles a `ptr_inc` and the 91.1 bundles a
// raw-wflip plant. Use the numbers above.

ns m1 {
    // Clear all 8 bits of the byte cell at the CONSTANT address `c`. NO POINTER AT ALL.
    // MEASURED 91.1 ops/cell against hex.zero_ptr's 943 -- 10.3x (scratchpad/m1_zbyte.py).
    //   1. zero the stl's 2-cell byte register
    //   2. aim the byte table's return at `back`
    //   3. flip bit dbit+8 of c, then JUMP INTO c: its jump word is now (v+256)*dw, which IS
    //      `read_ptr_byte_table + v` -- the table is pinned at op 256 -- and that entry xors v's
    //      bits into read_byte and returns
    //   4. undo both flips, then xor read_byte's two nibbles onto c's own low and high nibble.
    //      `hex.exact_xor`'s d3..d0 are ARBITRARY BIT ADDRESSES, so c's HIGH nibble is reachable
    //      by name -- exactly the thing `hex.zero` cannot do.
    // Verified on ALL 256 byte values, planted with a RAW wflip (hex.xor_by clamps to a nibble,
    // which had already made one cost measurement in this repo vacuous).
    def zerobyte c @ back < hex.pointers.read_byte, hex.pointers.ret_after_read_byte {
        hex.zero 2, hex.pointers.read_byte
        wflip hex.pointers.ret_after_read_byte+w, back
        c+dbit+8; c
      back:
        wflip hex.pointers.ret_after_read_byte+w, back
        c+dbit+8;
        hex.exact_xor c+dbit+3, c+dbit+2, c+dbit+1, c+dbit+0, hex.pointers.read_byte
        hex.exact_xor c+dbit+7, c+dbit+6, c+dbit+5, c+dbit+4, hex.pointers.read_byte+dw
    }

    // M8 F1.5 (docs/f1-runtime-ids.md): zerobyte for a 12-bit list cell (a wide-list map's sshead / thnext, at
    // Config.LIST_ID_BITS 12) -- the same round trip through the WIDE decoder table: flip bit dbit+12 of c, so its jump
    // word is (v+4096)*dw = `read_ptr_wide_table + v` (laid at op 4,096 by -D hex.pointers.PTR_WIDE_BITS=12), which
    // xors v's 12 bits into the 3-nibble read register and returns through ret_after_read_wide; then the three
    // nibbles xor back onto c. Needs the wide table (the guard makes its absence an assembly error, not a wild jump).
    // tests/fj/test_wide_ids_fj.py runs it on planted 0xFFF / 0x100 / 0x0FF / 0x123 (and a mutant missing a nibble).
    def zerocell12 c @ back < hex.pointers.read_byte, hex.pointers.ret_after_read_wide {
        rep(hex.pointers.PTR_WIDE_BITS != 12, i) .zerocell12__needs__D_hex_pointers_PTR_WIDE_BITS_12
        hex.zero 3, hex.pointers.read_byte
        wflip hex.pointers.ret_after_read_wide+w, back
        c+dbit+12; c
      back:
        wflip hex.pointers.ret_after_read_wide+w, back
        c+dbit+12;
        hex.exact_xor c+dbit+3, c+dbit+2, c+dbit+1, c+dbit+0, hex.pointers.read_byte
        hex.exact_xor c+dbit+7, c+dbit+6, c+dbit+5, c+dbit+4, hex.pointers.read_byte+dw
        hex.exact_xor c+dbit+11, c+dbit+10, c+dbit+9, c+dbit+8, hex.pointers.read_byte+2*dw
    }

    // ── the same round trip, minus the clear ──────────────────────────────────────────────────
    // `zerobyte` above is: read the byte, then xor it back onto itself (v ^ v = 0). Splitting the
    // read from the xor gives the other two byte operations for free.

    // READ the byte at CONSTANT address `c`, leaving it in `hex.pointers.read_byte` -- no copy, so
    // this is the cheapest form when the caller only wants to test it.

    // READ the byte at CONSTANT address `c` into the hex[:2] register `dst`.

    // STORE the hex[:2] register `src` into the byte cell at CONSTANT address `c`.
    // Read v, make read_byte = v ^ src, then xor THAT onto c:  c = v ^ (v ^ src) = src.
}
