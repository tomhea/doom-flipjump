// M13pS2c — the LS2 per-column ceiling/floor BAND LIST builder (the column-stream design's floor
// raster). Replaces the row-major `render_planes_spans`/`plane_col`/`plane.draw_span_flat` (M13c3/p1)
// with a per-COLUMN walk: seed the window's first row EXACTLY (one real `hex.fixed_mul`, matching
// `plane.draw_pixel`'s zidx derivation bit-for-bit) then advance via a cheap threshold walk
// (add/compare only) for the rest — mirrors `ReferenceModel._zidx_band_walk` (R15) exactly, so the fj
// kernel and the oracle stay byte-identical. @requires hex.init & stl.ptr_init.

ns plane {
    // perf #11-style: dst = (1<<32)//ph via the SHARED block-FP reciprocal table (`slopediv_recip`,
    // perf #13's SSOT — the SAME table `proj.slope_div`/`column_setup`'s `ipre` already use). Mirrors
    // `ReferenceModel._recip_div32` — RIGHT-NORMALIZE ONLY (no left-normalize branch): valid because
    // any REAL planeheight (16.16, >=1 world unit) has magnitude >= 0x10000, always above the table's
    // 0xFFF threshold, exactly like `column_setup`'s wall-scale `ipre` (SCALE_MIN=256 gives the same
    // guarantee). ⚠ scope limit: an implausibly tiny nonzero planeheight (< 0x100, i.e. under ~0.004
    // world units — never seen in real E1M1 data) would hit the table's unpopulated (zero) region;
    // not guarded, matching how M13pS2a's oracle prototype also only validated realistic magnitudes.
    def recip32 @ sph, rc, cfff, czero2, irecip, nrm, more, done, shloop, shmore, shdone \
            < bb_recip_ph, bb_recip_out, slopediv_recip, plane_recip_ret {
        hex.mov 8, sph, bb_recip_ph
        hex.set 2, rc, 0
        hex.set 8, cfff, 0xFFF
        hex.set 2, czero2, 0
      nrm:
        hex.cmp 8, sph, cfff, done, done, more   // sph > 0xFFF ? gt -> shift right
      more:
        hex.shr_hex 8, 1, sph
        hex.inc 2, rc
        ;nrm
      done:
        hex.read_table_packed 3, irecip, slopediv_recip, 3, sph   // recip[m] (packed, M13-lutpack)
        hex.zero 8, bb_recip_out
        hex.mov 5, bb_recip_out, irecip
        hex.shl_hex 8, 2, bb_recip_out             // recip << 2 nibbles
      shloop:
        hex.cmp 2, rc, czero2, shdone, shdone, shmore
      shmore:
        hex.shr_hex 8, 1, bb_recip_out
        hex.dec 2, rc
        ;shloop
      shdone:                                       // bb_recip_out = (recip<<2) >> rc = recip<<(2-rc)
        stl.fret plane_recip_ret

      sph: hex.vec 8
      rc: hex.vec 2
      cfff: hex.vec 8
      czero2: hex.vec 2
      irecip: hex.vec 6
    }

    // Build ONE column's ceiling/floor BAND LIST: mirrors `ReferenceModel._zidx_band_walk` (R15)
    // exactly. Inputs (globals, caller-set): bb_ph (planeheight, 8nib), bb_light (RAW sector light
    // 0..255, 2nib), bb_base (flat base palette index, 2nib), bb_y0 (window start row, 2nib),
    // bb_count (window length, 2nib — 0 means no window, writes nothing), bb_ascending (2nib, 1 =
    // ceiling/yslope increasing, 0 = floor/yslope decreasing), bb_arr (packed-byte output buffer
    // base, w/4nib, caller-owned, sized for the worst case — see the emitter's MAX_BANDS). Output:
    // bb_n (band-entry count written, 2nib). Each written entry is 3 PACKED bytes (run-length,
    // base — constant, repeated per entry so the reader's format stays uniform — , zrow), read back
    // by `stream.emit_band_list` via `hex.read_byte_and_inc` (byte order: count, base, zrow — the
    // cm-index `zrow<<8|base` decomposes into exactly these two bytes, so no combine is needed here).
    // @requires hex.init & stl.ptr_init.
    def build_bands \
            @ i, ys, ysptr, y0w, yadv, zidx, step, threshold_hi, threshold_lo, thi6, tlo6, cFFF6, \
              zidx8, lvl, zlbase, zlidx, zrow, \
              cur_zrow, runlen, ptr, c127, dist, moved, \
              empty, phzero, seed, seedclamp, seedok, chi_gt, chi_ok, chi_done, clo_gt, clo_ok, clo_done, \
              bhi_gt, bhi_ok, ascbump2, blo_gt, blo_ok, descbump2, \
              bloop, bbody, ascloop, ascmaybe, ascbump, ascstop, \
              descloop, descmaybe, descbump, descstop, classify, samezidx, diffzidx, cont2, \
              flush_final, writeentry, done \
            < bb_ph, bb_light, bb_base, bb_y0, bb_count, bb_ascending, bb_arr, bb_n, \
              bb_recip_ph, bb_recip_out, yslope_packed, zlight, recip32_leaf, plane_recip_ret, \
              plane_band_ret {
        hex.zero 2, bb_n
        hex.if0 2, bb_count, empty
        hex.mov w/4, ptr, bb_arr   // bb_arr is a RUNTIME register holding the buffer address (set by
                                   // the caller per call) -- NOT itself a compile-time array label, so
                                   // this must be hex.mov (copy the held value), never hex.set (which
                                   // would bake bb_arr's OWN storage address as a literal instead of
                                   // reading what's stored there -- the R11-adjacent trap that
                                   // corrupted memory starting at bb_arr's own location, eventually
                                   // smashing adjacent globals/code and crashing with ip<2w).
        hex.zero 3, lvl
        hex.mov 2, lvl, bb_light
        hex.shr_hex 3, 1, lvl                       // lvl = light >> 4 (LIGHTSEGSHIFT)
        hex.if0 8, bb_ph, phzero
        ;seed

      phzero:                                        // ph==0 -> ONE band covering the whole window, zidx=0
        hex.zero 3, zidx
        hex.mul_const 3, zlidx, lvl, 128
        hex.read_table 2, zrow, zlight, 3, zlidx
        hex.write_byte_and_inc ptr, bb_count
        hex.write_byte_and_inc ptr, bb_base
        hex.write_byte_and_inc ptr, zrow
        hex.inc 2, bb_n
        ;done

      seed:                                          // exact zidx at row y0 (mirrors plane.draw_pixel)
        // the yslope walk: ONE incrementing packed-byte pointer over yslope_packed (3 bytes/row,
        // little-endian, 6 nibbles -- max real yslope is 0xA00000). MEASURED: the old per-row
        // `hex.read_table 8` re-derived the full pointer every row at ~10k of the ~12.6k ops/row;
        // 3x read_byte_and_inc through a running pointer is ~4-7x cheaper (R14's array-walk lesson).
        hex.set w/4, ysptr, yslope_packed
        hex.zero w/4, y0w
        hex.mov 2, y0w, bb_y0
        hex.mul_const w/4, yadv, y0w, 3*dw
        hex.add w/4, ysptr, yadv                        // ysptr -> yslope_packed[y0]
        rep(3, k) hex.read_byte_and_inc ys + 2*k*dw, ysptr   // ys[0:6] = yslope[y0]; ptr -> y0+1
        hex.fixed_mul_lo 8, 4, dist, bb_ph, ys             // ys[6:8] stay zero-init (R11-safe wide read)
        hex.shr_hex 8, 5, dist
        hex.set 3, c127, 127
        hex.zero 3, zidx
        hex.mov 3, zidx, dist
        hex.cmp 3, zidx, c127, seedok, seedok, seedclamp   // zidx>127 -> clamp
      seedclamp:
        hex.mov 3, zidx, c127
      seedok:
        hex.mov 8, bb_recip_ph, bb_ph
        stl.fcall recip32_leaf, plane_recip_ret
        hex.zero 8, step
        hex.mov 8, step, bb_recip_out
        hex.shl_hex 8, 1, step                          // step = recip << 1 nibble ( *16 )
        hex.zero 8, zidx8
        hex.mov 3, zidx8, zidx
        hex.mul 8, threshold_lo, step, zidx8            // threshold_lo = step*zidx
        hex.mov 8, threshold_hi, threshold_lo           // threshold_hi = step*(zidx+1) = lo + step
        hex.add 8, threshold_hi, step                   //   (one hex.mul saved per call)
        // the per-row compares run at 6 NIBBLES against CLAMPED copies of the thresholds: ys is at
        // most 0xA00000 < 0xFFFFFF, so min(threshold, 0xFFFFFF) preserves EVERY comparison outcome
        // (a true threshold above 2^24 compares the same as 0xFFFFFF against any real ys), and the
        // clamped copies only need refreshing when a bump changes the threshold -- rare, vs the
        // per-row compare. Byte-identical to comparing the full-width thresholds.
        hex.set 8, cFFF6, 0xFFFFFF
        hex.cmp 8, threshold_hi, cFFF6, chi_ok, chi_ok, chi_gt
      chi_gt:
        hex.set 6, thi6, 0xFFFFFF
        ;chi_done
      chi_ok:
        hex.mov 6, thi6, threshold_hi
      chi_done:
        hex.cmp 8, threshold_lo, cFFF6, clo_ok, clo_ok, clo_gt
      clo_gt:
        hex.set 6, tlo6, 0xFFFFFF
        ;clo_done
      clo_ok:
        hex.mov 6, tlo6, threshold_lo
      clo_done:
        hex.mul_const 3, zlbase, lvl, 128               // zlbase = lvl*128 -- CALL-invariant, hoisted
        hex.mov 3, zlidx, zlbase                        //   out of the per-row classify (R12)
        hex.add 3, zlidx, zidx
        hex.read_table 2, cur_zrow, zlight, 3, zlidx    // seed cur_zrow = zlight[lvl*128+zidx]
        // row y0 is classified AT the seed (runlen=1) and the loop starts at the SECOND row --
        // mirroring the host `_zidx_band_walk` exactly (out=[seed]; walk only rows[1:]). Walking row
        // y0 too (the old shape) also risked a spurious first-row bump whenever the approximate
        // threshold undercuts the exact seed's own yslope.
        hex.set 2, runlen, 1
        hex.set 2, i, 1

      bloop:
        hex.cmp 2, i, bb_count, bbody, flush_final, flush_final
      bbody:
        rep(3, k) hex.read_byte_and_inc ys + 2*k*dw, ysptr   // ys = yslope[y]; ptr -> next row
        hex.zero 1, moved                               // did the walk move zidx THIS row?
        hex.if0 2, bb_ascending, descloop
      ascloop:
        hex.cmp 3, zidx, c127, ascmaybe, ascstop, ascstop
      ascmaybe:
        hex.cmp 6, ys, thi6, ascstop, ascbump, ascbump
      ascbump:
        hex.inc 3, zidx
        hex.add 8, threshold_hi, step
        hex.cmp 8, threshold_hi, cFFF6, bhi_ok, bhi_ok, bhi_gt   // refresh the clamped compare copy
      bhi_gt:
        hex.set 6, thi6, 0xFFFFFF
        ;ascbump2
      bhi_ok:
        hex.mov 6, thi6, threshold_hi
      ascbump2:
        hex.set 1, moved, 1
        ;ascloop
      ascstop:
        ;classify
      descloop:
        hex.if0 3, zidx, descstop
      descmaybe:
        hex.cmp 6, ys, tlo6, descbump, descstop, descstop
      descbump:
        hex.dec 3, zidx
        hex.sub 8, threshold_lo, step
        hex.cmp 8, threshold_lo, cFFF6, blo_ok, blo_ok, blo_gt   // refresh the clamped compare copy
      blo_gt:
        hex.set 6, tlo6, 0xFFFFFF
        ;descbump2
      blo_ok:
        hex.mov 6, tlo6, threshold_lo
      descbump2:
        hex.set 1, moved, 1
        ;descloop
      descstop:
        ;classify
      classify:
        // zidx unmoved this row => zrow unmoved (zrow is a pure function of the call-fixed lvl and
        // zidx) => extend the current run WITHOUT the zlight lookup -- most rows take this path.
        hex.if0 1, moved, samezidx
        // GROUP BY ZROW, not zidx: distinct zidx buckets can share the same darkest/lightest colormap
        // row (zlight clamps), and the oracle's `_expected_bands`/_zidx_band_walk grouping does too --
        // comparing raw zidx here under-merges bands (measured: a single "clamped" band split into
        // dozens of 1-row entries near the horizon before this fix).
        hex.mov 3, zlidx, zlbase
        hex.add 3, zlidx, zidx
        hex.read_table 2, zrow, zlight, 3, zlidx
        hex.cmp 2, zrow, cur_zrow, diffzidx, samezidx, diffzidx
      samezidx:
        hex.inc 2, runlen
        ;cont2
      diffzidx:
        ;writeentry
      cont2:
        hex.inc 2, i
        ;bloop

      writeentry:
        hex.write_byte_and_inc ptr, runlen
        hex.write_byte_and_inc ptr, bb_base
        hex.write_byte_and_inc ptr, cur_zrow
        hex.inc 2, bb_n
        hex.mov 2, cur_zrow, zrow
        hex.set 2, runlen, 1
        ;cont2

      flush_final:
        hex.write_byte_and_inc ptr, runlen
        hex.write_byte_and_inc ptr, bb_base
        hex.write_byte_and_inc ptr, cur_zrow
        hex.inc 2, bb_n
        ;done

      empty:
        ;done

      done:
        stl.fret plane_band_ret

      i: hex.vec 2
      ys: hex.vec 8
      ysptr: hex.vec w/4
      y0w: hex.vec w/4
      yadv: hex.vec w/4
      zidx: hex.vec 3
      step: hex.vec 8
      threshold_hi: hex.vec 8
      threshold_lo: hex.vec 8
      thi6: hex.vec 6
      tlo6: hex.vec 6
      cFFF6: hex.vec 8
      zidx8: hex.vec 8
      lvl: hex.vec 3
      zlbase: hex.vec 3
      zlidx: hex.vec 3
      moved: hex.vec 1
      zrow: hex.vec 2
      cur_zrow: hex.vec 2
      runlen: hex.vec 2
      ptr: hex.vec w/4
      c127: hex.vec 3
      dist: hex.vec 8
    }
}
