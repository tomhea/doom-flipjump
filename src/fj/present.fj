// ==============================================================================================
// present.fj       drives the screen device: command bytes on the output stream.
// STATUS  LIVE - the generated main
// ENTRY   present.init_screen, present.select_palette, present.draw_collines, present.end_frame
// SIZE    7 macros (present.init_screen .. present.set_max_fps)
// ==============================================================================================
// The device and its protocol are flipjump's: `flipjump/interpreter/io_devices/README.md` is the
// authority, and `src/doomfj/screenwire.py` is this repo's one copy of its numbers (the Python
// emitters print baked streams through it). Every macro here is a pure EMITTER: it writes command
// bytes with stl.output_char and touches no state, so every operand is a compile-time constant.
//
// ---------- ORIENTATION: the commands the program sends
//
//   byte  macro                    payload                          when
//   ----  -----------------------  -------------------------------  ------------------------------
//   0x01  init_screen              [W:2][H:2][format = BPP:1]       once, at boot (or per run in a
//                                                                    hosted tier, which runs one frame)
//   0x02  (Python: screenwire)     [slot][first][last][RGB ...]     the palettes, right after init
//   0x03  set_max_fps              [fps:1]                          once, at boot
//   0x04  set_window_title         <utf-8 bytes> 0x00               once, at boot
//   0x05  set_window_icon_header   [w][h] (+ w*h colours, Python)   once, at boot
//   0x06  select_palette           [slot:1]                         between frames, on a change
//   0x11  draw_collines            column records, then END_CMD     every frame
//   0x1F  (end_frame)              --                               every frame, after END_CMD
//
// ---------- draw_collines, as this program uses it (fields are bytes: R = C = 8 on its screens)
//   a column record: [x], then items top-down from the cursor (row 0):
//     [y2][colour]    fill rows [cursor, y2) with colour      (y2 <= H)
//     [0xFE][y]       KEEP: rows [cursor, y) keep what the screen shows
//     [0xFD][y]       COPY: rows [cursor, y) copy column x-1
//     [0xFF]          END: the column is done -- ALWAYS printed, also after a run that reached H
//   an item may leave the cursor where it is (a zero-row item paints nothing); only a row behind
//   the cursor is refused. The sprite runs rely on it: two run ends can map to one row.
//   end of the command: [0xFF] where a column would start (END_CMD); `end_frame` then presents.
//   The run-time records are emitted by stream_render.fj / frame_render.fj (`byte.emit`); the
//   constant ones by the Python emitters through screenwire.

ns present {
    // init_screen: [0x01][W:2][H:2][format:1] -- format = bits per colour (8: indexed, 256 colours).
    // The screen shows black at once; every palette slot holds the format's default, slot 0 is
    // selected. The program then defines its palettes (screenwire.define_palette, from Python).
    def init_screen {
        stl.output_char 0x01
        stl.output_char W & 0xff
        stl.output_char (W >> 8) & 0xff
        stl.output_char H & 0xff
        stl.output_char (H >> 8) & 0xff
        stl.output_char BPP
    }

    // select_palette: [0x06][slot] -- the palette `present` will show the picture through.
    def select_palette slot {
        stl.output_char 0x06
        stl.output_char slot
    }

    // draw_collines: [0x11] -- column records follow (above), until END_CMD.
    def draw_collines {
        stl.output_char 0x11
    }

    // end_frame: [0xFF] END_CMD (the draw_collines command is over), then [0x1F] present.
    def end_frame {
        stl.output_char 0xFF
        stl.output_char 0x1F
    }

    // set_window_title: [0x04] <utf-8 bytes> 0x00. `text` is a compile-time fj string (least-
    // significant BYTE first, what stl.output already assumes); `len` is explicit so an embedded
    // zero byte cannot silently truncate the name. 8*(2+len) ops, ONCE at boot.
    def set_window_title text, len {
        stl.output_char 0x04
        rep(len, i) stl.output_char (text >> (8*i)) & 0xff
        stl.output_char 0x00
    }

    // set_window_icon_header: [0x05][w][h]. The w*h COLOURS follow as bytes (8 bits each), drawn
    // through the palette selected when the command runs -- emitted by the generated icon macro,
    // because a 32x32 icon is 1024 bytes and fj macro parameters are compile-time constants.
    // ⚠ params are `iw, ih`, NOT `w, h`: `w` is the global memory-width constant from fj_consts.
    def set_window_icon_header iw, ih {
        stl.output_char 0x05
        stl.output_char iw
        stl.output_char ih
    }

    // set_max_fps: [0x03][fps] -- the interactive window holds every present until 1/fps seconds
    // have passed since the previous one (0 = no cap; a headless screen only records it). The world
    // advances a fixed step per frame and frames cost 2M..25M ops, so without a cap the game runs
    // several times faster whenever the view is cheap. Emitted ONCE, from the entry part.
    def set_max_fps fps {
        stl.output_char 0x03
        stl.output_char fps
    }
}
