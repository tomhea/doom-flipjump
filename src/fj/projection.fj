// F5 (projection kernels, M12m+) — the runtime projection math the fj wall renderer needs, each a
// byte-exact mirror of the H5 oracle (src/doomfj/reference_model.py). The shared LUTs (tantoangle,
// finesine, viewangletox, xtoviewangle, finetangent) are emitted as read_table data tables (M12l).
//
// proj.slope_div (R_PointToAngle's SlopeDiv): dst[:3] = the tantoangle index for slope num/den.
//   num, den are NON-NEGATIVE hex[:8] (16.16 magnitudes; the caller has abs'd them).
//     if den < 512:           dst = SLOPERANGE (2048 = 0x800)
//     else: dst = (num<<3) / (den>>8), clamped to SLOPERANGE.
//   Mirrors reference_model.ReferenceModel._slope_div exactly (unsigned divide, truncating).
//   @requires hex.init
//
// ── NAMING CONVENTIONS IN THIS FILE ───────────────────────────────────────────────────────────
// Macro signature anatomy:  `def name a, b, c \ @ local, names \ < global, names {`.
//   - positional params (before `@`) are the ABI — emitters instantiate these macros by name with
//     positional args, so params and macro names are frozen;
//   - `@ …` are compile-time locals: labels AND the `name: hex.vec n` data cells declared at the
//     bottom of the body. werror fails the build if a local is unused on any rep-gated path;
//   - `< …` are external (global) labels the body references — never declared here.
// Suffixes / prefixes that actually hold in this file:
//   - `…o` on a PARAM = an OUTPUT param (project_thing's x1o/x2o/ytopo/hpxo/istepo; also the
//     spelled-out `scalestep_out`). Params are never renamed, so the suffix is the only signal.
//   - `c…` = a constant register (`cang90`, `cclip`, `csmax`, `c_sloperange`); `…v` / `v…` = a
//     value materialized into a scratch register — table-read (`sinv`, `vsin`, `vcos`) or
//     computed (`dxv`/`dyv` = viewer-minus-partition deltas); `…_mag` / `…_abs` = a magnitude.
//   - `_m` on a MACRO name = the LINES-MODE twin of the 16.16 original (`slope_div_m`,
//     `point_to_angle_m`, `wall_x_range_m`, `column_params_m` do map-unit arithmetic;
//     `wall_scale_setup_m` differs only by D4 dispatch reads: `xtadisp` for xtoviewangle, and
//     disp=1 routing the nested divide's reciprocal through `srdisp` — see its own doc);
//     `_stream` = the stream-tier variant. See the M13-mapunits banner below.
// Register/addressing idioms:
//   - `dw` is one hex-digit cell, so `reg + 4*dw` addresses the HIGH 4-NIBBLE SLICE of a 16.16
//     register = its map-unit part. Every runtime coordinate here has zero low 16 bits, which is
//     why the 4-nibble slice arithmetic is exact, not an approximation.
//   - `hex.cmp a, b, lt, eq, gt` names THREE labels; label ladders are branch trees, not loops.
//   - Data cells (`name: hex.vec n`) sit at the bottom of the body — they are fj ops that must
//     never execute, so every PATH exits by a jump before reaching them (usually a final
//     `;end`/`;done`; in `wedge_qt`/`wedge_bbox_plane` the last op's own branches are the exits).
//   - `rep(flag, k) …` where `flag` is a COMPILE-TIME param (`deg`, `spn`, `disp`, `dsl`, `dtb`,
//     `dbl`) emits the op zero or one times: a build-config switch, not a runtime branch.
// id-Software vocabulary is KEPT ON PURPOSE — matching the oracle's names is a feature, because
//   every macro here is a bit-for-bit mirror of a reference_model.py function which is itself a
//   mirror of r_bsp.c/r_segs.c/r_things.c. So: rw_distance, rw_normalangle, rw_offset,
//   rw_centerangle, rw_angle1, texmid (texturemid), worldtop, centeryfix, SLOPERANGE, tantoangle,
//   finetangent, finesine, viewangletox, xtoviewangle, and R_ProjectSprite's tr_x/tr_y/gxt/gyt/
//   tz/tx/xscale/gzt all read as they do in DOOM. Do not "improve" them.
// The 1-nibble global latches (`full`, `tsstop`, `tsbstop`, `fbspent`) are NOT used here. The
//   file's only per-frame flag traffic is in `project_thing`: it READS `degfl` (load-shedding
//   armed) and WRITES `thfar` (the SPR-NEAR detail-radius flag, for the caller). Latch semantics
//   are documented once, at `frame_render.fj::seg_pass1_leaf_body_ts`.
// ──────────────────────────────────────────────────────────────────────────────────────────────

ns proj {
    // perf #13 [re-bless] + M13-coarseslope [re-bless, owner-approved +-1 column]: the divide is a
    //   BLOCK-FP RECIPROCAL, and the NUMERATOR is normalized ALONGSIDE the denominator: both take
    //   the same nibble shifts in the normalize loop, so num_norm ends <= 3 nibbles in den_norm's
    //   mantissa frame and the quotient is (num_norm * recip8[m]) >> (RK-8) with a FIXED 4-nibble
    //   final shift -- no 13-nibble product, no shift tree. recip8 = slopediv_recip8 (the
    //   <<3-DBITS-prefolded twin of slopediv_recip), so no shl_bit on num_norm either; the product
    //   is 3 schoolbook rows at width 8. Mirrors reference_model._slope_div EXACTLY (same integer
    //   steps, same table values, R6): +-1 screen column vs the old exact-numerator form at worst,
    //   and every golden-gate frame is pixel-identical (scratchpad/coarse_gate_check.py).
    //   @requires hex.init & stl.ptr_init.
    def slope_div dst, num, den, disp \
            @ den_tiny, den_ok, den_hi_zero, prod_small, nrm_hi, hi_done, nrm_lo, lo_more, \
              lo_done, num_in_range, \
              keep, clamp, done, \
              den_norm, num_norm, recip_wide, recip, prod, c512, c_sloperange \
            < slopediv_recip8 {
        // den < 0x200 <=> nibbles 3..7 are all zero AND the low 3 nibbles are < 0x200
        hex.if0 5, den + 3*dw, den_hi_zero
        ;den_ok
      den_hi_zero:
        hex.cmp 3, den, c512, den_tiny, den_ok, den_ok  // den < 512 ? -> clamp to SLOPERANGE
      den_tiny:
        hex.set 3, dst, 0x800
        ;done
      den_ok:
        hex.mov 6, den_norm, den + 2*dw          // den_norm = den >> 8  (den <= 8 nibbles -> <= 6)
        hex.mov 6, num_norm, num + 2*dw          // num_norm = num >> 8  (num <= den, same bound)
      nrm_hi:                                    // right-normalize: while den_norm > 0xFFF, BOTH >>= 1 nib
        hex.if0 3, den_norm + 3*dw, hi_done      // den_norm <= 0xFFF <=> nibbles 3..5 all zero
        hex.shr_hex 6, 1, den_norm
        hex.shr_hex 6, 1, num_norm
        ;nrm_hi
      hi_done:                                   // left-normalize: while den_norm < 0x100, BOTH <<= 1 nib
      nrm_lo:
        hex.if0 4, den_norm + 2*dw, lo_more      // den_norm < 0x100 <=> nibbles 2..5 all zero
        ;lo_done
      lo_more:
        hex.shl_hex 6, 1, den_norm
        hex.shl_hex 6, 1, num_norm
        ;nrm_lo
      lo_done:
        // slope >= 1 guard: post-normalize num_norm >= 0x1000 (nibbles 3..5 set) can only happen
        // when num > den (the callers' num<=den contract keeps num_norm <= den_norm <= 0xFFF); the
        // oracle's answer is then always exactly SLOPERANGE: its normalized numerator wnum =
        // num_norm << 3 >= 0x8000, and R[m] >= 0x1001, so ans >= (0x8000*0x1001)>>16 = 0x800 =>
        // clamp. Jumping straight to the clamp is oracle-equivalent, not an approximation.
        hex.if0 3, num_norm + 3*dw, num_in_range
        ;clamp
      num_in_range:
        // M13-ATANDISP, FIFTH application -- and the first two got ORPHANED. `sdrecip` has been
        // emitted whenever `lines` since the lever landed, but its only reader was `slope_div_m`,
        // which M14-c stopped calling when `wall_x_range_m` reverted to the full-width
        // `point_to_angle`. So the shipped binary carried the dispatch table AND kept paying the
        // packed read for the same values. `disp` is compile-time; non-lines tiers have no
        // `sdrecip` and keep the packed read.
        rep(1-disp, k) hex.read_table_packed 3, recip, slopediv_recip8, 3, den_norm  // recip8[m] = ((1<<24)//m) << 3
        rep(disp, k) sdrecip.lookup recip, den_norm

        hex.zero 8, recip_wide
        hex.mov 6, recip_wide, recip
        // the mod-16^8 product needs only num_norm's 3 post-normalize nibbles as multiplier rows
        hex.zero 8, prod
        rep(3, j) hex.fixed_mul_lo.row 8, j, prod, recip_wide, num_norm
        hex.shr_hex 8, 4, prod                   // >> (RK-8 = 16 bits): the FIXED final shift

        hex.if0 1, prod + 3*dw, prod_small       // nibble 3 set => >= 0x1000 > 0x800 -> clamp
        ;clamp
      prod_small:
        hex.cmp 3, prod, c_sloperange, keep, keep, clamp   // prod > SLOPERANGE ?  gt -> clamp
      keep:
        hex.mov 3, dst, prod
        ;done
      clamp:
        hex.set 3, dst, 0x800
        ;done

      den_norm: hex.vec 6
      num_norm: hex.vec 6
      recip_wide: hex.vec 8
      recip: hex.vec 6
      prod: hex.vec 8
      c512: hex.vec 3, 512
      c_sloperange: hex.vec 3, 0x800
      done:
    }

    // proj.point_to_angle dst, x1, y1, x2, y2 (R_PointToAngle2): dst[:8] = the 32-bit BAM angle of the
    //   vector (x1,y1)->(x2,y2). All coords are 16.16 signed world units (the SlopeDiv tuning is
    //   scale-dependent). Octant-fold around proj.slope_div + a tantoangle lookup — no atan at runtime.
    //   Mirrors reference_model.point_to_angle EXACTLY (incl. DOOM's ±1 octant-boundary quirks, e.g.
    //   due-N = ANG90-1). Reads the shared `tantoangle` LUT (M12l, read_table data table) by that label.
    //   Algorithm: dx=x2-x1, dy=y2-y1; fold to the major octant by sign+magnitude into
    //   idx = sxneg*4 + syneg*2 + (|dx|>|dy|); base = tantoangle[slope_div(min(|dx|,|dy|), max)];
    //   result = p2a_off[idx] (+ or -, per p2a_neg[idx]) base, mod 2^32. (0,0) -> 0.
    //   @requires hex.init & stl.ptr_init   (read_table needs the pointer init)
    def point_to_angle dst, x1, y1, x2, y2, disp \
            @ dx, dy, num, den, oct_idx, slope_idx, tan_base, c1, c2, c4, c6, czero, \
              dx_neg, dx_pos, dx_done, dy_neg, dy_pos, dy_done, dx_zero, both_zero, nonzero, \
              dx_major, dy_major, numden_set, \
              oct_lo4, oct_lo2, oct_hi4, oct0, oct1, oct2, oct3, oct4, oct5, oct6, oct7, done \
            < tantoangle {
        hex.mov 8, dx, x2
        hex.sub 8, dx, x1                        // dx = x2 - x1   (signed 16.16)
        hex.mov 8, dy, y2
        hex.sub 8, dy, y1                        // dy = y2 - y1
        hex.set 1, oct_idx, 0

        hex.sign 8, dx, dx_neg, dx_pos           // dx<0 ? fold x negative, set the octant bit
      dx_neg:
        hex.add 1, oct_idx, c4                   // oct_idx |= 4
        hex.neg 8, dx                            // dx = |dx|
        ;dx_done
      dx_pos:
      dx_done:
        hex.sign 8, dy, dy_neg, dy_pos
      dy_neg:
        hex.add 1, oct_idx, c2                   // oct_idx |= 2
        hex.neg 8, dy                            // dy = |dy|
        ;dy_done
      dy_pos:
      dy_done:
        // dx,dy are now non-negative magnitudes. zero check (unsigned, R5-ok): both zero -> angle 0.
        hex.if0 8, dx, dx_zero
        ;nonzero
      dx_zero:
        hex.if0 8, dy, both_zero
        ;nonzero
      both_zero:
        hex.zero 8, dst
        ;done
      nonzero:
        // dx_major = |dx| > |dy| (magnitudes, unsigned cmp R5-ok). num=min, den=max (slope_div
        // needs num<=den).
        hex.cmp 8, dx, dy, dy_major, dy_major, dx_major
      dx_major:
        hex.add 1, oct_idx, c1                   // oct_idx |= 1
        hex.mov 8, num, dy                        // num = |dy| (smaller), den = |dx| (larger)
        hex.mov 8, den, dx
        ;numden_set
      dy_major:                                   // |dx| <= |dy|
        hex.mov 8, num, dx
        hex.mov 8, den, dy
        ;numden_set
      numden_set:
        .slope_div slope_idx, num, den, disp      // slope_idx = tantoangle index for the slope
        // ORPHANED TABLE, see slope_div above: `ttang` ships whenever `lines` and had no live
        // reader. Same values, same shape (index_nibbles=3, result_nibbles=8 vs slope_idx: hex.vec 3
        // and tan_base: hex.vec 8).
        rep(1-disp, k) hex.read_table_packed 4, tan_base, tantoangle, 3, slope_idx   // shared LUT, M12l
        rep(disp, k) ttang.lookup tan_base, slope_idx
        // M13-p2acrush: the octant offset+sign, previously two read_tables (8-nib ~10.4k + 1-nib)
        // on oct_idx, is now a 3-deep COMPARE TREE to 8 constant tails (same formulas, ~1k).
        // oct_idx = sxneg*4 + syneg*2 + (|dx|>|dy|); the oracle's 8 returns (ANG90=0x40000000 etc.),
        // with `base` = tan_base:
        //   0: (ANG90-1)-base   1: +base            2: ANG270+base    3: -base
        //   4: ANG90+base       5: (ANG180-1)-base  6: (ANG270-1)-base 7: ANG180+base
        hex.cmp 1, oct_idx, c4, oct_lo4, oct4, oct_hi4
      oct_lo4:
        hex.cmp 1, oct_idx, c2, oct_lo2, oct2, oct3
      oct_lo2:
        hex.cmp 1, oct_idx, c1, oct0, oct1, oct1
      oct_hi4:
        hex.cmp 1, oct_idx, c6, oct5, oct6, oct7
      oct0:
        hex.set 8, dst, 0x3FFFFFFF
        hex.sub 8, dst, tan_base
        ;done
      oct1:
        hex.mov 8, dst, tan_base
        ;done
      oct2:
        hex.set 8, dst, 0xC0000000
        hex.add 8, dst, tan_base
        ;done
      oct3:
        hex.zero 8, dst
        hex.sub 8, dst, tan_base
        ;done
      oct4:
        hex.set 8, dst, 0x40000000
        hex.add 8, dst, tan_base
        ;done
      oct5:
        hex.set 8, dst, 0x7FFFFFFF
        hex.sub 8, dst, tan_base
        ;done
      oct6:
        hex.set 8, dst, 0xBFFFFFFF
        hex.sub 8, dst, tan_base
        ;done
      oct7:
        hex.set 8, dst, 0x80000000
        hex.add 8, dst, tan_base
        ;done

      dx: hex.vec 8
      dy: hex.vec 8
      num: hex.vec 8
      den: hex.vec 8
      oct_idx: hex.vec 1
      slope_idx: hex.vec 3
      tan_base: hex.vec 8
      c1: hex.vec 1, 1
      c2: hex.vec 1, 2
      c4: hex.vec 1, 4
      c6: hex.vec 1, 6
      czero: hex.vec 8, 0                        // ⚠ declared + reserved but never referenced
      done:
    }

    // ── M13-wedge: the MULTIPLY-FREE conservative FOV pre-cull (proj.wedge_setup + proj.wedge_reject)
    //
    // The true FOV is the wedge [viewangle-ANG45, viewangle+ANG45]. Round it OUTWARD to multiples of
    // 45° and you get a wedge of width 90°..135° that strictly CONTAINS the FOV — so a seg lying
    // entirely outside it is provably invisible and skipping it is BYTE-EXACT (no re-bless): the
    // frame is identical, we just stop paying for it. The payoff is that a 45°-multiple wedge is the
    // intersection of two half-planes whose interior tests are pure integer compares — NO multiply,
    // no table, no divide:
    //
    //   plane m (boundary direction m*45°, interior = the CCW side): cross(dir_m, v - eye) >= 0
    //     m=0: dy>=0   m=1: dy-dx>=0   m=2: -dx>=0   m=3: -(dx+dy)>=0
    //     m=4: -dy>=0  m=5: dx-dy>=0   m=6: dx>=0    m=7: dx+dy>=0
    //   so with Q0=dy, Q1=dy-dx, Q2=dx, Q3=dx+dy the test is ±Q[m&3] >= 0, negated for 2<=m<=5.
    //
    // Measured on the E1M1 spawn frame (scratchpad/wedge_dirs.py, host): 173 of 432 segs and 198 of
    // 488 point_to_angle calls rejected, with the visible-seg and emitted-seg sets IDENTICAL.
    // Finer boundary sets (16/24 directions) cull no better at the spawn angle, so 8 it is.

    // proj.wedge_setup qa, na, qb, nb, wex, wey, weyx, wexy, viewangle, viewx, viewy — ONCE PER
    //   FRAME. Writes the two half-plane descriptors (q = the base quantity 0..3, n = 1 iff the test
    //   is negated) bounding the outward-rounded FOV wedge, plus the four EYE terms the per-seg test
    //   subtracts (wex=viewx, wey=viewy, weyx=viewy-viewx, wexy=viewx+viewy) so that each Q is one
    //   subtraction off the raw vertex — no per-seg dx/dy staging.
    //   lo = floor((va-ANG45)/ANG45), hi = ceil((va+ANG45)/ANG45) via the integer identity
    //   ceil(a/b) = floor((a+b-1)/b); plane B is (hi+4) mod 8 (the far edge's half-plane points
    //   inward), and since +4 leaves m&3 alone, qb = wsel(hi).q while nb is wsel(hi).n INVERTED.
    //   All arithmetic is mod 2^32, which is exactly the BAM circle. wexy/weyx cannot overflow: the
    //   map's max |x|+|y| is 5440 units = 3.6e8 in 16.16, well inside the signed 32-bit range.
    //   @requires hex.init
    def wedge_setup qa, na, qb, nb, wex, wey, weyx, wexy, viewangle, viewx, viewy \
            @ mdir, angt, wsel, qout, nout, wret, \
              sel_lo4, sel_hi4, sel_lo2, mdir0, mdir1, mdir2, mdir3, mdir4, mdir5, mdir6, mdir7, \
              sel_done, \
              nb_set1, nb_done, c1, c2, c4, c6, cang45, cang90m1, end {
        hex.mov 8, wex, viewx
        hex.mov 8, wey, viewy
        // ⚠ CR-2026-08 (PJ-1) -- THIS ARITHMETIC IS THE MIRROR THAT WAS RIGHT. The eye terms are
        //   built at FULL 16.16 width and every reader takes their HIGH 4-nibble slice, so each Q
        //   is C - floor(E) for the COMBINED term E. The oracle mirror
        //   (mapcompiler.bbox_wedge_miss) used to floor PER AXIS instead -- floor(viewy)-floor(viewx)
        //   -- which differs by 1 whenever the fractions borrow (q=1) or carry (q=3). Invisible
        //   while the player stood on whole map units; a byte-exactness break the moment M14 gave
        //   it a fraction. MEASURED with a two-sided negative control: scratchpad/_pj1_probe.py.
        //
        //   THE ORACLE WAS MOVED TO THIS FORM, NOT THE OTHER WAY ROUND, AND THE REASON IS VISUAL:
        //   only this form is CONSERVATIVE. Write Q_true for the exact fractional eye. Here
        //   Q - Q_true = frac(E) is in [0,1) for ALL FOUR q, so a cull (|Q| >= 1 with the culling
        //   sign, Q being an integer) always implies the true point really is outside -- this test
        //   can fail to cull, never over-cull. The per-axis form does NOT have that property: for
        //   q=3 its error is fx+fy in [0,2), so Q=1 on the negated plane m=3 culls a box whose true
        //   Q is as low as -1, i.e. genuinely inside. That is not academic -- the wedge is rounded
        //   out to 45-degree boundaries, and at a view angle that IS an exact multiple of 45 (two
        //   of the four certified gate angles: 0x40000000, 0x80000000) the rounding slack is ZERO.
        //   Dropping a whole BSP subtree -- its walls, plane claims, step faces and things -- is
        //   exactly the failure PJ-1 was filed for, so the mirror that cannot do it wins.
        //
        //   Full-precision Q is not an option either: dx+dy at 16.16 needs 34 bits and Q is a
        //   4-nibble contract (see bbox_wedge_miss's WIDTH CONTRACT docstring and its per-map
        //   assert). ⇒ fj is UNCHANGED by PJ-1; the emitted program and its op counts do not move.
        hex.mov 8, weyx, viewy
        hex.sub 8, weyx, viewx              // weyx = viewy - viewx   (readers take floor via +4*dw)
        hex.mov 8, wexy, viewx
        hex.add 8, wexy, viewy              // wexy = viewx + viewy

        hex.mov 8, angt, viewangle
        hex.sub 8, angt, cang45             // (va - ANG45) mod 2^32
        hex.shr_hex 8, 7, angt              // >> 28 bits ...
        hex.shr_bit 8, angt                 //   ... then >> 1 = floor(./ANG45), in [0,7]
        hex.mov 1, mdir, angt
        stl.fcall wsel, wret
        hex.mov 1, qa, qout
        hex.mov 1, na, nout

        hex.mov 8, angt, viewangle
        hex.add 8, angt, cang90m1           // va + ANG45 + (ANG45-1)  =>  ceil((va+ANG45)/ANG45)
        hex.shr_hex 8, 7, angt
        hex.shr_bit 8, angt
        hex.mov 1, mdir, angt
        stl.fcall wsel, wret
        hex.mov 1, qb, qout
        hex.if0 1, nout, nb_set1            // nb = 1 - wsel(hi).n  (the +4 half-plane flip)
        hex.set 1, nb, 0
        ;nb_done
      nb_set1:
        hex.set 1, nb, 1
      nb_done:
        ;end

      wsel:                                 // mdir (0..7) -> qout = mdir&3, nout = (2 <= mdir <= 5)
        hex.cmp 1, mdir, c4, sel_lo4, mdir4, sel_hi4
      sel_lo4:
        hex.cmp 1, mdir, c2, sel_lo2, mdir2, mdir3
      sel_lo2:
        hex.cmp 1, mdir, c1, mdir0, mdir1, mdir1
      sel_hi4:
        hex.cmp 1, mdir, c6, mdir5, mdir6, mdir7
      mdir0:
        hex.set 1, qout, 0
        hex.set 1, nout, 0
        ;sel_done
      mdir1:
        hex.set 1, qout, 1
        hex.set 1, nout, 0
        ;sel_done
      mdir2:
        hex.set 1, qout, 2
        hex.set 1, nout, 1
        ;sel_done
      mdir3:
        hex.set 1, qout, 3
        hex.set 1, nout, 1
        ;sel_done
      mdir4:
        hex.set 1, qout, 0
        hex.set 1, nout, 1
        ;sel_done
      mdir5:
        hex.set 1, qout, 1
        hex.set 1, nout, 1
        ;sel_done
      mdir6:
        hex.set 1, qout, 2
        hex.set 1, nout, 0
        ;sel_done
      mdir7:
        hex.set 1, qout, 3
        hex.set 1, nout, 0
        ;sel_done
      sel_done:
        stl.fret wret

      mdir: hex.vec 1
      angt: hex.vec 8
      qout: hex.vec 1
      nout: hex.vec 1
      wret: ;0
      c1: hex.vec 1, 1
      c2: hex.vec 1, 2
      c4: hex.vec 1, 4
      c6: hex.vec 1, 6
      cang45: hex.vec 8, 0x20000000
      cang90m1: hex.vec 8, 0x3FFFFFFF
      end:
    }

    // proj.wedge_reject rej, v1x, v1y, v2x, v2y, qa, na, qb, nb, wex, wey, weyx, wexy — PER SEG.
    //   rej[:1] = 1 iff BOTH seg endpoints are strictly outside the SAME bounding half-plane, i.e.
    //   the whole seg misses the conservative wedge. (Both-outside-but-different-planes does NOT
    //   cull: such a seg spans the view.) Ordered so the common cases finish in TWO tests -- reject
    //   on (A:v1, A:v2), accept on (A:v1, B:v1) -- and so vertex 2 is never touched when v1 alone
    //   decides. Each test is one mov + one or two 8-nibble adds against a per-frame eye term:
    //     Q0 = v.y - viewy   Q1 = (v.y - v.x) - weyx   Q2 = v.x - viewx   Q3 = (v.x + v.y) - wexy
    //   which is exactly cross(dir_m, v - eye) up to the sign carried by `n`. @requires hex.init
    def wedge_reject rej, v1x, v1y, v2x, v2y, qa, na, qb, nb, wex, wey, weyx, wexy \
            @ a1out, b1out, test_b, reject, done, end {
        hex.set 1, rej, 0
        .wedge_qt v1x, v1y, qa, na, wex, wey, weyx, wexy, test_b, a1out   // v1 inside A -> A can't reject
      a1out:
        .wedge_qt v2x, v2y, qa, na, wex, wey, weyx, wexy, test_b, reject  // both outside A -> REJECT
      test_b:
        .wedge_qt v1x, v1y, qb, nb, wex, wey, weyx, wexy, done, b1out
      b1out:
        .wedge_qt v2x, v2y, qb, nb, wex, wey, weyx, wexy, done, reject
      reject:
        hex.set 1, rej, 1
      done:
        ;end
      end:
    }

    // proj.wedge_qt vx, vy, q, n, wex, wey, weyx, wexy, insid, outsid — ONE half-plane test on ONE
    //   vertex, jumping straight to `insid`/`outsid`. Inlined (four copies inside wedge_reject)
    //   rather than shared: the two `hex.mov 8` needed to stage a vertex into a shared body, plus the
    //   fcall/fret pair and the outc round-trip, cost more than the body itself. Every path exits by
    //   a jump, so the trailing data block is never fallen into. @requires hex.init
    def wedge_qt vx, vy, q, n, wex, wey, weyx, wexy, insid, outsid             @ qval, qsel_lo, qsel_hi, calc_q0, calc_q1, calc_q2, calc_q3, q_ready, plain_test, neg_nonzero, c1, c2, c3 {
        // M13-lines3: vertices are baked map<<16, so THEIR low 16 bits are zero, and Q is read from
        // the HIGH 4-NIBBLE slices -- 4-nibble mov/sub/sign at roughly half the cost of the
        // 8-nibble forms.
        // ⚠ CR-2026-08 (PJ-1) -- THE SECOND HALF OF THAT PREMISE IS DEAD AND THIS COMMENT USED TO
        // STATE IT AS FACT: "the eye terms are sums/differences of view coords that are themselves
        // map<<16 ... so the slice arithmetic is exact". Since M14 the EYE has a fraction, so the
        // low halves of weyx/wexy are NOT zero and slicing them is a floor, not an exact read.
        // That is fine, and deliberately so: Q here is C - floor(E), whose error against the exact
        // eye is frac(E) in [0,1), so this test can fail to cull but can never over-cull. The
        // oracle mirror was moved onto this same rule (mapcompiler.bbox_wedge_miss) rather than the
        // reverse, precisely to keep that property -- see the note in wedge_setup.
        hex.cmp 1, q, c2, qsel_lo, calc_q2, qsel_hi
      qsel_lo:
        hex.cmp 1, q, c1, calc_q0, calc_q1, calc_q1
      qsel_hi:
        hex.cmp 1, q, c3, calc_q2, calc_q3, calc_q3
      calc_q0:
        hex.mov 4, qval, vy + 4*dw          // Q0 = vy - viewy
        hex.sub 4, qval, wey + 4*dw
        ;q_ready
      calc_q1:
        hex.mov 4, qval, vy + 4*dw          // Q1 = (vy - vx) - (viewy - viewx)
        hex.sub 4, qval, vx + 4*dw
        hex.sub 4, qval, weyx + 4*dw
        ;q_ready
      calc_q2:
        hex.mov 4, qval, vx + 4*dw          // Q2 = vx - viewx
        hex.sub 4, qval, wex + 4*dw
        ;q_ready
      calc_q3:
        hex.mov 4, qval, vx + 4*dw          // Q3 = (vx + vy) - (viewx + viewy)
        hex.add 4, qval, vy + 4*dw
        hex.sub 4, qval, wexy + 4*dw
        ;q_ready
      q_ready:
        // sign/if0 rather than scmp-against-zero: hex.scmp is ~2.7x the cost (measured).
        hex.if0 1, n, plain_test
        hex.sign 4, qval, insid, neg_nonzero   // negated test: outside iff Q > 0
      neg_nonzero:
        hex.if0 4, qval, insid
        ;outsid
      plain_test:
        hex.sign 4, qval, outsid, insid        // plain test:   outside iff Q < 0

      qval: hex.vec 4
      c1: hex.vec 1, 1
      c2: hex.vec 1, 2
      c3: hex.vec 1, 3
    }

    // proj.wedge_bbox_plane — ONE half-plane test on a BBOX (M13-15M, the bbox wedge cull): jump
    //   `insid` when any part of the staged box (bl/bb/br/bt, all map<<16) can be inside half-plane
    //   (q, n), else `outsid`. The maximizing corner is a pure function of the plane:
    //   y = TOP iff n==0; x = LEFT iff (q<2) == (n==0)  (equivalent to the m-direction table:
    //   x=left for m<4, y=top for m in {0,1,6,7}). The Q arithmetic is wedge_qt's high-4-nibble
    //   slice form verbatim — corners are integer map units <<16, so THEIR low halves are zero.
    //   ⚠ CR-2026-08 (PJ-1): the EYE TERMS' low halves are not, since M14 made the view position
    //   fractional — slicing them floors the combined term, which is exactly what the oracle
    //   mirror now does too. See wedge_setup for why this direction and not the other.
    def wedge_bbox_plane q, n, bl, bb, br, bt, wex, wey, weyx, wexy, insid, outsid \
            @ use_top, use_left, use_right, corner_done, qsel_lo, qsel_hi, \
              calc_q0, calc_q1, calc_q2, calc_q3, q_ready, plain_test, neg_nonzero, \
              cx_hi, cy_hi, qval, c1, c2, c3 {
        hex.if0 1, n, use_top
        hex.mov 4, cy_hi, bb + 4*dw         // n=1: y = bottom; x = left iff q >= 2
        hex.cmp 1, q, c2, use_right, use_left, use_left
      use_top:
        hex.mov 4, cy_hi, bt + 4*dw         // n=0: y = top;    x = left iff q < 2
        hex.cmp 1, q, c2, use_left, use_right, use_right
      use_left:
        hex.mov 4, cx_hi, bl + 4*dw
        ;corner_done
      use_right:
        hex.mov 4, cx_hi, br + 4*dw
      corner_done:
        hex.cmp 1, q, c2, qsel_lo, calc_q2, qsel_hi
      qsel_lo:
        hex.cmp 1, q, c1, calc_q0, calc_q1, calc_q1
      qsel_hi:
        hex.cmp 1, q, c3, calc_q2, calc_q3, calc_q3
      calc_q0:
        hex.mov 4, qval, cy_hi              // Q0 = cy - viewy
        hex.sub 4, qval, wey + 4*dw
        ;q_ready
      calc_q1:
        hex.mov 4, qval, cy_hi              // Q1 = (cy - cx) - (viewy - viewx)
        hex.sub 4, qval, cx_hi
        hex.sub 4, qval, weyx + 4*dw
        ;q_ready
      calc_q2:
        hex.mov 4, qval, cx_hi              // Q2 = cx - viewx
        hex.sub 4, qval, wex + 4*dw
        ;q_ready
      calc_q3:
        hex.mov 4, qval, cx_hi              // Q3 = (cx + cy) - (viewx + viewy)
        hex.add 4, qval, cy_hi
        hex.sub 4, qval, wexy + 4*dw
      q_ready:
        hex.if0 1, n, plain_test
        hex.sign 4, qval, insid, neg_nonzero   // negated test: outside iff Q > 0
      neg_nonzero:
        hex.if0 4, qval, insid
        ;outsid
      plain_test:
        hex.sign 4, qval, outsid, insid        // plain test:   outside iff Q < 0

      cx_hi: hex.vec 4
      cy_hi: hex.vec 4
      qval: hex.vec 4
      c1: hex.vec 1, 1
      c2: hex.vec 1, 2
      c3: hex.vec 1, 3
    }

    // proj.wedge_bbox vis, <box>, <frame wedge regs> — vis=0 iff the whole box lies outside either
    //   of the frame's two wedge half-planes (then the subtree below it can contribute no pixel,
    //   no plane claim, no step face; THING subtrees get their boxes pre-inflated at bake time).
    //   Mirrors mapcompiler.bbox_wedge_miss / reference_model.bsp_render_order's oracle gate.
    def wedge_bbox vis, bl, bb, br, bt, qa, na, qb, nb, wex, wey, weyx, wexy \
            @ test_plane_b, box_miss, box_ok, end {
        hex.set 1, vis, 1
        .wedge_bbox_plane qa, na, bl, bb, br, bt, wex, wey, weyx, wexy, test_plane_b, box_miss
      test_plane_b:
        .wedge_bbox_plane qb, nb, bl, bb, br, bt, wex, wey, weyx, wexy, box_ok, box_miss
      box_miss:
        hex.set 1, vis, 0
      box_ok:
        ;end
      end:
    }

    // proj.point_to_dist dst, viewx, viewy, x, y (R_PointToDist): dst[:8] = the 16.16 distance from
    //   (viewx,viewy) to (x,y) — sqrt(dx²+dy²) computed via tantoangle + finesine + two FixedDivs (no
    //   sqrt). Fold to the major octant (dx>=dy), index tantoangle by the slope dy/dx >> DBITS, take
    //   angle+ANG90, divide dx by sin(that)=cos(atan(slope)). Mirrors reference_model.point_to_dist
    //   EXACTLY. Coords + result are 16.16. Reads the shared `tantoangle` LUT (M12l) + the `finesine`
    //   trig idiom (M6); exact for axis-aligned (dy=0 -> dist=dx), ~quantization off-axis. (0,0)->0.
    //   @requires hex.init & stl.ptr_init   (read_table + finesine.read_sin)
    def point_to_dist dst, viewx, viewy, x, y \
            @ dx, dy, swap_tmp, slope, slope_idx, angle, sine, czero, c_sloperange, cang90, \
              do_swap, no_swap, swapped, dx_zero, dx_nz, clamp_idx, keep_idx, \
              sine_zero, sine_nz, baddiv, done \
            < tantoangle {
        hex.mov 8, dx, x
        hex.sub 8, dx, viewx
        hex.abs 8, dx                            // dx = |x - viewx|
        hex.mov 8, dy, y
        hex.sub 8, dy, viewy
        hex.abs 8, dy                            // dy = |y - viewy|

        hex.cmp 8, dy, dx, no_swap, no_swap, do_swap   // dy > dx ? -> fold to the major octant (dx>=dy)
      do_swap:
        hex.mov 8, swap_tmp, dx
        hex.mov 8, dx, dy
        hex.mov 8, dy, swap_tmp
        ;swapped
      no_swap:
      swapped:
        hex.cmp 8, dx, czero, dx_nz, dx_zero, dx_nz    // dx == 0 ? (both deltas were 0) -> degenerate
      dx_zero:
        hex.zero 8, dst
        ;done
      dx_nz:
        hex.fixed_div 8, 4, slope, dy, dx, baddiv      // slope = (dy<<16)/dx  in [0, 0x10000] (dy<=dx)
        hex.shr_hex 8, 1, slope                        // >> DBITS = >> 5 bits: one nibble (4) ...
        hex.shr_bit 8, slope                           //   ... + one bit
        hex.mov 3, slope_idx, slope                    // idx = slope (low 3 nibbles; value <= 0x800)
        hex.cmp 3, slope_idx, c_sloperange, keep_idx, keep_idx, clamp_idx   // min(idx, SLOPERANGE)
      clamp_idx:
        hex.set 3, slope_idx, 0x800
      keep_idx:
        hex.read_table_packed 4, angle, tantoangle, 3, slope_idx   // tantoangle[idx]
        hex.add 8, angle, cang90                        // angle = tantoangle[idx] + ANG90
        hex.shr_hex 8, 5, angle                         // finesine index = angle >> 20 bits (= 5 nibbles;
        hex.mov 3, slope_idx, angle                     //   32 - log2(TRIG_N=4096) = 20). low 3 nibbles.
                                                        //   ⚠ slope_idx is REUSED: from here on it holds
                                                        //   the FINESINE index (sin_idx elsewhere).
        finesine.read_sin sine, slope_idx               // sin(atan(slope)+90deg) = cos(atan(slope))
        hex.cmp 8, sine, czero, sine_nz, sine_zero, sine_nz   // sine==0 guard (oracle: returns 0)
      sine_zero:
        hex.zero 8, dst
        ;done
      sine_nz:
        hex.fixed_div 8, 4, dst, dx, sine, baddiv       // dist = (dx<<16)/sine
        ;done
      baddiv:                                           // unreachable (dx!=0, sine!=0); safe fallback
        hex.zero 8, dst
        ;done

      dx: hex.vec 8
      dy: hex.vec 8
      swap_tmp: hex.vec 8
      slope: hex.vec 8
      slope_idx: hex.vec 3
      angle: hex.vec 8
      sine: hex.vec 8
      czero: hex.vec 8, 0
      c_sloperange: hex.vec 3, 0x800
      cang90: hex.vec 8, 0x40000000
      done:
    }

    // proj.wall_setup rw_normalangle, rw_distance, viewx, viewy, segangle, a, b, c (R_StoreWallRange):
    //   the per-wall projection setup. Writes rw_normalangle (the wall's normal BAM = (segangle<<16)+
    //   ANG90, DOOM's native winding) and rw_distance (the perpendicular view->wall-line distance, 16.16).
    //   segangle is the 16-bit seg BAM (WAD `angle>>16`); viewx/y are 16.16; a,b,c are the seg's baked
    //   16.16 affine coeffs (mapcompiler.seg_affine_coeffs, the shared SSOT).
    //   **perf #9 [re-bless]:** rw_distance = |fixed_mul(a,viewx) + fixed_mul(b,viewy) + c| — the AFFINE
    //   cross-product perpendicular distance — instead of fixed_mul(point_to_dist(view,v1), sin(ANG90 -
    //   offsetangle)) (point_to_angle + the two-divide point_to_dist + finesine). Same geometric quantity,
    //   exact-affine with NO atan/divide; sub-bit shift vs the old quantized divide path (PNG-verified
    //   clean on E1M1; square is byte-identical — axis-aligned segs make affine == the exact divide). For
    //   front-facing segs (past wall_x_range's span<ANG180 cull) the signed value is >0, so abs is a no-op;
    //   the pre-abs SIGN is what perf #10's back-face cull tests. Mirrors reference_model.wall_setup EXACTLY.
    //   @requires hex.init
    def wall_setup rw_normalangle, rw_distance, viewx, viewy, segangle, a, b, c \
            @ bviewy, cang90, end {
        hex.zero 8, rw_normalangle
        hex.mov 4, rw_normalangle + 4*dw, segangle      // rw_normalangle = segangle << 16 ...
        hex.add 8, rw_normalangle, cang90               //   ... + ANG90 (the wall normal)

        hex.fixed_mul_lo 8, 4, rw_distance, a, viewx       // rw_distance = a*viewx ...
        hex.fixed_mul_lo 8, 4, bviewy, b, viewy
        hex.add 8, rw_distance, bviewy                  //   + b*viewy ...
        hex.add 8, rw_distance, c                       //   + c  (signed perpendicular distance, mod 2^32)
        hex.abs 8, rw_distance                          // front-facing => signed>0 => abs is a no-op
        ;end                                            // skip the data block (else it runs as code)

      bviewy: hex.vec 8
      cang90: hex.vec 8, 0x40000000
      end:
    }

    // proj.wall_setup_sgn rw_normalangle, rw_distance, sgn, segangle (M13-absmul): wall_setup for a
    //   caller that ALREADY has the signed affine distance -- wall_x_range now exports it (its `sgn`
    //   output IS fixed_mul(a,viewx)+fixed_mul(b,viewy)+c, the exact quantity wall_setup recomputes
    //   with two more fixed_muls). rw_distance = abs(sgn); rw_normalangle as in wall_setup.
    //   BIT-IDENTICAL to wall_setup by construction. @requires hex.init
    def wall_setup_sgn rw_normalangle, rw_distance, sgn, segangle \
            @ cang90, end {
        hex.zero 8, rw_normalangle
        hex.mov 4, rw_normalangle + 4*dw, segangle      // rw_normalangle = segangle << 16 ...
        hex.add 8, rw_normalangle, cang90               //   ... + ANG90 (the wall normal)
        hex.mov 8, rw_distance, sgn
        hex.abs 8, rw_distance                          // front-facing => sgn>0 => abs is a no-op
        ;end

      cang90: hex.vec 8, 0x40000000
      end:
    }

    // proj.scale_recip_div q, num, den (M13-scalerecip [re-bless]): q[:8] = (num<<16)//den via the
    //   SHARED slopediv_recip block-FP table. num, den are NON-NEGATIVE magnitudes (the caller has
    //   sign-split; den > 0). Recipe (mirrors reference_model._scale_recip_div EXACTLY, R6):
    //   normalize den to a 3-nibble mantissa m in [0x100,0xFFF] with shift_nibs counting whole
    //   nibbles (base 6 = RK/4; range [4,11] for any 32-bit den), 14-NIBBLE truncated product
    //   num_wide*recip[m] (5 schoolbook rows, recip <= 5 nibbles), ONE whole-nibble shift picked by
    //   a compare tree, low 8 nibbles out. 14 nibbles is the measured-exact width (12 truncates
    //   real operands). @requires hex.init & stl.ptr_init
    def scale_recip_div q, num, den, disp \
            @ nrm_hi, hi_done, nrm_lo, lo_more, lo_done, \
              shift_lo, shift_67, shift_hi, shift4, shift5, shift6, shift7, shift8, shift9, \
              shift10, shift11, shift_done, done, \
              den_norm, num_wide, recip_wide, recip, prod, shift_nibs, csh5, csh6, csh8, csh10 \
            < slopediv_recip {
        hex.mov 8, den_norm, den   // (hex.mov zeroes dst first)
        hex.set 2, shift_nibs, 6                 // base shift = RK/4 = 6 nibbles; +- the exponent below
      nrm_hi:                                    // right-normalize: while den_norm > 0xFFF, >>= 1 nib, ++
        hex.if0 5, den_norm + 3*dw, hi_done      // den_norm <= 0xFFF <=> nibbles 3..7 all zero
        hex.shr_hex 8, 1, den_norm
        hex.inc 2, shift_nibs
        ;nrm_hi
      hi_done:                                   // left-normalize: while den_norm < 0x100, <<= 1 nib, --
      nrm_lo:
        hex.if0 6, den_norm + 2*dw, lo_more      // den_norm < 0x100 <=> nibbles 2..7 all zero
        ;lo_done
      lo_more:
        hex.shl_hex 8, 1, den_norm
        hex.dec 2, shift_nibs
        ;nrm_lo
      lo_done:
        // M13-SRDISP (the D4 dispatch lever, 4th application): 3 x read_byte_and_inc (42@ each)
        // + a mul_const ~ 247@ becomes a ~20@ lookup. `disp` is a COMPILE-TIME flag, so the
        // non-lines tiers -- which have no `srdisp` table -- keep the packed read.
        rep(1-disp, k) hex.read_table_packed 3, recip, slopediv_recip, 3, den_norm  // recip[m]=(1<<24)//m
        rep(disp, k) srdisp.lookup recip, den_norm
        hex.zero 14, num_wide
        hex.mov 8, num_wide + 4*dw, num          // num_wide = num << 16 (4 nibbles, by placement)
        hex.zero 14, recip_wide
        hex.mov 6, recip_wide, recip
        hex.zero 14, prod
        rep(5, j) hex.fixed_mul_lo.row 14, j, prod, num_wide, recip_wide   // mod 16^14
        // shift_nibs in [4,11]: den has 1..8 significant nibbles -> at most 5 right- or 2 left-shifts
        hex.cmp 2, shift_nibs, csh8, shift_lo, shift8, shift_hi
      shift_lo:
        hex.cmp 2, shift_nibs, csh5, shift4, shift5, shift_67
      shift_67:
        hex.cmp 2, shift_nibs, csh6, shift6, shift6, shift7   // lt unreachable (>= 6 here)
      shift_hi:
        hex.cmp 2, shift_nibs, csh10, shift9, shift10, shift11
      shift4:
        hex.shr_hex 14, 4, prod
        ;shift_done
      shift5:
        hex.shr_hex 14, 5, prod
        ;shift_done
      shift6:
        hex.shr_hex 14, 6, prod
        ;shift_done
      shift7:
        hex.shr_hex 14, 7, prod
        ;shift_done
      shift8:
        hex.shr_hex 14, 8, prod
        ;shift_done
      shift9:
        hex.shr_hex 14, 9, prod
        ;shift_done
      shift10:
        hex.shr_hex 14, 10, prod
        ;shift_done
      shift11:
        hex.shr_hex 14, 11, prod
        ;shift_done
      shift_done:
        hex.mov 8, q, prod
        ;done

      den_norm: hex.vec 8
      num_wide: hex.vec 14
      recip_wide: hex.vec 14
      recip: hex.vec 6
      prod: hex.vec 14
      shift_nibs: hex.vec 2
      csh5: hex.vec 2, 5
      csh6: hex.vec 2, 6
      csh8: hex.vec 2, 8
      csh10: hex.vec 2, 10
      done:
    }

    // proj.scale_from_global_angle scale, visangle, viewangle, rw_normalangle, rw_distance, projection, 0
    //   (R_ScaleFromGlobalAngle): scale[:8] = the wall's projected 16.16 scale (pixels per world unit)
    //   for the column whose ABSOLUTE view angle is visangle. scale = PROJECTION*sin(angleb) /
    //   (rw_distance*sin(anglea)), anglea = ANG90+(visangle-viewangle), angleb = ANG90+(visangle-
    //   rw_normalangle); clamped to [SCALE_MIN, SCALE_MAX]; den==0 -> SCALE_MAX. Mirrors
    //   reference_model.scale_from_global_angle EXACTLY. `projection` is a COMPILE-TIME arg = PROJECTION
    //   <<16 (= CENTERX<<16; resolution-dependent, so the caller supplies it from the config SSOT, R6).
    //   NOTE: the oracle's fixed_mul/fixed_div return UNSIGNED-wrapped 32-bit values (a negative result
    //   wraps to a huge positive), and its min/max clamp + den==0 test compare those as unsigned — so the
    //   compares here are hex.cmp (NOT scmp). Verified: a negative-den case (anglea past ANG180) wraps to
    //   a huge unsigned scale and clamps to SCALE_MAX, exactly as the oracle does (scmp would give
    //   SCALE_MIN and diverge). anglea/b are unsigned-modular BAM that only feed read_sin (bit extract).
    //   @requires hex.init & stl.ptr_init   (finesine.read_sin)
    def scale_from_global_angle scale, visangle, viewangle, rw_normalangle, rw_distance, projection, disp, col \
            @ anglea, angleb, num, den, sin_idx, sinv, cproj, cang90, csmin, csmax, qneg, \
              den_zero, num_neg, num_pos, den_neg, den_pos, dodiv, chk_min, set_max, set_min, end {
        rep(1-disp, k) hex.mov 8, anglea, visangle
        rep(1-disp, k) hex.sub 8, anglea, viewangle
        rep(1-disp, k) hex.add 8, anglea, cang90               // anglea = ANG90 + (visangle - viewangle)
        hex.mov 8, angleb, visangle
        hex.sub 8, angleb, rw_normalangle
        hex.add 8, angleb, cang90               // angleb = ANG90 + (visangle - rw_normalangle)

        hex.shr_hex 8, 5, angleb                // num = fixed_mul(PROJECTION<<16, read_sin(angleb))
        hex.mov 3, sin_idx, angleb              //   read_sin idx = angleb >> 20 (low 3 nibbles)
        finesine.read_sin sinv, sin_idx
        // M13-CPROJSTATIC: `hex.set 8, cproj, projection` used to run HERE, once per call, to
        // reload a value fixed at emit time. hex.fixed_mul_lo reads its operands via
        // `.mov n, wide_b, b` (fixed_point.fj:80) and never writes b, so cproj is never
        // disturbed -- the vec below carries the constant instead. 127.3 ops/call saved
        // (scratchpad/_ptr_price.log, "hex.set 8 (const addr)").
        // M13-mulorder: operands SWAPPED vs the obvious order. fixed_mul_lo runs one schoolbook row
        // per NONZERO nibble of its SECOND operand, and a negative 16.16 sine sign-extends to a dense
        // 12-nibble pattern (~10k ops as a multiplier) while cproj = PROJECTION<<16 has ONE nonzero
        // nibble (~1.9k). Multiplication is commutative and the macro takes the same mod-16^12 low
        // product either way, so this is BIT-IDENTICAL -- purely a row-count choice.
        hex.fixed_mul_lo 8, 4, num, sinv, cproj

        // M13-SINADISP: anglea is COLUMN-ONLY. Every caller builds visangle as
        // `viewangle + xtoviewangle[col]`, so anglea = ANG90 + (visangle - viewangle) reduces,
        // as an exact mod-2^32 identity, to ANG90 + xtoviewangle[col] -- viewangle cancels. The
        // whole den sine is therefore a compile-time function of the column: a 161-entry
        // dispatch (~2.6k lines) replaces mov8 + sub8 + add8 + shr_hex + mov3 + read_sin.
        rep(1-disp, k) hex.shr_hex 8, 5, anglea    // den = fixed_mul(rw_distance, read_sin(anglea))
        rep(1-disp, k) hex.mov 3, sin_idx, anglea
        rep(1-disp, k) finesine.read_sin sinv, sin_idx
        rep(disp, k) sinadisp.lookup sinv, col
        hex.fixed_mul_lo 8, 4, den, sinv, rw_distance   // same swap: rw_distance is the sparse operand

        hex.if0 8, den, den_zero                // den == 0 -> SCALE_MAX
        // M13-scalerecip [re-bless]: sign-split + block-FP reciprocal replaces the signed
        // fixed_div (38.5k -> ~19k ops). A sign MISMATCH (negative true quotient) goes straight
        // to SCALE_MAX -- proven identical to the old unsigned-wraparound-then-clamp (any negative
        // quotient's unsigned reading is >= 2^31 > SCALE_MAX). Mirrors the oracle exactly.
        hex.set 1, qneg, 0
        hex.sign 8, num, num_neg, num_pos
      num_neg:
        hex.neg 8, num
        hex.xor_by 1, qneg, 1
      num_pos:
        hex.sign 8, den, den_neg, den_pos
      den_neg:
        hex.neg 8, den
        hex.xor_by 1, qneg, 1
      den_pos:
        hex.if0 1, qneg, dodiv
      den_zero:
        hex.mov 8, scale, csmax
        ;end
      dodiv:
        .scale_recip_div scale, num, den, disp
        hex.cmp 8, scale, csmax, chk_min, chk_min, set_max    // min(SCALE_MAX, scale): > -> clamp (unsigned)
      set_max:
        hex.mov 8, scale, csmax
        ;end                                    // SCALE_MAX > SCALE_MIN, so the min-clamp is satisfied
      chk_min:
        hex.cmp 8, scale, csmin, set_min, end, end            // max(SCALE_MIN, scale): < -> clamp (unsigned)
      set_min:
        hex.mov 8, scale, csmin
        ;end

      anglea: hex.vec 8
      angleb: hex.vec 8
      num: hex.vec 8
      den: hex.vec 8
      sin_idx: hex.vec 3
      sinv: hex.vec 8
      cproj: hex.vec 8, projection    // PROJECTION<<16, baked (M13-CPROJSTATIC; see above)
      cang90: hex.vec 8, 0x40000000
      qneg: hex.vec 1
      csmin: hex.vec 8, 0x100             // SCALE_MIN (16.16 engine constant)
      csmax: hex.vec 8, 0x400000          // SCALE_MAX = 64.0
      end:
    }

    // proj.angle_to_x dst, angle (the viewangletox lookup, R_RenderSegLoop's column map): dst[:8] = the
    //   screen column for a view-relative BAM `angle` (0 = straight ahead, + = left). idx = (angle +
    //   ANG90) >> angle_shift(20), clamped to [0, len(viewangletox)-1 = 0x7FF = TRIG_N/2 - 1]; the result
    //   is the SIGNED column (2's-complement; off-screen ends carry the -1 / VIEW_W+1 sentinels). idx is
    //   unsigned so the low (max-0) clamp is automatic. Mirrors reference_model.angle_to_x EXACTLY.
    //   @requires hex.init & stl.ptr_init   (read_table)
    def angle_to_x dst, angle, disp \
            @ angt, vtx_idx, cang90, cmaxidx, clampmax, keep, end \
            < viewangletox {
        hex.mov 8, angt, angle
        hex.add 8, angt, cang90            // angle + ANG90 (mod 2^32)
        hex.shr_hex 8, 5, angt             // >> angle_shift = 20 bits (5 nibbles)
        hex.mov 3, vtx_idx, angt           // idx = top 12 bits of (angle+ANG90)  (low 3 nibbles)
        hex.cmp 3, vtx_idx, cmaxidx, keep, keep, clampmax   // idx > len-1 ? -> clamp (unsigned; idx>=0)
      clampmax:
        hex.set 3, vtx_idx, 0x7ff
      keep:
        rep(1-disp, k) hex.read_table_packed 4, dst, viewangletox, 3, vtx_idx  // signed column (2s-complement)
        // M13-VTXDISP: the SAME lever C2 applied to tantoangle/slopediv_recip8, and the same
        // values -- viewangletox as a per-entry D4 dispatch. MEASURED on THIS macro with only the
        // `disp` flag changed, both arms vacuity-checked (scratchpad/ca2_price.py, log
        // scratchpad/_ca2_price.log): 8,827.7 -> 1,809.5 ops/call, so 7,018.2 saved. angle_to_x
        // runs twice per in-frustum seg -- 228 calls at the median of the CALL-COUNT distribution,
        // ~105 at the median of the OPS distribution (a lighter frame; the two medians are
        // different frames, which is why the whole-program delta is -734k and not -1.6M).
        rep(disp, k) vtxdisp.lookup dst, vtx_idx
        ;end

      angt: hex.vec 8
      vtx_idx: hex.vec 3
      cang90: hex.vec 8, 0x40000000
      cmaxidx: hex.vec 3, 0x7ff           // len(viewangletox)-1 = TRIG_N/2 - 1
      end:
    }

    // proj.wall_x_range visible, x1, x2, rw_angle1, viewx, viewy, viewangle, v1x, v1y, v2x, v2y, a, b, c (R_AddLine):
    //   the seg's screen column range. Writes visible=1 + (x1,x2,rw_angle1) when the seg is on-screen,
    //   else visible=0 (the oracle's None) with x1/x2/rw_angle1 zeroed. v1 is the seg's LEFT screen
    //   vertex, v2 the RIGHT (DOOM-wound baked segs). Mirrors reference_model.wall_x_range EXACTLY:
    //   back-face cull (span >= ANG180), view-relative, two-edge frustum clip (CLIPANGLE=ANG45) via
    //   DOOM's unsigned tspan logic, then angle_to_x. All the angle/span/tspan compares are UNSIGNED
    //   (modular BAM) -> hex.cmp; only the final x1>=x2 column test is SIGNED (columns can be -1) ->
    //   hex.scmp. Outputs are computed into temps and committed only on the visible path.
    //   @requires hex.init & stl.ptr_init   (inlines point_to_angle x2 + angle_to_x x2)
    def wall_x_range visible, x1, x2, rw_angle1, sgn, viewx, viewy, viewangle, v1x, v1y, v2x, v2y, a, b, c \
            @ ang1, ang2, span, tspan, diff, ang1_world, tx1, tx2, sgn_b, frontok, \
              cang180, cclip, c2clip, cnegclip, \
              notback, leftclip, setleft, leftok, rightclip, setright, rightok, visok, end {
        hex.set 1, visible, 0              // default: culled (None)
        hex.zero 8, x1
        hex.zero 8, x2
        hex.zero 8, rw_angle1

        // perf #10 [exact]: affine back-face PRE-cull BEFORE the two atans. sgn = a*viewx + b*viewy + c
        // (the signed perpendicular distance to the seg line, seg_affine_coeffs). >0 iff the eye is on the
        // wall's FRONT side; a one-sided wall whose front faces away (sgn<=0) is invisible -> cull without
        // paying point_to_angle x2. Byte-exact: every seg this culls that span<ANG180 would keep is
        // frustum-culled anyway (verified across viewpoints).
        // M13-absmul (the [[fj-cost-model]] ROW RULE): fixed_mul_lo runs one schoolbook row per NONZERO
        // nibble of its SECOND operand, and a negative 16.16 viewx sign-extends to a dense 12-nibble
        // pattern (4,984 ops) where |viewx| has 2-3 nonzero nibbles (2,632). So multiply by the
        // per-frame ABS registers (viewxa/viewya, computed once at frame start alongside their sign
        // flags) and negate the product when the sign flag says so. BIT-IDENTICAL: viewx/viewy are
        // always map<<16, so the product's low 4 nibbles are zero and two's-complement negation of
        // the truncated product equals truncation of the negated product (verified over 401 viewpoints
        // x 575 segs, scratchpad session 2026-07-25). sgn is an OUTPUT (pre-abs): wall_setup's
        // rw_distance is abs(sgn), so the caller can skip wall_setup's identical 2-mul recompute.
        // ⚠ CR-2026-08 (PJ-2) -- MULTIPLY THE SIGNED VALUE. The old form multiplied |viewx| and
        //   negated the product, which is -floor(P/2^16) where the oracle's fixed_mul(a, viewx)
        //   gives -ceil(P/2^16). Equal iff P mod 2^16 == 0 -- true for every whole map unit, false
        //   from the player's second step once M14 made the position fractional. The in-file comment
        //   asserted the identity as PROVEN ("verified over 401 viewpoints x 575 segs"), and it was
        //   -- on integers. MEASURED with two-sided controls: scratchpad/_pj2_probe.py (abs/negate
        //   5 agree / 5 DIFFER, every divergence +1 ULP; this form 10 / 0). Note the R17 trap the
        //   probe pins down: at a HALF unit only an ODD `a` diverges, so a half-unit-only fixture
        //   set is half-vacuous.
        //   OPERAND ORDER: the sparse baked constant goes SECOND (the ROW RULE -- one schoolbook row
        //   per nonzero nibble of the second operand). That swap is bit-identical, and it is
        //   MEASURED not assumed (probe control 6), because "obviously equivalent" has been wrong
        //   here before. The old form's speed argument is dead anyway: post-M14 viewxa is a dense
        //   8-nibble value, so it no longer has the 2-3 nonzero nibbles the comment claimed.
        //   ⚠ viewxa/viewxs/viewya/viewys are GONE from the signature, and that is forced, not
        //   chosen: flipjump emits a Syntax Warning for an unused macro parameter and the build
        //   runs --werror (R8), so a dead parameter cannot simply be left in place. Safe here
        //   because these two macros are called only from hand-written fj (frame_render.fj, 9
        //   sites) -- NO Python f-string emits them -- so rule 4's frozen-ABI concern, which is
        //   about emitter-generated calls, does not apply. Checked by grep over src/doomfj/.
        hex.fixed_mul_lo 8, 4, sgn, viewx, a
        hex.fixed_mul_lo 8, 4, sgn_b, viewy, b
        hex.add 8, sgn, sgn_b
        hex.add 8, sgn, c
        hex.sign 8, sgn, end, frontok      // sgn < 0 -> back-facing, cull (visible=0)
      frontok:
        hex.if0 8, sgn, end                // sgn == 0 -> on the line, cull
        .point_to_angle ang1, viewx, viewy, v1x, v1y, 0   // absolute angle to v1 (left)
        .point_to_angle ang2, viewx, viewy, v2x, v2y, 0   // absolute angle to v2 (right)
        hex.mov 8, span, ang1
        hex.sub 8, span, ang2                          // span = (ang1 - ang2) mod 2^32
        hex.sign 8, span, end, notback                 // span >= ANG180 <=> bit 31 set -> cull
      notback:
        hex.mov 8, ang1_world, ang1                      // rw_angle1 = the WORLD-frame ang1, saved before
                                                         //   ang1 goes view-relative (committed on success)
        hex.sub 8, ang1, viewangle                     // ang1 view-relative
        hex.sub 8, ang2, viewangle                     // ang2 view-relative

        hex.mov 8, tspan, ang1                         // LEFT edge: tspan = ang1 + CLIPANGLE
        hex.add 8, tspan, cclip
        hex.cmp 8, tspan, c2clip, leftok, leftok, leftclip   // tspan > 2*CLIP ?
      leftclip:
        hex.mov 8, diff, tspan
        hex.sub 8, diff, c2clip
        hex.cmp 8, diff, span, setleft, end, end       // (tspan-2*CLIP) >= span -> off the left, cull
      setleft:
        hex.mov 8, ang1, cclip                         // ang1 = CLIPANGLE
      leftok:
        hex.mov 8, tspan, cclip                        // RIGHT edge: tspan = CLIPANGLE - ang2
        hex.sub 8, tspan, ang2
        hex.cmp 8, tspan, c2clip, rightok, rightok, rightclip
      rightclip:
        hex.mov 8, diff, tspan
        hex.sub 8, diff, c2clip
        hex.cmp 8, diff, span, setright, end, end      // off the right, cull
      setright:
        hex.mov 8, ang2, cnegclip                      // ang2 = -CLIPANGLE (0xE0000000)
      rightok:
        .angle_to_x tx1, ang1, 0
        .angle_to_x tx2, ang2, 0
        hex.scmp 8, tx1, tx2, visok, end, end          // x1 >= x2 -> sub-column, cull (SIGNED columns)
      visok:
        hex.set 1, visible, 1
        hex.mov 8, x1, tx1
        hex.mov 8, x2, tx2
        hex.mov 8, rw_angle1, ang1_world
        ;end

      ang1: hex.vec 8
      ang2: hex.vec 8
      span: hex.vec 8
      tspan: hex.vec 8
      diff: hex.vec 8
      ang1_world: hex.vec 8
      tx1: hex.vec 8
      tx2: hex.vec 8
      sgn_b: hex.vec 8
      cang180: hex.vec 8, 0x80000000      // ⚠ declared + reserved but never referenced
      cclip: hex.vec 8, 0x20000000        // CLIPANGLE = ANG45
      c2clip: hex.vec 8, 0x40000000       // 2*CLIPANGLE = ANG90 (the full FOV)
      cnegclip: hex.vec 8, 0xE0000000     // -CLIPANGLE mod 2^32
      end:
    }

    // proj.wall_screen_span top, bottom, ceilfix, floorfix, viewz, scale, centeryfix (R_RenderSegLoop's
    //   vertical projection): the screen rows a wall column fills. top = (centeryfix - fixed_mul(ceilfix -
    //   viewz, scale)) >> 16, bottom likewise from floorfix; ceilfix/floorfix = ceil_h/floor_h << 16
    //   (16.16). The >>16 is ARITHMETIC (signed rows): logical shr 4 nibbles then sign_extend the low 4.
    //   Outputs SIGNED row ints (8-nibble 2's-complement; the render loop clips off-screen rows). top <
    //   bottom always. centeryfix = CENTERY<<16 (resolution-dependent) is a compile-time arg (R6). Mirrors
    //   reference_model.wall_screen_span EXACTLY (the oracle's _signed(fixed_mul) wrap == fj's 2's-comp).
    //   @requires hex.init
    def wall_screen_span top, bottom, ceilfix, floorfix, viewz, scale, centeryfix \
            @ world_h, prod, end {
        hex.mov 8, world_h, ceilfix
        hex.sub 8, world_h, viewz           // worldtop = ceilfix - viewz
        hex.fixed_mul_lo 8, 4, prod, scale, world_h   // M14-perf ROW RULE: world_h's low 4
        hex.set 8, top, centeryfix                    // nibbles are 0 (integer<<16), scale is dense
        hex.sub 8, top, prod                // topfrac = centeryfix - worldtop*scale
        hex.shr_hex 8, 4, top               // >> 16 (logical) ...
        hex.sign_extend 8, 4, top           //   ... + sign-extend low 4 nibbles = arithmetic >> 16

        hex.mov 8, world_h, floorfix
        hex.sub 8, world_h, viewz           // worldbottom = floorfix - viewz
        hex.fixed_mul_lo 8, 4, prod, scale, world_h   // M14-perf ROW RULE (see above)
        hex.set 8, bottom, centeryfix
        hex.sub 8, bottom, prod
        hex.shr_hex 8, 4, bottom
        hex.sign_extend 8, 4, bottom
        ;end

      world_h: hex.vec 8
      prod: hex.vec 8
      end:
    }

    // proj.scalestep dst, scale1, scale2, x1, x2 (the per-column rw_scalestep, render_wall_frame): the
    //   linear scale increment dst = trunc((scale2 - scale1) / (x2 - x1)) TOWARD ZERO — a PLAIN truncated
    //   integer divide, NOT FixedDiv (the oracle + fj must divide identically). 0 if x2 <= x1. scale1/2
    //   are 16.16 (positive, clamped); x1/x2 are signed columns; dst is signed (8-nibble 2's-comp).
    //   The x2>x1 guard is signed (hex.scmp), diff's sign uses hex.sign, the divide is on magnitudes
    //   (unsigned hex.div), and a negative diff negates the quotient (-(|diff|//span) = trunc toward 0).
    //   @requires hex.init
    def scalestep dst, scale1, scale2, x1, x2 \
            @ diff, span, quot, rem, no_span, have_span, diff_neg, diff_pos, baddiv, end {
        hex.scmp 8, x2, x1, no_span, no_span, have_span  // x2 > x1 ? (signed columns) — else step 0
      no_span:
        hex.zero 8, dst
        ;end
      have_span:
        hex.mov 8, span, x2
        hex.sub 8, span, x1                 // span = x2 - x1  (> 0)
        hex.mov 8, diff, scale2
        hex.sub 8, diff, scale1             // diff = scale2 - scale1 (signed)
        hex.sign 8, diff, diff_neg, diff_pos
      diff_neg:
        hex.neg 8, diff                     // |diff|
        hex.div 8, 2, quot, rem, diff, span, baddiv   // M13: span = x2-x1 <= VIEW_W fits 2 nibbles
        hex.mov 8, dst, quot
        hex.neg 8, dst                      // dst = -(|diff| // span)  (trunc toward zero)
        ;end
      diff_pos:
        hex.div 8, 2, quot, rem, diff, span, baddiv   // dst = diff // span (2-nib divisor)
        hex.mov 8, dst, quot
        ;end
      baddiv:                               // unreachable (span > 0); safe fallback
        hex.zero 8, dst
        ;end

      diff: hex.vec 8
      span: hex.vec 8
      quot: hex.vec 8
      rem: hex.vec 8
      end:
    }

    // proj.wall_offset rw_offset, rw_centerangle, viewx, viewy, viewangle, rw_normalangle, rw_angle1,
    //   v1x, v1y, texoff (R_StoreWallRange texture-horizontal setup, _wall_offset): writes rw_offset (the
    //   16.16 wall-space horizontal coord of v1) and rw_centerangle (seeds the per-column finetangent).
    //   offsetangle = rw_normalangle - rw_angle1; rw_offset = fixed_mul(point_to_dist(view,v1),
    //   read_sin(BAM-abs(offsetangle) clamped to ANG90)); NEGATE if the UNFOLDED offsetangle < ANG180
    //   (DOOM's sign rule); then += texoff (= (seg.offset + sd.x_off)<<16). rw_centerangle = ANG90 +
    //   viewangle - rw_normalangle. All angle compares are unsigned BAM (hex.cmp). Mirrors the oracle
    //   exactly. @requires hex.init & stl.ptr_init  (inlines point_to_dist + finesine.read_sin)
    def wall_offset rw_offset, rw_centerangle, viewx, viewy, viewangle, rw_normalangle, rw_angle1, v1x, v1y, texoff \
            @ offsetangle, oa_abs, hyp, sin_idx, sinv, cang90, cang180, \
              gt180, le180, gt90, le90, doneg, skipneg, end {
        .point_to_dist hyp, viewx, viewy, v1x, v1y     // hyp = view->v1 distance
        hex.mov 8, offsetangle, rw_normalangle
        hex.sub 8, offsetangle, rw_angle1              // offsetangle = rw_normalangle - rw_angle1

        hex.mov 8, oa_abs, offsetangle                 // oa_abs = BAM abs(offsetangle), clamp to ANG90
        hex.cmp 8, oa_abs, cang180, le180, le180, gt180
      gt180:
        hex.neg 8, oa_abs
      le180:
        hex.cmp 8, oa_abs, cang90, le90, le90, gt90
      gt90:
        hex.mov 8, oa_abs, cang90
      le90:
        hex.shr_hex 8, 5, oa_abs                       // read_sin: idx = oa_abs >> 20 (low 3 nibbles)
        hex.mov 3, sin_idx, oa_abs
        finesine.read_sin sinv, sin_idx
        hex.fixed_mul_lo 8, 4, rw_offset, hyp, sinv       // rw_offset = hyp * sin(oa_abs)

        hex.cmp 8, offsetangle, cang180, doneg, skipneg, skipneg   // UNFOLDED offsetangle < ANG180 -> negate
      doneg:
        hex.neg 8, rw_offset
      skipneg:
        hex.add 8, rw_offset, texoff                   // += (seg.offset + sd.x_off) << 16

        hex.mov 8, rw_centerangle, viewangle           // rw_centerangle = ANG90 + viewangle - rw_normalangle
        hex.add 8, rw_centerangle, cang90
        hex.sub 8, rw_centerangle, rw_normalangle
        ;end

      offsetangle: hex.vec 8
      oa_abs: hex.vec 8
      hyp: hex.vec 8
      sin_idx: hex.vec 3
      sinv: hex.vec 8
      cang90: hex.vec 8, 0x40000000
      cang180: hex.vec 8, 0x80000000
      end:
    }

    // proj.texture_u dst, rw_centerangle, rw_offset, rw_distance, x, tw (per-column texture u-coord,
    //   render_wall_frame lines 549-552): dst = the texture column [0, tw) for screen column x.
    //   ang = rw_centerangle + xtoviewangle[x]; ft = finetangent[ang >> angle_shift(20)];
    //   tcol = (rw_offset - fixed_mul(ft, rw_distance)) >> 16 (ARITHMETIC, signed); dst = tcol mod tw,
    //   a FLOORED modulo (result in [0, tw) even for negative tcol). Implemented as an unsigned divide on
    //   |tcol| then, when tcol<0 and the remainder != 0, dst = tw - remainder (= Python's tcol % tw).
    //   Reads the M12l xtoviewangle (idx=column) + finetangent LUTs. Mirrors the oracle EXACTLY.
    //   @requires hex.init & stl.ptr_init   (read_table x2)
    def texture_u dst, rw_centerangle, rw_offset, rw_distance, x, tw \
            @ ang, ft, prod, tcol, tcol_abs, quot, rem, ft_idx, czero, \
              tpos, tneg, rem_zero, rem_nz, baddiv, end \
            < xtoviewangle, finetangent {
        hex.read_table_packed 4, ang, xtoviewangle, 2, x      // xtoviewangle[x]   (idx = screen column)
        hex.add 8, ang, rw_centerangle                 // ang = rw_centerangle + xtoviewangle[x]
        hex.shr_hex 8, 5, ang                          // ang >> angle_shift(20) = 5 nibbles
        hex.mov 3, ft_idx, ang                         //   low 3 nibbles = the finetangent index
        hex.read_table_packed 4, ft, finetangent, 3, ft_idx   // ft = finetangent[idx]  (signed)
        hex.fixed_mul_lo 8, 4, prod, ft, rw_distance      // prod = ft * rw_distance (signed)
        hex.mov 8, tcol, rw_offset
        hex.sub 8, tcol, prod                          // rw_offset - prod
        hex.shr_hex 8, 4, tcol
        hex.sign_extend 8, 4, tcol                     // arithmetic >> 16 -> signed texel column tcol

        hex.sign 8, tcol, tneg, tpos                   // floored mod: tcol % tw -> [0, tw)
      tpos:
        hex.div 8, 8, quot, rem, tcol, tw, baddiv      // tcol >= 0: dst = tcol % tw (unsigned)
        hex.mov 8, dst, rem
        ;end
      tneg:
        hex.mov 8, tcol_abs, tcol
        hex.neg 8, tcol_abs                            // |tcol|
        hex.div 8, 8, quot, rem, tcol_abs, tw, baddiv  // rem = |tcol| % tw
        hex.cmp 8, rem, czero, rem_nz, rem_zero, rem_nz   // rem == 0 ? (unsigned magnitude)
      rem_zero:
        hex.zero 8, dst                                // exact multiple -> 0
        ;end
      rem_nz:
        hex.mov 8, dst, tw
        hex.sub 8, dst, rem                            // dst = tw - (|tcol| % tw)  in (0, tw)
        ;end
      baddiv:                                          // tw == 0 unreachable; safe fallback
        hex.zero 8, dst
        ;end

      ang: hex.vec 8
      ft: hex.vec 8
      prod: hex.vec 8
      tcol: hex.vec 8
      tcol_abs: hex.vec 8
      quot: hex.vec 8
      rem: hex.vec 8
      ft_idx: hex.vec 3
      czero: hex.vec 8, 0
      end:
    }

    // proj.column_setup frac0, step, scale, worldtop, top, centery, ds (the per-column texture-v DDA
    //   setup, render_wall_frame lines 553-559): from a column's `scale` (16.16), the wall's `worldtop`
    //   (= sec.ceil_h - viewz_world, signed map units) and the clipped `top` screen row (signed), compute
    //   the 8.8 DDA params the textured-column leaf consumes. iscale = fixed_div(1<<16, scale) // ds
    //   (texels/pixel 16.16); texturemid = (worldtop<<16) // ds; frac = texturemid + (top-CENTERY)*iscale;
    //   frac0 = (frac>>8)&0xFFFF, step = (iscale>>8)&0xFFFF (both 8.8, 16-bit). `ds` (= TEXTURE_DOWNSCALE,
    //   which is RESOLUTION-dependent: max(1, NATIVE_W//W)) and CENTERY are both compile-time args from
    //   the Config SSOT (R6 — NOT hardcoded). The `// ds` is a FLOORED divide (Python //): iscale is
    //   positive so a plain divide suffices; texturemid (signed, ceiling-below-eye) uses sign-aware
    //   flooring (-qmag, minus 1 more when the magnitude divide leaves a remainder). (top-CENTERY)*iscale
    //   is a PLAIN signed multiply (2's-complement mod 2^32 via hex.mul), NOT fixed_mul. Mirrors the
    //   oracle EXACTLY. @requires hex.init
    def column_setup frac0, step, scale, worldtop, top, centery, ds \
            @ iscale_pre, iscale, worldtop_fix, worldtop_abs, qmag, rmag, texmid, row_off, \
              c_centery, prod, vfrac, \
              cds, czero, rdiscard, wpos, wneg, radj, tm_done, baddiv, end, \
              recip_norm, recip_norm_more, recip_norm_done, recip_shift, recip_shift_more, \
              recip_shift_done, scale_norm, norm_shift, recip_m, cfff, czero2 \
            < slopediv_recip {
        // perf #11 [re-bless]: iscale_pre = (1<<32)//scale via the block-FP reciprocal (numerator 2^32
        // is a power of 2 -> a pure SHIFT of recip[m], NO divide, NO mul). scale is the clamped wall
        // scale (>= SCALE_MIN=256), so only right-normalize: bring scale's top 3 nibbles to m (counting
        // norm_shift), recip = slopediv_recip[m], iscale_pre = (recip << 2 nibbles) >> norm_shift
        // nibbles. Mirrors _recip_div32.
        hex.mov 8, scale_norm, scale
        hex.set 2, norm_shift, 0
      recip_norm:
        hex.cmp 8, scale_norm, cfff, recip_norm_done, recip_norm_done, recip_norm_more   // > 0xFFF ?
      recip_norm_more:
        hex.shr_hex 8, 1, scale_norm
        hex.inc 2, norm_shift
        ;recip_norm
      recip_norm_done:
        hex.read_table_packed 3, recip_m, slopediv_recip, 3, scale_norm   // recip[m]  (m = low 3 nibbles)
        hex.zero 8, iscale_pre
        hex.mov 5, iscale_pre, recip_m
        hex.shl_hex 8, 2, iscale_pre                            // recip << 2 nibbles
      recip_shift:
        hex.cmp 2, norm_shift, czero2, recip_shift_done, recip_shift_done, recip_shift_more   // > 0 ?
      recip_shift_more:
        hex.shr_hex 8, 1, iscale_pre
        hex.dec 2, norm_shift
        ;recip_shift
      recip_shift_done:                                         // = (recip<<2) >> norm_shift
        hex.set 8, cds, ds
        hex.div 8, 8, iscale, rdiscard, iscale_pre, cds, baddiv   // // ds (positive: trunc == floor)

        hex.mov 8, worldtop_fix, worldtop                  // worldtop << 16  (16.16, signed)
        hex.shl_hex 8, 4, worldtop_fix
        hex.sign 8, worldtop_fix, wneg, wpos               // texturemid = worldtop_fix // ds (FLOORED)
      wpos:
        hex.div 8, 8, texmid, rdiscard, worldtop_fix, cds, baddiv   //   >= 0: plain divide
        ;tm_done
      wneg:
        hex.mov 8, worldtop_abs, worldtop_fix
        hex.neg 8, worldtop_abs                            //   |worldtop_fix|
        hex.div 8, 8, qmag, rmag, worldtop_abs, cds, baddiv   //   qmag = |.|//ds, rmag = |.|%ds
        hex.mov 8, texmid, qmag
        hex.neg 8, texmid                                  //   -qmag
        hex.cmp 8, rmag, czero, radj, tm_done, radj        //   rmag != 0 -> floor one more
      radj:
        hex.dec 8, texmid                                  //   -(qmag+1)  (floored toward -inf)
        ;tm_done
      tm_done:
        hex.set 8, c_centery, centery
        hex.mov 8, row_off, top
        hex.sub 8, row_off, c_centery                      // row_off = top - CENTERY (signed)
        hex.mul 8, prod, row_off, iscale                   // (top-CENTERY)*iscale (signed, mod 2^32)
        hex.mov 8, vfrac, texmid
        hex.add 8, vfrac, prod                             // vfrac = texturemid + (top-CENTERY)*iscale

        hex.shr_hex 8, 2, iscale                           // step = (iscale >> 8) & 0xFFFF
        hex.mov 4, step, iscale
        hex.shr_hex 8, 2, vfrac                            // frac0 = (vfrac >> 8) & 0xFFFF
        hex.mov 4, frac0, vfrac
        ;end

      baddiv:                                              // scale==0 / ds==0 unreachable; safe fallback
        hex.zero 4, frac0
        hex.zero 4, step
        ;end

      iscale_pre: hex.vec 8
      iscale: hex.vec 8
      worldtop_fix: hex.vec 8
      worldtop_abs: hex.vec 8
      qmag: hex.vec 8
      rmag: hex.vec 8
      texmid: hex.vec 8
      row_off: hex.vec 8
      c_centery: hex.vec 8
      prod: hex.vec 8
      vfrac: hex.vec 8
      scale_norm: hex.vec 8              // perf #11: block-FP reciprocal scratch
      norm_shift: hex.vec 2
      recip_m: hex.vec 6
      cfff: hex.vec 8, 0xfff
      czero2: hex.vec 2, 0
      cds: hex.vec 8
      czero: hex.vec 8, 0
      rdiscard: hex.vec 8                // divide remainders we never read
      end:
    }

    // proj.wall_scale_setup scale1, scalestep_out, viewangle, rw_normalangle, rw_distance, x1, x2,
    //   projection (the per-seg scale interpolation seed, render_wall_frame lines 521-527): scale1 = the
    //   column-x1 wall scale = scale_from_global_angle at visangle = viewangle + xtoviewangle[x1];
    //   scalestep_out = the linear rw_scalestep from x1 to x2 (scale2 at x2, then trunc((scale2-scale1)/
    //   (x2-x1))). The render loop then walks `scale += scalestep_out` across the columns. Composes the
    //   xtoviewangle lookup + scale_from_global_angle (M12q) x2 + scalestep (M12u). x1/x2 are columns
    //   (read as 2-nibble indices into xtoviewangle). `projection` is the compile-time Config arg (R6).
    //   Mirrors the oracle EXACTLY. @requires hex.init & stl.ptr_init   (read_table + finesine.read_sin)
    def wall_scale_setup scale1, scalestep_out, viewangle, rw_normalangle, rw_distance, x1, x2, projection \
            @ visang1, visang2, scale2, end \
            < xtoviewangle {
        hex.read_table_packed 4, visang1, xtoviewangle, 2, x1  // xtoviewangle[x1]
        hex.add 8, visang1, viewangle                   // visangle@x1 = viewangle + xtoviewangle[x1]
        .scale_from_global_angle scale1, visang1, viewangle, rw_normalangle, rw_distance, projection, 0, x1
        hex.read_table_packed 4, visang2, xtoviewangle, 2, x2  // xtoviewangle[x2]
        hex.add 8, visang2, viewangle                   // visangle@x2
        .scale_from_global_angle scale2, visang2, viewangle, rw_normalangle, rw_distance, projection, 0, x2
        .scalestep scalestep_out, scale1, scale2, x1, x2   // trunc((scale2-scale1)/(x2-x1)) toward zero
        ;end

      visang1: hex.vec 8
      visang2: hex.vec 8
      scale2: hex.vec 8
      end:
    }

    // proj.wall_scale_setup_m — the LINES-mode wall_scale_setup (M13-XTADISP). Identical values and
    // identical output, but the two xtoviewangle reads go through the D4 per-entry DISPATCH table
    // `xtadisp` (~20@) instead of hex.read_table_packed 4 (~289@ per the stl's documented
    // complexities, so ~15.6k ops saved per in-frustum seg). The same lever M13-ATANDISP applied to
    // tantoangle and slopediv_recip8; byte-exact by construction, same values.
    // x1/x2 are 2-nibble column indices in [0, VIEW_W] -- exactly the dispatch table's index width.
    def wall_scale_setup_m scale1, scalestep_out, viewangle, rw_normalangle, rw_distance, x1, x2, projection \
            @ visang1, visang2, scale2, end {
        xtadisp.lookup visang1, x1                      // xtoviewangle[x1]
        hex.add 8, visang1, viewangle                   // visangle@x1 = viewangle + xtoviewangle[x1]
        .scale_from_global_angle scale1, visang1, viewangle, rw_normalangle, rw_distance, projection, 1, x1
        xtadisp.lookup visang2, x2                      // xtoviewangle[x2]
        hex.add 8, visang2, viewangle                   // visangle@x2
        .scale_from_global_angle scale2, visang2, viewangle, rw_normalangle, rw_distance, projection, 1, x2
        .scalestep scalestep_out, scale1, scale2, x1, x2   // trunc((scale2-scale1)/(x2-x1)) toward zero
        ;end

      visang1: hex.vec 8
      visang2: hex.vec 8
      scale2: hex.vec 8
      end:
    }

    // proj.column_render_params top, bottom, texcol, frac0, step, <runtime per-column inputs>, centery,
    //   ds, viewh1 (the per-column render-parameter bundle, render_wall_frame lines 540-559): for one
    //   screen column, composes wall_screen_span -> CLIP (top=max(0,top), bottom=min(VIEW_H-1,bottom)) ->
    //   texture_u -> column_setup, yielding the column's (top, bottom [both clipped], texcol, frac0, step).
    //   The clip is the new logic: top/bottom are SIGNED rows so the clamps use hex.sign (max 0) and
    //   hex.scmp (min VIEW_H-1). centery / ds / viewh1(=VIEW_H-1) are compile-time Config args (R6);
    //   centeryfix is the compile-time expr centery*0x10000. column_setup gets the CLIPPED top (oracle
    //   line 541 clips before frac). Mirrors the oracle EXACTLY. @requires hex.init & stl.ptr_init
    def column_render_params top, bottom, texcol, frac0, step, scale, rw_centerangle, rw_offset, rw_distance, x, tw, ceilfix, floorfix, viewz, worldtop, centery, ds, viewh1 \
            @ c_viewh1, tneg, tok, bok, bhi, end {
        .wall_screen_span top, bottom, ceilfix, floorfix, viewz, scale, centery*0x10000
        hex.sign 8, top, tneg, tok          // top = max(0, top)  (signed)
      tneg:
        hex.zero 8, top
      tok:
        hex.set 8, c_viewh1, viewh1         // bottom = min(VIEW_H-1, bottom)  (signed)
        hex.scmp 8, bottom, c_viewh1, bok, bok, bhi
      bhi:
        hex.mov 8, bottom, c_viewh1
      bok:
        .texture_u texcol, rw_centerangle, rw_offset, rw_distance, x, tw
        .column_setup frac0, step, scale, worldtop, top, centery, ds   // uses the CLIPPED top
        ;end

      c_viewh1: hex.vec 8
      end:
    }

    // M13pS2/pG3-stream — the STREAM-mode column params: just the projected+clipped [top, bottom]
    // rows (wall_screen_span + the two clips). The texture u (a hex.div!) and the vertical DDA
    // setup (column_setup) are DEAD in the column-stream renderer's W1 mode (the wall run is one
    // baked lit byte; planes come from the shared band lists), so this variant skips them — the
    // measured bulk of the old per-column cost.
    def column_render_params_stream top, bottom, scale, ceilfix, floorfix, viewz, centery, viewh1 \
            @ c_viewh1, tneg, tok, bok, bhi, end {
        .wall_screen_span top, bottom, ceilfix, floorfix, viewz, scale, centery*0x10000
        hex.sign 8, top, tneg, tok          // top = max(0, top)  (signed)
      tneg:
        hex.zero 8, top
      tok:
        hex.set 8, c_viewh1, viewh1         // bottom = min(VIEW_H-1, bottom)  (signed)
        hex.scmp 8, bottom, c_viewh1, bok, bok, bhi
      bhi:
        hex.mov 8, bottom, c_viewh1
      bok:
        ;end
      c_viewh1: hex.vec 8
      end:
    }

    // proj.project_thing (V4 THINGS) — R_ProjectSprite: one billboard's screen box.
    //   Sets `vis` = 1 and (x1o, x2o, ytopo, hpxo, istepo) = the inclusive column range, the screen
    //   row of the sprite's top, its on-screen pixel height, and the DOWNSCALED-texel-per-column DDA
    //   step; `vis` = 0 if the thing is behind the eye, nearer than MINZ, off screen, or scaled to
    //   nothing. Per-thing inputs are BAKED (`sp_*`, all compile-time): the world position, the
    //   sprite's top z, its left offset, and its width/height in map units (a DOOM sprite pixel IS
    //   one map unit, so the geometry never downscales — only the sampling does).
    //   Cost is ONE `hex.fixed_div` (~38.5k, the dearest primitive here) plus one block-FP
    //   reciprocal and five multiplies — which is why THING_BUDGET exists.
    //   NAMING: tr_x/tr_y/gxt/gyt/tz/tx/xscale/gzt are R_ProjectSprite's own identifiers, kept so
    //   the fj reads next to r_things.c (see the conventions header).
    //   Mirrors ReferenceModel.project_thing EXACTLY. @requires hex.init & stl.ptr_init
    def project_thing vis, x1o, x2o, ytopo, hpxo, istepo, minz, projection, centerx, centery, vieww, viewh, ds, deg, spn, neartz \
            @ past_far, past_minz, xscale_done, in_fov, x2_ok, x1_ok, cols_ok, h_ok, h_fits, \
              clamp_tall, set_far, far_done, trig_calc, trig_have, trig_cached, reject, done, end, \
              deg_far_hard, \
              tr_x, tr_y, ang, sin_idx, vsin, vcos, gxt, gyt, tz, xscale, tx, tx_abs, tz_lim, \
              tx_left, tx_right, tmp, gzt, one16, czlim, cproj, c_centerxfix, c_centeryfix, \
              c_vieww, c_viewh \
            < viewx, viewy, viewangle, viewz, sp_x, sp_y, sp_z, sp_left, sp_w, sp_hh, sp_tzmax, \
              sp_tzmax2, degfl, thfar {
        hex.set 1, vis, 0
        hex.mov 8, tr_x, sp_x
        hex.sub 8, tr_x, viewx
        hex.mov 8, tr_y, sp_y
        hex.sub 8, tr_y, viewy
        // sin/cos of the VIEW angle: constant for the whole frame, but this leaf runs once per
        // THING (250 of them on E1M1). A `finesine` lookup carries result_nibbles=8, i.e. EIGHT
        // dispatches, so the pair costs ~8.6k ops -- against a 1-nibble `if0` to reuse them. A
        // macro's locals are program statics, so the cache needs nothing but the flag.
        hex.if0 1, trig_cached, trig_calc
        ;trig_have
      trig_calc:
        hex.mov 8, ang, viewangle                       // finesine index = angle >> 20 bits
        hex.shr_hex 8, 5, ang
        hex.mov 3, sin_idx, ang
        finesine.read_sin vsin, sin_idx
        finesine.read_cos vcos, sin_idx
        hex.set 1, trig_cached, 1
      trig_have:
        // tz = tr_x*cos + tr_y*sin  (DOOM: gxt - gyt with gyt = -FixedMul(tr_y, viewsin))
        // ⚠ OPERANDS SWAPPED (the M13-mulorder lever). `fixed_mul_lo` runs one schoolbook row
        // per NONZERO NIBBLE OF THE SECOND OPERAND, and tr_x/tr_y are differences of
        // (map-unit << 16) values -- their low FOUR nibbles are always zero -- while a finesine
        // value is a dense 16.16. Commutative and the same mod-16^12 low product, so this is
        // BIT-IDENTICAL: purely a row-count choice.
        hex.fixed_mul_lo 8, 4, gxt, vcos, tr_x
        hex.fixed_mul_lo 8, 4, gyt, vsin, tr_y
        hex.mov 8, tz, gxt
        hex.add 8, tz, gyt
        // ⚠ czlim is REUSED: it carries MINZ here and the SPR-NEAR detail radius below.
        hex.set 8, czlim, minz
        hex.scmp 8, tz, czlim, reject, past_minz, past_minz
      past_minz:
        // EXACT far reject, and it belongs HERE. h = wph*PROJECTION/tz, so tz > (wph*PROJ)<<16
        // gives h == 0 -- which the height test below already rejects, but only after two more
        // multiplies and a reciprocal. `sp_tzmax` is that threshold, baked per thing. Verified
        // exhaustively against `_scale_recip_div` over every sprite height: the boundary is exact,
        // no margin needed, so the frame cannot change.
        // 25M-CAP GRADUATED: past the SOFT count thing_record_body set degfl, and the reject
        // depth tightens to the second baked bound (sp_tzmax2, scanned for the raised min-size
        // exactly as sp_tzmax is for the base one). Same compare, different constant.
        rep(deg, k) hex.if1 1, degfl, deg_far_hard
        hex.cmp 8, tz, sp_tzmax, past_far, past_far, reject
      deg_far_hard:
        rep(deg, k) hex.cmp 8, tz, sp_tzmax2, past_far, past_far, reject
      past_far:
        // SPR-NEAR: beyond the detail radius? The record loop then picks the coarse packed
        // bank for SHORT buckets; near things keep full detail whatever their screen height.
        rep(spn, k) hex.set 1, thfar, 0
        rep(spn, k) hex.set 8, czlim, neartz
        rep(spn, k) hex.cmp 8, tz, czlim, far_done, far_done, set_far
      set_far:
        rep(spn, k) hex.set 1, thfar, 1
      far_done:
        // tx = tr_x*sin - tr_y*cos  (DOOM: -(gyt + gxt) with both negated)
        hex.fixed_mul_lo 8, 4, gxt, vsin, tr_x         // same swap, same reason
        hex.fixed_mul_lo 8, 4, gyt, vcos, tr_y
        hex.mov 8, tx, gxt
        hex.sub 8, tx, gyt
        hex.mov 8, tx_abs, tx                           // |tx| > tz<<2 -> outside the view
        hex.abs 8, tx_abs
        hex.mov 8, tz_lim, tz
        hex.shl_bit 8, tz_lim
        hex.shl_bit 8, tz_lim
        // ⚠ this reject runs BEFORE the divide, where DOOM runs it after. It needs only tz
        // and tx and rejects exactly the same set either way -- so the frame is unchanged
        // and every off-screen thing stops paying a `hex.fixed_div 8,4` (38,500 ops, the
        // dearest primitive in the table).
        hex.cmp 8, tx_abs, tz_lim, in_fov, in_fov, reject
      in_fov:
        hex.set 8, cproj, projection                    // ⚠ `projection` ALREADY carries the <<16
                                                        // (wall_renderer passes
                                                        // `cfg.PROJECTION << 16`). Shifting it
                                                        // again truncates it to 0 -> xscale 0 ->
                                                        // EVERY thing fails projection.
        // M13-scalerecip applied to sprites: `hex.fixed_div 8,4` is 38,500 ops -- the dearest
        // primitive there is -- and it runs for every thing that survives the FOV reject. The
        // shared block-FP reciprocal is roughly a third of that. ⚠ NOT bit-identical (a true divide
        // against a table reciprocal), so the ORACLE takes the same path: this is the same re-bless
        // the wall scale already took, not an approximation fj invented on its own.
        .scale_recip_div xscale, cproj, tz, 1           // xscale = (projection<<16) / tz
      xscale_done:                                      // ⚠ label is never jumped to (dead)
        hex.set 8, c_centerxfix, centerx*0x10000
        hex.mov 8, tx_left, tx
        hex.sub 8, tx_left, sp_left
        hex.fixed_mul_lo 8, 4, tmp, tx_left, xscale
        hex.add 8, tmp, c_centerxfix
        hex.shr_hex 8, 4, tmp
        hex.sign_extend 8, 4, tmp
        hex.mov 8, x1o, tmp
        hex.mov 8, tx_right, tx_left
        hex.add 8, tx_right, sp_w
        hex.fixed_mul_lo 8, 4, tmp, tx_right, xscale
        hex.add 8, tmp, c_centerxfix
        hex.shr_hex 8, 4, tmp
        hex.sign_extend 8, 4, tmp
        hex.dec 8, tmp
        hex.mov 8, x2o, tmp
        hex.sign 8, x2o, reject, x2_ok                  // x2 < 0 -> entirely off the left
      x2_ok:
        hex.set 8, c_vieww, vieww
        hex.scmp 8, x1o, c_vieww, x1_ok, reject, reject // x1 >= VIEW_W -> entirely off the right
      x1_ok:
        hex.scmp 8, x2o, x1o, reject, cols_ok, cols_ok  // x2 < x1 -> sub-column
      cols_ok:
        hex.mov 8, gzt, sp_z                            // gzt = (thing floor + sprite top) - viewz
        hex.sub 8, gzt, viewz
        hex.fixed_mul_lo 8, 4, tmp, xscale, gzt        // M14-perf ROW RULE: gzt is integer<<16
        hex.set 8, c_centeryfix, centery*0x10000
        hex.mov 8, ytopo, c_centeryfix
        hex.sub 8, ytopo, tmp
        hex.shr_hex 8, 4, ytopo
        hex.sign_extend 8, 4, ytopo
        hex.fixed_mul_lo 8, 4, tmp, xscale, sp_hh      // M14-perf ROW RULE: sp_hh is integer<<16
        hex.shr_hex 8, 4, tmp
        hex.sign_extend 8, 4, tmp
        hex.mov 8, hpxo, tmp
        hex.sign 8, hpxo, reject, h_ok
      h_ok:
        hex.if0 8, hpxo, reject
        hex.set 8, c_viewh, viewh
        hex.scmp 8, hpxo, c_viewh, h_fits, h_fits, clamp_tall   // taller than the screen -> CLAMP
      clamp_tall:
        // SPR-NEAR: a too-near sprite clamps to the tallest bucket instead of VANISHING --
        // feet planted: the top moves DOWN by the overflow so the bottom row stays true
        hex.mov 8, tmp, hpxo
        hex.sub 8, tmp, c_viewh
        hex.add 8, ytopo, tmp
        hex.mov 8, hpxo, c_viewh
      h_fits:
        hex.set 8, one16, 0x10000
        .scale_recip_div istepo, one16, xscale, 1       // (1<<32)/xscale = texels per screen column
        // CR-2026-08: /downscale = shift by log2(ds) (#ds-1), NOT ds/2 -- the two agree only
        // at ds in {1,2,4}; the oracle divides by the value (reference_model.project_thing)
        rep(#ds - 1, k) hex.shr_bit 8, istepo           // ... in DOWNSCALED texels
        hex.set 1, vis, 1
        ;done
      reject:
        hex.set 1, vis, 0
      done:
        ;end
      tr_x: hex.vec 8
      tr_y: hex.vec 8
      ang: hex.vec 8
      sin_idx: hex.vec 3
      vsin: hex.vec 8
      vcos: hex.vec 8
      gxt: hex.vec 8
      gyt: hex.vec 8
      tz: hex.vec 8
      xscale: hex.vec 8
      tx: hex.vec 8
      tx_abs: hex.vec 8
      tz_lim: hex.vec 8
      tx_left: hex.vec 8
      tx_right: hex.vec 8
      tmp: hex.vec 8
      gzt: hex.vec 8
      one16: hex.vec 8
      czlim: hex.vec 8                                // MINZ, then the SPR-NEAR radius
      cproj: hex.vec 8
      c_centerxfix: hex.vec 8
      c_centeryfix: hex.vec 8
      c_vieww: hex.vec 8
      c_viewh: hex.vec 8
      trig_cached: hex.vec 1                          // V4: sin/cos already cached this frame?
      end:
    }

    // proj.step_rows ra, rb, scale, wta8, wtb8, centeryfix_c (V3 step faces) -- `column_params_m`
    //   WITHOUT the two clips: the raw SIGNED screen rows two world heights project to in this
    //   column. The clips have to go because a step face is bounded by a DIFFERENT pair of heights
    //   than the wall's, and its emptiness test compares the two raw rows: `column_params_m` clamps
    //   `bottom` to VIEW_H-1, which silently loses the one row a face reaching the very bottom of
    //   the ceiling region needs (min(H-2, B) instead of min(H-1, B)). Same two 6-row multiplies,
    //   same >>16-arithmetic fold, so the cost is `column_params_m`'s (~11.9k) less the clamps.
    //   wta8/wtb8 are the PER-SEG hoisted map-unit heights, exactly as wtc8/wtf8 are. @requires hex.init
    def step_rows ra, rb, scale, wta8, wtb8, centeryfix_c \
            @ prod, c_centeryfix, end {
        hex.zero 8, prod
        rep(6, j) hex.fixed_mul_lo.row 8, j, prod, wta8, scale
        hex.set 8, c_centeryfix, centeryfix_c
        hex.mov 8, ra, c_centeryfix
        hex.sub 8, ra, prod                 // rowfrac = centeryfix - wt*scale
        hex.shr_hex 8, 4, ra                // >> 16 arithmetic:
        hex.sign_extend 8, 4, ra            //   logical shift + sign-extend the low half
        hex.zero 8, prod
        rep(6, j) hex.fixed_mul_lo.row 8, j, prod, wtb8, scale
        hex.mov 8, rb, c_centeryfix
        hex.sub 8, rb, prod
        hex.shr_hex 8, 4, rb
        hex.sign_extend 8, 4, rb
        ;end
      prod: hex.vec 8
      c_centeryfix: hex.vec 8
      end:
    }

    // proj.column_params_m top, bottom, scale, wtc8, wtf8, centeryfix_c, viewh1 -- the lines-mode
    //   per-column projection: wtc8/wtf8 are the PER-SEG HOISTED map-unit world heights
    //   ((ceilfix-viewz)>>16, sign-extended to 8 nibbles once per seg), so the per-column work is
    //   just prod = wt*scale (EXACT: wt<<16 * scale >> 16 == wt*scale, the mapmul identity),
    //   top = (centeryfix - prod) >> 16 arithmetic, and the clips. The multiplies run as 6
    //   schoolbook rows with SCALE as the multiplier (<= 3 nonzero nibbles; zero rows if0-skip).
    //   Bit-identical to wall_screen_span + clips on the same inputs. @requires hex.init
    def column_params_m top, bottom, scale, wtc8, wtf8, centeryfix_c, viewh1 \
            @ prod, c_viewh1, c_centeryfix, consts_set, set_consts, consts_ready, \
              tneg, tok, bok, bhi, end {
        // EXP-14: the two c_ constants are COMPILE-TIME values and this macro runs once per COLUMN,
        // so re-setting them every call cost two `hex.set 8` -- a zero plus a xor across eight
        // nibbles each. A macro's locals are program statics (the EXP-5 sin/cos-cache lesson), so
        // they survive between calls: set them on the FIRST call only, behind a 1-nibble flag.
        // Bit-identical -- nothing else ever writes either register. `opprof.py` put the
        // `hex.set > hex.set > hex.zero` path at ~2% of the whole frame.
        hex.if0 1, consts_set, set_consts
        ;consts_ready
      set_consts:
        hex.set 8, c_centeryfix, centeryfix_c
        hex.set 8, c_viewh1, viewh1
        hex.set 1, consts_set, 1
      consts_ready:
        hex.zero 8, prod
        rep(6, j) hex.fixed_mul_lo.row 8, j, prod, wtc8, scale
        hex.mov 8, top, c_centeryfix
        hex.sub 8, top, prod                // topfrac = centeryfix - wt*scale
        hex.shr_hex 8, 4, top               // >> 16 arithmetic:
        hex.sign_extend 8, 4, top           //   logical shift + sign-extend the low half
        hex.zero 8, prod
        rep(6, j) hex.fixed_mul_lo.row 8, j, prod, wtf8, scale
        hex.mov 8, bottom, c_centeryfix
        hex.sub 8, bottom, prod
        hex.shr_hex 8, 4, bottom
        hex.sign_extend 8, 4, bottom
        hex.sign 8, top, tneg, tok          // top = max(0, top)
      tneg:
        hex.zero 8, top
      tok:
        hex.scmp 8, bottom, c_viewh1, bok, bok, bhi   // bottom = min(VIEW_H-1, ...)
      bhi:
        hex.mov 8, bottom, c_viewh1
      bok:
        ;end
      prod: hex.vec 8
      c_viewh1: hex.vec 8
      c_centeryfix: hex.vec 8
      consts_set: hex.vec 1
      end:
    }

    // proj.point_on_side back, vx, vy, px, py, dx, dy (R_PointOnSide / mapcompiler._point_side): the BSP
    //   partition side test the bake-as-code walk (opt #7) branches on. back[:2] = 1 iff
    //   dx*(vy-py) - dy*(vx-px) > 0 (the "back/left" side; <0 or ON the line -> front -> 0). vx,vy are the
    //   viewer's 16.0 integer map coords (signed, 10-nibble sign-extended regs); px,py,dx,dy are the node's
    //   partition line, passed as their 10-nibble (40-bit) two's-complement patterns (the emitter/test masks
    //   them). Worked at 10 nibbles because int16 map coords bound the cross product by 2^32 (< 2^39), so the
    //   40-bit signed result never overflows and its sign matches the oracle's full-precision sign byte-exact.
    //   The cross product is genuinely SIGNED -> hex.scmp / hex.mul (R5). (The full bake will strength-reduce
    //   the two products with mul_const on |dx|,|dy| + an emit-time add/sub by sign; this reusable macro uses
    //   runtime hex.mul so one macro serves every node.) Mirrors mapcompiler._point_side EXACTLY. @requires hex.init
    def point_on_side back, vx, vy, px, py, dx, dy \
            @ cpx, cpy, cdx, cdy, dxv, dyv, p1, p2, czero, setback, front, end {
        hex.set 10, cpx, px
        hex.mov 10, dxv, vx
        hex.sub 10, dxv, cpx              // dxv = vx - px   (signed)
        hex.set 10, cpy, py
        hex.mov 10, dyv, vy
        hex.sub 10, dyv, cpy              // dyv = vy - py
        hex.set 10, cdx, dx
        hex.mul_lo 10, p1, cdx, dyv          // p1 = dx*(vy-py)   (signed 2's-comp, low 10 nibbles)
        hex.set 10, cdy, dy
        hex.mul_lo 10, p2, cdy, dxv          // p2 = dy*(vx-px)
        hex.sub 10, p1, p2                // side = dx*(vy-py) - dy*(vx-px)
        hex.set 10, czero, 0
        hex.scmp 10, p1, czero, front, front, setback   // <0 & ==0 -> front(0); >0 -> back(1)
      setback:
        hex.set 2, back, 1
        ;end
      front:
        hex.set 2, back, 0
        ;end

      cpx: hex.vec 10
      cpy: hex.vec 10
      cdx: hex.vec 10
      cdy: hex.vec 10
      dxv: hex.vec 10
      dyv: hex.vec 10
      p1: hex.vec 10
      p2: hex.vec 10
      czero: hex.vec 10
      end:
    }

    // proj.point_on_side_leaf back, vx, vy, cpx, cpy, cdx_mag, cdy_mag, sign_dx, sign_dy, pos_ret —
    //   the REGISTER form of point_on_side for the BSP-as-code shared fcall leaf (mantra #9): the heavy
    //   side math is emitted ONCE at a global label and fcall'd per node, NOT unrolled per node
    //   (unrolling 681x blew up the E1M1 assemble). The node's near point (cpx,cpy) is still a 10-nibble
    //   two's-complement REGISTER (it feeds a further signed subtract against the viewer), but the
    //   partition DIRECTION (dx,dy) never re-enters a subtract — only a product — so M13-possignmag
    //   bakes it as an 8-nibble zero-extended MAGNITUDE (cdx_mag/cdy_mag) + a 1-nibble sign flag
    //   (sign_dx/sign_dy, 1 iff the original dx/dy was negative). side = dx*(vy-py) - dy*(vx-px) > 0 ->
    //   back; writing it as signA*|dx|*|dyv| - signB*|dy|*|dxv| (signA = sign(dx)^sign(dyv), signB =
    //   sign(dy)^sign(dxv), both XORs of a baked bit with a runtime hex.sign test) turns the two
    //   hex.mul_lo 10 signed cross-products into two hex.mul_lo 8 UNSIGNED magnitude products (int16 map
    //   coords -> every difference/delta magnitude fits 5 nibbles, product fits 8 -- no overflow) plus a
    //   4-way sign-pair dispatch that replaces the final signed subtract+compare with a single unsigned
    //   hex.cmp 8 (or no compare at all in the two single-sign cases). Exact: same true integer sign,
    //   no mod-16^n wraparound anywhere. cdx_mag/cdy_mag as the mul_lo 'b' operand additionally gets
    //   fixed_mul_lo.row's built-in zero-digit skip on their always-zero high nibbles for free.
    //   Writes back(0/1) to `back` and returns via stl.fret pos_ret. @requires hex.init.
    def point_on_side_leaf back, vx, vy, cpx, cpy, cdx_mag, cdy_mag, sign_dx, sign_dy, pos_ret \
            @ dyv_neg, dyv_pos, dyv_done, dxv_neg, dxv_pos, dxv_done, \
              signA_pos, signA_neg, both_pos, pos_neg, check_p2, both_neg, setback, front, end, \
              dxv, dyv, dxv_mag, dyv_mag, sign_dxv, sign_dyv, signA, signB, p1, p2 {
        hex.mov 10, dxv, vx
        hex.sub 10, dxv, cpx              // dxv = vx - px   (signed, 10-nib -- unchanged width)
        hex.mov 10, dyv, vy
        hex.sub 10, dyv, cpy              // dyv = vy - py

        hex.sign 10, dyv, dyv_neg, dyv_pos
      dyv_neg:
        hex.set 1, sign_dyv, 1
        hex.neg 5, dyv                     // magnitude fits 5 nibbles (int16 coords => diff <= 65535);
        ;dyv_done                          // negating only the low 5 nibbles == the true magnitude
      dyv_pos:                             // (two's-complement truncation identity)
        hex.set 1, sign_dyv, 0
      dyv_done:
        hex.zero 8, dyv_mag
        hex.mov 5, dyv_mag, dyv

        hex.sign 10, dxv, dxv_neg, dxv_pos
      dxv_neg:
        hex.set 1, sign_dxv, 1
        hex.neg 5, dxv
        ;dxv_done
      dxv_pos:
        hex.set 1, sign_dxv, 0
      dxv_done:
        hex.zero 8, dxv_mag
        hex.mov 5, dxv_mag, dxv

        hex.mul_lo 8, p1, dyv_mag, cdx_mag   // p1 = |dx|*|dyv|
        hex.mul_lo 8, p2, dxv_mag, cdy_mag   // p2 = |dy|*|dxv|

        hex.mov 1, signA, sign_dx
        hex.xor 1, signA, sign_dyv          // signA = sign(dx*dyv)
        hex.mov 1, signB, sign_dy
        hex.xor 1, signB, sign_dxv          // signB = sign(dy*dxv)

        hex.if 1, signA, signA_pos, signA_neg
      signA_pos:                            // signA==0 (p1 contributes +|p1|)
        hex.if 1, signB, both_pos, pos_neg
      both_pos:                             // (+,+): side = |p1|-|p2| -> back = p1>p2
        hex.cmp 8, p1, p2, front, front, setback
      pos_neg:                              // (+,-): side = |p1|+|p2| -> back unless both zero
        hex.if 8, p1, check_p2, setback
      check_p2:
        hex.if 8, p2, front, setback
      signA_neg:                            // signA==1 (p1 contributes -|p1|)
        hex.if 1, signB, front, both_neg     // (-,+): side = -|p1|-|p2| <= 0 -> always front
      both_neg:                             // (-,-): side = |p2|-|p1| -> back = p2>p1 (p1<p2)
        hex.cmp 8, p1, p2, setback, front, front

      setback:
        hex.set 2, back, 1
        ;end
      front:
        hex.set 2, back, 0
      end:
        stl.fret pos_ret                  // return (the data below is never fallen into — fret exits first)

      dxv: hex.vec 10
      dyv: hex.vec 10
      dxv_mag: hex.vec 8
      dyv_mag: hex.vec 8
      sign_dxv: hex.vec 1
      sign_dyv: hex.vec 1
      signA: hex.vec 1
      signB: hex.vec 1
      p1: hex.vec 8
      p2: hex.vec 8
    }

    // ── M13-mapunits (lines mode): the map-unit twins of slope_div / point_to_angle /
    // wall_x_range. Every runtime coordinate in this program is a 16.16 value whose low 16 bits
    // are ZERO (vertices are baked map<<16, the eye is parsed map<<16), so the angle pipeline can
    // run on the HIGH 4-NIBBLE slices -- 4-nibble subs/compares and a 9-nibble product instead of
    // 8- and 13-nibble ones -- and stay BIT-IDENTICAL: slope_div's mantissa normalization finds
    // the same top-3-nibble mantissa either way (m and m<<16 share significant nibbles), the
    // reciprocal is the same table entry, and the product differs by an exact <<16 that the final
    // shift absorbs (prod' = prod >> 16 exactly, no truncation difference). Verified equal by the
    // byte-exact frame gates; the fb/raster/stream modes keep the original macros untouched.

    // proj.slope_div_m dst, num, den — num/den are NON-NEGATIVE MAP-UNIT magnitudes (4 nibbles,
    //   the 16.16 values >> 16). Bit-identical to slope_div(num<<16, den<<16): den<<16 < 0x200
    //   <=> den == 0, and den_norm/num_norm are built as den<<8 / num<<8 (= the original's
    //   (v<<16)>>8) -- from there the body is the coarseslope slope_div verbatim.
    def slope_div_m dst, num, den @ den_zero, den_ok, prod_small, shift1, shift2, shift3, norm_done, num_in_range, keep, clamp, done, den_norm, num_norm, recip_wide, recip, prod, c_sloperange {
        hex.if0 4, den, den_zero                 // den<<16 < 512 <=> den == 0
        ;den_ok
      den_zero:
        hex.set 3, dst, 0x800
        ;done
      den_ok:
        hex.zero 6, den_norm
        hex.mov 4, den_norm + 2*dw, den          // den_norm = den << 8  (== (den<<16) >> 8)
        hex.zero 6, num_norm
        hex.mov 4, num_norm + 2*dw, num          // num_norm = num << 8
        // M13-slopetree: den is a 4-nibble map-unit magnitude >= 1, so den_norm's leading nibble
        // sits at position 2+k where k = den's leading-nibble index -- FOUR cases, decided by
        // three if0 slice tests; the left-normalize can never trigger (den_norm >= 0x100 always).
        // Replaces the shift LOOP with at most one fixed-amount shift pair. Bit-identical.
        hex.if0 3, den + 1*dw, norm_done         // k=0: den <= 0xF -> already normalized
        hex.if0 2, den + 2*dw, shift1            // k=1: one shift
        hex.if0 1, den + 3*dw, shift2            // k=2: two shifts
      shift3:
        hex.shr_hex 6, 3, den_norm
        hex.shr_hex 6, 3, num_norm
        ;norm_done
      shift2:
        hex.shr_hex 6, 2, den_norm
        hex.shr_hex 6, 2, num_norm
        ;norm_done
      shift1:
        hex.shr_hex 6, 1, den_norm
        hex.shr_hex 6, 1, num_norm
        ;norm_done
      norm_done:
        hex.if0 3, num_norm + 3*dw, num_in_range // slope>=1 guard: oracle-equivalent clamp
        ;clamp
      num_in_range:
        // M13-ATANDISP: the reciprocal through the D4 dispatch table too -- 3 x
        // read_byte_and_inc (42@ each) + a mul_const ~ 247@ becomes a ~20@ lookup.
        sdrecip.lookup recip, den_norm
        hex.zero 8, recip_wide
        hex.mov 6, recip_wide, recip
        hex.zero 8, prod
        rep(3, j) hex.fixed_mul_lo.row 8, j, prod, recip_wide, num_norm
        hex.shr_hex 8, 4, prod                   // >> 16: the FIXED final shift
        hex.if0 1, prod + 3*dw, prod_small
        ;clamp
      prod_small:
        hex.cmp 3, prod, c_sloperange, keep, keep, clamp
      keep:
        hex.mov 3, dst, prod
        ;done
      clamp:
        hex.set 3, dst, 0x800
        ;done

      den_norm: hex.vec 6
      num_norm: hex.vec 6
      recip_wide: hex.vec 8
      recip: hex.vec 6
      prod: hex.vec 8
      c_sloperange: hex.vec 3, 0x800
      done:
    }

    // proj.point_to_angle_m dst, x1, y1, x2, y2 — the map-unit twin: x1/y1/x2/y2 are addresses of
    //   the 16.16 registers' HIGH 4-NIBBLE slices (pass reg + 4*dw). Bit-identical output.
    def point_to_angle_m dsl, dtb, dst, x1, y1, x2, y2 \
            @ dx, dy, num, den, oct_idx, slope_idx, tan_base, c1, c2, c4, c6, \
              dx_neg, dx_pos, dx_done, dy_neg, dy_pos, dy_done, dx_zero, both_zero, nonzero, \
              dx_major, dy_major, numden_set, \
              oct_lo4, oct_lo2, oct_hi4, oct0, oct1, oct2, oct3, oct4, oct5, oct6, oct7, done \
            {
        hex.mov 4, dx, x2
        hex.sub 4, dx, x1                        // dx = x2 - x1   (signed map units)
        hex.mov 4, dy, y2
        hex.sub 4, dy, y1
        hex.set 1, oct_idx, 0

        hex.sign 4, dx, dx_neg, dx_pos
      dx_neg:
        hex.add 1, oct_idx, c4
        hex.neg 4, dx
        ;dx_done
      dx_pos:
      dx_done:
        hex.sign 4, dy, dy_neg, dy_pos
      dy_neg:
        hex.add 1, oct_idx, c2
        hex.neg 4, dy
        ;dy_done
      dy_pos:
      dy_done:
        hex.if0 4, dx, dx_zero
        ;nonzero
      dx_zero:
        hex.if0 4, dy, both_zero
        ;nonzero
      both_zero:
        hex.zero 8, dst
        ;done
      nonzero:
        hex.cmp 4, dx, dy, dy_major, dy_major, dx_major
      dx_major:
        hex.add 1, oct_idx, c1
        hex.mov 4, num, dy
        hex.mov 4, den, dx
        ;numden_set
      dy_major:
        hex.mov 4, num, dx
        hex.mov 4, den, dy
        ;numden_set
      numden_set:
        .slope_div_m slope_idx, num, den
        rep(dsl, q) .slope_div_m slope_idx, num, den   // ablate: price the divide
        // M13-ATANDISP: tan_base = tantoangle[slope_idx] through the D4 per-entry DISPATCH table
        // instead of `hex.read_table_packed 4` -- the stl's own complexities say that read is
        // 4 x read_byte_and_inc (42@ each) + a mul_const = ~289@, the single most expensive
        // item in the atan; a dispatch lookup is ~3 hex.xor + zero + xor_zero. Same values,
        // so the frames stay byte-exact.
        ttang.lookup tan_base, slope_idx
        rep(dtb, q) ttang.lookup tan_base, slope_idx         // ablate: price the LUT lookup
        hex.cmp 1, oct_idx, c4, oct_lo4, oct4, oct_hi4
      oct_lo4:
        hex.cmp 1, oct_idx, c2, oct_lo2, oct2, oct3
      oct_lo2:
        hex.cmp 1, oct_idx, c1, oct0, oct1, oct1
      oct_hi4:
        hex.cmp 1, oct_idx, c6, oct5, oct6, oct7
      oct0:
        hex.set 8, dst, 0x3FFFFFFF
        hex.sub 8, dst, tan_base
        ;done
      oct1:
        hex.mov 8, dst, tan_base
        ;done
      oct2:
        hex.set 8, dst, 0xC0000000
        hex.add 8, dst, tan_base
        ;done
      oct3:
        hex.zero 8, dst
        hex.sub 8, dst, tan_base
        ;done
      oct4:
        hex.set 8, dst, 0x40000000
        hex.add 8, dst, tan_base
        ;done
      oct5:
        hex.set 8, dst, 0x7FFFFFFF
        hex.sub 8, dst, tan_base
        ;done
      oct6:
        hex.set 8, dst, 0xBFFFFFFF
        hex.sub 8, dst, tan_base
        ;done
      oct7:
        hex.set 8, dst, 0x80000000
        hex.add 8, dst, tan_base
        ;done

      dx: hex.vec 4
      dy: hex.vec 4
      num: hex.vec 4
      den: hex.vec 4
      oct_idx: hex.vec 1
      slope_idx: hex.vec 3
      tan_base: hex.vec 8
      c1: hex.vec 1, 1
      c2: hex.vec 1, 2
      c4: hex.vec 1, 4
      c6: hex.vec 1, 6
      done:
    }

    // proj.wall_x_range_m — the lines-mode variant: map-unit atans (point_to_angle_m on the
    //   4-nibble slices), NO rw_angle1 output (dead in lines mode), no cull-path output zeroing
    //   (the leaf frets on !visible without reading x1/x2), and the final column compare at
    //   2 nibbles (post-clip columns are in [0, VIEW_W+1]). Everything else mirrors wall_x_range.
    // M13-EMIT rung 3 (ablate "atantwice", measurement only): run the seg's TWO vertex atans a
    // second time into a dead register. Measuring by ADDING keeps everything downstream --
    // culls, columns, emission -- bit-identical, so the delta is the frame's atan cost and
    // nothing else (the gate frames must stay byte-exact, which is the check).
    def atan_dup dst, viewx, viewy, v1x, v1y, v2x, v2y {
        .point_to_angle_m 0, 0, dst, viewx + 4*dw, viewy + 4*dw, v1x + 4*dw, v1y + 4*dw
        .point_to_angle_m 0, 0, dst, viewx + 4*dw, viewy + 4*dw, v2x + 4*dw, v2y + 4*dw
    }

    def wall_x_range_m dbl, dsl, dtb, visible, x1, x2, sgn, viewx, viewy, viewangle, v1x, v1y, v2x, v2y, a, b, c \
            @ adup, ang1, ang2, span, tspan, diff, tx1, tx2, sgn_b, frontok, \
              cclip, c2clip, cnegclip, \
              notback, leftclip, setleft, leftok, rightclip, setright, rightok, visok, end {
        hex.set 1, visible, 0

        // M13-mapmul WAS: viewxa = |viewx| = m<<16, so fixed_mul(a, m<<16) = (a*m<<16)>>16 = a*m
        // EXACTLY -- the mul ran on the 4-NIBBLE map slice (viewxa+4*dw), and the two atans on the
        // map slice too. Bit-identical, AND ONLY BIT-IDENTICAL WHILE THE PREMISE HOLDS.
        //
        // ⚠ M14-c KILLED THE PREMISE. The player sim moves in 16.16, so `viewx = m<<16` stops being
        // true from the player's second step: the low nibbles carry a real fraction and the map
        // slice silently FLOORS the view position. The renderer then draws the frame for the
        // integer position -- byte-exact at whole map units (which is every gate, test and golden
        // this repo has ever had) and wrong everywhere between them. Measured before the fix:
        // 10/10 random walkable viewpoints byte-exact on integers, 2/10 at +1/2 unit; at
        // (-416, 256, 0) seg 424's x1 stayed 133 where the oracle said 134, and column 133 kept a
        // riser piece the oracle had already given up. See docs/handoff-m14.md section 4b.
        //
        // So both halves go back to full 16.16 width -- the same arithmetic `wall_x_range` (the
        // non-`_m` twin, which the projection-kernel tests cover) has always used. At an integer
        // position this is bit-identical to what it replaces, so nothing that was certified moves;
        // it costs the map-slice's narrower multiplier rows and narrower atan.
        // ⚠ CR-2026-08 (PJ-2) -- MULTIPLY THE SIGNED VALUE. The old form multiplied |viewx| and
        //   negated the product, which is -floor(P/2^16) where the oracle's fixed_mul(a, viewx)
        //   gives -ceil(P/2^16). Equal iff P mod 2^16 == 0 -- true for every whole map unit, false
        //   from the player's second step once M14 made the position fractional. The in-file comment
        //   asserted the identity as PROVEN ("verified over 401 viewpoints x 575 segs"), and it was
        //   -- on integers. MEASURED with two-sided controls: scratchpad/_pj2_probe.py (abs/negate
        //   5 agree / 5 DIFFER, every divergence +1 ULP; this form 10 / 0). Note the R17 trap the
        //   probe pins down: at a HALF unit only an ODD `a` diverges, so a half-unit-only fixture
        //   set is half-vacuous.
        //   OPERAND ORDER: the sparse baked constant goes SECOND (the ROW RULE -- one schoolbook row
        //   per nonzero nibble of the second operand). That swap is bit-identical, and it is
        //   MEASURED not assumed (probe control 6), because "obviously equivalent" has been wrong
        //   here before. The old form's speed argument is dead anyway: post-M14 viewxa is a dense
        //   8-nibble value, so it no longer has the 2-3 nonzero nibbles the comment claimed.
        //   ⚠ viewxa/viewxs/viewya/viewys are GONE from the signature, and that is forced, not
        //   chosen: flipjump emits a Syntax Warning for an unused macro parameter and the build
        //   runs --werror (R8), so a dead parameter cannot simply be left in place. Safe here
        //   because these two macros are called only from hand-written fj (frame_render.fj, 9
        //   sites) -- NO Python f-string emits them -- so rule 4's frozen-ABI concern, which is
        //   about emitter-generated calls, does not apply. Checked by grep over src/doomfj/.
        hex.fixed_mul_lo 8, 4, sgn, viewx, a
        hex.fixed_mul_lo 8, 4, sgn_b, viewy, b
        hex.add 8, sgn, sgn_b
        hex.add 8, sgn, c
        hex.sign 8, sgn, end, frontok
      frontok:
        hex.if0 8, sgn, end
        .point_to_angle ang1, viewx, viewy, v1x, v1y, 1
        .point_to_angle ang2, viewx, viewy, v2x, v2y, 1
        // `dsl`/`dtb` (ablate "slopetwice"/"tabletwice") used to split point_to_angle_m's cost into
        // its slope-divide and table-read halves. The full-width `point_to_angle` has no such split,
        // so they now re-run the WHOLE atan into a dead register instead -- measurement-only knobs
        // (never set in a shipped or gated config), but their granularity is coarser than it was.
        rep(dsl + dtb, k) .point_to_angle adup, viewx, viewy, v1x, v1y, 1
        rep(dbl, k) .atan_dup adup, viewx, viewy, v1x, v1y, v2x, v2y
        hex.mov 8, span, ang1
        hex.sub 8, span, ang2
        hex.sign 8, span, end, notback
      notback:
        hex.sub 8, ang1, viewangle
        hex.sub 8, ang2, viewangle

        hex.mov 8, tspan, ang1
        hex.add 8, tspan, cclip
        hex.cmp 8, tspan, c2clip, leftok, leftok, leftclip
      leftclip:
        hex.mov 8, diff, tspan
        hex.sub 8, diff, c2clip
        hex.cmp 8, diff, span, setleft, end, end
      setleft:
        hex.mov 8, ang1, cclip
      leftok:
        hex.mov 8, tspan, cclip
        hex.sub 8, tspan, ang2
        hex.cmp 8, tspan, c2clip, rightok, rightok, rightclip
      rightclip:
        hex.mov 8, diff, tspan
        hex.sub 8, diff, c2clip
        hex.cmp 8, diff, span, setright, end, end
      setright:
        hex.mov 8, ang2, cnegclip
      rightok:
        .angle_to_x tx1, ang1, 1
        .angle_to_x tx2, ang2, 1
        hex.cmp 2, tx1, tx2, visok, end, end     // post-clip columns are unsigned-small
      visok:
        hex.set 1, visible, 1
        hex.mov 8, x1, tx1
        hex.mov 8, x2, tx2
        ;end

      adup: hex.vec 8
      ang1: hex.vec 8
      ang2: hex.vec 8
      span: hex.vec 8
      tspan: hex.vec 8
      diff: hex.vec 8
      tx1: hex.vec 8
      tx2: hex.vec 8
      sgn_b: hex.vec 8
      cclip: hex.vec 8, 0x20000000
      c2clip: hex.vec 8, 0x40000000
      cnegclip: hex.vec 8, 0xE0000000
      end:
    }

}
