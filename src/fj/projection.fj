// F5 (projection kernels, M12m+) — the runtime projection math the fj wall renderer needs, each a
// byte-exact mirror of the H5 oracle (src/doomfj/reference_model.py). The shared LUTs (tantoangle,
// finesine, viewangletox, xtoviewangle, finetangent) are emitted as read_table data tables (M12l).
//
// proj.slope_div (R_PointToAngle's SlopeDiv): dst[:3] = the tantoangle index for slope num/den.
//   num, den are NON-NEGATIVE hex[:8] (16.16 magnitudes; the caller has abs'd them).
//     if den < 512:           dst = SLOPERANGE (2048 = 0x800)
//     else: dst = (num<<3) / (den>>8), clamped to SLOPERANGE.
//   Mirrors reference_model.ReferenceModel._slope_div exactly (unsigned divide, truncating).
//   @requires hex.init

ns proj {
    // perf #13 [re-bless] + M13-coarseslope [re-bless, owner-approved +-1 column]: the divide is a
    //   BLOCK-FP RECIPROCAL, and the NUMERATOR is normalized ALONGSIDE the denominator: both take
    //   the same nibble shifts in the normalize loop, so wnum ends <= 3 nibbles in sden's mantissa
    //   frame and the quotient is (wnum * recip8[m]) >> (RK-8) with a FIXED 4-nibble final shift --
    //   no 13-nibble product, no fsh shift tree. recip8 = slopediv_recip8 (the <<3-DBITS-prefolded
    //   twin of slopediv_recip), so no shl_bit on wnum either; the product is 3 schoolbook rows at
    //   width 8. Mirrors reference_model._slope_div EXACTLY (same integer steps, same table values,
    //   R6): +-1 screen column vs the old exact-numerator form at worst, and every golden-gate
    //   frame is pixel-identical (scratchpad/coarse_gate_check.py). @requires hex.init & stl.ptr_init.
    def slope_div dst, num, den \
            @ lt, ge, denlo, prodlo, nrm_hi, hi_done, nrm_lo, lo_more, lo_done, wok, \
              keep, clamp, done, \
              sden, wnum, recipw, recip, prod, c512s, csr3 \
            < slopediv_recip8 {
        // den < 0x200 <=> nibbles 3..7 are all zero AND the low 3 nibbles are < 0x200
        hex.if0 5, den + 3*dw, denlo
        ;ge
      denlo:
        hex.cmp 3, den, c512s, lt, ge, ge        // den < 512 ?  lt -> small (clamp to SLOPERANGE)
      lt:
        hex.set 3, dst, 0x800
        ;done
      ge:
        hex.zero 6, sden
        hex.mov 6, sden, den + 2*dw              // sden = den >> 8   (den <= 8 nibbles -> sden <= 6)
        hex.zero 6, wnum
        hex.mov 6, wnum, num + 2*dw              // wnum = num >> 8   (num <= den, same bound)
      nrm_hi:                                    // right-normalize: while sden > 0xFFF, BOTH >>= 1 nib
        hex.if0 3, sden + 3*dw, hi_done          // sden <= 0xFFF <=> nibbles 3..5 all zero
        hex.shr_hex 6, 1, sden
        hex.shr_hex 6, 1, wnum
        ;nrm_hi
      hi_done:                                   // left-normalize: while sden < 0x100, BOTH <<= 1 nib
      nrm_lo:
        hex.if0 4, sden + 2*dw, lo_more          // sden < 0x100 <=> nibbles 2..5 all zero
        ;lo_done
      lo_more:
        hex.shl_hex 6, 1, sden
        hex.shl_hex 6, 1, wnum
        ;nrm_lo
      lo_done:
        // slope >= 1 guard: post-normalize wnum >= 0x1000 (nibbles 3..5 set) can only happen when
        // num > den (the callers' num<=den contract keeps wnum <= sden <= 0xFFF); the oracle's
        // answer is then always exactly SLOPERANGE (wnum_o >= 0x8000, R[m] >= 0x1001 => ans >= 0x800
        // => clamp), so jumping straight to the clamp is oracle-equivalent, not an approximation.
        hex.if0 3, wnum + 3*dw, wok
        ;clamp
      wok:
        hex.read_table_packed 3, recip, slopediv_recip8, 3, sden   // recip8[m] = ((1<<24)//m) << 3

        hex.zero 8, recipw
        hex.mov 6, recipw, recip
        // the mod-16^8 product needs only wnum's 3 post-normalize nibbles as multiplier rows
        hex.zero 8, prod
        rep(3, j) hex.fixed_mul_lo.row 8, j, prod, recipw, wnum
        hex.shr_hex 8, 4, prod                   // >> (RK-8 = 16 bits): the FIXED final shift

        hex.if0 1, prod + 3*dw, prodlo           // nibble 3 set => >= 0x1000 > 0x800 -> clamp
        ;clamp
      prodlo:
        hex.cmp 3, prod, csr3, keep, keep, clamp   // prod > SLOPERANGE ?  gt -> clamp
      keep:
        hex.mov 3, dst, prod
        ;done
      clamp:
        hex.set 3, dst, 0x800
        ;done

      sden: hex.vec 6
      wnum: hex.vec 6
      recipw: hex.vec 8
      recip: hex.vec 6
      prod: hex.vec 8
      c512s: hex.vec 3, 512
      csr3: hex.vec 3, 0x800
      done:
    }

    // proj.point_to_angle dst, x1, y1, x2, y2 (R_PointToAngle2): dst[:8] = the 32-bit BAM angle of the
    //   vector (x1,y1)->(x2,y2). All coords are 16.16 signed world units (the SlopeDiv tuning is
    //   scale-dependent). Octant-fold around proj.slope_div + a tantoangle lookup — no atan at runtime.
    //   Mirrors reference_model.point_to_angle EXACTLY (incl. DOOM's ±1 octant-boundary quirks, e.g.
    //   due-N = ANG90-1). Reads the shared `tantoangle` LUT (M12l, read_table data table) by that label.
    //   Algorithm: dx=x2-x1, dy=y2-y1; fold to the major octant by sign+magnitude into
    //   idx = sxneg*4 + syneg*2 + (|dx|>|dy|); base = tantoangle[slope_div(min(|dx|,|dy|), max)];
    //   result = p2a_off[idx] (+ or -, per p2a_neg[idx]) base, mod 2^32. (0,0) -> 0.
    //   @requires hex.init & stl.ptr_init   (read_table needs the pointer init)
    def point_to_angle dst, x1, y1, x2, y2 \
            @ dx, dy, num, den, idx, sidx, base, c1, c2, c4, c6, czero, \
              sxn, sxp, sxd, syn, syp, syd, dxz, bothz, nz, gt_, ndx, numden, \
              lo4, lo2, hi4, oct0, oct1, oct2, oct3, oct4, oct5, oct6, oct7, done \
            < tantoangle {
        hex.mov 8, dx, x2
        hex.sub 8, dx, x1                        // dx = x2 - x1   (signed 16.16)
        hex.mov 8, dy, y2
        hex.sub 8, dy, y1                        // dy = y2 - y1
        hex.set 1, idx, 0

        hex.sign 8, dx, sxn, sxp                 // sxneg ? fold x negative, set the idx bit
      sxn:
        hex.add 1, idx, c4                       // idx |= 4
        hex.neg 8, dx                            // dx = |dx|
        ;sxd
      sxp:
      sxd:
        hex.sign 8, dy, syn, syp
      syn:
        hex.add 1, idx, c2                       // idx |= 2
        hex.neg 8, dy                            // dy = |dy|
        ;syd
      syp:
      syd:
        // dx,dy are now non-negative magnitudes. zero check (unsigned, R5-ok): both zero -> angle 0.
        hex.if0 8, dx, dxz
        ;nz
      dxz:
        hex.if0 8, dy, bothz
        ;nz
      bothz:
        hex.zero 8, dst
        ;done
      nz:
        // gt = |dx| > |dy| (magnitudes, unsigned cmp R5-ok). num=min, den=max (slope_div needs num<=den).
        hex.cmp 8, dx, dy, ndx, ndx, gt_
      gt_:
        hex.add 1, idx, c1                       // idx |= 1
        hex.mov 8, num, dy                        // num = |dy| (smaller), den = |dx| (larger)
        hex.mov 8, den, dx
        ;numden
      ndx:                                        // |dx| <= |dy|
        hex.mov 8, num, dx
        hex.mov 8, den, dy
        ;numden
      numden:
        .slope_div sidx, num, den                 // sidx = tantoangle index for the slope
        hex.read_table_packed 4, base, tantoangle, 3, sidx   // base = tantoangle[sidx]   (shared LUT, M12l)
        // M13-p2acrush: the octant offset+sign, previously two read_tables (8-nib ~10.4k + 1-nib)
        // on idx, is now a 3-deep COMPARE TREE to 8 constant tails (same formulas, ~1k). idx =
        // sxneg*4 + syneg*2 + (|dx|>|dy|); the oracle's 8 returns (ANG90=0x40000000 etc.):
        //   0: (ANG90-1)-base   1: +base            2: ANG270+base    3: -base
        //   4: ANG90+base       5: (ANG180-1)-base  6: (ANG270-1)-base 7: ANG180+base
        hex.cmp 1, idx, c4, lo4, oct4, hi4
      lo4:
        hex.cmp 1, idx, c2, lo2, oct2, oct3
      lo2:
        hex.cmp 1, idx, c1, oct0, oct1, oct1
      hi4:
        hex.cmp 1, idx, c6, oct5, oct6, oct7
      oct0:
        hex.set 8, dst, 0x3FFFFFFF
        hex.sub 8, dst, base
        ;done
      oct1:
        hex.mov 8, dst, base
        ;done
      oct2:
        hex.set 8, dst, 0xC0000000
        hex.add 8, dst, base
        ;done
      oct3:
        hex.zero 8, dst
        hex.sub 8, dst, base
        ;done
      oct4:
        hex.set 8, dst, 0x40000000
        hex.add 8, dst, base
        ;done
      oct5:
        hex.set 8, dst, 0x7FFFFFFF
        hex.sub 8, dst, base
        ;done
      oct6:
        hex.set 8, dst, 0xBFFFFFFF
        hex.sub 8, dst, base
        ;done
      oct7:
        hex.set 8, dst, 0x80000000
        hex.add 8, dst, base
        ;done

      dx: hex.vec 8
      dy: hex.vec 8
      num: hex.vec 8
      den: hex.vec 8
      idx: hex.vec 1
      sidx: hex.vec 3
      base: hex.vec 8
      c1: hex.vec 1, 1
      c2: hex.vec 1, 2
      c4: hex.vec 1, 4
      c6: hex.vec 1, 6
      czero: hex.vec 8, 0
      done:
    }

    // proj.coarse_bracket lo, hi, vx, vy, viewx, viewy (M13-raster coarse cull): a DIVISION-FREE
    //   conservative [lo,hi] BAM interval bracketing atan2(vy-viewy, vx-viewx). Uses ONLY sign-folds +
    //   integer magnitude compares (NO slope_div): octant idx (sign(dx)*4+sign(dy)*2+(|dx|>|dy|),
    //   matching point_to_angle) + a wedge idx (0..7) from a 3-deep compare tree on the ratio
    //   min/max (smaller*8 vs larger*{1..7}, exact integer, no divide). combined=idx*8+wedge indexes
    //   the BAKED `coarse_bounds` table (doomfj.coarse_cull, interleaved 8-nibble lo,hi pairs -> entry
    //   2*combined = lo, 2*combined+1 = hi). The interval is a guaranteed SUPERSET of the true angle
    //   (baked guard covers tantoangle quantization), so a seg both of whose vertices' intervals miss
    //   the frustum is provably invisible -> cullable without the division. @requires hex.init & stl.ptr_init
    def coarse_bracket lo, hi, vx, vy, viewx, viewy \
            @ dx, dy, idx, smaller, larger, s8, lk, comb, cidx, \
              dxneg, dxpos, dyneg, dypos, dxgt, dxle, havesl, \
              whi, w67, w7yes, w45, w5yes, wlo, w23, w3yes, w01, w1yes, wdone, \
              b1, b2, b4, kone, ktwo, end \
            < coarse_bounds {
        hex.mov 8, dx, vx
        hex.sub 8, dx, viewx                     // dx = vx - viewx  (signed)
        hex.mov 8, dy, vy
        hex.sub 8, dy, viewy                     // dy = vy - viewy
        hex.set 2, idx, 0
        hex.sign 8, dx, dxneg, dxpos
      dxneg:
        hex.add 2, idx, b4                       // idx |= 4
        hex.neg 8, dx
        ;dxpos
      dxpos:
        hex.sign 8, dy, dyneg, dypos
      dyneg:
        hex.add 2, idx, b2                       // idx |= 2
        hex.neg 8, dy
        ;dypos
      dypos:
        hex.cmp 8, dx, dy, dxle, dxle, dxgt      // |dx| > |dy| ? (unsigned magnitudes)
      dxgt:
        hex.add 2, idx, b1                       // idx |= 1
        hex.zero 9, smaller
        hex.mov 8, smaller, dy                   // smaller = |dy| (min)
        hex.zero 9, larger
        hex.mov 8, larger, dx                    // larger  = |dx| (max)
        ;havesl
      dxle:
        hex.zero 9, smaller
        hex.mov 8, smaller, dx
        hex.zero 9, larger
        hex.mov 8, larger, dy
        ;havesl
      havesl:
        hex.mul_const 9, s8, smaller, 8          // s8 = smaller*8  (no overflow: 9 nibbles)
        hex.mul_const 2, comb, idx, 8            // comb = idx*8  (wedge added below)
        // wedge (0..7): comb += largest k in {0..7} with s8 >= larger*k
        hex.mul_const 9, lk, larger, 4
        hex.cmp 9, s8, lk, wlo, whi, whi         // s8 >= larger*4 ?
      whi:
        hex.add 2, comb, b4
        hex.mul_const 9, lk, larger, 6
        hex.cmp 9, s8, lk, w45, w67, w67         // s8 >= larger*6 ?
      w67:
        hex.add 2, comb, ktwo
        hex.mul_const 9, lk, larger, 7
        hex.cmp 9, s8, lk, wdone, w7yes, w7yes   // s8 >= larger*7 ?
      w7yes:
        hex.add 2, comb, kone
        ;wdone
      w45:
        hex.mul_const 9, lk, larger, 5
        hex.cmp 9, s8, lk, wdone, w5yes, w5yes   // s8 >= larger*5 ?
      w5yes:
        hex.add 2, comb, kone
        ;wdone
      wlo:
        hex.mul_const 9, lk, larger, 2
        hex.cmp 9, s8, lk, w01, w23, w23         // s8 >= larger*2 ?
      w23:
        hex.add 2, comb, ktwo
        hex.mul_const 9, lk, larger, 3
        hex.cmp 9, s8, lk, wdone, w3yes, w3yes   // s8 >= larger*3 ?
      w3yes:
        hex.add 2, comb, kone
        ;wdone
      w01:
        hex.mov 9, lk, larger                    // larger*1
        hex.cmp 9, s8, lk, wdone, w1yes, w1yes   // s8 >= larger*1 ?
      w1yes:
        hex.add 2, comb, kone
        ;wdone
      wdone:
        hex.mul_const 2, cidx, comb, 2           // interleaved: lo @ 2*comb, hi @ 2*comb+1
        hex.read_table 8, lo, coarse_bounds, 2, cidx
        hex.add 2, cidx, kone
        hex.read_table 8, hi, coarse_bounds, 2, cidx
        ;end

      dx: hex.vec 8
      dy: hex.vec 8
      idx: hex.vec 2
      smaller: hex.vec 9
      larger: hex.vec 9
      s8: hex.vec 9
      lk: hex.vec 9
      comb: hex.vec 2
      cidx: hex.vec 2
      b1: hex.vec 2, 1
      b2: hex.vec 2, 2
      b4: hex.vec 2, 4
      kone: hex.vec 2, 1
      ktwo: hex.vec 2, 2
      end:
    }

    // proj.frustum_sector sect, lo, hi, viewangle (M13-raster coarse cull): classify the coarse
    //   angle interval [lo,hi] relative to the view frustum. sect = 1 (LEFT) if the whole bracket is
    //   view-relative-angle > +ANG45, 2 (RIGHT) if < -ANG45, else 0 (touches/near the frustum, or
    //   ambiguous). A seg is cullable ONLY if BOTH vertices are in the SAME non-zero sector — a wall
    //   whose vertices straddle the frustum (opposite sectors) SPANS the view and is visible, so
    //   "both vertices outside" alone is NOT sufficient to cull (that wrongly blanks close spanning
    //   walls). Signed view-relative compares (rl,rh = lo-va, hi-va as 2's-complement); because the
    //   bracket is a narrow CCW arc, requiring BOTH ends past the same ±ANG45 edge keeps it exact.
    def frustum_sector sect, lo, hi, viewangle \
            @ rl, rh, leftrh, chkright, rightrh, setL, setR, setnone, cang45, cnang45, end {
        hex.mov 8, rl, lo
        hex.sub 8, rl, viewangle                 // rl = lo - va  (signed view-relative)
        hex.mov 8, rh, hi
        hex.sub 8, rh, viewangle                 // rh = hi - va
        hex.scmp 8, rl, cang45, chkright, chkright, leftrh    // rl > +ANG45 ? (signed)
      leftrh:
        hex.scmp 8, rh, cang45, chkright, chkright, setL      // rh > +ANG45 ? -> LEFT
      chkright:
        hex.scmp 8, rl, cnang45, rightrh, setnone, setnone    // rl < -ANG45 ? (signed)
      rightrh:
        hex.scmp 8, rh, cnang45, setR, setnone, setnone       // rh < -ANG45 ? -> RIGHT
      setL:
        hex.set 1, sect, 1
        ;end
      setR:
        hex.set 1, sect, 2
        ;end
      setnone:
        hex.set 1, sect, 0
        ;end

      rl: hex.vec 8
      rh: hex.vec 8
      cang45: hex.vec 8, 0x20000000
      cnang45: hex.vec 8, 0xE0000000
      end:
    }

    // ── M13-wedge: the MULTIPLY-FREE conservative FOV pre-cull (proj.wedge_setup + proj.wedge_reject)
    //
    // The true FOV is the wedge [viewangle-ANG45, viewangle+ANG45]. Round it OUTWARD to multiples of
    // 45° and you get a wedge of width 90°..135° that strictly CONTAINS the FOV — so a seg lying
    // entirely outside it is provably invisible and skipping it is BYTE-EXACT (no re-bless): the
    // frame is identical, we just stop paying for it. The payoff is that a 45°-multiple wedge is the
    // intersection of two half-planes whose interior tests are pure integer compares — NO multiply,
    // no table, no divide:
    //
    //   plane m (boundary direction m*45°, interior = the CCW side): cross(dir_m, v - eye) >= 0
    //     m=0: dy>=0   m=1: dy-dx>=0   m=2: -dx>=0   m=3: -(dx+dy)>=0
    //     m=4: -dy>=0  m=5: dx-dy>=0   m=6: dx>=0    m=7: dx+dy>=0
    //   so with Q0=dy, Q1=dy-dx, Q2=dx, Q3=dx+dy the test is ±Q[m&3] >= 0, negated for 2<=m<=5.
    //
    // Measured on the E1M1 spawn frame (scratchpad/wedge_dirs.py, host): 173 of 432 segs and 198 of
    // 488 point_to_angle calls rejected, with the visible-seg and emitted-seg sets IDENTICAL.
    // Finer boundary sets (16/24 directions) cull no better at the spawn angle, so 8 it is.

    // proj.wedge_setup qa, na, qb, nb, wex, wey, weyx, wexy, viewangle, viewx, viewy — ONCE PER
    //   FRAME. Writes the two half-plane descriptors (q = the base quantity 0..3, n = 1 iff the test
    //   is negated) bounding the outward-rounded FOV wedge, plus the four EYE terms the per-seg test
    //   subtracts (wex=viewx, wey=viewy, weyx=viewy-viewx, wexy=viewx+viewy) so that each Q is one
    //   subtraction off the raw vertex — no per-seg dx/dy staging.
    //   lo = floor((va-ANG45)/ANG45), hi = ceil((va+ANG45)/ANG45) via the integer identity
    //   ceil(a/b) = floor((a+b-1)/b); plane B is (hi+4) mod 8 (the far edge's half-plane points
    //   inward), and since +4 leaves m&3 alone, qb = wsel(hi).q while nb is wsel(hi).n INVERTED.
    //   All arithmetic is mod 2^32, which is exactly the BAM circle. wexy/weyx cannot overflow: the
    //   map's max |x|+|y| is 5440 units = 3.6e8 in 16.16, well inside the signed 32-bit range.
    //   @requires hex.init
    def wedge_setup qa, na, qb, nb, wex, wey, weyx, wexy, viewangle, viewx, viewy \
            @ m, t, wsel, qout, nout, wret, \
              slo4, shi4, slo2, m0, m1, m2, m3, m4, m5, m6, m7, sdone, \
              nb0, nbdone, c1, c2, c4, c6, cang45, cang90m1, end {
        hex.mov 8, wex, viewx
        hex.mov 8, wey, viewy
        hex.mov 8, weyx, viewy
        hex.sub 8, weyx, viewx              // weyx = viewy - viewx
        hex.mov 8, wexy, viewx
        hex.add 8, wexy, viewy              // wexy = viewx + viewy

        hex.mov 8, t, viewangle
        hex.sub 8, t, cang45                // (va - ANG45) mod 2^32
        hex.shr_hex 8, 7, t                 // >> 28 bits ...
        hex.shr_bit 8, t                    //   ... then >> 1 = floor(./ANG45), in [0,7]
        hex.mov 1, m, t
        stl.fcall wsel, wret
        hex.mov 1, qa, qout
        hex.mov 1, na, nout

        hex.mov 8, t, viewangle
        hex.add 8, t, cang90m1              // va + ANG45 + (ANG45-1)  =>  ceil((va+ANG45)/ANG45)
        hex.shr_hex 8, 7, t
        hex.shr_bit 8, t
        hex.mov 1, m, t
        stl.fcall wsel, wret
        hex.mov 1, qb, qout
        hex.if0 1, nout, nb0                // nb = 1 - wsel(hi).n  (the +4 half-plane flip)
        hex.set 1, nb, 0
        ;nbdone
      nb0:
        hex.set 1, nb, 1
      nbdone:
        ;end

      wsel:                                 // m (0..7) -> qout = m&3, nout = (2 <= m <= 5)
        hex.cmp 1, m, c4, slo4, m4, shi4
      slo4:
        hex.cmp 1, m, c2, slo2, m2, m3
      slo2:
        hex.cmp 1, m, c1, m0, m1, m1
      shi4:
        hex.cmp 1, m, c6, m5, m6, m7
      m0:
        hex.set 1, qout, 0
        hex.set 1, nout, 0
        ;sdone
      m1:
        hex.set 1, qout, 1
        hex.set 1, nout, 0
        ;sdone
      m2:
        hex.set 1, qout, 2
        hex.set 1, nout, 1
        ;sdone
      m3:
        hex.set 1, qout, 3
        hex.set 1, nout, 1
        ;sdone
      m4:
        hex.set 1, qout, 0
        hex.set 1, nout, 1
        ;sdone
      m5:
        hex.set 1, qout, 1
        hex.set 1, nout, 1
        ;sdone
      m6:
        hex.set 1, qout, 2
        hex.set 1, nout, 0
        ;sdone
      m7:
        hex.set 1, qout, 3
        hex.set 1, nout, 0
        ;sdone
      sdone:
        stl.fret wret

      m: hex.vec 1
      t: hex.vec 8
      qout: hex.vec 1
      nout: hex.vec 1
      wret: ;0
      c1: hex.vec 1, 1
      c2: hex.vec 1, 2
      c4: hex.vec 1, 4
      c6: hex.vec 1, 6
      cang45: hex.vec 8, 0x20000000
      cang90m1: hex.vec 8, 0x3FFFFFFF
      end:
    }

    // proj.wedge_reject rej, v1x, v1y, v2x, v2y, qa, na, qb, nb, wex, wey, weyx, wexy — PER SEG.
    //   rej[:1] = 1 iff BOTH seg endpoints are strictly outside the SAME bounding half-plane, i.e.
    //   the whole seg misses the conservative wedge. (Both-outside-but-different-planes does NOT
    //   cull: such a seg spans the view.) Ordered so the common cases finish in TWO tests -- reject
    //   on (A:v1, A:v2), accept on (A:v1, B:v1) -- and so vertex 2 is never touched when v1 alone
    //   decides. Each test is one mov + one or two 8-nibble adds against a per-frame eye term:
    //     Q0 = v.y - viewy   Q1 = (v.y - v.x) - weyx   Q2 = v.x - viewx   Q3 = (v.x + v.y) - wexy
    //   which is exactly cross(dir_m, v - eye) up to the sign carried by `n`. @requires hex.init
    def wedge_reject rej, v1x, v1y, v2x, v2y, qa, na, qb, nb, wex, wey, weyx, wexy \
            @ a1out, b1out, tb, rejlab, done, end {
        hex.set 1, rej, 0
        .wedge_qt v1x, v1y, qa, na, wex, wey, weyx, wexy, tb, a1out       // v1 inside A -> A can't reject
      a1out:
        .wedge_qt v2x, v2y, qa, na, wex, wey, weyx, wexy, tb, rejlab      // both outside A -> REJECT
      tb:
        .wedge_qt v1x, v1y, qb, nb, wex, wey, weyx, wexy, done, b1out
      b1out:
        .wedge_qt v2x, v2y, qb, nb, wex, wey, weyx, wexy, done, rejlab
      rejlab:
        hex.set 1, rej, 1
      done:
        ;end
      end:
    }

    // proj.wedge_qt vx, vy, q, n, wex, wey, weyx, wexy, insid, outsid — ONE half-plane test on ONE
    //   vertex, jumping straight to `insid`/`outsid`. Inlined (four copies inside wedge_reject)
    //   rather than shared: the two `hex.mov 8` needed to stage a vertex into a shared body, plus the
    //   fcall/fret pair and the outc round-trip, cost more than the body itself. Every path exits by
    //   a jump, so the trailing data block is never fallen into. @requires hex.init
    def wedge_qt vx, vy, q, n, wex, wey, weyx, wexy, insid, outsid             @ s, qlo, qhi, qq0, qq1, qq2, qq3, qdone, posform, negnz, c1, c2, c3 {
        // M13-lines3: every operand here is a 16.16 value whose LOW 16 BITS ARE ZERO (vertices are
        // baked map<<16; the eye terms are sums/differences of view coords that are themselves
        // map<<16) -- so Q's sign is fully determined by the HIGH 4-NIBBLE slices, and 4-nibble
        // mov/sub/sign replace the 8-nibble forms at roughly half the cost. No borrow-in is
        // possible from the (all-zero) low halves, so the slice arithmetic is exact.
        hex.cmp 1, q, c2, qlo, qq2, qhi
      qlo:
        hex.cmp 1, q, c1, qq0, qq1, qq1
      qhi:
        hex.cmp 1, q, c3, qq2, qq3, qq3
      qq0:
        hex.mov 4, s, vy + 4*dw             // Q0 = vy - viewy
        hex.sub 4, s, wey + 4*dw
        ;qdone
      qq1:
        hex.mov 4, s, vy + 4*dw             // Q1 = (vy - vx) - (viewy - viewx)
        hex.sub 4, s, vx + 4*dw
        hex.sub 4, s, weyx + 4*dw
        ;qdone
      qq2:
        hex.mov 4, s, vx + 4*dw             // Q2 = vx - viewx
        hex.sub 4, s, wex + 4*dw
        ;qdone
      qq3:
        hex.mov 4, s, vx + 4*dw             // Q3 = (vx + vy) - (viewx + viewy)
        hex.add 4, s, vy + 4*dw
        hex.sub 4, s, wexy + 4*dw
        ;qdone
      qdone:
        // sign/if0 rather than scmp-against-zero: hex.scmp is ~2.7x the cost (measured).
        hex.if0 1, n, posform
        hex.sign 4, s, insid, negnz            // negated test: outside iff Q > 0
      negnz:
        hex.if0 4, s, insid
        ;outsid
      posform:
        hex.sign 4, s, outsid, insid           // plain test:   outside iff Q < 0

      s: hex.vec 4
      c1: hex.vec 1, 1
      c2: hex.vec 1, 2
      c3: hex.vec 1, 3
    }

    // proj.point_to_dist dst, viewx, viewy, x, y (R_PointToDist): dst[:8] = the 16.16 distance from
    //   (viewx,viewy) to (x,y) — sqrt(dx²+dy²) computed via tantoangle + finesine + two FixedDivs (no
    //   sqrt). Fold to the major octant (dx>=dy), index tantoangle by the slope dy/dx >> DBITS, take
    //   angle+ANG90, divide dx by sin(that)=cos(atan(slope)). Mirrors reference_model.point_to_dist
    //   EXACTLY. Coords + result are 16.16. Reads the shared `tantoangle` LUT (M12l) + the `finesine`
    //   trig idiom (M6); exact for axis-aligned (dy=0 -> dist=dx), ~quantization off-axis. (0,0)->0.
    //   @requires hex.init & stl.ptr_init   (read_table + finesine.read_sin)
    def point_to_dist dst, viewx, viewy, x, y \
            @ dx, dy, tmp, slope, sidx, angle, sine, czero, csr3, cang90, \
              do_swap, no_swap, swapped, dx_zero, dx_nz, clamp_idx, keep_idx, \
              sine_zero, sine_nz, baddiv, done \
            < tantoangle {
        hex.mov 8, dx, x
        hex.sub 8, dx, viewx
        hex.abs 8, dx                            // dx = |x - viewx|
        hex.mov 8, dy, y
        hex.sub 8, dy, viewy
        hex.abs 8, dy                            // dy = |y - viewy|

        hex.cmp 8, dy, dx, no_swap, no_swap, do_swap   // dy > dx ? -> fold to the major octant (dx>=dy)
      do_swap:
        hex.mov 8, tmp, dx
        hex.mov 8, dx, dy
        hex.mov 8, dy, tmp
        ;swapped
      no_swap:
      swapped:
        hex.cmp 8, dx, czero, dx_nz, dx_zero, dx_nz    // dx == 0 ? (both deltas were 0) -> degenerate
      dx_zero:
        hex.zero 8, dst
        ;done
      dx_nz:
        hex.fixed_div 8, 4, slope, dy, dx, baddiv      // slope = (dy<<16)/dx  in [0, 0x10000] (dy<=dx)
        hex.shr_hex 8, 1, slope                        // >> DBITS = >> 5 bits: one nibble (4) ...
        hex.shr_bit 8, slope                           //   ... + one bit
        hex.mov 3, sidx, slope                         // idx = slope (low 3 nibbles; value <= 0x800)
        hex.cmp 3, sidx, csr3, keep_idx, keep_idx, clamp_idx   // min(idx, SLOPERANGE) (oracle safety)
      clamp_idx:
        hex.set 3, sidx, 0x800
      keep_idx:
        hex.read_table_packed 4, angle, tantoangle, 3, sidx   // tantoangle[idx]
        hex.add 8, angle, cang90                        // angle = tantoangle[idx] + ANG90
        hex.shr_hex 8, 5, angle                         // finesine index = angle >> 20 bits (= 5 nibbles;
        hex.mov 3, sidx, angle                          //   32 - log2(TRIG_N=4096) = 20). low 3 nibbles.
        finesine.read_sin sine, sidx                    // sin(atan(slope)+90deg) = cos(atan(slope))
        hex.cmp 8, sine, czero, sine_nz, sine_zero, sine_nz   // sine==0 guard (oracle: returns 0)
      sine_zero:
        hex.zero 8, dst
        ;done
      sine_nz:
        hex.fixed_div 8, 4, dst, dx, sine, baddiv       // dist = (dx<<16)/sine
        ;done
      baddiv:                                           // unreachable (dx!=0, sine!=0); safe fallback
        hex.zero 8, dst
        ;done

      dx: hex.vec 8
      dy: hex.vec 8
      tmp: hex.vec 8
      slope: hex.vec 8
      sidx: hex.vec 3
      angle: hex.vec 8
      sine: hex.vec 8
      czero: hex.vec 8, 0
      csr3: hex.vec 3, 0x800
      cang90: hex.vec 8, 0x40000000
      done:
    }

    // proj.wall_setup rw_normalangle, rw_distance, viewx, viewy, segangle, a, b, c (R_StoreWallRange):
    //   the per-wall projection setup. Writes rw_normalangle (the wall's normal BAM = (segangle<<16)+
    //   ANG90, DOOM's native winding) and rw_distance (the perpendicular view->wall-line distance, 16.16).
    //   segangle is the 16-bit seg BAM (WAD `angle>>16`); viewx/y are 16.16; a,b,c are the seg's baked
    //   16.16 affine coeffs (mapcompiler.seg_affine_coeffs, the shared SSOT).
    //   **perf #9 [re-bless]:** rw_distance = |fixed_mul(a,viewx) + fixed_mul(b,viewy) + c| — the AFFINE
    //   cross-product perpendicular distance — instead of fixed_mul(point_to_dist(view,v1), sin(ANG90 -
    //   offsetangle)) (point_to_angle + the two-divide point_to_dist + finesine). Same geometric quantity,
    //   exact-affine with NO atan/divide; sub-bit shift vs the old quantized divide path (PNG-verified
    //   clean on E1M1; square is byte-identical — axis-aligned segs make affine == the exact divide). For
    //   front-facing segs (past wall_x_range's span<ANG180 cull) the signed value is >0, so abs is a no-op;
    //   the pre-abs SIGN is what perf #10's back-face cull tests. Mirrors reference_model.wall_setup EXACTLY.
    //   @requires hex.init
    def wall_setup rw_normalangle, rw_distance, viewx, viewy, segangle, a, b, c \
            @ t, cang90, end {
        hex.zero 8, rw_normalangle
        hex.mov 4, rw_normalangle + 4*dw, segangle      // rw_normalangle = segangle << 16 ...
        hex.add 8, rw_normalangle, cang90               //   ... + ANG90 (the wall normal)

        hex.fixed_mul_lo 8, 4, rw_distance, a, viewx       // rw_distance = a*viewx ...
        hex.fixed_mul_lo 8, 4, t, b, viewy
        hex.add 8, rw_distance, t                       //   + b*viewy ...
        hex.add 8, rw_distance, c                       //   + c  (signed perpendicular distance, mod 2^32)
        hex.abs 8, rw_distance                          // front-facing => signed>0 => abs is a no-op
        ;end                                            // skip the data block (else it runs as code)

      t: hex.vec 8
      cang90: hex.vec 8, 0x40000000
      end:
    }

    // proj.wall_setup_sgn rw_normalangle, rw_distance, sgn, segangle (M13-absmul): wall_setup for a
    //   caller that ALREADY has the signed affine distance -- wall_x_range now exports it (its `sgn`
    //   output IS fixed_mul(a,viewx)+fixed_mul(b,viewy)+c, the exact quantity wall_setup recomputes
    //   with two more fixed_muls). rw_distance = abs(sgn); rw_normalangle as in wall_setup.
    //   BIT-IDENTICAL to wall_setup by construction. @requires hex.init
    def wall_setup_sgn rw_normalangle, rw_distance, sgn, segangle \
            @ cang90, end {
        hex.zero 8, rw_normalangle
        hex.mov 4, rw_normalangle + 4*dw, segangle      // rw_normalangle = segangle << 16 ...
        hex.add 8, rw_normalangle, cang90               //   ... + ANG90 (the wall normal)
        hex.mov 8, rw_distance, sgn
        hex.abs 8, rw_distance                          // front-facing => sgn>0 => abs is a no-op
        ;end

      cang90: hex.vec 8, 0x40000000
      end:
    }

    // proj.scale_recip_div q, num, den (M13-scalerecip [re-bless]): q[:8] = (num<<16)//den via the
    //   SHARED slopediv_recip block-FP table. num, den are NON-NEGATIVE magnitudes (the caller has
    //   sign-split; den > 0). Recipe (mirrors reference_model._scale_recip_div EXACTLY, R6):
    //   normalize den to a 3-nibble mantissa m in [0x100,0xFFF] with fsh counting whole nibbles
    //   (base 6 = RK/4; range [4,11] for any 32-bit den), 14-NIBBLE truncated product wnum*recip[m]
    //   (5 schoolbook rows, recip <= 5 nibbles), ONE whole-nibble shift picked by a compare tree,
    //   low 8 nibbles out. 14 nibbles is the measured-exact width (12 truncates real operands).
    //   @requires hex.init & stl.ptr_init
    def scale_recip_div q, num, den \
            @ nrm_hi, hi_done, nrm_lo, lo_more, lo_done, \
              tlo, tlo67, thi, fs4, fs5, fs6, fs7, fs8, fs9, fs10, fs11, fsh_done, done, \
              sden, wnum, recipw, recip, prod, fsh, c5t, c6t, c8t, c10t \
            < slopediv_recip {
        hex.zero 8, sden
        hex.mov 8, sden, den
        hex.set 2, fsh, 6                        // base shift = RK/4 = 6 nibbles; +- the exponent below
      nrm_hi:                                    // right-normalize: while sden > 0xFFF, >>= 1 nib, fsh++
        hex.if0 5, sden + 3*dw, hi_done          // sden <= 0xFFF <=> nibbles 3..7 all zero
        hex.shr_hex 8, 1, sden
        hex.inc 2, fsh
        ;nrm_hi
      hi_done:                                   // left-normalize: while sden < 0x100, <<= 1 nib, fsh--
      nrm_lo:
        hex.if0 6, sden + 2*dw, lo_more          // sden < 0x100 <=> nibbles 2..7 all zero
        ;lo_done
      lo_more:
        hex.shl_hex 8, 1, sden
        hex.dec 2, fsh
        ;nrm_lo
      lo_done:
        hex.read_table_packed 3, recip, slopediv_recip, 3, sden   // recip[m] = (1<<24)//m
        hex.zero 14, wnum
        hex.mov 8, wnum + 4*dw, num              // wnum = num << 16 (4 nibbles, by placement)
        hex.zero 14, recipw
        hex.mov 6, recipw, recip
        hex.zero 14, prod
        rep(5, j) hex.fixed_mul_lo.row 14, j, prod, wnum, recipw   // prod = wnum*recip mod 16^14
        // fsh in [4,11]: den has 1..8 significant nibbles -> at most 5 right- or 2 left-shifts
        hex.cmp 2, fsh, c8t, tlo, fs8, thi
      tlo:
        hex.cmp 2, fsh, c5t, fs4, fs5, tlo67
      tlo67:
        hex.cmp 2, fsh, c6t, fs6, fs6, fs7       // lt unreachable (fsh >= 6 here)
      thi:
        hex.cmp 2, fsh, c10t, fs9, fs10, fs11
      fs4:
        hex.shr_hex 14, 4, prod
        ;fsh_done
      fs5:
        hex.shr_hex 14, 5, prod
        ;fsh_done
      fs6:
        hex.shr_hex 14, 6, prod
        ;fsh_done
      fs7:
        hex.shr_hex 14, 7, prod
        ;fsh_done
      fs8:
        hex.shr_hex 14, 8, prod
        ;fsh_done
      fs9:
        hex.shr_hex 14, 9, prod
        ;fsh_done
      fs10:
        hex.shr_hex 14, 10, prod
        ;fsh_done
      fs11:
        hex.shr_hex 14, 11, prod
        ;fsh_done
      fsh_done:
        hex.mov 8, q, prod
        ;done

      sden: hex.vec 8
      wnum: hex.vec 14
      recipw: hex.vec 14
      recip: hex.vec 6
      prod: hex.vec 14
      fsh: hex.vec 2
      c5t: hex.vec 2, 5
      c6t: hex.vec 2, 6
      c8t: hex.vec 2, 8
      c10t: hex.vec 2, 10
      done:
    }

    // proj.scale_from_global_angle scale, visangle, viewangle, rw_normalangle, rw_distance, projection
    //   (R_ScaleFromGlobalAngle): scale[:8] = the wall's projected 16.16 scale (pixels per world unit)
    //   for the column whose ABSOLUTE view angle is visangle. scale = PROJECTION*sin(angleb) /
    //   (rw_distance*sin(anglea)), anglea = ANG90+(visangle-viewangle), angleb = ANG90+(visangle-
    //   rw_normalangle); clamped to [SCALE_MIN, SCALE_MAX]; den==0 -> SCALE_MAX. Mirrors
    //   reference_model.scale_from_global_angle EXACTLY. `projection` is a COMPILE-TIME arg = PROJECTION
    //   <<16 (= CENTERX<<16; resolution-dependent, so the caller supplies it from the config SSOT, R6).
    //   NOTE: the oracle's fixed_mul/fixed_div return UNSIGNED-wrapped 32-bit values (a negative result
    //   wraps to a huge positive), and its min/max clamp + den==0 test compare those as unsigned — so the
    //   compares here are hex.cmp (NOT scmp). Verified: a negative-den case (anglea past ANG180) wraps to
    //   a huge unsigned scale and clamps to SCALE_MAX, exactly as the oracle does (scmp would give
    //   SCALE_MIN and diverge). anglea/b are unsigned-modular BAM that only feed read_sin (bit extract).
    //   @requires hex.init & stl.ptr_init   (finesine.read_sin)
    def scale_from_global_angle scale, visangle, viewangle, rw_normalangle, rw_distance, projection \
            @ anglea, angleb, num, den, sidx, sinv, cproj, cang90, csmin, csmax, qneg, \
              den_zero, numn, nump, denn, denp, dodiv, chk_min, set_max, set_min, end {
        hex.mov 8, anglea, visangle
        hex.sub 8, anglea, viewangle
        hex.add 8, anglea, cang90               // anglea = ANG90 + (visangle - viewangle)
        hex.mov 8, angleb, visangle
        hex.sub 8, angleb, rw_normalangle
        hex.add 8, angleb, cang90               // angleb = ANG90 + (visangle - rw_normalangle)

        hex.shr_hex 8, 5, angleb                // num = fixed_mul(PROJECTION<<16, read_sin(angleb))
        hex.mov 3, sidx, angleb                 //   read_sin idx = angleb >> 20 (low 3 nibbles)
        finesine.read_sin sinv, sidx
        hex.set 8, cproj, projection            //   PROJECTION<<16 (compile-time, from Config)
        // M13-mulorder: operands SWAPPED vs the obvious order. fixed_mul_lo runs one schoolbook row
        // per NONZERO nibble of its SECOND operand, and a negative 16.16 sine sign-extends to a dense
        // 12-nibble pattern (~10k ops as a multiplier) while cproj = PROJECTION<<16 has ONE nonzero
        // nibble (~1.9k). Multiplication is commutative and the macro takes the same mod-16^12 low
        // product either way, so this is BIT-IDENTICAL -- purely a row-count choice.
        hex.fixed_mul_lo 8, 4, num, sinv, cproj

        hex.shr_hex 8, 5, anglea                // den = fixed_mul(rw_distance, read_sin(anglea))
        hex.mov 3, sidx, anglea
        finesine.read_sin sinv, sidx
        hex.fixed_mul_lo 8, 4, den, sinv, rw_distance   // same swap: rw_distance is the sparse operand

        hex.if0 8, den, den_zero                // den == 0 -> SCALE_MAX
        // M13-scalerecip [re-bless]: sign-split + block-FP reciprocal replaces the signed
        // fixed_div (38.5k -> ~19k ops). A sign MISMATCH (negative true quotient) goes straight
        // to SCALE_MAX -- proven identical to the old unsigned-wraparound-then-clamp (any negative
        // quotient's unsigned reading is >= 2^31 > SCALE_MAX). Mirrors the oracle exactly.
        hex.set 1, qneg, 0
        hex.sign 8, num, numn, nump
      numn:
        hex.neg 8, num
        hex.xor_by 1, qneg, 1
      nump:
        hex.sign 8, den, denn, denp
      denn:
        hex.neg 8, den
        hex.xor_by 1, qneg, 1
      denp:
        hex.if0 1, qneg, dodiv
      den_zero:
        hex.mov 8, scale, csmax
        ;end
      dodiv:
        .scale_recip_div scale, num, den
        hex.cmp 8, scale, csmax, chk_min, chk_min, set_max    // min(SCALE_MAX, scale): > -> clamp (unsigned)
      set_max:
        hex.mov 8, scale, csmax
        ;end                                    // SCALE_MAX > SCALE_MIN, so the min-clamp is satisfied
      chk_min:
        hex.cmp 8, scale, csmin, set_min, end, end            // max(SCALE_MIN, scale): < -> clamp (unsigned)
      set_min:
        hex.mov 8, scale, csmin
        ;end

      anglea: hex.vec 8
      angleb: hex.vec 8
      num: hex.vec 8
      den: hex.vec 8
      sidx: hex.vec 3
      sinv: hex.vec 8
      cproj: hex.vec 8
      cang90: hex.vec 8, 0x40000000
      qneg: hex.vec 1
      csmin: hex.vec 8, 0x100             // SCALE_MIN (16.16 engine constant)
      csmax: hex.vec 8, 0x400000          // SCALE_MAX = 64.0
      end:
    }

    // proj.angle_to_x dst, angle (the viewangletox lookup, R_RenderSegLoop's column map): dst[:8] = the
    //   screen column for a view-relative BAM `angle` (0 = straight ahead, + = left). idx = (angle +
    //   ANG90) >> angle_shift(20), clamped to [0, len(viewangletox)-1 = 0x7FF = TRIG_N/2 - 1]; the result
    //   is the SIGNED column (2's-complement; off-screen ends carry the -1 / VIEW_W+1 sentinels). idx is
    //   unsigned so the low (max-0) clamp is automatic. Mirrors reference_model.angle_to_x EXACTLY.
    //   @requires hex.init & stl.ptr_init   (read_table)
    def angle_to_x dst, angle \
            @ t, vidx, cang90, cmaxidx, clampmax, keep, end \
            < viewangletox {
        hex.mov 8, t, angle
        hex.add 8, t, cang90               // angle + ANG90 (mod 2^32)
        hex.shr_hex 8, 5, t                // >> angle_shift = 20 bits (5 nibbles)
        hex.mov 3, vidx, t                 // idx = top 12 bits of (angle+ANG90)  (low 3 nibbles)
        hex.cmp 3, vidx, cmaxidx, keep, keep, clampmax   // idx > len-1 ? -> clamp (unsigned; idx>=0)
      clampmax:
        hex.set 3, vidx, 0x7ff
      keep:
        hex.read_table_packed 4, dst, viewangletox, 3, vidx     // the signed column (2's-complement)
        ;end

      t: hex.vec 8
      vidx: hex.vec 3
      cang90: hex.vec 8, 0x40000000
      cmaxidx: hex.vec 3, 0x7ff           // len(viewangletox)-1 = TRIG_N/2 - 1
      end:
    }

    // proj.wall_x_range visible, x1, x2, rw_angle1, viewx, viewy, viewangle, v1x, v1y, v2x, v2y, a, b, c (R_AddLine):
    //   the seg's screen column range. Writes visible=1 + (x1,x2,rw_angle1) when the seg is on-screen,
    //   else visible=0 (the oracle's None) with x1/x2/rw_angle1 zeroed. v1 is the seg's LEFT screen
    //   vertex, v2 the RIGHT (DOOM-wound baked segs). Mirrors reference_model.wall_x_range EXACTLY:
    //   back-face cull (span >= ANG180), view-relative, two-edge frustum clip (CLIPANGLE=ANG45) via
    //   DOOM's unsigned tspan logic, then angle_to_x. All the angle/span/tspan compares are UNSIGNED
    //   (modular BAM) -> hex.cmp; only the final x1>=x2 column test is SIGNED (columns can be -1) ->
    //   hex.scmp. Outputs are computed into temps and committed only on the visible path.
    //   @requires hex.init & stl.ptr_init   (inlines point_to_angle x2 + angle_to_x x2)
    def wall_x_range visible, x1, x2, rw_angle1, sgn, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, v1x, v1y, v2x, v2y, a, b, c \
            @ a1, a2, span, tspan, diff, rwa, tx1, tx2, sgnt, frontok, \
              xadone, yadone, \
              cang180, cclip, c2clip, cnegclip, \
              notback, leftclip, setleft, leftok, rightclip, setright, rightok, visok, end {
        hex.set 1, visible, 0              // default: culled (None)
        hex.zero 8, x1
        hex.zero 8, x2
        hex.zero 8, rw_angle1

        // perf #10 [exact]: affine back-face PRE-cull BEFORE the two atans. sgn = a*viewx + b*viewy + c
        // (the signed perpendicular distance to the seg line, seg_affine_coeffs). >0 iff the eye is on the
        // wall's FRONT side; a one-sided wall whose front faces away (sgn<=0) is invisible -> cull without
        // paying point_to_angle x2. Byte-exact: every seg this culls that span<ANG180 would keep is
        // frustum-culled anyway (verified across viewpoints).
        // M13-absmul (the [[fj-cost-model]] ROW RULE): fixed_mul_lo runs one schoolbook row per NONZERO
        // nibble of its SECOND operand, and a negative 16.16 viewx sign-extends to a dense 12-nibble
        // pattern (4,984 ops) where |viewx| has 2-3 nonzero nibbles (2,632). So multiply by the
        // per-frame ABS registers (viewxa/viewya, computed once at frame start alongside their sign
        // flags) and negate the product when the sign flag says so. BIT-IDENTICAL: viewx/viewy are
        // always map<<16, so the product's low 4 nibbles are zero and two's-complement negation of
        // the truncated product equals truncation of the negated product (verified over 401 viewpoints
        // x 575 segs, scratchpad session 2026-07-25). sgn is an OUTPUT (pre-abs): wall_setup's
        // rw_distance is abs(sgn), so the caller can skip wall_setup's identical 2-mul recompute.
        hex.fixed_mul_lo 8, 4, sgn, a, viewxa
        hex.if0 1, viewxs, xadone
        hex.neg 8, sgn
      xadone:
        hex.fixed_mul_lo 8, 4, sgnt, b, viewya
        hex.if0 1, viewys, yadone
        hex.neg 8, sgnt
      yadone:
        hex.add 8, sgn, sgnt
        hex.add 8, sgn, c
        hex.sign 8, sgn, end, frontok      // sgn < 0 -> back-facing, cull (visible=0)
      frontok:
        hex.if0 8, sgn, end                // sgn == 0 -> on the line, cull
        .point_to_angle a1, viewx, viewy, v1x, v1y    // absolute angle to v1 (left)
        .point_to_angle a2, viewx, viewy, v2x, v2y    // absolute angle to v2 (right)
        hex.mov 8, span, a1
        hex.sub 8, span, a2                            // span = (a1 - a2) mod 2^32
        hex.sign 8, span, end, notback                 // span >= ANG180 <=> bit 31 set -> cull
      notback:
        hex.mov 8, rwa, a1                             // rw_angle1 = absolute a1 (committed on success)
        hex.sub 8, a1, viewangle                       // a1 view-relative
        hex.sub 8, a2, viewangle                       // a2 view-relative

        hex.mov 8, tspan, a1                           // LEFT edge: tspan = a1 + CLIPANGLE
        hex.add 8, tspan, cclip
        hex.cmp 8, tspan, c2clip, leftok, leftok, leftclip   // tspan > 2*CLIP ?
      leftclip:
        hex.mov 8, diff, tspan
        hex.sub 8, diff, c2clip
        hex.cmp 8, diff, span, setleft, end, end       // (tspan-2*CLIP) >= span -> off the left, cull
      setleft:
        hex.mov 8, a1, cclip                           // a1 = CLIPANGLE
      leftok:
        hex.mov 8, tspan, cclip                        // RIGHT edge: tspan = CLIPANGLE - a2
        hex.sub 8, tspan, a2
        hex.cmp 8, tspan, c2clip, rightok, rightok, rightclip
      rightclip:
        hex.mov 8, diff, tspan
        hex.sub 8, diff, c2clip
        hex.cmp 8, diff, span, setright, end, end      // off the right, cull
      setright:
        hex.mov 8, a2, cnegclip                        // a2 = -CLIPANGLE (0xE0000000)
      rightok:
        .angle_to_x tx1, a1
        .angle_to_x tx2, a2
        hex.scmp 8, tx1, tx2, visok, end, end          // x1 >= x2 -> sub-column, cull (SIGNED columns)
      visok:
        hex.set 1, visible, 1
        hex.mov 8, x1, tx1
        hex.mov 8, x2, tx2
        hex.mov 8, rw_angle1, rwa
        ;end

      a1: hex.vec 8
      a2: hex.vec 8
      span: hex.vec 8
      tspan: hex.vec 8
      diff: hex.vec 8
      rwa: hex.vec 8
      tx1: hex.vec 8
      tx2: hex.vec 8
      sgnt: hex.vec 8
      cang180: hex.vec 8, 0x80000000
      cclip: hex.vec 8, 0x20000000        // CLIPANGLE = ANG45
      c2clip: hex.vec 8, 0x40000000       // 2*CLIPANGLE = ANG90 (the full FOV)
      cnegclip: hex.vec 8, 0xE0000000     // -CLIPANGLE mod 2^32
      end:
    }

    // proj.wall_screen_span top, bottom, ceilfix, floorfix, viewz, scale, centeryfix (R_RenderSegLoop's
    //   vertical projection): the screen rows a wall column fills. top = (centeryfix - fixed_mul(ceilfix -
    //   viewz, scale)) >> 16, bottom likewise from floorfix; ceilfix/floorfix = ceil_h/floor_h << 16
    //   (16.16). The >>16 is ARITHMETIC (signed rows): logical shr 4 nibbles then sign_extend the low 4.
    //   Outputs SIGNED row ints (8-nibble 2's-complement; the render loop clips off-screen rows). top <
    //   bottom always. centeryfix = CENTERY<<16 (resolution-dependent) is a compile-time arg (R6). Mirrors
    //   reference_model.wall_screen_span EXACTLY (the oracle's _signed(fixed_mul) wrap == fj's 2's-comp).
    //   @requires hex.init
    def wall_screen_span top, bottom, ceilfix, floorfix, viewz, scale, centeryfix \
            @ wt, prod, end {
        hex.mov 8, wt, ceilfix
        hex.sub 8, wt, viewz                // worldtop = ceilfix - viewz
        hex.fixed_mul_lo 8, 4, prod, wt, scale
        hex.set 8, top, centeryfix
        hex.sub 8, top, prod                // topfrac = centeryfix - worldtop*scale
        hex.shr_hex 8, 4, top               // >> 16 (logical) ...
        hex.sign_extend 8, 4, top           //   ... + sign-extend low 4 nibbles = arithmetic >> 16

        hex.mov 8, wt, floorfix
        hex.sub 8, wt, viewz                // worldbottom = floorfix - viewz
        hex.fixed_mul_lo 8, 4, prod, wt, scale
        hex.set 8, bottom, centeryfix
        hex.sub 8, bottom, prod
        hex.shr_hex 8, 4, bottom
        hex.sign_extend 8, 4, bottom
        ;end

      wt: hex.vec 8
      prod: hex.vec 8
      end:
    }

    // proj.scalestep dst, scale1, scale2, x1, x2 (the per-column rw_scalestep, render_wall_frame): the
    //   linear scale increment dst = trunc((scale2 - scale1) / (x2 - x1)) TOWARD ZERO — a PLAIN truncated
    //   integer divide, NOT FixedDiv (the oracle + fj must divide identically). 0 if x2 <= x1. scale1/2
    //   are 16.16 (positive, clamped); x1/x2 are signed columns; dst is signed (8-nibble 2's-comp).
    //   The x2>x1 guard is signed (hex.scmp), diff's sign uses hex.sign, the divide is on magnitudes
    //   (unsigned hex.div), and a negative diff negates the quotient (-(|diff|//span) = trunc toward 0).
    //   @requires hex.init
    def scalestep dst, scale1, scale2, x1, x2 \
            @ diff, span, q, r, le_, gt_, neg_, pos_, baddiv, end {
        hex.scmp 8, x2, x1, le_, le_, gt_   // x2 > x1 ? (signed columns) — else step 0
      le_:
        hex.zero 8, dst
        ;end
      gt_:
        hex.mov 8, span, x2
        hex.sub 8, span, x1                 // span = x2 - x1  (> 0)
        hex.mov 8, diff, scale2
        hex.sub 8, diff, scale1             // diff = scale2 - scale1 (signed)
        hex.sign 8, diff, neg_, pos_
      neg_:
        hex.neg 8, diff                     // |diff|
        hex.div 8, 2, q, r, diff, span, baddiv   // M13: span = x2-x1 <= VIEW_W fits 2 nibbles
        hex.mov 8, dst, q
        hex.neg 8, dst                      // dst = -(|diff| // span)  (trunc toward zero)
        ;end
      pos_:
        hex.div 8, 2, q, r, diff, span, baddiv   // dst = diff // span (2-nib divisor)
        hex.mov 8, dst, q
        ;end
      baddiv:                               // unreachable (span > 0); safe fallback
        hex.zero 8, dst
        ;end

      diff: hex.vec 8
      span: hex.vec 8
      q: hex.vec 8
      r: hex.vec 8
      end:
    }

    // proj.wall_offset rw_offset, rw_centerangle, viewx, viewy, viewangle, rw_normalangle, rw_angle1,
    //   v1x, v1y, texoff (R_StoreWallRange texture-horizontal setup, _wall_offset): writes rw_offset (the
    //   16.16 wall-space horizontal coord of v1) and rw_centerangle (seeds the per-column finetangent).
    //   offsetangle = rw_normalangle - rw_angle1; rw_offset = fixed_mul(point_to_dist(view,v1),
    //   read_sin(BAM-abs(offsetangle) clamped to ANG90)); NEGATE if the UNFOLDED offsetangle < ANG180
    //   (DOOM's sign rule); then += texoff (= (seg.offset + sd.x_off)<<16). rw_centerangle = ANG90 +
    //   viewangle - rw_normalangle. All angle compares are unsigned BAM (hex.cmp). Mirrors the oracle
    //   exactly. @requires hex.init & stl.ptr_init  (inlines point_to_dist + finesine.read_sin)
    def wall_offset rw_offset, rw_centerangle, viewx, viewy, viewangle, rw_normalangle, rw_angle1, v1x, v1y, texoff \
            @ offsetangle, oa, hyp, sidx, sinv, cang90, cang180, \
              gt180, le180, gt90, le90, doneg, skipneg, end {
        .point_to_dist hyp, viewx, viewy, v1x, v1y     // hyp = view->v1 distance
        hex.mov 8, offsetangle, rw_normalangle
        hex.sub 8, offsetangle, rw_angle1              // offsetangle = rw_normalangle - rw_angle1

        hex.mov 8, oa, offsetangle                     // oa = BAM abs(offsetangle), clamp to ANG90
        hex.cmp 8, oa, cang180, le180, le180, gt180
      gt180:
        hex.neg 8, oa
      le180:
        hex.cmp 8, oa, cang90, le90, le90, gt90
      gt90:
        hex.mov 8, oa, cang90
      le90:
        hex.shr_hex 8, 5, oa                           // read_sin(oa): idx = oa >> 20 (low 3 nibbles)
        hex.mov 3, sidx, oa
        finesine.read_sin sinv, sidx
        hex.fixed_mul_lo 8, 4, rw_offset, hyp, sinv       // rw_offset = hyp * sin(oa)

        hex.cmp 8, offsetangle, cang180, doneg, skipneg, skipneg   // UNFOLDED offsetangle < ANG180 -> negate
      doneg:
        hex.neg 8, rw_offset
      skipneg:
        hex.add 8, rw_offset, texoff                   // += (seg.offset + sd.x_off) << 16

        hex.mov 8, rw_centerangle, viewangle           // rw_centerangle = ANG90 + viewangle - rw_normalangle
        hex.add 8, rw_centerangle, cang90
        hex.sub 8, rw_centerangle, rw_normalangle
        ;end

      offsetangle: hex.vec 8
      oa: hex.vec 8
      hyp: hex.vec 8
      sidx: hex.vec 3
      sinv: hex.vec 8
      cang90: hex.vec 8, 0x40000000
      cang180: hex.vec 8, 0x80000000
      end:
    }

    // proj.texture_u dst, rw_centerangle, rw_offset, rw_distance, x, tw (per-column texture u-coord,
    //   render_wall_frame lines 549-552): dst = the texture column [0, tw) for screen column x.
    //   ang = rw_centerangle + xtoviewangle[x]; ft = finetangent[ang >> angle_shift(20)];
    //   tcol = (rw_offset - fixed_mul(ft, rw_distance)) >> 16 (ARITHMETIC, signed); dst = tcol mod tw,
    //   a FLOORED modulo (result in [0, tw) even for negative tcol). Implemented as an unsigned divide on
    //   |tcol| then, when tcol<0 and the remainder != 0, dst = tw - remainder (= Python's tcol % tw).
    //   Reads the M12l xtoviewangle (idx=column) + finetangent LUTs. Mirrors the oracle EXACTLY.
    //   @requires hex.init & stl.ptr_init   (read_table x2)
    def texture_u dst, rw_centerangle, rw_offset, rw_distance, x, tw \
            @ ang, ft, prod, tcol, atcol, q, m, idx, czero, \
              tpos, tneg, mzero, mnz, baddiv, end \
            < xtoviewangle, finetangent {
        hex.read_table_packed 4, ang, xtoviewangle, 2, x      // xtoviewangle[x]   (idx = screen column)
        hex.add 8, ang, rw_centerangle                 // ang = rw_centerangle + xtoviewangle[x]
        hex.shr_hex 8, 5, ang                          // ang >> angle_shift(20) = 5 nibbles
        hex.mov 3, idx, ang                            //   low 3 nibbles = the finetangent index
        hex.read_table_packed 4, ft, finetangent, 3, idx      // ft = finetangent[idx]  (signed)
        hex.fixed_mul_lo 8, 4, prod, ft, rw_distance      // prod = ft * rw_distance (signed)
        hex.mov 8, tcol, rw_offset
        hex.sub 8, tcol, prod                          // rw_offset - prod
        hex.shr_hex 8, 4, tcol
        hex.sign_extend 8, 4, tcol                     // arithmetic >> 16 -> signed texel column tcol

        hex.sign 8, tcol, tneg, tpos                   // floored mod: tcol % tw -> [0, tw)
      tpos:
        hex.div 8, 8, q, m, tcol, tw, baddiv           // tcol >= 0: dst = tcol % tw (unsigned)
        hex.mov 8, dst, m
        ;end
      tneg:
        hex.mov 8, atcol, tcol
        hex.neg 8, atcol                               // |tcol|
        hex.div 8, 8, q, m, atcol, tw, baddiv          // m = |tcol| % tw
        hex.cmp 8, m, czero, mnz, mzero, mnz           // m == 0 ? (unsigned magnitude)
      mzero:
        hex.zero 8, dst                                // exact multiple -> 0
        ;end
      mnz:
        hex.mov 8, dst, tw
        hex.sub 8, dst, m                              // dst = tw - (|tcol| % tw)  in (0, tw)
        ;end
      baddiv:                                          // tw == 0 unreachable; safe fallback
        hex.zero 8, dst
        ;end

      ang: hex.vec 8
      ft: hex.vec 8
      prod: hex.vec 8
      tcol: hex.vec 8
      atcol: hex.vec 8
      q: hex.vec 8
      m: hex.vec 8
      idx: hex.vec 3
      czero: hex.vec 8, 0
      end:
    }

    // proj.column_setup frac0, step, scale, worldtop, top, centery, ds (the per-column texture-v DDA
    //   setup, render_wall_frame lines 553-559): from a column's `scale` (16.16), the wall's `worldtop`
    //   (= sec.ceil_h - viewz_world, signed map units) and the clipped `top` screen row (signed), compute
    //   the 8.8 DDA params the textured-column leaf consumes. iscale = fixed_div(1<<16, scale) // ds
    //   (texels/pixel 16.16); texturemid = (worldtop<<16) // ds; frac = texturemid + (top-CENTERY)*iscale;
    //   frac0 = (frac>>8)&0xFFFF, step = (iscale>>8)&0xFFFF (both 8.8, 16-bit). `ds` (= TEXTURE_DOWNSCALE,
    //   which is RESOLUTION-dependent: max(1, NATIVE_W//W)) and CENTERY are both compile-time args from
    //   the Config SSOT (R6 — NOT hardcoded). The `// ds` is a FLOORED divide (Python //): iscale is
    //   positive so a plain divide suffices; texturemid (signed, ceiling-below-eye) uses sign-aware
    //   flooring (-qmag, minus 1 more when the magnitude divide leaves a remainder). (top-CENTERY)*iscale
    //   is a PLAIN signed multiply (2's-complement mod 2^32 via hex.mul), NOT fixed_mul. Mirrors the
    //   oracle EXACTLY. @requires hex.init
    def column_setup frac0, step, scale, worldtop, top, centery, ds \
            @ ipre, iscale, wtf, awtf, qmag, rmag, texmid, tc, ccy, prod, frac, \
              cds, czero, r0, wpos, wneg, radj, tm_done, baddiv, end, \
              isc_nrm, isc_more, isc_done, isc_sh, isc_shm, isc_shd, sscale, rc, irecip, cfff, czero2i \
            < slopediv_recip {
        // perf #11 [re-bless]: ipre = (1<<32)//scale via the block-FP reciprocal (numerator 2^32 is a
        // power of 2 -> a pure SHIFT of recip[m], NO divide, NO mul). scale is the clamped wall scale
        // (>= SCALE_MIN=256), so only right-normalize: bring scale's top 3 nibbles to m (counting rc),
        // recip = slopediv_recip[m], ipre = (recip << 2 nibbles) >> rc nibbles. Mirrors _recip_div32.
        hex.mov 8, sscale, scale
        hex.set 2, rc, 0
      isc_nrm:
        hex.cmp 8, sscale, cfff, isc_done, isc_done, isc_more   // sscale > 0xFFF ?  gt -> shift right
      isc_more:
        hex.shr_hex 8, 1, sscale
        hex.inc 2, rc
        ;isc_nrm
      isc_done:
        hex.read_table_packed 3, irecip, slopediv_recip, 3, sscale     // recip[m]  (m = sscale, low 3 nibbles)
        hex.zero 8, ipre
        hex.mov 5, ipre, irecip
        hex.shl_hex 8, 2, ipre                                  // recip << 2 nibbles
      isc_sh:
        hex.cmp 2, rc, czero2i, isc_shd, isc_shd, isc_shm       // rc > 0 ?  gt -> shift right
      isc_shm:
        hex.shr_hex 8, 1, ipre
        hex.dec 2, rc
        ;isc_sh
      isc_shd:                                                  // ipre = (recip<<2) >> rc = recip<<(2-rc)
        hex.set 8, cds, ds
        hex.div 8, 8, iscale, r0, ipre, cds, baddiv        // iscale = ipre // ds (positive: trunc == floor)

        hex.mov 8, wtf, worldtop                           // wtf = worldtop << 16  (16.16, signed)
        hex.shl_hex 8, 4, wtf
        hex.sign 8, wtf, wneg, wpos                        // texturemid = wtf // ds  (FLOORED)
      wpos:
        hex.div 8, 8, texmid, r0, wtf, cds, baddiv         //   wtf >= 0: plain divide
        ;tm_done
      wneg:
        hex.mov 8, awtf, wtf
        hex.neg 8, awtf                                    //   |wtf|
        hex.div 8, 8, qmag, rmag, awtf, cds, baddiv        //   qmag = |wtf|//ds, rmag = |wtf|%ds
        hex.mov 8, texmid, qmag
        hex.neg 8, texmid                                  //   -qmag
        hex.cmp 8, rmag, czero, radj, tm_done, radj        //   rmag != 0 -> floor one more
      radj:
        hex.dec 8, texmid                                  //   -(qmag+1)  (floored toward -inf)
        ;tm_done
      tm_done:
        hex.set 8, ccy, centery
        hex.mov 8, tc, top
        hex.sub 8, tc, ccy                                 // tc = top - CENTERY (signed)
        hex.mul 8, prod, tc, iscale                        // (top-CENTERY)*iscale (signed, 2's-comp mod 2^32)
        hex.mov 8, frac, texmid
        hex.add 8, frac, prod                              // frac = texturemid + (top-CENTERY)*iscale

        hex.shr_hex 8, 2, iscale                           // step = (iscale >> 8) & 0xFFFF
        hex.mov 4, step, iscale
        hex.shr_hex 8, 2, frac                             // frac0 = (frac >> 8) & 0xFFFF
        hex.mov 4, frac0, frac
        ;end

      baddiv:                                              // scale==0 / ds==0 unreachable; safe fallback
        hex.zero 4, frac0
        hex.zero 4, step
        ;end

      ipre: hex.vec 8
      iscale: hex.vec 8
      wtf: hex.vec 8
      awtf: hex.vec 8
      qmag: hex.vec 8
      rmag: hex.vec 8
      texmid: hex.vec 8
      tc: hex.vec 8
      ccy: hex.vec 8
      prod: hex.vec 8
      frac: hex.vec 8
      sscale: hex.vec 8                  // perf #11: block-FP reciprocal scratch
      rc: hex.vec 2
      irecip: hex.vec 6
      cfff: hex.vec 8, 0xfff
      czero2i: hex.vec 2, 0
      cds: hex.vec 8
      czero: hex.vec 8, 0
      r0: hex.vec 8
      end:
    }

    // proj.wall_scale_setup scale1, scalestep_out, viewangle, rw_normalangle, rw_distance, x1, x2,
    //   projection (the per-seg scale interpolation seed, render_wall_frame lines 521-527): scale1 = the
    //   column-x1 wall scale = scale_from_global_angle at visangle = viewangle + xtoviewangle[x1];
    //   scalestep_out = the linear rw_scalestep from x1 to x2 (scale2 at x2, then trunc((scale2-scale1)/
    //   (x2-x1))). The render loop then walks `scale += scalestep_out` across the columns. Composes the
    //   xtoviewangle lookup + scale_from_global_angle (M12q) x2 + scalestep (M12u). x1/x2 are columns
    //   (read as 2-nibble indices into xtoviewangle). `projection` is the compile-time Config arg (R6).
    //   Mirrors the oracle EXACTLY. @requires hex.init & stl.ptr_init   (read_table + finesine.read_sin)
    def wall_scale_setup scale1, scalestep_out, viewangle, rw_normalangle, rw_distance, x1, x2, projection \
            @ vis1, vis2, scale2, end \
            < xtoviewangle {
        hex.read_table_packed 4, vis1, xtoviewangle, 2, x1     // xtoviewangle[x1]
        hex.add 8, vis1, viewangle                      // visangle@x1 = viewangle + xtoviewangle[x1]
        .scale_from_global_angle scale1, vis1, viewangle, rw_normalangle, rw_distance, projection
        hex.read_table_packed 4, vis2, xtoviewangle, 2, x2     // xtoviewangle[x2]
        hex.add 8, vis2, viewangle                      // visangle@x2
        .scale_from_global_angle scale2, vis2, viewangle, rw_normalangle, rw_distance, projection
        .scalestep scalestep_out, scale1, scale2, x1, x2   // trunc((scale2-scale1)/(x2-x1)) toward zero
        ;end

      vis1: hex.vec 8
      vis2: hex.vec 8
      scale2: hex.vec 8
      end:
    }

    // proj.column_render_params top, bottom, texcol, frac0, step, <runtime per-column inputs>, centery,
    //   ds, viewh1 (the per-column render-parameter bundle, render_wall_frame lines 540-559): for one
    //   screen column, composes wall_screen_span -> CLIP (top=max(0,top), bottom=min(VIEW_H-1,bottom)) ->
    //   texture_u -> column_setup, yielding the column's (top, bottom [both clipped], texcol, frac0, step).
    //   The clip is the new logic: top/bottom are SIGNED rows so the clamps use hex.sign (max 0) and
    //   hex.scmp (min VIEW_H-1). centery / ds / viewh1(=VIEW_H-1) are compile-time Config args (R6);
    //   centeryfix is the compile-time expr centery*0x10000. column_setup gets the CLIPPED top (oracle
    //   line 541 clips before frac). Mirrors the oracle EXACTLY. @requires hex.init & stl.ptr_init
    def column_render_params top, bottom, texcol, frac0, step, scale, rw_centerangle, rw_offset, rw_distance, x, tw, ceilfix, floorfix, viewz, worldtop, centery, ds, viewh1 \
            @ cvh, tneg, tok, bok, bhi, end {
        .wall_screen_span top, bottom, ceilfix, floorfix, viewz, scale, centery*0x10000
        hex.sign 8, top, tneg, tok          // top = max(0, top)  (signed)
      tneg:
        hex.zero 8, top
      tok:
        hex.set 8, cvh, viewh1              // bottom = min(VIEW_H-1, bottom)  (signed)
        hex.scmp 8, bottom, cvh, bok, bok, bhi
      bhi:
        hex.mov 8, bottom, cvh
      bok:
        .texture_u texcol, rw_centerangle, rw_offset, rw_distance, x, tw
        .column_setup frac0, step, scale, worldtop, top, centery, ds   // uses the CLIPPED top
        ;end

      cvh: hex.vec 8
      end:
    }

    // M13pS2/pG3-stream — the STREAM-mode column params: just the projected+clipped [top, bottom]
    // rows (wall_screen_span + the two clips). The texture u (a hex.div!) and the vertical DDA
    // setup (column_setup) are DEAD in the column-stream renderer's W1 mode (the wall run is one
    // baked lit byte; planes come from the shared band lists), so this variant skips them — the
    // measured bulk of the old per-column cost.
    def column_render_params_stream top, bottom, scale, ceilfix, floorfix, viewz, centery, viewh1 \
            @ cvh, tneg, tok, bok, bhi, end {
        .wall_screen_span top, bottom, ceilfix, floorfix, viewz, scale, centery*0x10000
        hex.sign 8, top, tneg, tok          // top = max(0, top)  (signed)
      tneg:
        hex.zero 8, top
      tok:
        hex.set 8, cvh, viewh1              // bottom = min(VIEW_H-1, bottom)  (signed)
        hex.scmp 8, bottom, cvh, bok, bok, bhi
      bhi:
        hex.mov 8, bottom, cvh
      bok:
        ;end
      cvh: hex.vec 8
      end:
    }

    // proj.column_params_m top, bottom, scale, wtc8, wtf8, centeryfix_c, viewh1 -- the lines-mode
    //   per-column projection: wtc8/wtf8 are the PER-SEG HOISTED map-unit world heights
    //   ((ceilfix-viewz)>>16, sign-extended to 8 nibbles once per seg), so the per-column work is
    //   just prod = wt*scale (EXACT: wt<<16 * scale >> 16 == wt*scale, the mapmul identity),
    //   top = (centeryfix - prod) >> 16 arithmetic, and the clips. The multiplies run as 6
    //   schoolbook rows with SCALE as the multiplier (<= 3 nonzero nibbles; zero rows if0-skip).
    //   Bit-identical to wall_screen_span + clips on the same inputs. @requires hex.init
    def column_params_m top, bottom, scale, wtc8, wtf8, centeryfix_c, viewh1 \
            @ prod, cvh, ccyf, tneg, tok, bok, bhi, end {
        hex.zero 8, prod
        rep(6, j) hex.fixed_mul_lo.row 8, j, prod, wtc8, scale
        hex.set 8, ccyf, centeryfix_c
        hex.mov 8, top, ccyf
        hex.sub 8, top, prod                // topfrac = centeryfix - wt*scale
        hex.shr_hex 8, 4, top               // >> 16 arithmetic:
        hex.sign_extend 8, 4, top           //   logical shift + sign-extend the low half
        hex.zero 8, prod
        rep(6, j) hex.fixed_mul_lo.row 8, j, prod, wtf8, scale
        hex.mov 8, bottom, ccyf
        hex.sub 8, bottom, prod
        hex.shr_hex 8, 4, bottom
        hex.sign_extend 8, 4, bottom
        hex.sign 8, top, tneg, tok          // top = max(0, top)
      tneg:
        hex.zero 8, top
      tok:
        hex.set 8, cvh, viewh1              // bottom = min(VIEW_H-1, bottom)
        hex.scmp 8, bottom, cvh, bok, bok, bhi
      bhi:
        hex.mov 8, bottom, cvh
      bok:
        ;end
      prod: hex.vec 8
      cvh: hex.vec 8
      ccyf: hex.vec 8
      end:
    }

    // proj.point_on_side back, vx, vy, px, py, dx, dy (R_PointOnSide / mapcompiler._point_side): the BSP
    //   partition side test the bake-as-code walk (opt #7) branches on. back[:2] = 1 iff
    //   dx*(vy-py) - dy*(vx-px) > 0 (the "back/left" side; <0 or ON the line -> front -> 0). vx,vy are the
    //   viewer's 16.0 integer map coords (signed, 10-nibble sign-extended regs); px,py,dx,dy are the node's
    //   partition line, passed as their 10-nibble (40-bit) two's-complement patterns (the emitter/test masks
    //   them). Worked at 10 nibbles because int16 map coords bound the cross product by 2^32 (< 2^39), so the
    //   40-bit signed result never overflows and its sign matches the oracle's full-precision sign byte-exact.
    //   The cross product is genuinely SIGNED -> hex.scmp / hex.mul (R5). (The full bake will strength-reduce
    //   the two products with mul_const on |dx|,|dy| + an emit-time add/sub by sign; this reusable macro uses
    //   runtime hex.mul so one macro serves every node.) Mirrors mapcompiler._point_side EXACTLY. @requires hex.init
    def point_on_side back, vx, vy, px, py, dx, dy \
            @ cpx, cpy, cdx, cdy, dxv, dyv, p1, p2, czero, setback, front, end {
        hex.set 10, cpx, px
        hex.mov 10, dxv, vx
        hex.sub 10, dxv, cpx              // dxv = vx - px   (signed)
        hex.set 10, cpy, py
        hex.mov 10, dyv, vy
        hex.sub 10, dyv, cpy              // dyv = vy - py
        hex.set 10, cdx, dx
        hex.mul_lo 10, p1, cdx, dyv          // p1 = dx*(vy-py)   (signed 2's-comp, low 10 nibbles)
        hex.set 10, cdy, dy
        hex.mul_lo 10, p2, cdy, dxv          // p2 = dy*(vx-px)
        hex.sub 10, p1, p2                // side = dx*(vy-py) - dy*(vx-px)
        hex.set 10, czero, 0
        hex.scmp 10, p1, czero, front, front, setback   // <0 & ==0 -> front(0); >0 -> back(1)
      setback:
        hex.set 2, back, 1
        ;end
      front:
        hex.set 2, back, 0
        ;end

      cpx: hex.vec 10
      cpy: hex.vec 10
      cdx: hex.vec 10
      cdy: hex.vec 10
      dxv: hex.vec 10
      dyv: hex.vec 10
      p1: hex.vec 10
      p2: hex.vec 10
      czero: hex.vec 10
      end:
    }

    // proj.point_on_side_leaf back, vx, vy, cpx, cpy, cdx_mag, cdy_mag, sign_dx, sign_dy, pos_ret —
    //   the REGISTER form of point_on_side for the BSP-as-code shared fcall leaf (mantra #9): the heavy
    //   side math is emitted ONCE at a global label and fcall'd per node, NOT unrolled per node
    //   (unrolling 681x blew up the E1M1 assemble). The node's near point (cpx,cpy) is still a 10-nibble
    //   two's-complement REGISTER (it feeds a further signed subtract against the viewer), but the
    //   partition DIRECTION (dx,dy) never re-enters a subtract — only a product — so M13-possignmag
    //   bakes it as an 8-nibble zero-extended MAGNITUDE (cdx_mag/cdy_mag) + a 1-nibble sign flag
    //   (sign_dx/sign_dy, 1 iff the original dx/dy was negative). side = dx*(vy-py) - dy*(vx-px) > 0 ->
    //   back; writing it as signA*|dx|*|dyv| - signB*|dy|*|dxv| (signA = sign(dx)^sign(dyv), signB =
    //   sign(dy)^sign(dxv), both XORs of a baked bit with a runtime hex.sign test) turns the two
    //   hex.mul_lo 10 signed cross-products into two hex.mul_lo 8 UNSIGNED magnitude products (int16 map
    //   coords -> every difference/delta magnitude fits 5 nibbles, product fits 8 -- no overflow) plus a
    //   4-way sign-pair dispatch that replaces the final signed subtract+compare with a single unsigned
    //   hex.cmp 8 (or no compare at all in the two single-sign cases). Exact: same true integer sign,
    //   no mod-16^n wraparound anywhere. cdx_mag/cdy_mag as the mul_lo 'b' operand additionally gets
    //   fixed_mul_lo.row's built-in zero-digit skip on their always-zero high nibbles for free.
    //   Writes back(0/1) to `back` and returns via stl.fret pos_ret. @requires hex.init.
    def point_on_side_leaf back, vx, vy, cpx, cpy, cdx_mag, cdy_mag, sign_dx, sign_dy, pos_ret \
            @ dyv_neg, dyv_pos, dyv_done, dxv_neg, dxv_pos, dxv_done, \
              a0, a1, cmp_pp, mixed01, chk_p2, cmp_pp2, setback, front, end, \
              dxv, dyv, dxv_mag, dyv_mag, sign_dxv, sign_dyv, signA, signB, p1, p2 {
        hex.mov 10, dxv, vx
        hex.sub 10, dxv, cpx              // dxv = vx - px   (signed, 10-nib -- unchanged width)
        hex.mov 10, dyv, vy
        hex.sub 10, dyv, cpy              // dyv = vy - py

        hex.sign 10, dyv, dyv_neg, dyv_pos
      dyv_neg:
        hex.set 1, sign_dyv, 1
        hex.neg 5, dyv                     // magnitude fits 5 nibbles (int16 coords => diff <= 65535);
        ;dyv_done                          // negating only the low 5 nibbles == the true magnitude
      dyv_pos:                             // (two's-complement truncation identity)
        hex.set 1, sign_dyv, 0
      dyv_done:
        hex.zero 8, dyv_mag
        hex.mov 5, dyv_mag, dyv

        hex.sign 10, dxv, dxv_neg, dxv_pos
      dxv_neg:
        hex.set 1, sign_dxv, 1
        hex.neg 5, dxv
        ;dxv_done
      dxv_pos:
        hex.set 1, sign_dxv, 0
      dxv_done:
        hex.zero 8, dxv_mag
        hex.mov 5, dxv_mag, dxv

        hex.mul_lo 8, p1, dyv_mag, cdx_mag   // p1 = |dx|*|dyv|
        hex.mul_lo 8, p2, dxv_mag, cdy_mag   // p2 = |dy|*|dxv|

        hex.mov 1, signA, sign_dx
        hex.xor 1, signA, sign_dyv          // signA = sign(dx*dyv)
        hex.mov 1, signB, sign_dy
        hex.xor 1, signB, sign_dxv          // signB = sign(dy*dxv)

        hex.if 1, signA, a0, a1
      a0:                                    // signA==0 (p1 contributes +|p1|)
        hex.if 1, signB, cmp_pp, mixed01
      cmp_pp:                               // (+,+): side = |p1|-|p2| -> back = p1>p2
        hex.cmp 8, p1, p2, front, front, setback
      mixed01:                              // (+,-): side = |p1|+|p2| -> back unless both zero
        hex.if 8, p1, chk_p2, setback
      chk_p2:
        hex.if 8, p2, front, setback
      a1:                                    // signA==1 (p1 contributes -|p1|)
        hex.if 1, signB, front, cmp_pp2      // (-,+): side = -|p1|-|p2| <= 0 -> always front
      cmp_pp2:                              // (-,-): side = |p2|-|p1| -> back = p2>p1 (p1<p2)
        hex.cmp 8, p1, p2, setback, front, front

      setback:
        hex.set 2, back, 1
        ;end
      front:
        hex.set 2, back, 0
      end:
        stl.fret pos_ret                  // return (the data below is never fallen into — fret exits first)

      dxv: hex.vec 10
      dyv: hex.vec 10
      dxv_mag: hex.vec 8
      dyv_mag: hex.vec 8
      sign_dxv: hex.vec 1
      sign_dyv: hex.vec 1
      signA: hex.vec 1
      signB: hex.vec 1
      p1: hex.vec 8
      p2: hex.vec 8
    }

    // ── M13-mapunits (lines mode): the map-unit twins of slope_div / point_to_angle /
    // wall_x_range. Every runtime coordinate in this program is a 16.16 value whose low 16 bits
    // are ZERO (vertices are baked map<<16, the eye is parsed map<<16), so the angle pipeline can
    // run on the HIGH 4-NIBBLE slices -- 4-nibble subs/compares and a 9-nibble product instead of
    // 8- and 13-nibble ones -- and stay BIT-IDENTICAL: slope_div's mantissa normalization finds
    // the same top-3-nibble mantissa either way (m and m<<16 share significant nibbles), the
    // reciprocal is the same table entry, and the product differs by an exact <<16 that the final
    // shift absorbs (prod' = prod >> 16 exactly, no truncation difference). Verified equal by the
    // byte-exact frame gates; the fb/raster/stream modes keep the original macros untouched.

    // proj.slope_div_m dst, num, den — num/den are NON-NEGATIVE MAP-UNIT magnitudes (4 nibbles,
    //   the 16.16 values >> 16). Bit-identical to slope_div(num<<16, den<<16): den<<16 < 0x200
    //   <=> den == 0, and sden/wnum are built as den<<8 / num<<8 (= the original's (v<<16)>>8) --
    //   from there the body is the coarseslope slope_div verbatim.
    def slope_div_m dst, num, den             @ lt, ge, prodlo, nrm_hi, hi_done, nrm_lo, lo_more, lo_done, wok,               keep, clamp, done,               sden, wnum, recipw, recip, prod, csr3             < slopediv_recip8 {
        hex.if0 4, den, lt                       // den<<16 < 512 <=> den == 0
        ;ge
      lt:
        hex.set 3, dst, 0x800
        ;done
      ge:
        hex.zero 6, sden
        hex.mov 4, sden + 2*dw, den              // sden = den << 8  (== (den<<16) >> 8)
        hex.zero 6, wnum
        hex.mov 4, wnum + 2*dw, num              // wnum = num << 8
      nrm_hi:                                    // right-normalize: while sden > 0xFFF, BOTH >>= 1 nib
        hex.if0 3, sden + 3*dw, hi_done
        hex.shr_hex 6, 1, sden
        hex.shr_hex 6, 1, wnum
        ;nrm_hi
      hi_done:
      nrm_lo:                                    // left-normalize: while sden < 0x100, BOTH <<= 1 nib
        hex.if0 4, sden + 2*dw, lo_more
        ;lo_done
      lo_more:
        hex.shl_hex 6, 1, sden
        hex.shl_hex 6, 1, wnum
        ;nrm_lo
      lo_done:
        hex.if0 3, wnum + 3*dw, wok              // slope>=1 guard: oracle-equivalent clamp
        ;clamp
      wok:
        hex.read_table_packed 3, recip, slopediv_recip8, 3, sden
        hex.zero 8, recipw
        hex.mov 6, recipw, recip
        hex.zero 8, prod
        rep(3, j) hex.fixed_mul_lo.row 8, j, prod, recipw, wnum
        hex.shr_hex 8, 4, prod                   // >> 16: the FIXED final shift
        hex.if0 1, prod + 3*dw, prodlo
        ;clamp
      prodlo:
        hex.cmp 3, prod, csr3, keep, keep, clamp
      keep:
        hex.mov 3, dst, prod
        ;done
      clamp:
        hex.set 3, dst, 0x800
        ;done

      sden: hex.vec 6
      wnum: hex.vec 6
      recipw: hex.vec 8
      recip: hex.vec 6
      prod: hex.vec 8
      csr3: hex.vec 3, 0x800
      done:
    }

    // proj.point_to_angle_m dst, x1, y1, x2, y2 — the map-unit twin: x1/y1/x2/y2 are addresses of
    //   the 16.16 registers' HIGH 4-NIBBLE slices (pass reg + 4*dw). Bit-identical output.
    def point_to_angle_m dst, x1, y1, x2, y2 \
            @ dx, dy, num, den, idx, sidx, base, c1, c2, c4, c6, \
              sxn, sxp, sxd, syn, syp, syd, dxz, bothz, nz, gt_, ndx, numden, \
              lo4, lo2, hi4, oct0, oct1, oct2, oct3, oct4, oct5, oct6, oct7, done \
            < tantoangle {
        hex.mov 4, dx, x2
        hex.sub 4, dx, x1                        // dx = x2 - x1   (signed map units)
        hex.mov 4, dy, y2
        hex.sub 4, dy, y1
        hex.set 1, idx, 0

        hex.sign 4, dx, sxn, sxp
      sxn:
        hex.add 1, idx, c4
        hex.neg 4, dx
        ;sxd
      sxp:
      sxd:
        hex.sign 4, dy, syn, syp
      syn:
        hex.add 1, idx, c2
        hex.neg 4, dy
        ;syd
      syp:
      syd:
        hex.if0 4, dx, dxz
        ;nz
      dxz:
        hex.if0 4, dy, bothz
        ;nz
      bothz:
        hex.zero 8, dst
        ;done
      nz:
        hex.cmp 4, dx, dy, ndx, ndx, gt_
      gt_:
        hex.add 1, idx, c1
        hex.mov 4, num, dy
        hex.mov 4, den, dx
        ;numden
      ndx:
        hex.mov 4, num, dx
        hex.mov 4, den, dy
        ;numden
      numden:
        .slope_div_m sidx, num, den
        hex.read_table_packed 4, base, tantoangle, 3, sidx
        hex.cmp 1, idx, c4, lo4, oct4, hi4
      lo4:
        hex.cmp 1, idx, c2, lo2, oct2, oct3
      lo2:
        hex.cmp 1, idx, c1, oct0, oct1, oct1
      hi4:
        hex.cmp 1, idx, c6, oct5, oct6, oct7
      oct0:
        hex.set 8, dst, 0x3FFFFFFF
        hex.sub 8, dst, base
        ;done
      oct1:
        hex.mov 8, dst, base
        ;done
      oct2:
        hex.set 8, dst, 0xC0000000
        hex.add 8, dst, base
        ;done
      oct3:
        hex.zero 8, dst
        hex.sub 8, dst, base
        ;done
      oct4:
        hex.set 8, dst, 0x40000000
        hex.add 8, dst, base
        ;done
      oct5:
        hex.set 8, dst, 0x7FFFFFFF
        hex.sub 8, dst, base
        ;done
      oct6:
        hex.set 8, dst, 0xBFFFFFFF
        hex.sub 8, dst, base
        ;done
      oct7:
        hex.set 8, dst, 0x80000000
        hex.add 8, dst, base
        ;done

      dx: hex.vec 4
      dy: hex.vec 4
      num: hex.vec 4
      den: hex.vec 4
      idx: hex.vec 1
      sidx: hex.vec 3
      base: hex.vec 8
      c1: hex.vec 1, 1
      c2: hex.vec 1, 2
      c4: hex.vec 1, 4
      c6: hex.vec 1, 6
      done:
    }

    // proj.wall_x_range_m — the lines-mode variant: map-unit atans (point_to_angle_m on the
    //   4-nibble slices), NO rw_angle1 output (dead in lines mode), no cull-path output zeroing
    //   (the leaf frets on !visible without reading x1/x2), and the final column compare at
    //   2 nibbles (post-clip columns are in [0, VIEW_W+1]). Everything else mirrors wall_x_range.
    def wall_x_range_m visible, x1, x2, sgn, viewx, viewy, viewxa, viewxs, viewya, viewys, viewangle, v1x, v1y, v2x, v2y, a, b, c \
            @ a1, a2, span, tspan, diff, tx1, tx2, sgnt, frontok, \
              xadone, yadone, \
              cclip, c2clip, cnegclip, \
              notback, leftclip, setleft, leftok, rightclip, setright, rightok, visok, end {
        hex.set 1, visible, 0

        // M13-mapmul: viewxa = |viewx| = m<<16, so fixed_mul(a, m<<16) = (a*m<<16)>>16 = a*m
        // EXACTLY (no truncation) -- the mul runs on the 4-NIBBLE map slice (viewxa+4*dw) at
        // mul_lo 8 instead of fixed_mul_lo 8,4's 12-nibble internal width. Bit-identical.
        hex.zero 8, sgn
        rep(4, j) hex.fixed_mul_lo.row 8, j, sgn, a, viewxa + 4*dw   // 4 multiplier rows only
        hex.if0 1, viewxs, xadone
        hex.neg 8, sgn
      xadone:
        hex.zero 8, sgnt
        rep(4, j) hex.fixed_mul_lo.row 8, j, sgnt, b, viewya + 4*dw
        hex.if0 1, viewys, yadone
        hex.neg 8, sgnt
      yadone:
        hex.add 8, sgn, sgnt
        hex.add 8, sgn, c
        hex.sign 8, sgn, end, frontok
      frontok:
        hex.if0 8, sgn, end
        .point_to_angle_m a1, viewx + 4*dw, viewy + 4*dw, v1x + 4*dw, v1y + 4*dw
        .point_to_angle_m a2, viewx + 4*dw, viewy + 4*dw, v2x + 4*dw, v2y + 4*dw
        hex.mov 8, span, a1
        hex.sub 8, span, a2
        hex.sign 8, span, end, notback
      notback:
        hex.sub 8, a1, viewangle
        hex.sub 8, a2, viewangle

        hex.mov 8, tspan, a1
        hex.add 8, tspan, cclip
        hex.cmp 8, tspan, c2clip, leftok, leftok, leftclip
      leftclip:
        hex.mov 8, diff, tspan
        hex.sub 8, diff, c2clip
        hex.cmp 8, diff, span, setleft, end, end
      setleft:
        hex.mov 8, a1, cclip
      leftok:
        hex.mov 8, tspan, cclip
        hex.sub 8, tspan, a2
        hex.cmp 8, tspan, c2clip, rightok, rightok, rightclip
      rightclip:
        hex.mov 8, diff, tspan
        hex.sub 8, diff, c2clip
        hex.cmp 8, diff, span, setright, end, end
      setright:
        hex.mov 8, a2, cnegclip
      rightok:
        .angle_to_x tx1, a1
        .angle_to_x tx2, a2
        hex.cmp 2, tx1, tx2, visok, end, end     // post-clip columns are unsigned-small
      visok:
        hex.set 1, visible, 1
        hex.mov 8, x1, tx1
        hex.mov 8, x2, tx2
        ;end

      a1: hex.vec 8
      a2: hex.vec 8
      span: hex.vec 8
      tspan: hex.vec 8
      diff: hex.vec 8
      tx1: hex.vec 8
      tx2: hex.vec 8
      sgnt: hex.vec 8
      cclip: hex.vec 8, 0x20000000
      c2clip: hex.vec 8, 0x40000000
      cnegclip: hex.vec 8, 0xE0000000
      end:
    }

}
