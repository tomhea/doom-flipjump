// ==============================================================================================
// sim_wide.fj    M8 F1.5 -- the WIDE-LIST twins: runtime thing ids past 254 (docs/f1-runtime-ids.md, A1)
// STATUS  LIVE only on a map with Config.LIST_ID_BITS = 12 (build.py includes it after sim.fj then, never
//         otherwise); assembled with `-D hex.pointers.PTR_WIDE_BITS=12` (config.Config.fj_defines)
// ENTRY   sim.leaf_link_w, sim.leaf_unlink_w, sim.thing_pass_depth_w, sim.rank_key_w, m1.zerocell12
// NOTE    its OWN file, so sim.fj and m1_reset.fj stay byte-identical to the 8-bit programs' (every test that
//         mutates sim.fj by text, and every heat key naming its macro paths, sees what it always saw)
// ==============================================================================================
ns sim {
    // M8 F1.5 (docs/f1-runtime-ids.md, option A1) -- THE WIDE-LIST TWINS: a map whose runtime ids pass 254
    // (Config.LIST_ID_BITS = 12: E1M3 341, E1M4 345, E1M5 370 things + pools + drops) keeps its per-leaf lists in
    // the SAME cells at the SAME stride -- an entry is id + 1 in bits dbit .. dbit+11 of its jump word -- and reads
    // and writes them through flipjump's DUAL decoder table: hex.read_cell / hex.write_cell, a 4,096-entry table at
    // op 4,096 that the build lays with `-D hex.pointers.PTR_WIDE_BITS=12` (config.Config.fj_defines). Every
    // other op is the 8-bit macro's, with an id 3 nibbles wide where it was 2 (ll_enc / ll_v / ll_nxt, td_rk).
    //
    // ⚠ TWINS BY RULE, NOT BY HAND: tests/host/test_wide_list_twins.py derives each body below from its 8-bit macro
    // in sim.fj (the accessor, the widths -- nothing else) and requires this text to equal it, with R9 mutants. The
    // 8-bit macros are untouched, so E1M1's and E1M2's programs -- and every heat-list key that names their macro
    // paths -- are what they were; a wide map's emitter calls these names (doomfj.things.list_macros).
    // ⚠ The guard: assembled without the wide table, `hex.read_cell` would silently read 8 bits (PTR_WIDE falls
    // back to PTR_CELL_BITS) -- an undefined macro instead makes that an assembly error that names the fix.
    // tests/fj/test_wide_ids_fj.py RUNS them at ids 0 .. 299 across 255 / 256 (with mutants).

    // sim.leaf_link at 12 bits: t (w/4 nibbles, < 4,094) stored as t + 1
    def leaf_link_w t, leaf @ at_head, scan, step, after, done \
            < sshead, thnext, ll_enc, ll_v, ll_nxt, ll_p, ll_q, ll_base, ll_idx {
        rep(hex.pointers.PTR_WIDE_BITS != 12, i) .LIST_WIDE__needs__D_hex_pointers_PTR_WIDE_BITS_12
        hex.mov 3, ll_enc, t
        hex.inc 3, ll_enc
        hex.set w/4, ll_base, sshead
        hex.ptr_index ll_p, ll_base, leaf
        hex.read_cell ll_v, ll_p
        hex.if0 3, ll_v, at_head
        hex.cmp 3, ll_v, ll_enc, scan, scan, at_head
      scan:
        hex.zero w/4, ll_idx
        hex.mov 3, ll_idx, ll_v
        hex.dec w/4, ll_idx
        hex.set w/4, ll_base, thnext
        hex.ptr_index ll_p, ll_base, ll_idx
        hex.read_cell ll_nxt, ll_p
        hex.if0 3, ll_nxt, after
        hex.cmp 3, ll_nxt, ll_enc, step, step, after
      step:
        hex.mov 3, ll_v, ll_nxt
        ;scan
      after:
        hex.ptr_index ll_q, ll_base, t
        hex.write_cell ll_q, ll_nxt
        hex.write_cell ll_p, ll_enc
        ;done
      at_head:
        hex.set w/4, ll_base, thnext
        hex.ptr_index ll_q, ll_base, t
        hex.write_cell ll_q, ll_v
        hex.write_cell ll_p, ll_enc
      done:
    }

    def leaf_unlink_w t, leaf @ head, walk, advance, unlink, done \
            < sshead, thnext, ll_enc, ll_v, ll_nxt, ll_p, ll_q, ll_base, ll_idx {
        rep(hex.pointers.PTR_WIDE_BITS != 12, i) .LIST_WIDE__needs__D_hex_pointers_PTR_WIDE_BITS_12
        hex.mov 3, ll_enc, t
        hex.inc 3, ll_enc
        hex.set w/4, ll_base, sshead
        hex.ptr_index ll_p, ll_base, leaf
        hex.read_cell ll_v, ll_p
        hex.cmp 3, ll_v, ll_enc, walk, head, walk
      head:
        hex.set w/4, ll_base, thnext
        hex.ptr_index ll_q, ll_base, t
        hex.read_cell ll_nxt, ll_q
        hex.write_cell ll_p, ll_nxt
        hex.zero 3, ll_nxt
        hex.write_cell ll_q, ll_nxt
        ;done
      walk:
        hex.if0 3, ll_v, done
        hex.zero w/4, ll_idx
        hex.mov 3, ll_idx, ll_v
        hex.dec w/4, ll_idx
        hex.set w/4, ll_base, thnext
        hex.ptr_index ll_p, ll_base, ll_idx
        hex.read_cell ll_nxt, ll_p
        hex.cmp 3, ll_nxt, ll_enc, advance, unlink, advance
      advance:
        hex.mov 3, ll_v, ll_nxt
        ;walk
      unlink:
        hex.ptr_index ll_q, ll_base, t
        hex.read_cell ll_nxt, ll_q
        hex.write_cell ll_p, ll_nxt
        hex.zero 3, ll_nxt
        hex.write_cell ll_q, ll_nxt
      done:
    }

    // the 7-parameter form, as the 8-bit walk's
    def thing_pass_depth_w throw, n_th, thpos, anim, sel, selret, lthi {
        .thing_pass_depth_w throw, n_th, thpos, anim, sel, selret, lthi, 0, 0
    }

    // sim.thing_pass_depth at 12 bits: the head and the links read wide; rank 0 from td_rk (3 nibbles) on
    def thing_pass_depth_w throw, n_th, thpos, anim, sel, selret, lthi, rk0, ex \
            @ multi, single, round, scan, key_read, keyed, cand_eq, cand, take, next, round_end, done, empty \
            < cur_ssp, thnext, tstop, thing_ret, thing_leaf, viewx, viewy, mt_dx, mt_dy, mt_d, mt_ret, \
              mt_dist_leaf, td_head, td_e, td_t, td_p, td_q, td_best, td_bk, td_lk, td_lt, td_have, td_first, \
              td_poff, td_pbase, td_pptr, td_rk, sp_ex, td_kp, td_keys, \
              sp_x, sp_y, sp_z, sp_left, sp_w, sp_hh, sp_tzmax, sp_tzmax2, \
              sp_mon, sp_base, sp_base2, sp_dw, sp_lt {
        rep(hex.pointers.PTR_WIDE_BITS != 12, i) .LIST_WIDE__needs__D_hex_pointers_PTR_WIDE_BITS_12
        hex.mov w/4, td_p, cur_ssp
        hex.sparse_zero HOT_PAD, w/4, td_head
        hex.read_cell td_head, td_p
        hex.if0 w/4, td_head, empty
        hex.mov w/4, td_t, td_head
        hex.dec w/4, td_t
        hex.set w/4, td_q, thnext
        hex.ptr_index td_p, td_q, td_t
        hex.sparse_zero HOT_PAD, w/4, td_e
        hex.read_cell td_e, td_p
        hex.if0 w/4, td_e, single
        ;multi
      single:
        hex.if1 1, tstop, done
        .thing_load throw, n_th, thpos, td_t, anim, sel, selret
        stl.fcall thing_leaf, thing_ret
        rep(ex, k) hex.sparse_zero HOT_PAD, 1, sp_ex
        ;done
      multi:
        hex.set 1, td_first, 1
        rep(rk0>0, k) hex.set 3, td_rk, rk0
      round:
        hex.if1 1, tstop, done
        hex.zero 1, td_have
        hex.mov w/4, td_e, td_head
      scan:
        hex.if0 w/4, td_e, round_end
        hex.mov w/4, td_t, td_e
        hex.dec w/4, td_t
        hex.mov w/4, td_poff, td_t
        hex.shl_hex w/4, 1, td_poff
        hex.set w/4, td_pbase, td_keys
        hex.ptr_index td_kp, td_pbase, td_poff
        hex.if0 1, td_first, key_read
        .thing_int_read thpos, td_t, td_poff, td_pbase, td_pptr
        hex.sub 4, mt_dx, viewx + 4*dw
        hex.sub 4, mt_dy, viewy + 4*dw
        stl.fcall mt_dist_leaf, mt_ret
        rep(rk0>0, k) .rank_key_w
        rep(4, i) hex.write_hex_and_inc td_kp, mt_d + i*dw
        ;keyed
      key_read:
        rep(4, i) hex.read_hex_and_inc mt_d + i*dw, td_kp
      keyed:
        hex.if1 1, td_first, cand
        hex.cmp 4, mt_d, td_lk, next, cand_eq, cand
      cand_eq:
        hex.cmp w/4, td_t, td_lt, next, next, cand
      cand:
        hex.if0 1, td_have, take
        hex.cmp 4, mt_d, td_bk, take, next, next
      take:
        hex.mov w/4, td_best, td_t
        hex.mov 4, td_bk, mt_d
        hex.set 1, td_have, 1
      next:
        hex.set w/4, td_q, thnext
        hex.ptr_index td_p, td_q, td_t
        hex.sparse_zero HOT_PAD, w/4, td_e
        hex.read_cell td_e, td_p
        ;scan
      round_end:
        hex.if0 1, td_have, done
        hex.mov 4, td_lk, td_bk
        hex.mov w/4, td_lt, td_best
        hex.zero 1, td_first
        .thing_load throw, n_th, thpos, td_best, anim, sel, selret
        stl.fcall thing_leaf, thing_ret
        rep(ex, k) hex.sparse_zero HOT_PAD, 1, sp_ex
        ;round
      done:
        hex.sparse_zero HOT_PAD, 8, sp_x
        hex.sparse_zero HOT_PAD, 8, sp_y
        hex.sparse_zero HOT_PAD, 8, sp_z
        hex.sparse_zero HOT_PAD, 8, sp_left
        hex.sparse_zero HOT_PAD, 8, sp_w
        hex.sparse_zero HOT_PAD, 8, sp_hh
        hex.sparse_zero HOT_PAD, 8, sp_tzmax
        hex.sparse_zero HOT_PAD, 8, sp_tzmax2
        hex.sparse_zero HOT_PAD, 2, sp_mon
        hex.sparse_zero HOT_PAD, 4, sp_base
        hex.sparse_zero HOT_PAD, 4, sp_base2
        hex.sparse_zero HOT_PAD, 2, sp_dw
        hex.sparse_zero HOT_PAD, 2, sp_lt
        rep(anim, k) hex.zero 2, lthi
      empty:
    }

    // sim.rank_key on a 3-nibble td_t / td_rk (rows past 255)
    def rank_key_w @ r1, r0 < td_t, td_rk, mt_d {
        hex.cmp 3, td_t, td_rk, r1, r0, r0
      r1:
        hex.xor_by 1, mt_d + 3*dw, 8
      r0:
    }
}

ns m1 {
    // M8 F1.5 (docs/f1-runtime-ids.md): zerobyte for a 12-bit list cell (a wide-list map's sshead / thnext, at
    // Config.LIST_ID_BITS 12) -- the same round trip through the WIDE decoder table: flip bit dbit+12 of c, so its jump
    // word is (v+4096)*dw = `read_ptr_wide_table + v` (laid at op 4,096 by -D hex.pointers.PTR_WIDE_BITS=12), which
    // xors v's 12 bits into the 3-nibble read register and returns through ret_after_read_wide; then the three
    // nibbles xor back onto c. Needs the wide table (the guard makes its absence an assembly error, not a wild jump).
    // tests/fj/test_wide_ids_fj.py runs it on planted 0xFFF / 0x100 / 0x0FF / 0x123 (and a mutant missing a nibble).
    def zerocell12 c @ back < hex.pointers.read_byte, hex.pointers.ret_after_read_wide {
        rep(hex.pointers.PTR_WIDE_BITS != 12, i) .zerocell12__needs__D_hex_pointers_PTR_WIDE_BITS_12
        hex.zero 3, hex.pointers.read_byte
        wflip hex.pointers.ret_after_read_wide+w, back
        c+dbit+12; c
      back:
        wflip hex.pointers.ret_after_read_wide+w, back
        c+dbit+12;
        hex.exact_xor c+dbit+3, c+dbit+2, c+dbit+1, c+dbit+0, hex.pointers.read_byte
        hex.exact_xor c+dbit+7, c+dbit+6, c+dbit+5, c+dbit+4, hex.pointers.read_byte+dw
        hex.exact_xor c+dbit+11, c+dbit+10, c+dbit+9, c+dbit+8, hex.pointers.read_byte+2*dw
    }
}
